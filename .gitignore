# Secrets (.continue/: Continue's copy of BRAVE_API_KEY from older --editors
# runs, which setup.sh now removes)
.env
.continue/.env
.continue/.env.*.bak

# Native Open WebUI install (repo-local venv)
.venv/

# acp-bridge built by setup.sh --editors: binary + stamp (bin/), source
# checkout and cargo output (build/)
bin/
build/

# Runtime data and logs
data/
logs/
run/

# The test server's CA certificate, copied out of its container (docs/server.md)
server-test/test-ca.crt

# Backups made by setup.sh before overwriting files outside the repo
*.bak

# Personal Claude Code settings
.claude/settings.local.json

# OS cruft
.DS_Store

# Python bytecode
__pycache__/
*.pyc
