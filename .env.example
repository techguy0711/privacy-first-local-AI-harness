# Copy to .env (gitignored) and fill in BRAVE_API_KEY. See README.md for the full setup sequence.

MODE=local                  # local | server -- selects coder-${MODE}, backend default and editor configs
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text
SERVER_HOST=                # server mode only: TLS hostname of the shared box (see docs/server.md); unused in local mode

# Open WebUI. stack.sh passes these as --host/--port CLI flags to `open-webui
# serve` (its HOST/PORT env vars are ignored by the pip CLI -- see docs/privacy.md).
WEBUI_HOST=127.0.0.1
WEBUI_PORT=3000
WEBUI_SECRET_KEY=           # generated by setup.sh on first run; must stay stable (MCP tool credentials depend on it)
OPEN_WEBUI_VERSION=0.12.3   # pinned so every machine matches; stack.sh and the gateway are verified against it. setup.sh rebuilds the venv when it changes (data/ is kept)

# Brave Search MCP server. stack.sh registers it in Open WebUI as the "Brave
# Search" tool, on by default in new chats. Search is skipped entirely (stack.sh/doctor.sh report
# "disabled: no key") when BRAVE_API_KEY is empty. With a key, setup.sh installs
# it into build/brave-mcp/ from services/brave-mcp/package-lock.json (every
# package pinned and hash-checked), so starting it never contacts npm.
BRAVE_API_KEY=
BRAVE_MCP_VERSION=2.1.4     # must match services/brave-mcp/package-lock.json
BRAVE_MCP_HOST=127.0.0.1
BRAVE_MCP_PORT=8765
BRAVE_MCP_ENABLED_TOOLS="brave_web_search brave_news_search"

# Xcode ACP agent (optional, macOS + Xcode 27 only). acp-bridge is a minimal
# Rust ACP<->local-model adapter, used instead of larger agent CLIs that phone
# home even with telemetry disabled (see docs/privacy.md). setup.sh --editors
# builds it from this tag, refuses to build unless the tag is this exact commit,
# and applies editors/acp/acp-bridge.patch + queue.patch (needs Rust: https://rustup.rs).
ACP_BRIDGE_VERSION=0.9.2
ACP_BRIDGE_COMMIT=abadae136c6cab4ae085c050675b16e4599ca676

# Ollama runs models through llama-server, which by default keeps up to 32
# prompt-cache checkpoints per conversation and an 8 GiB prompt cache in RAM;
# on a 16 GB Mac that alone pushed the machine into swap. setup.sh puts these
# in Ollama's environment (launchctl + a login LaunchAgent on macOS; prints the
# systemd steps on Linux); restart Ollama once afterwards. They only limit
# caching, not the model's context. Empty = llama-server's own defaults. A
# shared server with spare RAM can raise LLAMA_ARG_CACHE_RAM.
LLAMA_ARG_CTX_CHECKPOINTS=4
LLAMA_ARG_CACHE_RAM=512     # MiB; the second slot below does most of its job
# KV cache (the model's context memory) in 8 bits instead of 16, applied the
# same way. Halves it and its checkpoints (about 0.5-1.1 GB with coder-local)
# with a very small precision loss: outputs can differ in wording from f16
# (docs/server.md). f16 or empty = Ollama's default, exact output.
OLLAMA_KV_CACHE_TYPE=q8_0
# Conversation slots per model, applied the same way. With one, each of Open
# WebUI's background calls (a chat's title and tags) took the chat's slot,
# so the next reply re-read the whole conversation (30-110 s on a
# 16 GB Mac). Each slot holds its own KV cache (+527 MiB with coder-local at
# q8_0). A shared server can raise it to keep more users' chats warm.
OLLAMA_NUM_PARALLEL=2

GATEWAY_PORT=8787          # always 127.0.0.1; expose only through private TLS proxy
GATEWAY_SERVICE_KEY=        # generated by setup; private WebUI -> gateway credential
QUEUE_ACTIVE=1             # concurrent inference requests; benchmark before raising
QUEUE_WAITING=32
QUEUE_PER_USER=2            # active + waiting requests per authenticated account
QUEUE_WAIT_SECONDS=300
INFERENCE_TIMEOUT_SECONDS=600
QUEUE_RETENTION_SECONDS=300 # completed jobs/results retained in RAM for reconnects
QUEUE_MAX_JOBS=128          # includes retained results; bounded total memory
QUEUE_MAX_BODY_BYTES=1048576  # everything in a request except inline images
QUEUE_MAX_RESULT_BYTES=4194304
QUEUE_MAX_IMAGE_BYTES=16777216 # inline PNG/JPEG/WebP per chat request (decoded); 0 refuses images
# One JSON line per request and per finished job in logs/gateway-audit.log:
# time, account id, endpoint, model, outcome; never prompts or replies.
# Empty = on in server mode, off in local mode; 1 or 0 to choose.
GATEWAY_AUDIT_LOG=

# Server mode only: stack.sh starts Open WebUI with these defaults unless set
# here (see docs/compliance.md). Uncomment a line to override it.
# AUDIT_LOG_LEVEL=METADATA          # sign-ins and changes, no bodies, in data/openwebui/audit.log; NONE = off
# JWT_EXPIRES_IN=12h                # login lifetime; Open WebUI's own default is 4w
# ENABLE_PASSWORD_VALIDATION=true   # with PASSWORD_VALIDATION_REGEX_PATTERN='^.{15,}$' (15+ characters)
# WEBUI_SESSION_COOKIE_SECURE=true  # login cookies over HTTPS only (the TLS proxy)
# Sign-in through your organization's identity provider (OIDC) instead of
# local passwords: Open WebUI's OAUTH_CLIENT_ID, OAUTH_CLIENT_SECRET,
# OPENID_PROVIDER_URL, ENABLE_OAUTH_SIGNUP and ENABLE_LOGIN_FORM=false
# (docs/compliance.md, identity).
