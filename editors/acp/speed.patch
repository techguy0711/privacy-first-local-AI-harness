+/// speed.patch: the harness's `scripts/` folder when this
+/// binary runs from its `bin/` (it holds `code-search`), so `bash` finds
+/// `code-search` wherever the repo was cloned.
+fn harness_scripts_dir() -> Option<PathBuf> {
+    static DIR: std::sync::OnceLock<Option<PathBuf>> = std::sync::OnceLock::new();
+    DIR.get_or_init(|| {
+        let exe = std::env::current_exe().ok()?.canonicalize().ok()?;
+        let scripts = exe.parent()?.parent()?.join("scripts");
+        scripts.join("code-search").is_file().then_some(scripts)
+    })
+    .clone()
+}
