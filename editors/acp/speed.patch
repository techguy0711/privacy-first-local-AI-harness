+/// The edited region of `patched` with line numbers and two lines of context,
+/// so the model can see the change took without reading the file again.
+fn changed_lines(original: &str, patched: &str, old_text: &str, new_text: &str) -> String {
+    const CONTEXT: usize = 2;
+    const MAX_LINES: usize = 40;
+    let Some(at) = original.find(old_text) else {
+        return String::new();
+    };
+    let first = patched[..at].matches('\n').count(); // 0-based line of the change
+    let last = first + new_text.trim_end_matches('\n').matches('\n').count();
+    let lines: Vec<&str> = patched.lines().collect();
+    let start = first.saturating_sub(CONTEXT);
+    let end = (last + CONTEXT + 1).min(lines.len()).min(start + MAX_LINES);
+    let mut out = format!("Lines {}-{} now read (no need to read the file again to check):\n", start + 1, end);
+    for (i, line) in lines[start..end].iter().enumerate() {
+        out.push_str(&format!("{:>5}  {}\n", start + i + 1, line));
+    }
+    out
+}
