+/// speed.patch: a whole-file read of a file longer than this
+/// returns only the lines around the latest search's hits in it.
+const LARGE_READ_LINES: usize = 250;
+/// Lines shown before and after each search hit in such a read.
+const HIT_CONTEXT_LINES: usize = 30;
+/// Hit lines (1-based, inclusive ranges) per file from the latest
+/// `search_code` or `code-search`, keyed by canonical path.
+static SEARCH_HITS: std::sync::Mutex<Option<HashMap<PathBuf, Vec<(usize, usize)>>>> =
+    std::sync::Mutex::new(None);
+
+/// Remember where the latest search found matches. Lines look like
+/// `path:12:text` (search_code) or `path:10-49  0.71  decl` (code-search).
+fn record_search_hits(working_dir: &Path, output: &str) {
+    let mut hits: HashMap<PathBuf, Vec<(usize, usize)>> = HashMap::new();
+    for line in output.lines() {
+        let Some((path, rest)) = line.split_once(':') else { continue };
+        let digits = |s: &str| s.chars().take_while(|c| c.is_ascii_digit()).collect::<String>();
+        let Ok(start) = digits(rest).parse::<usize>() else { continue };
+        let after = &rest[digits(rest).len()..];
+        let end = after
+            .strip_prefix('-')
+            .and_then(|s| digits(s).parse::<usize>().ok())
+            .unwrap_or(start)
+            .max(start);
+        if let Some(p) = resolve_sandboxed_path(working_dir, path).filter(|p| p.is_file()) {
+            hits.entry(p).or_default().push((start, end));
+        }
+    }
+    // Replace only this project's hits (another session may use another).
+    let wd = working_dir.canonicalize().unwrap_or_else(|_| working_dir.to_path_buf());
+    if let Ok(mut map) = SEARCH_HITS.lock() {
+        let map = map.get_or_insert_with(HashMap::new);
+        map.retain(|p, _| !p.starts_with(&wd));
+        map.extend(hits);
+    }
+}
+
+/// For a long file the latest search hit, the lines around those hits
+/// (and the hits are used up, so asking again returns the whole file).
+fn windowed_read(working_dir: &Path, path: &str, text: &str) -> Option<String> {
+    let lines: Vec<&str> = text.lines().collect();
+    if lines.len() <= LARGE_READ_LINES {
+        return None;
+    }
+    let key = resolve_sandboxed_path(working_dir, path)?;
+    let mut hits = SEARCH_HITS.lock().ok()?.as_mut()?.remove(&key)?;
+    hits.sort();
+    let mut windows: Vec<(usize, usize)> = Vec::new();
+    for (s, e) in hits.into_iter().take(6) {
+        let (s, e) = (s.saturating_sub(HIT_CONTEXT_LINES).max(1), (e + HIT_CONTEXT_LINES).min(lines.len()));
+        match windows.last_mut() {
+            Some(last) if s <= last.1 + 1 => last.1 = last.1.max(e),
+            _ => windows.push((s, e)),
+        }
+    }
+    let (first, last) = (windows.first()?.0, windows.last()?.1);
+    let mut out = format!(
+        "[{path} has {} lines; showing lines {first}-{last} around your search hit. \
+         Read other parts with offset/limit.]\n",
+        lines.len()
+    );
+    let mut shown_to = 0;
+    for (s, e) in windows {
+        if shown_to > 0 {
+            out.push_str(&format!("[lines {}-{} not shown]\n", shown_to + 1, s - 1));
+        }
+        for (i, l) in lines[s - 1..e].iter().enumerate() {
+            out.push_str(&format!("{:>5}  {l}\n", s + i));
+        }
+        shown_to = e;
+    }
+    Some(out)
+}
