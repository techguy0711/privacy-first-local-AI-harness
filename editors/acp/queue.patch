+    h.send(&json!({"jsonrpc":"2.0","id":1,"method":"initialize",
+        "params":{"protocolVersion":1,"clientCapabilities":{"session":{"notices":{}}}}}));
+    let _ = h.read_line();
+    h.send(&json!({"jsonrpc":"2.0","id":2,"method":"session/new","params":{"cwd":&cwd}}));
