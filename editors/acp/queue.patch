+/// Reconstructed from persisted tool evidence, not model-written notes. Keep
+/// the latest mutation result per file even when raw exchanges are compacted.
+pub fn file_state(messages: &[Value]) -> String {
+    let mut entries: Vec<(String, String)> = Vec::new();
+    for (i, message) in messages.iter().enumerate() {
+        let Some(calls) = message["tool_calls"].as_array() else { continue; };
+        for call in calls {
+            let name = call["function"]["name"].as_str().unwrap_or("");
+            if !matches!(name, "edit" | "write_file") { continue; }
+            let raw = &call["function"]["arguments"];
+            let args = raw.as_str().and_then(|s| serde_json::from_str::<Value>(s).ok())
+                .unwrap_or_else(|| raw.clone());
+            let Some(path) = args["path"].as_str() else { continue; };
+            let result = messages[i + 1..].iter().take_while(|m| m["role"] == "tool")
+                .find(|m| call.get("id").map_or(calls.len() == 1, |id| m.get("tool_call_id") == Some(id)));
+            let Some(text) = result.and_then(|m| m["content"].as_str()) else { continue; };
+            let failed = text.starts_with("Error") || text.starts_with("Not run");
+            let diagnostic = text.find("[Xcode diagnostics").map(|i| &text[i..]);
+            let detail = if failed { text.lines().next().unwrap_or(text) } else {
+                diagnostic.unwrap_or("Changed on disk; a full build is still required.")
+            };
+            let entry = format!("{}: {} — {}", cut(path, 160), if failed { "last edit FAILED" } else { "changed" }, cut(detail, 360));
+            entries.retain(|(p, _)| p != path);
+            entries.push((path.into(), entry));
+            if entries.len() > 8 { entries.remove(0); }
+        }
+    }
+    if entries.is_empty() { return String::new(); }
+    format!("\n{FILE_STATE_TAG}\nLatest file evidence (not a claim that the task is complete):\n{}\nUse the current file before editing; do not replay earlier changes. Resolve reported errors before unrelated work.\n</file-state>",
+        entries.into_iter().map(|(_, e)| e).collect::<Vec<_>>().join("\n"))
