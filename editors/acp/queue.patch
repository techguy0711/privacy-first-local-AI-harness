+/// A write_file or edit carrying one of the bridge's placeholders (copied
+/// from a compacted request) is refused and leaves the file as it was.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_placeholder_writes_are_refused_and_leave_the_file() {
+    let project = fresh_project_dir("placeholder");
+    std::fs::write(project.join("src/app.txt"), "real\n").unwrap();
+    let port = free_port();
+    let (router, recorded) = mock_llm_sequence_router(vec![
+        scripted_tool_call("", "w1", "write_file", json!({"path":"src/app.txt",
+            "content":"[contents of src/app.txt elided - call read_file for the current version]"})),
+        scripted_tool_call("", "e1", "edit", json!({"path":"src/app.txt", "old_text":"real",
+            "new_text":"[Older copy of src/app.txt omitted - it was read again later; use the later result.]"})),
+        final_answer("Stopped."),
+    ]);
+    let mut h = TestHarness::start_with_router_and_env(port, router, &[
+        ("LLM_BASE_URL", &format!("http://127.0.0.1:{port}/v1")), ("LLM_VERIFY", "off"),
+    ]).await;
+    h.send(&json!({"jsonrpc":"2.0","id":1,"method":"session/new","params":{"cwd":project}}));
+    let sid = h.read_line()["result"]["sessionId"].as_str().unwrap().to_string();
+    h.send(&json!({"jsonrpc":"2.0","id":2,"method":"session/prompt","params":{"sessionId":sid,"prompt":[{"type":"text","text":"Restore the file"}]}}));
+    let (notifications, response) = h.read_until_response(2);
+    assert_eq!(response["result"]["stopReason"], "end_turn");
+    assert_eq!(std::fs::read_to_string(project.join("src/app.txt")).unwrap(), "real\n");
+    let done = updates_of(&notifications, "tool_call_update");
+    assert!(done.iter().filter(|u| u["status"] == "failed").count() >= 2, "{done:?}");
+    let requests = recorded.lock().unwrap().clone();
+    let seen = requests[2]["messages"].to_string();
+    assert!(seen.contains("Not run: content contains") && seen.contains("Not run: new_text contains"), "{seen}");
+    h.shutdown();
+}
