+/// Keep the latest failed edit's evidence but remove its invalid argument
+/// example and older failed exchanges from the request copy. Stored history
+/// stays untouched. Only complete single-call exchanges are transformed.
+pub fn remove_failed_edit_examples(messages: &mut Vec<Value>) {
+    let mut failed = Vec::new();
+    for i in 0..messages.len().saturating_sub(1) {
+        let Some(calls) = messages[i].get("tool_calls").and_then(Value::as_array) else { continue; };
+        if calls.len() != 1 { continue; }
+        let name = calls[0]["function"]["name"].as_str().unwrap_or("");
+        let result = &messages[i + 1];
+        let text = result["content"].as_str().unwrap_or("");
+        let id_matches = calls[0].get("id").map_or(true, |id| result.get("tool_call_id") == Some(id));
+        if name == "edit" && result["role"] == "tool" && id_matches
+            && (text.starts_with("Error") || text.starts_with("Not run")) {
+            failed.push(i);
+        }
+    }
+    let last = failed.last().copied();
+    for i in failed.into_iter().rev() {
+        if Some(i) == last {
+            let text = messages[i + 1]["content"].as_str().unwrap_or("");
+            messages[i] = serde_json::json!({"role":"assistant", "content":format!("{RECOVERY_MARK}\n{text}")});
+            messages.remove(i + 1);
+        } else {
+            messages.drain(i..i + 2);
+        }
+    }
+}
