+/// Why an `old_text` that matches nothing failed, when it is one of the
+/// two usual slips: a placeholder line ("// ...") standing for code the
+/// model left out, or text that differs only in spacing.
+fn near_miss(current: &str, old: &str) -> String {
+    let placeholder = old.lines().map(str::trim).find(|line| {
+        let bare = line
+            .trim_start_matches(['/', '*', '#', '<', '!', '-'])
+            .trim_end_matches(['/', '*', '>', '-'])
+            .trim();
+        (bare.starts_with("...") || bare.starts_with('…')) && !current.contains(*line)
+    });
+    if let Some(line) = placeholder {
+        return format!("old_text contains the placeholder line \"{line}\", which is not in the file. old_text must be a verbatim copy: use a smaller block without placeholders.\n");
+    }
+    let squash = |s: &str| s.split_whitespace().collect::<String>();
+    if squash(current).contains(&squash(old)) {
+        return "old_text differs from the file only in spaces or line breaks: copy it again with the file's exact spacing.\n".into();
+    }
+    String::new()
