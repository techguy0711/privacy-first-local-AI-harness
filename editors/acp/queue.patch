+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_identical_edit_loop_returns_visible_failure_after_three_calls() {
+    let count = Arc::new(AtomicUsize::new(0));
+    let observed = count.clone();
+    let router = Router::new()
+        .route("/v1/models", get(mock_models))
+        .route("/v1/chat/completions", post(move |req: Request<Body>| {
+            let count = count.clone();
+            async move {
+                let n = count.fetch_add(1, Ordering::SeqCst);
+                if n >= 3 {
+                    let bytes = axum::body::to_bytes(req.into_body(), 1024 * 1024).await.unwrap();
+                    let body: Value = serde_json::from_slice(&bytes).unwrap();
+                    let messages = body["messages"].as_array().unwrap();
+                    assert!(messages.iter().any(|m| m["role"] == "assistant" && m["content"].as_str().unwrap_or("").contains("incomplete")));
+                }
+                if n == 5 {
+                    return axum::Json(json!({"choices":[{"message":{"role":"assistant","content":"Resumed successfully."},"finish_reason":"stop"}]}));
+                }
+                axum::Json(json!({"choices":[{"message":{
+                    "role":"assistant", "content":null, "tool_calls":[{
+                        "id":"noop", "type":"function", "function":{
+                            "name":"edit", "arguments":"{\"path\":\"unused.swift\",\"old_text\":\"some Scene\",\"new_text\":\"some Scene\"}"
+                        }
+                    }]
+                },"finish_reason":"tool_calls"}]}))
+            }
+        }));
+    let port = free_port();
+    let mut h = TestHarness::start_with_router_and_env(port, router, &[
+        ("LLM_BASE_URL", &format!("http://127.0.0.1:{port}/v1")),
+        ("LLM_INVESTIGATE_LIMIT", "0"),
+    ]).await;
+    h.send(&json!({"jsonrpc":"2.0","id":1,"method":"session/new","params":{"cwd":"/tmp"}}));
+    let sid = h.read_line()["result"]["sessionId"].as_str().unwrap().to_string();
+    h.send(&json!({"jsonrpc":"2.0","id":2,"method":"session/prompt","params":{
+        "sessionId":sid,"prompt":[{"type":"text","text":"fix the view"}]
+    }}));
+    let (_, response) = h.read_until_response(2);
+    assert_eq!(observed.load(Ordering::SeqCst), 3);
+    assert_eq!(response["result"]["status"], "failed");
