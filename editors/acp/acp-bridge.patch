+    /// Every tool call has exactly one result right after its message and
+    /// every tool result belongs to a call (OpenAI ids or Ollama order).
+    fn assert_pairs_consistent(msgs: &[Value]) {
+        let mut i = 0;
+        while i < msgs.len() {
+            match role(&msgs[i]) {
+                "tool" => panic!("orphan tool result at {i}: {msgs:#?}"),
+                "assistant" if has_tool_calls(&msgs[i]) => {
+                    let calls = msgs[i]["tool_calls"].as_array().unwrap();
+                    for (k, call) in calls.iter().enumerate() {
+                        let r = msgs.get(i + 1 + k).expect("missing tool result");
+                        assert_eq!(role(r), "tool", "missing result for call {k} at {i}");
+                        if let Some(id) = call.get("id").and_then(Value::as_str) {
+                            assert_eq!(r["tool_call_id"], id);
+                        }
+                    }
+                    i += calls.len();
+                }
+                _ => {}
+            }
+            i += 1;
+        }
+    }
