+fn detect_xcode(
+    cwd: &Path,
+    flag: &str,
+    container: &str,
+    cancel: Option<&CancelToken>,
+) -> Option<VerifyPlan> {
+    let stem = container
+        .rsplit_once('.')
+        .map(|(s, _)| s)
+        .unwrap_or(container);
+    let list = xcode_query(
+        cwd,
+        &["-list", "-json", flag, container, "-disableAutomaticPackageResolution"],
+        cancel,
+    )?;
+    let scheme = pick_scheme(&list, stem)?;
+    let dd = derived_data_dir(cwd);
+    let dd_str = dd.to_string_lossy().into_owned();
+    let settings = xcode_query(
+        cwd,
+        &[
+            "-showBuildSettings",
+            "-json",
+            flag,
+            container,
+            "-scheme",
+            &scheme,
+            "-disableAutomaticPackageResolution",
+            "-derivedDataPath",
+            &dd_str,
+        ],
+        cancel,
+    );
+    let destination = settings.as_ref().and_then(|s| {
+        let bs = &s.get(0)?["buildSettings"];
+        destination_for(
+            bs["SUPPORTED_PLATFORMS"].as_str().unwrap_or(""),
+            bs["SDKROOT"].as_str().unwrap_or(""),
+        )
+    });
+    let dest_arg = destination
+        .map(|d| format!(" -destination {}", quote(d)))
+        .unwrap_or_default();
+    let command = format!(
+        "xcodebuild {flag} {} -scheme {}{dest_arg} -derivedDataPath {} \
+         -disableAutomaticPackageResolution CODE_SIGNING_ALLOWED=NO -quiet build",
+        quote(container),
+        quote(&scheme),
+        quote(&dd_str),
+    );
+    let platform = destination
+        .map(|d| {
+            let d = d.trim_start_matches("generic/").trim_start_matches("platform=");
+            format!(" ({d})")
+        })
+        .unwrap_or_default();
+    let label = format!("xcodebuild -scheme {}{platform}", quote(&scheme));
+    info!(command = %command, "Detected Xcode verify build");
+    Some(VerifyPlan::new(command, label))
+}
