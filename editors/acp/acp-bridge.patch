+//! Web search through the local Brave MCP server, with a hard privacy guard.
+//!
+//! The model gets one slim tool, `web_search(query)`. It is offered only
+//! when a `[[mcp.servers]]` entry with `role = "web_search"` (a loopback
+//! URL: the Brave server the stack runs on 127.0.0.1) answers; acp-bridge
+//! holds no search key. Each call maps to `brave_web_search` with FIXED
+//! arguments (`count: 5`, `result_filter: ["web"]`, `text_decorations:
+//! false`); nothing else the model might pass is forwarded.
+//!
+//! Before anything leaves the machine, [`check_query`] refuses (never
+//! rewrites) a query that looks like it carries project data: control or
+//! non-ASCII characters, or more than 150 characters / 12 words; code
+//! syntax; paths and file names; URLs, e-mail addresses, IPs, local host
+//! names; secrets (long mixed tokens, hex, UUIDs, known key prefixes, the
+//! values of key variables in the environment); and names from the
+//! workspace (file and folder names, project / bundle / organisation / git /
+//! account names, declared types and functions, also when split into
+//! words). The names are collected again after every tool call that may
+//! have written files. The model gets the reason and may rewrite the query
+//! once.
+//! Budgets: 3 searches per turn, 20 per session; a repeated query is
+//! answered from the session's cache.
+
+use crate::mcp::{ConnectOptions, McpClient, McpResult, McpSpec, ServerConfig};
+use serde_json::{json, Value};
+use std::collections::HashSet;
+use std::path::Path;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+use tracing::{info, warn};
+
+/// Searches per turn / per session.
+pub const PER_TURN: usize = 3;
+pub const PER_SESSION: usize = 20;
+/// Maximum query length (Brave allows 400 characters / 50 words; ours is
+/// stricter on purpose).
+const MAX_CHARS: usize = 150;
+const MAX_WORDS: usize = 12;
+/// Result size for the model.
+const MAX_RESULT_CHARS: usize = 1_500;
+const MAX_RESULTS: usize = 5;
+/// Handshake limit for the search server at a turn boundary.
+const HANDSHAKE: Duration = Duration::from_secs(2);
+/// A down server is re-checked at most this often.
+const RECHECK: Duration = Duration::from_secs(300);
+/// Tool the Brave server provides.
+pub const BRAVE_TOOL: &str = "brave_web_search";
+
+/// The model-facing tool.
+pub fn definition() -> Value {
+    json!({
+        "type": "function",
+        "function": {
+            "name": "web_search",
+            "description": "Search the public web (Brave) for public documentation or a generic error message. Query: at most 12 plain words, e.g. 'SpriteKit SKView presentScene'. Never include code, file names, paths, or names from this project. Prefer docs_search for Apple APIs when you have it. At most 3 searches per request.",
+            "parameters": {
+                "type": "object",
+                "properties": {"query": {"type": "string", "description": "At most 12 generic words"}},
+                "required": ["query"]
+            }
+        }
+    })
+}
+
+/// Text for a refused query (the model may rewrite it once).
+pub fn refusal_text(reason: &str) -> String {
+    format!(
+        "Error: web_search refused by the privacy guard: {reason}. Web search may only contain public, generic terms (framework + API/type + generic error text), e.g. \"SpriteKit SKView presentScene\" or \"Swift cannot assign to property get-only\". Never include file names, paths, code, or names declared in this project. Rewrite the query once or continue without searching."
+    )
+}
+
+/// Why a query was refused.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Refusal {
+    /// Stable rule id for the log (`shape`, `code`, `path`, `network`,
+    /// `secret`, `workspace`).
+    pub rule: &'static str,
+    pub reason: String,
+}
+
+fn refuse(rule: &'static str, reason: impl Into<String>) -> Result<String, Refusal> {
+    Err(Refusal {
+        rule,
+        reason: reason.into(),
+    })
+}
+
+/// Words never treated as project names (too generic to identify anything).
+const GENERIC: &[&str] = &[
+    "init", "main", "view", "views", "model", "models", "data", "test", "tests", "value", "item", "items", "self",
+    "super", "app", "apps", "application", "scene", "scenes", "game", "games", "project", "untitled", "content",
+    "manager", "controller", "service", "helper", "helpers", "util", "utils", "common", "core", "base", "string",
+    "list", "file", "files", "image", "images", "assets", "resources", "source", "sources", "info", "debug",
+    "release", "build", "products", "preview", "previews", "swift", "xcode", "apple", "error", "errors", "entity",
+    "entities", "effect", "effects", "player", "state", "settings", "config", "network", "storage", "user",
+    "users", "screen", "button", "label", "text", "color", "colors", "theme", "style", "styles", "layout",
+    "component", "components", "delegate", "handler", "request", "response", "result", "event", "events", "action",
+    "actions", "store", "cache", "query", "search", "update", "create", "delete", "remove", "insert", "load", "save",
+    "start", "stop", "run", "show", "hide", "open", "close", "read", "write", "make", "handle", "setup", "configure",
+    "property", "properties", "function", "method", "class", "struct", "enum", "protocol", "type", "types",
+    "particle", "particles", "background", "foreground", "tests", "uitests", "readme", "license", "package",
+    "root", "admin", "guest", "nobody", "runner", "ubuntu", "shared", "staff",
+];
+
+fn is_generic(word: &str) -> bool {
+    GENERIC.contains(&word.to_ascii_lowercase().as_str())
+}
+
+/// Names from a workspace that must not appear in a search query.
+#[derive(Debug, Clone, Default)]
+pub struct WorkspaceTerms {
+    /// Identifier-like names (types, functions, file stems): matched case-
+    /// sensitively, and case-insensitively when at least 8 characters.
+    idents: HashSet<String>,
+    idents_lower: HashSet<String>,
+    /// Plain names (project, bundle id parts, organisation, git owner /
+    /// repo): matched case-insensitively.
+    names_lower: HashSet<String>,
+}
+
+impl WorkspaceTerms {
+    fn add_ident(&mut self, s: &str) {
+        if s.chars().count() >= 4 && !is_generic(s) {
+            self.idents.insert(s.to_string());
+            self.idents_lower.insert(s.to_ascii_lowercase());
+        }
+    }
+
+    fn add_name(&mut self, s: &str) {
+        for w in s.split(|c: char| !c.is_ascii_alphanumeric()) {
+            if w.chars().count() >= 4 && !is_generic(w) && !w.chars().all(|c| c.is_ascii_digit()) {
+                self.names_lower.insert(w.to_ascii_lowercase());
+            }
+        }
+        if s.chars().count() >= 4 && !is_generic(s) {
+            self.names_lower.insert(s.to_ascii_lowercase());
+        }
+    }
+
+    pub fn len(&self) -> usize {
+        self.idents.len() + self.names_lower.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.len() == 0
+    }
+
+    /// Whether `token` is a workspace name.
+    pub fn contains(&self, token: &str) -> bool {
+        if token.chars().count() < 4 || is_generic(token) {
+            return false;
+        }
+        let lower = token.to_ascii_lowercase();
+        self.idents.contains(token)
+            || (token.len() >= 8 && self.idents_lower.contains(&lower))
+            || self.names_lower.contains(&lower)
+    }
+
+    /// Whether words written together (`gamescene` from "Game Scene") are a
+    /// workspace name, ignoring case (at least 6 characters).
+    pub fn contains_joined(&self, joined: &str) -> bool {
+        if joined.len() < 6 {
+            return false;
+        }
+        let lower = joined.to_ascii_lowercase();
+        self.idents_lower.contains(&lower) || self.names_lower.contains(&lower)
+    }
+
+    /// Collect the names of the project in `cwd` (bounded walk: at most
+    /// 3,000 files of at most 256 KB; build, DerivedData, node_modules,
+    /// Pods, target and hidden folders skipped).
+    pub fn scan(cwd: &Path) -> Self {
+        let mut t = WorkspaceTerms::default();
+        if let Some(name) = cwd.file_name().and_then(|n| n.to_str()) {
+            t.add_name(name);
+        }
+        // The account name (/Users/<name>/…, /home/<name>/…, $USER).
+        let mut parts = cwd.components().filter_map(|c| c.as_os_str().to_str());
+        let _root = parts.next();
+        if let (Some("Users" | "home"), Some(user)) = (parts.next(), parts.next()) {
+            t.add_name(user);
+        }
+        for var in ["USER", "LOGNAME"] {
+            if let Ok(user) = std::env::var(var) {
+                t.add_name(&user);
+            }
+        }
+        if let Ok(text) = std::fs::read_to_string(cwd.join(".git/config")) {
+            for line in text.lines() {
+                if let Some(url) = line.trim().strip_prefix("url = ") {
+                    let path = url
+                        .trim()
+                        .trim_end_matches(".git")
+                        .rsplit_once(':')
+                        .map(|(_, p)| p)
+                        .unwrap_or(url);
+                    let parts: Vec<&str> = path.trim_start_matches('/').rsplit('/').take(2).collect();
+                    for p in parts {
+                        t.add_name(p);
+                    }
+                }
+            }
+        }
+        let mut budget = 3000usize;
+        scan_dir(cwd, 0, &mut budget, &mut t);
+        t
+    }
+}
+
+fn scan_dir(dir: &Path, depth: usize, budget: &mut usize, t: &mut WorkspaceTerms) {
+    if depth > 10 || *budget == 0 {
+        return;
+    }
+    let Ok(rd) = std::fs::read_dir(dir) else { return };
+    for e in rd.filter_map(|e| e.ok()) {
+        if *budget == 0 {
+            return;
+        }
+        let name = e.file_name().to_string_lossy().into_owned();
+        if name.starts_with('.')
+            || matches!(name.as_str(), "build" | "DerivedData" | "node_modules" | "Pods" | "target" | "Carthage")
+        {
+            continue;
+        }
+        let Ok(ft) = e.file_type() else { continue };
+        let stem = name.split('.').next().unwrap_or(&name).to_string();
+        if ft.is_dir() {
+            if name.ends_with(".xcodeproj") || name.ends_with(".xcworkspace") {
+                t.add_name(&stem);
+                t.add_ident(&stem);
+                if let Ok(text) = std::fs::read_to_string(e.path().join("project.pbxproj")) {
+                    scan_pbxproj(&text, t);
+                }
+                continue;
+            }
+            if !name.ends_with(".xcassets") {
+                t.add_ident(&stem);
+            }
+            scan_dir(&e.path(), depth + 1, budget, t);
+        } else if ft.is_file() {
+            *budget -= 1;
+            t.add_ident(&stem);
+            let source = [
+                ".swift", ".m", ".mm", ".h", ".c", ".cc", ".cpp", ".rs", ".kt", ".java", ".ts", ".tsx", ".js",
+                ".jsx", ".py", ".go", ".rb", ".cs",
+            ]
+            .iter()
+            .any(|x| name.ends_with(x));
+            if source && e.metadata().is_ok_and(|m| m.len() <= 256 * 1024) {
+                if let Ok(text) = std::fs::read_to_string(e.path()) {
+                    scan_declarations(&text, t);
+                }
+            }
+        }
+    }
+}
+
+fn scan_pbxproj(text: &str, t: &mut WorkspaceTerms) {
+    for line in text.lines() {
+        let l = line.trim();
+        for key in ["PRODUCT_BUNDLE_IDENTIFIER = ", "ORGANIZATIONNAME = ", "PRODUCT_NAME = "] {
+            if let Some(v) = l.strip_prefix(key) {
+                let v = v.trim_end_matches(';').trim_matches('"');
+                if v.starts_with('$') {
+                    continue;
+                }
+                for part in v.split(['.', ' ', '-', '_']) {
+                    if !matches!(part.to_ascii_lowercase().as_str(), "com" | "org" | "net" | "io" | "dev" | "app" | "inc" | "llc" | "ltd") {
+                        t.add_name(part);
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// Names declared in source: types/modules after `class struct enum
+/// protocol actor typealias trait interface object type mod`, functions
+/// (at least 6 characters) after `func fn fun def`. `let` / `var` names are
+/// mostly generic locals and are not collected; `override` lines and
+/// `extension X` (SDK types) are skipped.
+fn scan_declarations(text: &str, t: &mut WorkspaceTerms) {
+    for line in text.lines() {
+        if line.contains("override") {
+            continue;
+        }
+        let words: Vec<&str> = line
+            .split(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
+            .filter(|w| !w.is_empty())
+            .collect();
+        for pair in words.windows(2) {
+            let (kw, name) = (pair[0], pair[1]);
+            if !name.chars().next().is_some_and(|c| c.is_ascii_alphabetic() || c == '_') {
+                continue;
+            }
+            match kw {
+                "class" | "struct" | "enum" | "protocol" | "actor" | "typealias" | "trait" | "interface"
+                | "object" | "type" | "mod" => t.add_ident(name),
+                "func" | "fn" | "fun" | "def" if name.len() >= 6 => t.add_ident(name),
+                _ => {}
+            }
+        }
+    }
+}
+
+const SOURCE_EXTENSIONS: &[&str] = &[
+    ".swift", ".m", ".mm", ".h", ".c", ".cc", ".cpp", ".rs", ".kt", ".kts", ".java", ".ts", ".tsx", ".js", ".jsx",
+    ".py", ".go", ".rb", ".cs", ".gradle", ".xcodeproj", ".xcworkspace", ".pbxproj", ".plist", ".json", ".yaml",
+    ".yml", ".toml", ".env", ".sh", ".storyboard", ".xib", ".xcassets", ".entitlements",
+];
+
+fn is_ipv4(t: &str) -> bool {
+    let parts: Vec<&str> = t.split('.').collect();
+    parts.len() == 4 && parts.iter().all(|p| !p.is_empty() && p.len() <= 3 && p.chars().all(|c| c.is_ascii_digit()))
+}
+
+fn looks_secret(t: &str) -> bool {
+    let core = t.trim_matches(|c: char| !c.is_ascii_alphanumeric());
+    let letters = core.chars().filter(|c| c.is_ascii_alphabetic()).count();
+    let digits = core.chars().filter(|c| c.is_ascii_digit()).count();
+    let hex = core.len() >= 16 && core.chars().all(|c| c.is_ascii_hexdigit()) && digits > 0;
+    let mixed = core.len() >= 20 && letters > 0 && digits > 0;
+    let uuid = {
+        let p: Vec<&str> = t.split('-').collect();
+        p.len() == 5 && [8, 4, 4, 4, 12].iter().zip(&p).all(|(n, s)| s.len() == *n && s.chars().all(|c| c.is_ascii_hexdigit()))
+    };
+    let prefixed = ["sk-", "ghp_", "gho_", "github_pat_", "AKIA", "xoxb-", "xoxp-", "xoxa-", "xoxs-", "BSA"]
+        .iter()
+        .any(|p| t.starts_with(p) && t.len() >= p.len() + 8);
+    hex || mixed || uuid || prefixed
+}
+
+/// Values of key-like environment variables (to refuse if they show up).
+pub fn env_secrets() -> Vec<String> {
+    std::env::vars()
+        .filter(|(k, v)| {
+            let k = k.to_ascii_uppercase();
+            (k == "LLM_API_KEY"
+                || k == "BRAVE_API_KEY"
+                || k.ends_with("_KEY")
+                || k.ends_with("_TOKEN")
+                || k.ends_with("_SECRET")
+                || k.contains("PASSWORD"))
+                && v.len() >= 8
+        })
+        .map(|(_, v)| v)
+        .collect()
+}
+
+/// Check a query; `Ok` is the normalized query (trimmed, single spaces).
+pub fn check_query(query: &str, terms: &WorkspaceTerms, secrets: &[String]) -> Result<String, Refusal> {
+    if query.chars().any(|c| c.is_ascii_control()) {
+        return refuse("shape", "it contains control characters (newlines, tabs)");
+    }
+    // Apple API names and Swift / clang error texts are plain ASCII. Anything
+    // else (zero-width or bidi characters, full-width or look-alike letters
+    // and punctuation, which search engines fold back to ASCII) could carry
+    // a project name or code past the checks below.
+    if let Some(c) = query.chars().find(|c| !c.is_ascii()) {
+        return refuse(
+            "shape",
+            format!("it contains a non-ASCII character (U+{:04X}); use plain ASCII letters, digits and punctuation", c as u32),
+        );
+    }
+    let q = query.split_whitespace().collect::<Vec<_>>().join(" ");
+    if q.is_empty() {
+        return refuse("shape", "the query is empty");
+    }
+    if q.chars().count() > MAX_CHARS {
+        return refuse("shape", format!("it is longer than {MAX_CHARS} characters"));
+    }
+    let words: Vec<&str> = q.split(' ').collect();
+    if words.len() > MAX_WORDS {
+        return refuse("shape", format!("it has more than {MAX_WORDS} words"));
+    }
+
+    // URLs first (their "//" would otherwise read as code).
+    if q.contains("://") || q.to_ascii_lowercase().split(' ').any(|w| w.starts_with("www.")) {
+        return refuse("network", "it contains a URL");
+    }
+
+    // Code syntax.
+    if let Some(c) = q.chars().find(|c| "{};=<>[]`$|\\".contains(*c)) {
+        return refuse("code", format!("it contains code syntax ('{c}')"));
+    }
+    for seq in ["->", "=>", "::", "//", "/*", "*/", "&&", "||", "#include", "#import"] {
+        if q.contains(seq) {
+            return refuse("code", format!("it contains code syntax ('{seq}')"));
+        }
+    }
+    if q.matches('"').count() > 2 || q.matches('\'').count() > 2 {
+        return refuse("code", "it has more than one quoted phrase");
+    }
+    // Parentheses only as an Objective-C/Swift selector: name(_:) / name(label:).
+    let mut rest = q.as_str();
+    while let Some(open) = rest.find('(') {
+        let Some(close) = rest[open..].find(')') else {
+            return refuse("code", "it contains code syntax ('(')");
+        };
+        let inner = &rest[open + 1..open + close];
+        let before = rest[..open].chars().next_back();
+        if !inner.chars().all(|c| c.is_ascii_alphabetic() || c == '_' || c == ':')
+            || !before.is_some_and(|c| c.is_ascii_alphanumeric())
+        {
+            return refuse("code", "it contains a call or expression in parentheses");
+        }
+        rest = &rest[open + close + 1..];
+    }
+    if q.contains(')') && !q.contains('(') {
+        return refuse("code", "it contains code syntax (')')");
+    }
+    for (i, w) in words.iter().enumerate() {
+        if matches!(*w, "import" | "@import") && words.get(i + 1).is_some_and(|n| n.chars().next().is_some_and(char::is_alphabetic)) {
+            return refuse("code", "it contains an import statement");
+        }
+        if matches!(*w, "func" | "fn" | "def" | "let" | "var" | "class" | "struct" | "enum" | "protocol") {
+            if let Some(next) = words.get(i + 1) {
+                let name: String = next.chars().take_while(|c| c.is_ascii_alphanumeric() || *c == '_').collect();
+                let after_name = &next[name.len()..];
+                let following = words.get(i + 2).copied().unwrap_or("");
+                if !name.is_empty()
+                    && (after_name.starts_with(['(', ':', '{'])
+                        || following.starts_with(['(', ':', '{']))
+                {
+                    return refuse("code", format!("it contains a declaration ('{w} {name}…')"));
+                }
+            }
+        }
+    }
+
+    // Network / identity, paths and secrets, per word.
+    for w in &words {
+        let lower = w.to_ascii_lowercase();
+        if let Some(site) = lower.strip_prefix("site:") {
+            let ok = site.contains('.')
+                && !site.contains('/')
+                && site.chars().all(|c| c.is_ascii_alphanumeric() || c == '.' || c == '-')
+                && site != "localhost"
+                && !is_ipv4(site)
+                && ![".local", ".internal", ".lan", ".corp", ".home.arpa", ".localhost"].iter().any(|s| site.ends_with(s));
+            if !ok {
+                return refuse("network", "only site:<public domain> is allowed");
+            }
+            continue;
+        }
+        if lower.contains("://") || lower.starts_with("www.") {
+            return refuse("network", "it contains a URL");
+        }
+        let at = lower.find('@');
+        if at.is_some_and(|i| i > 0 && lower[i + 1..].contains('.')) {
+            return refuse("network", "it contains an e-mail address");
+        }
+        let bare = lower.trim_matches(|c: char| !c.is_ascii_alphanumeric() && c != '.' && c != ':');
+        if is_ipv4(bare) || bare == "localhost" || bare.starts_with("localhost:") {
+            return refuse("network", "it contains a local address");
+        }
+        if [".local", ".internal", ".lan", ".corp", ".home.arpa"].iter().any(|s| bare.ends_with(s)) {
+            return refuse("network", "it contains an internal host name");
+        }
+        if w.contains('/') || w.contains('\\') || w.starts_with('~') || (w.starts_with('.') && w.len() > 1) {
+            return refuse("path", "it contains a path");
+        }
+        let trimmed = w.trim_end_matches(|c: char| matches!(c, ',' | '.' | '?' | '!' | '"' | '\'' | ':'));
+        if SOURCE_EXTENSIONS.iter().any(|x| trimmed.to_ascii_lowercase().ends_with(x) && trimmed.len() > x.len()) {
+            return refuse("path", format!("it contains a file name ('{trimmed}')"));
+        }
+        if looks_secret(w) {
+            return refuse("secret", "it contains a token that looks like a key or an id");
+        }
+    }
+    for s in secrets.iter().filter(|s| s.len() >= 8) {
+        if q.contains(s.as_str()) {
+            return refuse("secret", "it contains the value of a key from the environment");
+        }
+    }
+
+    // Names from this workspace, also split into words ("Game Scene" for
+    // GameScene, "spawn bear wave" for spawnBearWave).
+    let tokens: Vec<&str> = q
+        .split(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
+        .filter(|t| !t.is_empty())
+        .collect();
+    let mut found: Vec<String> = tokens.iter().filter(|t| terms.contains(t)).map(|t| t.to_string()).collect();
+    for n in 2..=3 {
+        for w in tokens.windows(n) {
+            if terms.contains_joined(&w.concat()) {
+                found.push(w.join(" "));
+            }
+        }
+    }
+    if !found.is_empty() {
+        return refuse("workspace", format!("it contains names from this project ({})", found.join(", ")));
+    }
+    Ok(q)
+}
+
+/// Strip HTML tags (Brave marks matches with `<strong>`).
+fn strip_tags(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    let mut in_tag = false;
+    for c in s.chars() {
+        match c {
+            '<' => in_tag = true,
+            '>' => in_tag = false,
+            _ if !in_tag => out.push(c),
+            _ => {}
+        }
+    }
+    out.replace("&amp;", "&").replace("&quot;", "\"").replace("&#39;", "'").replace("&lt;", "<").replace("&gt;", ">")
+}
+
+/// Text for the model and `rawOutput` for a `brave_web_search` result: up
+/// to 5 lines `title — description (url)`, 1,500 characters, plus a note
+/// that pages cannot be opened.
+pub fn shape_results(query: &str, r: &McpResult) -> (String, Value) {
+    let mut lines = Vec::new();
+    let mut docs = Vec::new();
+    for chunk in r.text.split('\n') {
+        let Ok(v) = serde_json::from_str::<Value>(chunk.trim()) else { continue };
+        let (Some(title), Some(url)) = (v.get("title").and_then(Value::as_str), v.get("url").and_then(Value::as_str)) else {
+            continue;
+        };
+        let title = strip_tags(title);
+        let desc = strip_tags(v.get("description").and_then(Value::as_str).unwrap_or(""));
+        lines.push(format!("{title} — {desc} ({url})"));
+        docs.push(json!(format!("{title} ({url})")));
+        if lines.len() == MAX_RESULTS {
+            break;
+        }
+    }
+    if lines.is_empty() {
+        return ("No web results found.".to_string(), json!({"query": query, "documents": []}));
+    }
+    let mut text = String::new();
+    for l in &lines {
+        if text.len() + l.len() + 1 > MAX_RESULT_CHARS {
+            break;
+        }
+        text.push_str(l);
+        text.push('\n');
+    }
+    text.push_str("(Pages cannot be opened; use these snippets.)");
+    (text, json!({"query": query, "documents": docs}))
+}
