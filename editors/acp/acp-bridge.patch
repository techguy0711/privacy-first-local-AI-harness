+// ---------------------------------------------------------------------------
+// Step 11: session persistence and session/resume
+// ---------------------------------------------------------------------------
+
+/// A repo-like layout: `<root>/editors/acp/config.toml` with
+/// `state_dir = "../../data/acp-bridge"` (relative to the config file).
+fn persist_layout(tag: &str) -> (PathBuf, PathBuf, PathBuf) {
+    let root = fresh_dir(tag);
+    let config_dir = root.join("editors/acp");
+    std::fs::create_dir_all(&config_dir).unwrap();
+    let config = config_dir.join("config.toml");
+    std::fs::write(&config, "[persist]\nstate_dir = \"../../data/acp-bridge\"\nretention_days = 30\n").unwrap();
+    let project = root.join("Project");
+    std::fs::create_dir_all(&project).unwrap();
+    (root, config, project)
+}
+
+/// Process 1 stores the conversation (history without the system prompt,
+/// NOTES.md, meta; 0700/0600; secrets redacted) and dies; process 2
+/// advertises resume, Xcode's `session/resume` brings the conversation
+/// back (the model sees the earlier messages and the notes), and
+/// session/list shows it. Unknown and malformed ids are refused.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn step11_resume_after_restart() {
+    let (root, config, project) = persist_layout("persist");
+    std::fs::write(project.join("secret.txt"), "token=abcdefghijklmnop12\n").unwrap();
+    let env = [("LLM_PERSIST", "1"), ("ACP_TEST_SERVICE_TOKEN", "abcdefghijklmnop12")];
+    let replies = vec![
+        tool_call("n1", "notes", json!({"action": "append", "text": "The word is PINEAPPLE"})),
+        tool_call("r1", "read_file", json!({"path": "secret.txt"})),
+        answer("Noted."),
+    ];
+    let (mut b, _) = Bridge::start_with_config(script(replies), &env, Some(&config)).await;
+    let init = b.initialize(1);
+    assert_eq!(init["result"]["agentCapabilities"]["sessionCapabilities"], json!({"resume": {}, "close": {}, "list": {}}), "{init}");
+    assert!(init["result"]["agentCapabilities"].get("loadSession").is_none());
+    let sid = b.new_session(project.to_str().unwrap(), json!([]));
+    let (_, r) = b.prompt(&sid, "Remember the word for later");
+    assert_eq!(r["result"]["text"], "Noted.");
+    b.kill();
+
+    let dir = root.join("data/acp-bridge/sessions").join(&sid);
+    assert!(dir.is_dir(), "stored under the config-relative state_dir");
+    let history = std::fs::read_to_string(dir.join("history.jsonl")).unwrap();
+    let first: Value = serde_json::from_str(history.lines().next().unwrap()).unwrap();
+    assert_eq!(first["role"], "user", "no system prompt on disk");
+    assert!(!history.contains("abcdefghijklmnop12") && history.contains("token=[redacted]"), "{history}");
+    assert!(std::fs::read_to_string(dir.join("NOTES.md")).unwrap().contains("The word is PINEAPPLE"));
+    let meta: Value = serde_json::from_str(&std::fs::read_to_string(dir.join("meta.json")).unwrap()).unwrap();
+    assert_eq!(meta["title"], "Remember the word for later");
+    assert_eq!(meta["cwd"], project.to_str().unwrap());
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        assert_eq!(std::fs::metadata(&dir).unwrap().permissions().mode() & 0o777, 0o700);
+        assert_eq!(std::fs::metadata(dir.join("history.jsonl")).unwrap().permissions().mode() & 0o777, 0o600);
+    }
+
+    // Process 2.
+    let (mut b, recorded) =
+        Bridge::start_with_config(script(vec![answer("PINEAPPLE")]), &env, Some(&config)).await;
+    b.initialize(1);
+    let (notes, r) = b.call("session/resume", json!({"sessionId": &sid, "cwd": project.to_str().unwrap(), "mcpServers": []}));
+    assert_eq!(r["result"], json!({}), "{r}");
+    let _ = notes;
+    let after = b.wait_for(Duration::from_secs(5), |m| m["params"]["update"]["sessionUpdate"] == "session_info_update" && m["params"]["update"]["title"] == "Remember the word for later");
+    assert!(after.iter().any(|m| m["params"]["update"]["sessionUpdate"] == "available_commands_update"));
+    let (_, r) = b.prompt(&sid, "What was the word?");
+    assert_eq!(r["result"]["text"], "PINEAPPLE");
+    let req = recorded.lock().unwrap()[0].clone();
+    let msgs = req["messages"].as_array().unwrap();
+    assert_eq!(msgs[0]["role"], "system");
+    assert!(msgs.iter().any(|m| m["content"] == "Remember the word for later"), "earlier messages are back");
+    assert!(msgs.iter().any(|m| m["content"].as_str().is_some_and(|c| c.starts_with("token=[redacted]"))));
+    assert!(msgs.last().unwrap()["content"].as_str().unwrap().contains("The word is PINEAPPLE\n"), "notes restored");
+    // session/list (filtered by cwd).
+    let (_, r) = b.call("session/list", json!({"cwd": project.to_str().unwrap()}));
+    let list = r["result"]["sessions"].as_array().unwrap();
+    assert_eq!(list.len(), 1);
+    assert_eq!(list[0]["sessionId"], sid);
+    assert_eq!(list[0]["title"], "Remember the word for later");
+    assert!(list[0]["updatedAt"].as_str().unwrap().ends_with('Z'));
+    let (_, r) = b.call("session/list", json!({"cwd": "/elsewhere"}));
+    assert_eq!(r["result"]["sessions"], json!([]));
+    // Unknown and malformed ids.
+    let (_, r) = b.call("session/resume", json!({"sessionId": uuid::Uuid::new_v4().to_string(), "cwd": "/x"}));
+    assert_eq!(r["error"]["code"], -32002, "{r}");
+    assert_eq!(r["error"]["data"]["reason"], "unknown_session");
+    let (_, r) = b.call("session/resume", json!({"sessionId": "../x", "cwd": "/x"}));
+    assert_eq!(r["error"]["code"], -32602, "{r}");
+    // Replay is not supported (v2 replayFrom); session/load is not offered.
+    let (_, r) = b.call("session/resume", json!({"sessionId": &sid, "cwd": "/x", "replayFrom": {"type": "start"}}));
+    assert_eq!(r["error"]["code"], -32602, "{r}");
+    let (_, r) = b.call("session/load", json!({"sessionId": &sid, "cwd": "/x", "mcpServers": []}));
+    assert_eq!(r["error"]["data"]["reason"], "load_not_supported", "{r}");
+
+    // A third process cannot take the session while process 2 has it.
+    let (mut b3, _) = Bridge::start_with_config(script(vec![answer("x")]), &env, Some(&config)).await;
+    b3.initialize(1);
+    let (_, r) = b3.call("session/resume", json!({"sessionId": &sid, "cwd": project.to_str().unwrap()}));
+    assert_eq!(r["error"]["code"], -32005, "{r}");
+    assert!(r["error"]["message"].as_str().unwrap().contains("in use by another acp-bridge process"), "{r}");
+    b3.shutdown();
+
+    // session/close keeps the stored copy.
+    let (_, r) = b.call("session/close", json!({"sessionId": &sid}));
+    assert!(r.get("error").is_none(), "{r}");
+    assert!(dir.join("history.jsonl").is_file());
+    let stderr = b.shutdown();
+    assert!(stderr.contains("session/resume"), "{stderr}");
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// The config of [`persist_layout`] plus the mock as Xcode's mcpbridge.
+fn persist_mcp_config(root: &Path) -> PathBuf {
+    mcp_config(&root.join("editors/acp"), "[persist]\nstate_dir = \"../../data/acp-bridge\"\n")
+}
+
+fn mock_starts(log: &Path) -> Vec<u64> {
+    mock_log(log)
+        .iter()
+        .filter(|l| l["event"] == "start")
+        .filter_map(|l| l["pid"].as_u64())
+        .collect()
+}
+
+fn wait_dead(pid: u64) -> bool {
+    let deadline = Instant::now() + Duration::from_secs(3);
+    while pid_alive(pid) && Instant::now() < deadline {
+        std::thread::sleep(Duration::from_millis(50));
+    }
+    !pid_alive(pid)
+}
+
+/// Idle eviction is harmless: the next prompt restores the session and
+/// reconnects its xcode-tools. Retention deletes old stored sessions at
+/// startup.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn step11_lazy_restore_and_retention() {
+    let (root, _, project) = persist_layout("persist-lazy");
+    let config = persist_mcp_config(&root);
+    let log = root.join("mock.jsonl");
+    let sessions = root.join("data/acp-bridge/sessions");
+    let old = uuid::Uuid::new_v4().to_string();
+    std::fs::create_dir_all(sessions.join(&old)).unwrap();
+    std::fs::write(
+        sessions.join(&old).join("meta.json"),
+        json!({"format": 1, "sessionId": old, "cwd": "/old", "updatedAtUnix": 1_000_000_000u64, "updatedAt": "2001-09-09T01:46:40Z"}).to_string(),
+    )
+    .unwrap();
+    let env = [("LLM_PERSIST", "1"), ("LLM_SESSION_IDLE_TIMEOUT", "1")];
+    let (mut b, recorded) =
+        Bridge::start_with_config(script(vec![answer("first"), answer("second")]), &env, Some(&config)).await;
+    b.initialize(1);
+    std::thread::sleep(Duration::from_millis(300));
+    assert!(!sessions.join(&old).exists(), "a 25-year-old session is past the 30-day retention");
+    let sid = b.new_session(project.to_str().unwrap(), xcode_server(&[("MOCK_LOG", log.to_str().unwrap())]));
+    b.prompt(&sid, "one");
+    assert!(tool_names(&recorded.lock().unwrap()[0]).contains(&"docs_search".to_string()));
+    let first = mock_starts(&log);
+    assert_eq!(first.len(), 1);
+    std::thread::sleep(Duration::from_millis(2600));
+    assert!(wait_dead(first[0]), "the evicted session's server is stopped");
+    let (_, r) = b.prompt(&sid, "two");
+    assert_eq!(r["result"]["text"], "second", "{r}");
+    let req = recorded.lock().unwrap()[1].clone();
+    assert!(req["messages"].as_array().unwrap().iter().any(|m| m["content"] == "one"));
+    assert!(tool_names(&req).contains(&"docs_search".to_string()), "xcode-tools reconnected");
+    assert_eq!(mock_starts(&log).len(), 2);
+    let stderr = b.shutdown();
+    assert!(stderr.contains("Evicted idle sessions"), "{stderr}");
+    assert!(stderr.contains("Restored a stored session for its prompt"), "{stderr}");
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+/// A v2 client resumes the same way; session/resume connects the client's
+/// MCP server (the resumed turn has docs_search); resuming a live session
+/// with the same server keeps the connection, a different one (Xcode
+/// restarted: new session id) replaces it.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn step11_v2_resume_reconnects_xcode_tools() {
+    let (root, _, project) = persist_layout("persist-v2");
+    let config = persist_mcp_config(&root);
+    let log = root.join("mock.jsonl");
+    let env = [("LLM_PERSIST", "1")];
+    let cwd = project.to_str().unwrap();
+    let (mut b, _) = Bridge::start_with_config(script(vec![answer("hello back")]), &env, Some(&config)).await;
+    let init = b.initialize(2);
+    assert!(init["result"]["capabilities"]["session"].is_object(), "v2 baseline (new/list/resume/close): {init}");
+    let sid = b.new_session(cwd, json!([]));
+    b.prompt(&sid, "hello");
+    b.kill();
+
+    let (mut b, recorded) = Bridge::start_with_config(script(vec![answer("again")]), &env, Some(&config)).await;
+    b.initialize(2);
+    let server = xcode_server(&[("MOCK_LOG", log.to_str().unwrap())]);
+    let (_, r) = b.call("session/resume", json!({"sessionId": &sid, "cwd": cwd, "mcpServers": server}));
+    assert_eq!(r["result"], json!({}), "{r}");
+    let (_, r) = b.prompt(&sid, "and now?");
+    assert!(r.get("error").is_none(), "{r}");
+    let req = recorded.lock().unwrap()[0].clone();
+    assert!(req["messages"].as_array().unwrap().iter().any(|m| m["content"] == "hello"));
+    assert!(tool_names(&req).contains(&"docs_search".to_string()));
+    let (_, r) = b.call("session/resume", json!({"sessionId": &sid, "cwd": cwd, "mcpServers": server}));
+    assert_eq!(r["result"], json!({}), "{r}");
+    assert_eq!(mock_starts(&log).len(), 1, "same server: connection kept");
+    let other = xcode_server(&[("MOCK_LOG", log.to_str().unwrap()), ("MOCK_GEN", "27")]);
+    let (_, r) = b.call("session/resume", json!({"sessionId": &sid, "cwd": cwd, "mcpServers": other}));
+    assert_eq!(r["result"], json!({}), "{r}");
+    std::thread::sleep(Duration::from_millis(500));
+    let starts = mock_starts(&log);
+    assert_eq!(starts.len(), 2, "new server: reconnected");
+    assert!(wait_dead(starts[0]), "the replaced server is stopped");
+    let stderr = b.shutdown();
+    assert!(stderr.contains("MCP server already connected for this session"), "{stderr}");
+    assert!(stderr.contains("Replacing the session's MCP server connection"), "{stderr}");
+    let _ = std::fs::remove_dir_all(&root);
+}
