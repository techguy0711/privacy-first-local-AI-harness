+/// Xcode's `notifications/tools/list_changed` (e.g. a workspace finished
+/// loading) makes the next turn list the tools again: a tool missing from
+/// the first list shows up.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn fix_xcode_tool_list_changes_are_picked_up() {
+    let dir = fresh_dir("list-changed");
+    let config = mcp_config(&dir, "");
+    let log = dir.join("mock.jsonl");
+    let (mut b, recorded) =
+        Bridge::start_with_config(script(vec![answer("one"), answer("two")]), &[], Some(&config)).await;
+    b.initialize(1);
+    let server = xcode_server(&[("MOCK_LOG", log.to_str().unwrap()), ("MOCK_TOOLS_LATE", "DocumentationSearch")]);
+    let sid = b.new_session(dir.to_str().unwrap(), server);
+    b.prompt(&sid, "first");
+    std::thread::sleep(Duration::from_millis(500));
+    b.prompt(&sid, "second");
+    let reqs = recorded.lock().unwrap().clone();
+    assert!(tool_names(&reqs[1]).contains(&"docs_search".to_string()), "{:?}", tool_names(&reqs[1]));
+    let lists = mock_log(&log).iter().filter(|l| l["msg"]["method"] == "tools/list").count();
+    assert_eq!(lists, 2, "listed at connect and again after list_changed");
+    let stderr = b.shutdown();
+    assert!(stderr.contains("Xcode's tool list changed; listed it again"), "{stderr}");
+    let _ = std::fs::remove_dir_all(&dir);
+}
