+/// A call of an exposed MCP tool (`mcp__<server>__<tool>`).
+async fn passthrough_call(turn: &TurnCtx, name: &str, args: &Value, cancel: &CancelToken) -> tools::ToolOutcome {
+    let (Some((conn, client)), Some(tool)) = (turn.xcode.clone(), turn.passthrough.get(name)) else {
+        return tools::ToolOutcome { output: format!("Unknown tool: {name}"), failed: true };
+    };
+    // Defense in depth: string arguments of an open-world tool pass the
+    // web-search privacy guard (such tools are refused by policy anyway).
+    if client.tool(tool).is_some_and(|t| t.open_world()) {
+        let empty = crate::websearch::WorkspaceTerms::default();
+        for v in args.as_object().into_iter().flat_map(|o| o.values()) {
+            if let Some(text) = v.as_str() {
+                if let Err(r) = crate::websearch::check_query(text, &empty, &crate::websearch::env_secrets()) {
+                    return tools::ToolOutcome { output: crate::websearch::refusal_text(&r.reason), failed: true };
+                }
+            }
+        }
+    }
+    let timeout = Duration::from_secs(conn.policy.call_timeout_secs.max(1));
+    match conn.call(&client, tool, args.clone(), timeout, Some(cancel), None).await {
+        Ok(r) => tools::ToolOutcome { failed: r.is_error, output: crate::xcode::result_text(&r) },
+        Err(e) => tools::ToolOutcome { output: format!("Error: {tool} failed: {e}"), failed: true },
+    }
+}
