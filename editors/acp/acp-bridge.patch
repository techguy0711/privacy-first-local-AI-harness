+/// The HTTP client for the LLM endpoint. Prompts and source code go only to
+/// the configured endpoint: proxies from the environment (`HTTP(S)_PROXY`,
+/// `ALL_PROXY`) are ignored, and redirects are followed only within the
+/// same origin (scheme, host and port; at most 5).
+pub fn http_client(timeout: Duration) -> Client {
+    Client::builder()
+        .timeout(timeout)
+        .pool_max_idle_per_host(4)
+        .no_proxy()
+        .redirect(reqwest::redirect::Policy::custom(|attempt| {
+            let same_origin = attempt
+                .previous()
+                .first()
+                .is_some_and(|first| first.origin() == attempt.url().origin());
+            if same_origin && attempt.previous().len() <= 5 {
+                attempt.follow()
+            } else {
+                attempt.stop()
+            }
+        }))
+        .build()
+        .expect("Failed to create HTTP client")
+}
