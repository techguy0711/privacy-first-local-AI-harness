+// ---------------------------------------------------------------------------
+// Step 8a: xcode-tools passthrough (the mock MCP server plays mcpbridge)
+// ---------------------------------------------------------------------------
+
+/// Path of the mock MCP server example (built by `cargo test`).
+pub fn mock_bin() -> PathBuf {
+    let exe = std::env::current_exe().unwrap();
+    let p = exe.parent().unwrap().parent().unwrap().join("examples/mock_mcp_server");
+    assert!(p.is_file(), "mock server not built at {}", p.display());
+    p
+}
+
+/// A config file allowing the mock as Xcode's mcpbridge, plus `extra`.
+pub fn mcp_config(dir: &Path, extra: &str) -> PathBuf {
+    let path = dir.join("acp-config.toml");
+    std::fs::write(
+        &path,
+        format!(
+            "[mcp]\nallowed_commands = [\"{}\"]\nconnect_timeout_secs = 10\n{extra}\n",
+            mock_bin().display()
+        ),
+    )
+    .unwrap();
+    path
+}
+
+/// The `mcpServers` entry Xcode sends, pointing at the mock (Xcode's env
+/// plus the MOCK_* switches, which only reach the child this way).
+pub fn xcode_server(env: &[(&str, &str)]) -> Value {
+    let mut e: Vec<Value> = vec![
+        json!({"name": "MCP_XCODE_PID", "value": "15054"}),
+        json!({"name": "MCP_XCODE_SESSION_ID", "value": "BDE7A0AD-1BE4-4301-9C6F-3D2AB9BBE6DA"}),
+    ];
+    e.extend(env.iter().map(|(k, v)| json!({"name": k, "value": v})));
+    json!([{"name": "xcode-tools", "command": mock_bin(), "args": [], "env": e}])
+}
+
+pub fn mock_log(path: &Path) -> Vec<Value> {
+    std::fs::read_to_string(path)
+        .unwrap_or_default()
+        .lines()
+        .filter_map(|l| serde_json::from_str(l).ok())
+        .collect()
+}
+
+pub fn mock_calls(log: &[Value]) -> Vec<Value> {
+    log.iter()
+        .filter(|l| l["msg"]["method"] == "tools/call")
+        .map(|l| l["msg"]["params"].clone())
+        .collect()
+}
+
+fn pid_alive(pid: u64) -> bool {
+    Command::new("kill")
+        .args(["-0", &pid.to_string()])
+        .stderr(Stdio::null())
+        .status()
+        .is_ok_and(|s| s.success())
+}
+
+/// session/new answers at once although the mock delays its handshake;
+/// the model gets `docs_search` (and none of Xcode's other tools); a call
+/// shows as `mcp__xcode-tools__DocumentationSearch` (kind search, rawOutput
+/// documents) and the model gets the top 3 documents; the child got Xcode's
+/// env but not acp-bridge's keys; session/close kills it.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn step8a_docs_search_through_xcode_tools() {
+    let project = skview_project("xt-docs");
+    let log = project.parent().unwrap().join("mock.jsonl");
+    let config = mcp_config(project.parent().unwrap(), "");
+    let replies = vec![
+        tool_call("d1", "docs_search", json!({"query": "SKView presentScene"})),
+        answer("Use presentScene."),
+    ];
+    let (mut b, recorded) = Bridge::start_with_config(script(replies), &[], Some(&config)).await;
+    let init = b.initialize(1);
+    assert_eq!(init["result"]["agentCapabilities"]["mcpCapabilities"], json!({"http": false, "sse": false}));
+    let started = Instant::now();
+    let sid = b.new_session(
+        project.to_str().unwrap(),
+        xcode_server(&[("MOCK_LOG", log.to_str().unwrap()), ("MOCK_INIT_DELAY_MS", "1500")]),
+    );
+    assert!(started.elapsed() < Duration::from_millis(300), "session/new took {:?}", started.elapsed());
+    let (notes, r) = b.prompt(&sid, "How do I show a scene in an SKView?");
+    assert_eq!(r["result"]["stopReason"], "end_turn", "{r}");
+
+    let reqs = recorded.lock().unwrap().clone();
+    let names = tool_names(&reqs[0]);
+    assert!(names.contains(&"docs_search".to_string()), "{names:?}");
+    for hidden in ["GetTopCrashIssues", "XcodeWrite", "BuildProject", "XcodeRefreshCodeIssuesInFile", "DocumentationSearch"] {
+        assert!(!names.iter().any(|n| n.contains(hidden)), "{hidden} exposed: {names:?}");
+    }
+    let docs = &tool_results(&reqs[1])[0];
+    assert!(docs.starts_with("presentScene(_:) (https://developer.apple.com/documentation/spritekit/skview/presentscene(_:))"), "{docs}");
+    assert!(docs.contains("scene (https://") && docs.contains("SKView (https://"));
+    assert!(!docs.contains("SpriteView"), "only the top 3");
+    assert!(docs.len() <= 3500);
+
+    let start = &updates(&notes, "tool_call")[0];
+    assert_eq!(start["title"], "mcp__xcode-tools__DocumentationSearch");
+    assert_eq!(start["kind"], "search");
+    assert_eq!(start["rawInput"]["query"], "SKView presentScene");
+    let done = &updates(&notes, "tool_call_update")[0];
+    assert_eq!(done["status"], "completed");
+    assert_eq!(done["rawOutput"]["query"], "SKView presentScene");
+    assert_eq!(done["rawOutput"]["documents"].as_array().unwrap().len(), 3);
+
+    let lines = mock_log(&log);
+    let start_ev = lines.iter().find(|l| l["event"] == "start").unwrap();
+    let env = start_ev["env"].as_object().unwrap();
+    assert_eq!(env["MCP_XCODE_SESSION_ID"], "BDE7A0AD-1BE4-4301-9C6F-3D2AB9BBE6DA");
+    assert_eq!(env["MCP_XCODE_PID"], "15054");
+    assert!(!env.contains_key("LLM_API_KEY") && !env.contains_key("LLM_BASE_URL"), "{env:?}");
+    let calls = mock_calls(&lines);
+    assert_eq!(calls.len(), 1);
+    assert_eq!(calls[0]["name"], "DocumentationSearch");
+    assert!(calls[0]["arguments"].get("workspaceIdentifier").is_none());
+
+    // session/close kills the server.
+    let pid = start_ev["pid"].as_u64().unwrap();
+    assert!(pid_alive(pid));
+    let (_, r) = b.call("session/close", json!({"sessionId": sid}));
+    assert!(r.get("error").is_none(), "{r}");
+    let deadline = Instant::now() + Duration::from_secs(3);
+    while pid_alive(pid) && Instant::now() < deadline {
+        std::thread::sleep(Duration::from_millis(50));
+    }
+    assert!(!pid_alive(pid), "mcpbridge mock {pid} outlived its session");
+    let log_text = b.shutdown();
+    assert!(log_text.contains("docs_search query=SKView presentScene"), "{log_text}");
+}
