+/// Mock LLM whose first chat request hangs for 60s (a slow model); later
+/// requests answer "Hello" at once. Counts requests.
+fn mock_llm_slow_first_router() -> (Router, Arc<AtomicUsize>) {
+    let count = Arc::new(AtomicUsize::new(0));
+    let router = Router::new()
+        .route("/v1/models", get(mock_models))
+        .route("/v1/chat/completions", post(mock_chat_completions_slow_first))
+        .route("/api/tags", get(mock_ollama_tags))
+        .with_state(Arc::clone(&count));
+    (router, count)
+}
+
+async fn mock_chat_completions_slow_first(State(count): State<Arc<AtomicUsize>>) -> impl IntoResponse {
+    if count.fetch_add(1, Ordering::SeqCst) == 0 {
+        tokio::time::sleep(Duration::from_secs(60)).await;
+    }
+    axum::Json(json!({
+        "choices": [{"message": {"role": "assistant", "content": "Hello"}, "finish_reason": "stop"}]
+    }))
+}
+
+fn cancel_notification(sid: &str) -> Value {
+    json!({"jsonrpc":"2.0","method":"session/cancel","params":{"sessionId": sid}})
+}
+
+/// session/cancel during a slow LLM request answers the pending prompt
+/// promptly with stopReason "cancelled"; the session keeps working.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_cancel_stops_in_flight_llm_request() {
+    let port = free_port();
+    let (router, count) = mock_llm_slow_first_router();
+    let mut h = TestHarness::start_with_router_and_env(
+        port,
+        router,
+        &[("LLM_BASE_URL", &format!("http://127.0.0.1:{port}/v1"))],
+    )
+    .await;
+    h.send(&json!({"jsonrpc":"2.0","id":1,"method":"session/new","params":{"cwd":"/tmp"}}));
+    let sid = h.read_line()["result"]["sessionId"].as_str().unwrap().to_string();
+    h.send(&json!({
+        "jsonrpc":"2.0","id":2,"method":"session/prompt",
+        "params":{"sessionId":&sid,"prompt":[{"type":"text","text":"think hard"}]}
+    }));
+    tokio::time::sleep(Duration::from_millis(500)).await;
+    assert_eq!(count.load(Ordering::SeqCst), 1, "LLM request in flight");
+    let cancelled_at = std::time::Instant::now();
+    h.send(&cancel_notification(&sid));
+    let (_n, response) = h.read_until_response(2);
+    assert!(
+        cancelled_at.elapsed() < Duration::from_secs(5),
+        "cancel took {:?}",
+        cancelled_at.elapsed()
+    );
+    assert_eq!(response["result"]["stopReason"], "cancelled");
+    assert_eq!(response["result"]["status"], "cancelled");
+
+    // The session is still usable.
+    h.send(&json!({
+        "jsonrpc":"2.0","id":3,"method":"session/prompt",
+        "params":{"sessionId":&sid,"prompt":[{"type":"text","text":"again"}]}
+    }));
+    let (_n, response) = h.read_until_response(3);
+    assert_eq!(response["result"]["stopReason"], "end_turn");
+    assert_eq!(response["result"]["text"], "Hello");
+
+    // A cancel with no running turn is a harmless no-op.
+    h.send(&cancel_notification(&sid));
+    h.send(&json!({"jsonrpc":"2.0","id":4,"method":"session/list","params":{}}));
+    assert_eq!(h.read_line()["id"], 4);
+    h.shutdown();
+}
