+        tool_call("w6", "web_search", json!({"query": "ＧａｍｅＳｃｅｎｅ crash"})),
+        answer("turn two"),
+    ];
+    let (mut b, recorded) = Bridge::start_with_config(
+        script(replies),
+        &[("LLM_WEB_SEARCH", "on"), ("LLM_INVESTIGATE_LIMIT", "0"), ("LLM_PERSIST", "1")],
+        Some(&config),
+    )
+    .await;
+    b.initialize(1);
+    let sid = b.new_session(project.to_str().unwrap(), json!([]));
+    let (_, r) = b.prompt(&sid, "build the honey system");
+    assert_eq!(r["result"]["text"], "turn one", "{r}");
+    let results = tool_results(recorded.lock().unwrap().last().unwrap());
+    assert!(results[0].starts_with("Result 1 for SpriteKit SKView presentScene"), "{}", results[0]);
+    assert!(results[2].contains("names from this project (HoneyHarvestSystem, collectNectarBurst)"), "{}", results[2]);
+    assert!(results[3].contains("names from this project (honey harvest system)"), "{}", results[3]);
+
+    // session/resume of the live session with another cwd.
+    let (_, r) = b.call("session/resume", json!({"sessionId": &sid, "cwd": other.to_str().unwrap(), "mcpServers": []}));
+    assert_eq!(r["result"], json!({}), "{r}");
+    let (_, r) = b.prompt(&sid, "now the engine");
+    assert_eq!(r["result"]["text"], "turn two", "{r}");
+    let results = tool_results(recorded.lock().unwrap().last().unwrap());
+    let n = results.len();
+    assert!(results[n - 3].contains("names from this project (SecretThingEngine)"), "{}", results[n - 3]);
+    assert!(results[n - 2].contains("non-ASCII character (U+200B)"), "{}", results[n - 2]);
+    assert!(results[n - 1].contains("non-ASCII character (U+FF27)"), "{}", results[n - 1]);
+
+    let sent: Vec<String> = mock_calls(&mock_log(&log))
+        .iter()
+        .map(|c| c["arguments"]["query"].as_str().unwrap_or("").to_string())
+        .collect();
+    assert_eq!(sent, vec!["SpriteKit SKView presentScene"], "only the generic query reaches the server");
+    let stderr = b.shutdown();
+    assert!(stderr.contains("Resumed session moves to a new cwd"), "{stderr}");
+    let _ = std::fs::remove_dir_all(&dir);
+}
