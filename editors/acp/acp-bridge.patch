+// ---------------------------------------------------------------------------
+// Server specs and policy checks
+// ---------------------------------------------------------------------------
+
+/// How to reach one MCP server.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum McpSpec {
+    Stdio {
+        name: String,
+        command: String,
+        args: Vec<String>,
+        env: Vec<(String, String)>,
+    },
+    Http {
+        name: String,
+        url: String,
+        headers: Vec<(String, String)>,
+    },
+}
+
+impl McpSpec {
+    pub fn name(&self) -> &str {
+        match self {
+            McpSpec::Stdio { name, .. } | McpSpec::Http { name, .. } => name,
+        }
+    }
+}
+
+fn pairs(v: Option<&Value>) -> Vec<(String, String)> {
+    match v {
+        Some(Value::Array(items)) => items
+            .iter()
+            .filter_map(|e| {
+                Some((
+                    e.get("name")?.as_str()?.to_string(),
+                    e.get("value")?.as_str()?.to_string(),
+                ))
+            })
+            .collect(),
+        Some(Value::Object(map)) => map
+            .iter()
+            .filter_map(|(k, v)| Some((k.clone(), v.as_str()?.to_string())))
+            .collect(),
+        _ => Vec::new(),
+    }
+}
+
+/// Parse one entry of ACP `mcpServers`: v1 stdio has no `type`, v2 uses
+/// `type: "stdio"`; `type: "http"` is HTTP; `sse` (deprecated) and other
+/// types are refused.
+pub fn parse_acp_server(v: &Value) -> Result<McpSpec, String> {
+    let name = v
+        .get("name")
+        .and_then(Value::as_str)
+        .unwrap_or("")
+        .to_string();
+    match v.get("type").and_then(Value::as_str) {
+        None | Some("stdio") => {
+            let command = v
+                .get("command")
+                .and_then(Value::as_str)
+                .ok_or_else(|| format!("MCP server '{name}' has no command"))?
+                .to_string();
+            let args = v
+                .get("args")
+                .and_then(Value::as_array)
+                .map(|a| a.iter().filter_map(|x| x.as_str().map(str::to_owned)).collect())
+                .unwrap_or_default();
+            Ok(McpSpec::Stdio {
+                name,
+                command,
+                args,
+                env: pairs(v.get("env")),
+            })
+        }
+        Some("http") => {
+            let url = v
+                .get("url")
+                .and_then(Value::as_str)
+                .ok_or_else(|| format!("MCP server '{name}' has no url"))?
+                .to_string();
+            Ok(McpSpec::Http {
+                name,
+                url,
+                headers: pairs(v.get("headers")),
+            })
+        }
+        Some(other) => Err(format!("MCP server '{name}': transport '{other}' is not supported")),
+    }
+}
+
+/// Whether a client-provided stdio command is on the allowlist (both sides
+/// canonicalized, so symlinks and `..` cannot sneak past).
+pub fn command_allowed(command: &str, allowed: &[String]) -> bool {
+    let canon = |p: &str| std::fs::canonicalize(p).unwrap_or_else(|_| std::path::PathBuf::from(p));
+    let cmd = canon(command);
+    std::path::Path::new(command).is_absolute() && allowed.iter().any(|a| canon(a) == cmd)
+}
+
+/// Arguments a client may pass to an allowlisted command. Xcode starts its
+/// `mcpbridge` without arguments; a subcommand (`run-agent <agent>` launches
+/// a coding agent with Xcode's configuration) is refused, option flags are
+/// accepted. Other allowlisted commands get their arguments as given.
+pub fn args_allowed(command: &str, args: &[String]) -> Result<(), String> {
+    let path = std::fs::canonicalize(command).unwrap_or_else(|_| std::path::PathBuf::from(command));
+    let is_bridge = [path.as_path(), std::path::Path::new(command)]
+        .iter()
+        .any(|p| p.file_name().and_then(|n| n.to_str()) == Some("mcpbridge"));
+    match args.iter().find(|a| !a.starts_with('-')) {
+        Some(sub) if is_bridge => Err(format!("mcpbridge is only started as an MCP server, not with '{sub}'")),
+        _ => Ok(()),
+    }
+}
+
+/// Parse `url` and require a loopback host (127.0.0.1, ::1, localhost).
+pub fn loopback_url(url: &str) -> Result<url::Url, String> {
+    let u = url::Url::parse(url).map_err(|e| format!("invalid URL '{url}': {e}"))?;
+    if !matches!(u.scheme(), "http" | "https") {
+        return Err(format!("'{url}': only http(s) is allowed"));
+    }
+    let ok = match u.host() {
+        Some(url::Host::Ipv4(ip)) => ip.is_loopback(),
+        Some(url::Host::Ipv6(ip)) => ip.is_loopback(),
+        Some(url::Host::Domain(d)) => d.eq_ignore_ascii_case("localhost"),
+        None => false,
+    };
+    if ok {
+        Ok(u)
+    } else {
+        Err(format!("'{url}' is not a loopback address; acp-bridge only talks to MCP servers on this machine"))
+    }
+}
+
+/// Tools that are never called, whatever the config says: Xcode's
+/// Organizer / App Store Connect tools (they contact Apple), message
+/// sending, and any open-world tool that is not the guarded web search.
+pub fn hard_denied(tool: &McpTool, web_search_role: bool) -> Option<&'static str> {
+    let n = tool.name.as_str();
+    if n.starts_with("Get") && n.contains("Crash") {
+        return Some("crash reports come from Apple's servers");
+    }
+    if n.starts_with("Get") && n.contains("FieldPerformance") {
+        return Some("field performance data comes from Apple's servers");
+    }
+    if n == "XcodeMessageSend" {
+        return Some("sends messages");
+    }
+    if tool.open_world() && !web_search_role {
+        return Some("open-world tool");
+    }
+    None
+}
