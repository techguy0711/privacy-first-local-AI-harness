+/// [`execute_tool_with_cancel`] on the blocking thread pool, so a long
+/// tool does not stall the async runtime (or the request loop).
+pub async fn execute_tool_async(
+    working_dir: &Path,
+    name: &str,
+    arguments: &Value,
+    cancel: &CancelToken,
+) -> ToolOutcome {
+    let (wd, name, args, cancel) = (
+        working_dir.to_path_buf(),
+        name.to_string(),
+        arguments.clone(),
+        cancel.clone(),
+    );
+    tokio::task::spawn_blocking(move || execute_tool_with_cancel(&wd, &name, &args, Some(&cancel)))
+        .await
+        .unwrap_or_else(|e| ToolOutcome {
+            output: format!("Error: tool execution failed: {e}"),
+            failed: true,
+        })
+}
