+/// The model's reaction to tool results in the recorded SKView session,
+/// played by a mock: it replays the recorded calls, but follows a hint that
+/// names docs_search, applies the fix the documentation shows, and stops.
+pub fn skview_reactive_model() -> Responder {
+    let calls = recorded_skview_calls();
+    Arc::new(move |body: &Value, _n| {
+        let msgs = body["messages"].as_array().unwrap();
+        let last = msgs.last().unwrap();
+        let last_tool = if last["role"] == "tool" { last["content"].as_str().unwrap_or("") } else { "" };
+        let made = msgs
+            .iter()
+            .filter(|m| m["tool_calls"][0]["id"].as_str().is_some_and(|id| id.starts_with('r')))
+            .count();
+        if last_tool.starts_with("patched") {
+            return answer("Fixed: SKView.scene is get-only, so the view now calls skView.presentScene(gameScene).");
+        }
+        if last_tool.contains("presentScene(_:)") {
+            return tool_call(
+                "fix",
+                "edit",
+                json!({"path": "MyApp/GameView.swift", "old_text": "skView.scene = gameScene", "new_text": "skView.presentScene(gameScene)"}),
+            );
+        }
+        if let Some(q) = last_tool.split("docs_search (query: \"").nth(1).and_then(|r| r.split('"').next()) {
+            return tool_call("docs", "docs_search", json!({"query": q}));
+        }
+        match calls.get(made) {
+            Some((name, args)) => tool_call(&format!("r{made}"), name, args.clone()),
+            None => answer("I'm not sure why 'scene' is get-only."),
+        }
+    })
+}
