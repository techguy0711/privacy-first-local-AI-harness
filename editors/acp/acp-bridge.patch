+/// rejected, or when either side is too large to show.
+pub fn plan_file_change(working_dir: &Path, name: &str, arguments: &Value) -> Option<FileChange> {
+    let arg = |key: &str| arguments.get(key).and_then(|v| v.as_str()).unwrap_or("");
+    match name {
+        "write_file" => plan_write_file(working_dir, arg("path"), arg("content")),
+        "edit" => {
+            let (path, old_text, new_text) = (arg("path"), arg("old_text"), arg("new_text"));
+            let fits = old_text.len() <= MAX_DIFF_BYTES && new_text.len() <= MAX_DIFF_BYTES;
+            (!path.is_empty() && !old_text.is_empty() && fits).then(|| FileChange {
+                path: display_path(working_dir, path),
+                old_text: Some(old_text.to_string()),
+                new_text: new_text.to_string(),
+            })
+        }
+        _ => None,
+    }
+}
