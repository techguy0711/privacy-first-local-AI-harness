+/// The process-wide connection to the web-search server.
+pub struct WebSearch {
+    pub server: ServerConfig,
+    state: tokio::sync::Mutex<(Option<Arc<McpClient>>, Option<Instant>)>,
+}
+
+impl WebSearch {
+    /// From the settings: the first `[[mcp.servers]]` entry with role
+    /// `web_search`, when MCP and web search are on.
+    pub fn from_settings(mcp: &crate::mcp::McpSettings) -> Option<Arc<Self>> {
+        if !mcp.enabled || !mcp.web_search {
+            return None;
+        }
+        let server = mcp.servers.iter().find(|s| s.role.as_deref() == Some("web_search"))?.clone();
+        if let Err(e) = crate::mcp::loopback_url(&server.url) {
+            warn!(server = %server.name, error = %e, "Web search server ignored");
+            return None;
+        }
+        if !server.allow.iter().any(|t| t == BRAVE_TOOL) {
+            warn!(server = %server.name, "Web search server ignored: brave_web_search is not in its allow list");
+            return None;
+        }
+        Some(Arc::new(Self {
+            server,
+            state: tokio::sync::Mutex::new((None, None)),
+        }))
+    }
+
+    /// The client for this turn: connected lazily (2 s handshake); a server
+    /// that was down is re-checked at most every 5 minutes. `None` = no
+    /// web_search this turn.
+    pub async fn client_for_turn(&self) -> Option<Arc<McpClient>> {
+        let mut st = self.state.lock().await;
+        if let Some(c) = &st.0 {
+            return Some(Arc::clone(c));
+        }
+        if st.1.is_some_and(|t| t.elapsed() < RECHECK) {
+            return None;
+        }
+        st.1 = Some(Instant::now());
+        let spec = McpSpec::Http {
+            name: self.server.name.clone(),
+            url: self.server.url.clone(),
+            headers: Vec::new(),
+        };
+        match McpClient::connect(&spec, &ConnectOptions { handshake_timeout: HANDSHAKE }).await {
+            Ok(c) if c.tool(BRAVE_TOOL).is_some() => {
+                info!(server = %self.server.name, "Web search available");
+                st.0 = Some(Arc::clone(&c));
+                Some(c)
+            }
+            Ok(_) => {
+                warn!(server = %self.server.name, "Web search server has no brave_web_search tool");
+                None
+            }
+            Err(e) => {
+                info!(server = %self.server.name, error = %e, "Web search server not reachable; no web_search for now");
+                None
+            }
+        }
+    }
+
+    /// Forget the client (after a transport failure) so the next turn
+    /// reconnects.
+    pub async fn reset(&self) {
+        let mut st = self.state.lock().await;
+        st.0 = None;
+        st.1 = None;
+    }
+
+    pub fn call_timeout(&self) -> Duration {
+        Duration::from_secs(self.server.call_timeout_secs.unwrap_or(20).max(1))
+    }
+}
+
+/// The fixed `brave_web_search` arguments for an allowed query.
+pub fn brave_args(query: &str) -> Value {
+    json!({"query": query, "count": MAX_RESULTS, "result_filter": ["web"], "text_decorations": false})
+}
