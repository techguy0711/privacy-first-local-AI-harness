@@ -0,0 +1,553 @@
+//! Context budget — keep each LLM request inside the model's context window.
+//!
+//! Before every chat request the engine estimates the request size (system
+//! prompt, history and tool schemas at ~3.5 characters per token) and, when
+//! it exceeds `context - reserved output - margin`, shrinks a copy of the history
+//! oldest-first. The stored session history is never modified.
+//!
+//! Shrinking steps, each stopping as soon as the request fits:
+//! 1. elide file contents in old `write_file` / `edit` arguments (and drop
+//!    old reasoning text),
+//! 2. truncate old tool results,
+//! 3. drop whole old rounds (an assistant tool-call message together with
+//!    all of its tool results, so no call or result is ever orphaned),
+//! 4. as a last resort, steps 1–2 on the recent rounds too.
+//!
+//! The system prompt, the turn's user message and the latest user message
+//! are never changed or dropped. The system message stays byte-identical
+//! (so the backend's cached prompt prefix stays valid); when rounds were
+//! dropped the report says so and the engine tells the model at the end of
+//! the request (see `notes`).
+
+use serde_json::Value;
+
+/// Characters per token used for the estimate (conservative for code).
+const CHARS_PER_TOKEN: f64 = 3.5;
+/// Characters charged per image (vision models spend up to ~1k tokens).
+const IMAGE_CHARS: usize = 3500;
+/// Characters charged per message for role markers / chat template.
+const MESSAGE_OVERHEAD_CHARS: usize = 16;
+/// Tokens kept free besides the reply budget (estimate error, template).
+pub const SAFETY_MARGIN_TOKENS: u64 = 1024;
+/// Output reservation when none is given.
+pub const DEFAULT_REPLY_TOKENS: u64 = 4096;
+/// Most recent message groups left intact by steps 1–3.
+const RECENT_GROUPS: usize = 4;
+/// Old tool results are cut to this many characters.
+const OLD_RESULT_CHARS: usize = 400;
+/// Marker ending a truncated tool result.
+const TRUNCATED_MARK: &str = "characters of this old tool result elided]";
+
+/// Prompt-token budget for a model with `context_size` tokens when
+/// `reserve_tokens` are kept free for the reply (the engine passes
+/// `LlmConfig::reserve_output_tokens`, which is separate from the reply cap
+/// `max_tokens`; `None` reserves [`DEFAULT_REPLY_TOKENS`]).
+pub fn budget_tokens(context_size: u64, reserve_tokens: Option<u64>) -> u64 {
+    context_size
+        .saturating_sub(reserve_tokens.unwrap_or(DEFAULT_REPLY_TOKENS))
+        .saturating_sub(SAFETY_MARGIN_TOKENS)
+}
+
+/// Estimated tokens for `chars` characters.
+pub fn tokens_for_chars(chars: usize) -> u64 {
+    (chars as f64 / CHARS_PER_TOKEN).ceil() as u64
+}
+
+/// Approximate character count of a JSON value as the model sees it:
+/// string lengths plus key names; images count as [`IMAGE_CHARS`] each
+/// instead of their base64 size.
+pub fn value_chars(v: &Value) -> usize {
+    match v {
+        Value::String(s) => s.len(),
+        Value::Array(a) => a.iter().map(value_chars).sum::<usize>() + a.len(),
+        Value::Object(o) => o
+            .iter()
+            .map(|(k, v)| match k.as_str() {
+                // Ollama native: `images: [base64, …]`.
+                "images" => v.as_array().map_or(IMAGE_CHARS, |a| a.len() * IMAGE_CHARS),
+                // OpenAI: `{type: "image_url", image_url: {url: "data:…"}}`.
+                "image_url" => IMAGE_CHARS,
+                _ => k.len() + 3 + value_chars(v),
+            })
+            .sum(),
+        Value::Number(n) => n.to_string().len(),
+        Value::Bool(_) => 5,
+        Value::Null => 4,
+    }
+}
+
+fn message_chars(m: &Value) -> usize {
+    value_chars(m) + MESSAGE_OVERHEAD_CHARS
+}
+
+/// Estimated prompt tokens for `messages` plus `overhead_chars` (tool
+/// schemas).
+pub fn estimate_request_tokens(messages: &[Value], overhead_chars: usize) -> u64 {
+    tokens_for_chars(overhead_chars + messages.iter().map(message_chars).sum::<usize>())
+}
+
+/// What [`fit_messages`] did.
+#[derive(Debug, Default, Clone, PartialEq, Eq)]
+pub struct FitReport {
+    pub before_tokens: u64,
+    pub after_tokens: u64,
+    pub budget_tokens: u64,
+    /// File contents elided from tool-call arguments (and reasoning
+    /// dropped), counted per message.
+    pub elided: usize,
+    /// Tool results truncated.
+    pub truncated: usize,
+    /// Messages dropped.
+    pub dropped: usize,
+    /// Indices (into the input) of the dropped messages, ascending.
+    pub dropped_indices: Vec<usize>,
+}
+
+impl FitReport {
+    pub fn changed(&self) -> bool {
+        self.elided + self.truncated + self.dropped > 0
+    }
+
+    pub fn fits(&self) -> bool {
+        self.after_tokens <= self.budget_tokens
+    }
+
+    /// Whether whole old rounds were dropped (the model should be told).
+    pub fn dropped_note(&self) -> bool {
+        self.dropped > 0
+    }
+}
+
+fn role(m: &Value) -> &str {
+    m.get("role").and_then(Value::as_str).unwrap_or("")
+}
+
+fn has_tool_calls(m: &Value) -> bool {
+    m.get("tool_calls")
+        .and_then(Value::as_array)
+        .is_some_and(|c| !c.is_empty())
+}
+
+/// Split message indices `start..len` into groups: an assistant message
+/// with tool calls plus the tool results that follow it, or any other
+/// single message.
+fn groups(messages: &[Value], start: usize) -> Vec<Vec<usize>> {
+    let mut out: Vec<Vec<usize>> = Vec::new();
+    let mut i = start;
+    while i < messages.len() {
+        let mut g = vec![i];
+        if role(&messages[i]) == "assistant" && has_tool_calls(&messages[i]) {
+            while i + 1 < messages.len() && role(&messages[i + 1]) == "tool" {
+                i += 1;
+                g.push(i);
+            }
+        }
+        out.push(g);
+        i += 1;
+    }
+    out
+}
+
+fn elision_marker(path: &str) -> String {
+    format!("[contents of {path} elided - call read_file for the current version]")
+}
+
+/// Elide the file contents of `write_file` / `edit` calls and drop the
+/// reasoning text of an assistant message. Returns whether it changed.
+fn elide_message(m: &mut Value) -> bool {
+    let mut changed = false;
+    if let Some(obj) = m.as_object_mut() {
+        for key in ["reasoning", "reasoning_content", "thinking"] {
+            if obj.get(key).and_then(Value::as_str).is_some_and(|s| !s.is_empty()) {
+                obj.remove(key);
+                changed = true;
+            }
+        }
+    }
+    let Some(calls) = m.get_mut("tool_calls").and_then(Value::as_array_mut) else {
+        return changed;
+    };
+    for call in calls {
+        let Some(func) = call.get_mut("function") else {
+            continue;
+        };
+        let name = func.get("name").and_then(Value::as_str).unwrap_or("");
+        let keys: &[&str] = match name {
+            "write_file" => &["content"],
+            "edit" => &["old_text", "new_text"],
+            _ => continue,
+        };
+        // OpenAI-compatible: a JSON string; Ollama native: an object.
+        let (mut args, was_string) = match func.get("arguments") {
+            Some(Value::String(s)) => match serde_json::from_str::<Value>(s) {
+                Ok(v) => (v, true),
+                Err(_) => continue,
+            },
+            Some(v @ Value::Object(_)) => (v.clone(), false),
+            _ => continue,
+        };
+        let path = args
+            .get("path")
+            .and_then(Value::as_str)
+            .unwrap_or("the file")
+            .to_string();
+        let marker = elision_marker(&path);
+        let mut call_changed = false;
+        for key in keys {
+            if let Some(text) = args.get(*key).and_then(Value::as_str) {
+                if text.len() > marker.len() {
+                    args[*key] = Value::String(marker.clone());
+                    call_changed = true;
+                }
+            }
+        }
+        if call_changed {
+            func["arguments"] = if was_string {
+                Value::String(args.to_string())
+            } else {
+                args
+            };
+            changed = true;
+        }
+    }
+    changed
+}
+
+/// Cut a tool result to [`OLD_RESULT_CHARS`] characters. Returns whether
+/// it changed.
+fn truncate_result(m: &mut Value) -> bool {
+    let Some(text) = m.get("content").and_then(Value::as_str) else {
+        return false;
+    };
+    let total = text.chars().count();
+    if total <= OLD_RESULT_CHARS + 80 || text.ends_with(TRUNCATED_MARK) {
+        return false;
+    }
+    let head: String = text.chars().take(OLD_RESULT_CHARS).collect();
+    m["content"] = Value::String(format!(
+        "{head}\n[... {} {TRUNCATED_MARK}",
+        total - OLD_RESULT_CHARS
+    ));
+    true
+}
+
+/// Shrink a copy of `messages` until the request (plus `overhead_chars`
+/// for the tool schemas) fits `budget_tokens`, following the steps in the
+/// module docs. `protected` lists message indices that must stay as they
+/// are; the system message (index 0) and the latest user message are
+/// always protected.
+pub fn fit_messages(
+    messages: &[Value],
+    overhead_chars: usize,
+    budget_tokens: u64,
+    protected: &[usize],
+) -> (Vec<Value>, FitReport) {
+    let mut msgs: Vec<Value> = messages.to_vec();
+    let mut sizes: Vec<usize> = msgs.iter().map(message_chars).collect();
+    let mut total: usize = overhead_chars + sizes.iter().sum::<usize>();
+    let mut report = FitReport {
+        before_tokens: tokens_for_chars(total),
+        after_tokens: tokens_for_chars(total),
+        budget_tokens,
+        ..FitReport::default()
+    };
+    if report.fits() {
+        return (msgs, report);
+    }
+
+    let mut keep: Vec<usize> = protected.to_vec();
+    let start = if msgs.first().is_some_and(|m| role(m) == "system") {
+        keep.push(0);
+        1
+    } else {
+        0
+    };
+    if let Some(last_user) = msgs.iter().rposition(|m| role(m) == "user") {
+        keep.push(last_user);
+    }
+    let fits = |total: usize| tokens_for_chars(total) <= budget_tokens;
+
+    let all_groups = groups(&msgs, start);
+    let old_count = all_groups.len().saturating_sub(RECENT_GROUPS);
+    let mut dropped = vec![false; msgs.len()];
+
+    // Steps 1-2 over the given groups; true once the request fits.
+    let shrink = |groups: &[Vec<usize>],
+                      msgs: &mut Vec<Value>,
+                      sizes: &mut Vec<usize>,
+                      total: &mut usize,
+                      report: &mut FitReport|
+     -> bool {
+        for (step, g) in [0, 1].iter().flat_map(|s| groups.iter().map(move |g| (*s, g))) {
+            for &i in g {
+                if keep.contains(&i) {
+                    continue;
+                }
+                let changed = match (step, role(&msgs[i])) {
+                    (0, "assistant") => elide_message(&mut msgs[i]),
+                    (1, "tool") => truncate_result(&mut msgs[i]),
+                    _ => false,
+                };
+                if changed {
+                    if step == 0 {
+                        report.elided += 1;
+                    } else {
+                        report.truncated += 1;
+                    }
+                    let new = message_chars(&msgs[i]);
+                    *total = *total - sizes[i] + new;
+                    sizes[i] = new;
+                    if fits(*total) {
+                        return true;
+                    }
+                }
+            }
+        }
+        false
+    };
+
+    let mut done = shrink(&all_groups[..old_count], &mut msgs, &mut sizes, &mut total, &mut report);
+
+    // Step 3: drop whole old groups, oldest first.
+    if !done {
+        for g in &all_groups[..old_count] {
+            if g.iter().any(|i| keep.contains(i)) {
+                continue;
+            }
+            for &i in g {
+                dropped[i] = true;
+                total -= sizes[i];
+                report.dropped += 1;
+            }
+            if fits(total) {
+                done = true;
+                break;
+            }
+        }
+    }
+
+    // Step 4: steps 1-2 on the recent groups too.
+    if !done {
+        shrink(&all_groups[old_count..], &mut msgs, &mut sizes, &mut total, &mut report);
+    }
+
+    report.dropped_indices = dropped
+        .iter()
+        .enumerate()
+        .filter(|(_, d)| **d)
+        .map(|(i, _)| i)
+        .collect();
+    let out: Vec<Value> = msgs
+        .into_iter()
+        .zip(dropped)
+        .filter(|(_, d)| !d)
+        .map(|(m, _)| m)
+        .collect();
+    report.after_tokens = tokens_for_chars(total);
+    (out, report)
+}
