+//! Read-only MCP probe: connect to a loopback Streamable HTTP MCP server
+//! (e.g. the local Brave server at http://127.0.0.1:8765/mcp), do the
+//! handshake and list its tools. Makes no tool calls, so it costs no search
+//! quota. Usage: `cargo run --release --example mcp_probe -- <url>`.
+
+use acp_bridge::mcp::{ConnectOptions, McpClient, McpSpec};
+use std::time::Duration;
+
+#[tokio::main]
+async fn main() {
+    let url = std::env::args().nth(1).unwrap_or_else(|| "http://127.0.0.1:8765/mcp".into());
+    let spec = McpSpec::Http { name: "probe".into(), url: url.clone(), headers: vec![] };
+    let opts = ConnectOptions { handshake_timeout: Duration::from_secs(5) };
+    match McpClient::connect(&spec, &opts).await {
+        Ok(c) => {
+            println!("connected to {url}: protocol {} server {}", c.protocol_version(), c.server_info());
+            for t in c.tools() {
+                println!("  {} (openWorld: {})", t.name, t.open_world());
+            }
+            c.close().await;
+        }
+        Err(e) => {
+            eprintln!("probe failed: {e}");
+            std::process::exit(1);
+        }
+    }
+}
