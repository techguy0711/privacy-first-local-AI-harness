+    assert_eq!(r["result"]["text"], "Fixed both.\n\nBuild succeeded.");
+    let reqs = recorded.lock().unwrap().clone();
+    let failed_prompt = reqs[2]["messages"].as_array().unwrap().last().unwrap()["content"].as_str().unwrap().to_string();
+    assert!(failed_prompt.starts_with("The build failed with these errors."), "{failed_prompt}");
+    assert!(failed_prompt.contains("MyApp/Broken.swift:1: error: Cannot assign to property: 'scene' is a get-only property"), "{failed_prompt}");
+    assert!(failed_prompt.contains("MyApp/Broken.swift:2: error:"), "{failed_prompt}");
