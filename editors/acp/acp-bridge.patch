+//! No-progress guard — stops a turn from spinning on read-only calls.
+//!
+//! A small model that lacks the knowledge to fix something tends to search
+//! and re-read the project instead of acting (the recorded Xcode failure:
+//! 21 calls, mostly `search_code("scene")`, zero edits). [`TurnGuard`] is
+//! pure per-turn bookkeeping the engine consults around every tool call:
+//!
+//! - **Duplicates**: an identical read-only call (same tool, same
+//!   canonical arguments) is answered from the cache instead of running
+//!   again: a pointer to the earlier result while it is recent, the full
+//!   result otherwise. Any successful change clears the cache.
+//! - **Investigation streak**: read-only calls since the last successful
+//!   change (duplicates count double). At `limit` a nudge is appended to
+//!   the tool result, at `limit + 4` a user message follows the round, from
+//!   `limit + 8` read-only calls are refused, and after three refusals the
+//!   turn ends with a summary of what was found.
+//! - **SDK-symbol hint**: a project search for a type (or for a member the
+//!   compiler error names) that the project does not declare gets a note
+//!   that it is an Apple SDK symbol, plus the best way to look it up
+//!   (`docs_search`, `web_search`, or the model's own knowledge).
+//!
+//! `investigate_limit = 0` (`LLM_INVESTIGATE_LIMIT=0`) turns all of it off.
+
+use crate::tools::ToolOutcome;
+use serde_json::{Map, Value};
+use std::collections::{HashMap, HashSet};
+use std::path::{Path, PathBuf};
+use tracing::info;
+
+/// Default investigation limit (`LLM_INVESTIGATE_LIMIT`).
+pub const DEFAULT_INVESTIGATE_LIMIT: u32 = 6;
+/// Refused read-only calls after which the turn ends.
+const MAX_BLOCKED: u32 = 3;
+/// A duplicate whose original is at most this many rounds back gets a
+/// pointer instead of the full result (it is still in the request).
+const RECENT_ROUNDS: usize = 4;
+/// Characters of the earlier result repeated with a pointer.
+const POINTER_PREVIEW_CHARS: usize = 300;
+
+/// What the engine does with a tool call.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Decision {
+    /// Run the tool.
+    Run,
+    /// Do not run it; answer with this text (and status).
+    Answer { text: String, failed: bool },
+}
+
+/// Which lookup tools exist this turn (changes the hint text).
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct HintTools {
+    pub docs_search: bool,
+    pub web_search: bool,
+}
+
+/// Guard settings for one turn.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct GuardConfig {
+    /// Read-only calls before the first nudge; 0 = guard off.
+    pub investigate_limit: u32,
+    /// A verify build runs after the turn (mentioned in the nudge).
+    pub verify_enabled: bool,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Kind {
+    /// Changes files / repository state.
+    Mutating,
+    /// Reads only; the result can be reused for an identical call.
+    Cacheable,
+    /// Reads only (or unknown), but the result is not reused.
+    Investigative,
+    /// Bookkeeping (notes): neither counts nor resets.
+    Neutral,
+}
+
+#[derive(Debug, Clone)]
+struct Cached {
+    round: usize,
+    output: String,
+    failed: bool,
+    count: u32,
+}
+
+/// Per-turn guard state.
+#[derive(Debug)]
+pub struct TurnGuard {
+    cfg: GuardConfig,
+    tools: HintTools,
+    wd: PathBuf,
+    /// Identifiers quoted in the turn's compiler error ('scene').
+    error_names: Vec<String>,
+    /// Modules the project imports.
+    imports: Vec<String>,
+    round: usize,
+    streak: u32,
+    nudged: bool,
+    user_nudged: bool,
+    pending_user_nudge: Option<String>,
+    blocked: u32,
+    cache: HashMap<String, Cached>,
+    hinted: HashSet<String>,
+    /// Successful writes: path -> (round, content).
+    writes: HashMap<String, (usize, String)>,
+    /// Successful edits: (path, old, new) key -> round.
+    edits: HashMap<String, usize>,
+    /// Short notes on what read-only calls found (for the final summary).
+    findings: Vec<String>,
+}
+
+impl TurnGuard {
+    /// `user_text` is the turn's prompt (compiler errors are read from it);
+    /// `imports` the modules the project imports (see [`project_imports`]).
+    pub fn new(cfg: GuardConfig, wd: &Path, user_text: &str, imports: Vec<String>) -> Self {
+        Self {
+            cfg,
+            tools: HintTools::default(),
+            wd: wd.to_path_buf(),
+            error_names: error_names(user_text),
+            imports,
+            round: 0,
+            streak: 0,
+            nudged: false,
+            user_nudged: false,
+            pending_user_nudge: None,
+            blocked: 0,
+            cache: HashMap::new(),
+            hinted: HashSet::new(),
+            writes: HashMap::new(),
+            edits: HashMap::new(),
+            findings: Vec::new(),
+        }
+    }
+
+    /// The lookup tools the model has this turn.
+    pub fn set_tools(&mut self, tools: HintTools) {
+        self.tools = tools;
+    }
+
+    pub fn enabled(&self) -> bool {
+        self.cfg.investigate_limit > 0
+    }
+
+    /// Start of an LLM round (rounds are numbered from 1 in messages).
+    pub fn begin_round(&mut self) {
+        self.round += 1;
+    }
+
+    /// LLM rounds so far in this turn.
+    pub fn round(&self) -> usize {
+        self.round
+    }
+
+    /// Current investigation streak.
+    pub fn streak(&self) -> u32 {
+        self.streak
+    }
+
+    /// Whether the turn should end now (too many refused calls).
+    pub fn should_stop(&self) -> bool {
+        self.enabled() && self.blocked >= MAX_BLOCKED
+    }
+
+    /// A user message to add after this round, once.
+    pub fn take_user_nudge(&mut self) -> Option<String> {
+        self.pending_user_nudge.take()
+    }
+
+    /// A verify build failed: the model legitimately re-reads files, so the
+    /// streak restarts at `limit - 3` and the thresholds re-arm.
+    pub fn on_build_failed(&mut self) {
+        self.streak = self.cfg.investigate_limit.saturating_sub(3);
+        self.nudged = false;
+        self.user_nudged = false;
+        self.blocked = 0;
+        self.cache.clear();
+    }
+
+    /// Bullet list of what the turn's read-only calls found.
+    pub fn summary(&self) -> String {
+        let mut seen = HashSet::new();
+        self.findings
+            .iter()
+            .filter(|f| seen.insert(f.as_str()))
+            .map(|f| format!("- {f}"))
+            .collect::<Vec<_>>()
+            .join("\n")
+    }
+
+    /// Decide whether a call runs. `name` / `args` are the canonical tool
+    /// name and (normalized) arguments.
+    pub fn before(&mut self, name: &str, args: &Value) -> Decision {
+        if !self.enabled() {
+            return Decision::Run;
+        }
+        let kind = classify(name, args);
+        match (kind, name) {
+            (Kind::Mutating, "write_file") => {
+                let path = str_arg(args, "path");
+                let content = str_arg(args, "content");
+                if let Some((round, written)) = self.writes.get(&path) {
+                    let on_disk = std::fs::read_to_string(crate::tools::display_path(&self.wd, &path));
+                    if *written == content && on_disk.is_ok_and(|d| d == content) {
+                        let text = format!(
+                            "File already has exactly this content (written in round {round}); no change made."
+                        );
+                        let suffix = self.bump(1);
+                        return Decision::Answer {
+                            text: join(&text, suffix.as_deref()),
+                            failed: false,
+                        };
+                    }
+                }
+                Decision::Run
+            }
+            (Kind::Mutating, "edit") => {
+                let key = edit_key(args);
+                if let Some(round) = self.edits.get(&key).copied() {
+                    let path = crate::tools::display_path(&self.wd, &str_arg(args, "path"));
+                    let (old, new) = (str_arg(args, "old_text"), str_arg(args, "new_text"));
+                    if std::fs::read_to_string(path)
+                        .is_ok_and(|d| !d.contains(old.as_str()) && d.contains(new.as_str()))
+                    {
+                        let text = format!(
+                            "This edit was already applied in round {round}; the file already contains new_text."
+                        );
+                        let suffix = self.bump(1);
+                        return Decision::Answer {
+                            text: join(&text, suffix.as_deref()),
+                            failed: false,
+                        };
+                    }
+                }
+                Decision::Run
+            }
+            (Kind::Cacheable | Kind::Investigative, _) => {
+                // This call would bring the streak to limit + 8 or more.
+                if self.streak + 1 >= self.cfg.investigate_limit + 8 {
+                    self.blocked += 1;
+                    info!(
+                        streak = self.streak,
+                        blocked = self.blocked,
+                        tool = name,
+                        "Investigation limit reached; refusing a read-only call"
+                    );
+                    return Decision::Answer {
+                        text: format!(
+                            "Not run: investigation limit for this turn reached ({} calls without a change). Make the change now or give your final answer.",
+                            self.streak
+                        ),
+                        failed: true,
+                    };
+                }
+                if kind == Kind::Cacheable {
+                    let key = call_key(&self.wd, name, args);
+                    if let Some(c) = self.cache.get_mut(&key) {
+                        c.count += 1;
+                        let c = c.clone();
+                        let text = duplicate_text(&c, self.round);
+                        info!(tool = name, count = c.count, original_round = c.round, "Duplicate tool call answered from cache");
+                        let suffix = self.bump(2);
+                        return Decision::Answer {
+                            text: join(&text, suffix.as_deref()),
+                            failed: c.failed,
+                        };
+                    }
+                }
+                Decision::Run
+            }
+            _ => Decision::Run,
+        }
+    }
+
+    /// Bookkeeping after a call ran. Returns text to append to the tool
+    /// result (hint and / or nudge).
+    pub fn after(&mut self, name: &str, args: &Value, outcome: &ToolOutcome) -> Option<String> {
+        if !self.enabled() {
+            return None;
+        }
+        match classify(name, args) {
+            Kind::Mutating => {
+                if !outcome.failed {
+                    self.on_change();
+                    match name {
+                        "write_file" => {
+                            self.writes.insert(
+                                str_arg(args, "path"),
+                                (self.round, str_arg(args, "content")),
+                            );
+                        }
+                        "edit" => {
+                            self.edits.insert(edit_key(args), self.round);
+                        }
+                        _ => {}
+                    }
+                }
+                None
+            }
+            Kind::Neutral => None,
+            kind => {
+                if kind == Kind::Cacheable {
+                    self.cache.insert(
+                        call_key(&self.wd, name, args),
+                        Cached {
+                            round: self.round,
+                            output: outcome.output.clone(),
+                            failed: outcome.failed,
+                            count: 1,
+                        },
+                    );
+                }
+                self.record_finding(name, args, outcome);
+                let mut parts: Vec<String> = Vec::new();
+                let mut delta = 1;
+                if name == "search_code" && !outcome.failed {
+                    if let Some(hint) = self.sdk_hint(&str_arg(args, "pattern"), &outcome.output) {
+                        parts.push(hint);
+                        delta += 1;
+                    }
+                }
+                if let Some(nudge) = self.bump(delta) {
+                    parts.push(nudge);
+                }
+                (!parts.is_empty()).then(|| parts.join("\n"))
+            }
+        }
+    }
+
+    /// A successful change (also a passing verify build): the streak and
+    /// the thresholds restart, cached results are stale.
+    pub fn on_change(&mut self) {
+        self.streak = 0;
+        self.nudged = false;
+        self.user_nudged = false;
+        self.blocked = 0;
+        self.cache.clear();
+    }
+
+    /// Add `delta` to the streak; returns the nudge text when the first
+    /// threshold is crossed (and queues the user message at the second).
+    fn bump(&mut self, delta: u32) -> Option<String> {
+        let n = self.cfg.investigate_limit;
+        self.streak += delta;
+        if !self.user_nudged && self.streak >= n + 4 {
+            self.user_nudged = true;
+            self.nudged = true;
+            info!(streak = self.streak, "Investigation streak: adding a user message");
+            self.pending_user_nudge = Some(
+                "Stop investigating now. Your next reply must be an edit or write_file call with your best fix, or your final answer."
+                    .to_string(),
+            );
+        }
+        if !self.nudged && self.streak >= n {
+            self.nudged = true;
+            info!(streak = self.streak, "Investigation streak: nudging");
+            let verify = if self.cfg.verify_enabled {
+                " -- the build check will verify it and show you any errors"
+            } else {
+                ""
+            };
+            return Some(format!(
+                "[acp-bridge] {} read/search calls without changing anything. Stop investigating. If the task needs a code change, make the most likely fix now with edit{verify}. If it is a question, answer it now.",
+                self.streak
+            ));
+        }
+        None
+    }
+
+    fn record_finding(&mut self, name: &str, args: &Value, outcome: &ToolOutcome) {
+        let finding = match name {
+            "read_file" => format!("read {}", str_arg(args, "path")),
+            "search_code" => {
+                let pattern = str_arg(args, "pattern");
+                if outcome.output.starts_with("No matches") || outcome.failed {
+                    format!("search \"{pattern}\": no matches")
+                } else {
+                    let hits: Vec<&str> = outcome.output.lines().filter(|l| l.contains(':')).collect();
+                    let first: Vec<String> = hits
+                        .iter()
+                        .take(2)
+                        .map(|l| {
+                            let mut it = l.splitn(3, ':');
+                            format!("{}:{}", it.next().unwrap_or(""), it.next().unwrap_or(""))
+                        })
+                        .collect();
+                    format!("search \"{pattern}\": {} matches ({})", hits.len(), first.join(", "))
+                }
+            }
+            "list_dir" => format!("listed {}", str_arg(args, "path")),
+            other => crate::tools::tool_title(other, args),
+        };
+        if self.findings.len() < 40 {
+            self.findings.push(finding);
+        }
+    }
+
+    /// The SDK-symbol hint for a `search_code` call, once per symbol.
+    fn sdk_hint(&mut self, pattern: &str, output: &str) -> Option<String> {
+        let (symbol, is_type) = search_symbol(pattern)?;
+        // A capped result may hide the declaration: no hint then.
+        if output.contains("... truncated") {
+            return None;
+        }
+        // "No matches found for '<pattern>'" echoes the pattern.
+        let output = if output.starts_with("No matches found") { "" } else { output };
+        if is_type {
+            if declares_type(output, &symbol) || !self.hinted.insert(symbol.clone()) {
+                return None;
+            }
+            let module = sdk_module(&symbol);
+            let what = match module {
+                Some(m) if self.imports.is_empty() || self.imports.iter().any(|i| i == m) => {
+                    format!("it is an Apple SDK type ({m})")
+                }
+                Some(m) => format!("it is probably an Apple SDK type ({m})"),
+                None => "it probably comes from an Apple SDK or a package".to_string(),
+            };
+            let member = self.error_names.first().cloned();
+            let query = match &member {
+                Some(m) => format!("{symbol} {m}"),
+                None => symbol.clone(),
+            };
+            info!(symbol = %symbol, "SDK-symbol hint");
+            Some(format!(
+                "[acp-bridge] {symbol} is not declared in this project -- {what}, so searching the project will not show its API. {}",
+                self.lookup_advice(&symbol, &query)
+            ))
+        } else {
+            if !self.error_names.iter().any(|n| n == &symbol)
+                || declares_member(output, &symbol)
+                || !self.hinted.insert(symbol.clone())
+            {
+                return None;
+            }
+            let owner = receiver_type(&self.wd, output, &symbol);
+            let of = owner
+                .as_deref()
+                .map(|t| match sdk_module(t) {
+                    Some(m) => format!(" ({t}, {m})"),
+                    None => format!(" ({t})"),
+                })
+                .unwrap_or_default();
+            let query = match &owner {
+                Some(t) => format!("{t} {symbol}"),
+                None => symbol.clone(),
+            };
+            let subject = owner.clone().unwrap_or_else(|| "that type".to_string());
+            info!(member = %symbol, owner = ?owner, "SDK-member hint");
+            Some(format!(
+                "[acp-bridge] '{symbol}' from the compiler error is not declared in this project -- it is a member of an Apple SDK type{of}, so searching the project will not show its API. {}",
+                self.lookup_advice(&subject, &query)
+            ))
+        }
+    }
+
+    fn lookup_advice(&self, subject: &str, query: &str) -> String {
+        if self.tools.docs_search {
+            format!("Look it up with docs_search (query: \"{query}\"), then make the change.")
+        } else if self.tools.web_search {
+            format!(
+                "Search the web for the public API name only, e.g. web_search \"{query}\" (never paste code), then make the change."
+            )
+        } else {
+            format!("Use your knowledge of {subject}'s API and make the most likely fix.")
+        }
+    }
+}
+
+fn join(text: &str, suffix: Option<&str>) -> String {
+    match suffix {
+        Some(s) => format!("{text}\n{s}"),
+        None => text.to_string(),
+    }
+}
+
+fn str_arg(args: &Value, key: &str) -> String {
+    args.get(key).and_then(Value::as_str).unwrap_or("").to_string()
+}
+
+fn edit_key(args: &Value) -> String {
+    format!(
+        "{}\u{0}{}\u{0}{}",
+        str_arg(args, "path"),
+        str_arg(args, "old_text"),
+        str_arg(args, "new_text")
+    )
+}
+
+fn duplicate_text(c: &Cached, round: usize) -> String {
+    let preview = |s: &str| -> String {
+        let cut: String = s.chars().take(POINTER_PREVIEW_CHARS).collect();
+        if cut.len() < s.len() {
+            format!("{cut}…")
+        } else {
+            cut
+        }
+    };
+    if c.count >= 3 {
+        return format!(
+            "[Duplicate: you have now made this exact call {} times; nothing changed since round {}. Stop repeating it: use the result or make the change.]\n{}",
+            c.count,
+            c.round,
+            preview(&c.output)
+        );
+    }
+    if round.saturating_sub(c.round) <= RECENT_ROUNDS {
+        format!(
+            "[Duplicate: identical to your call in round {}; nothing changed since. The result is above. Don't repeat calls -- use it or make the change.]\n{}",
+            c.round,
+            preview(&c.output)
+        )
+    } else {
+        format!(
+            "[Duplicate of your call in round {}; nothing changed since. Same result again:]\n{}",
+            c.round, c.output
+        )
+    }
+}
+
+/// Classify a call for the guard.
+fn classify(name: &str, args: &Value) -> Kind {
+    match name {
+        "write_file" | "edit" | "git_commit" => Kind::Mutating,
+        "read_file" | "list_dir" | "search_code" | "git_status" | "git_diff" | "git_log"
+        | "docs_search" | "web_search" => Kind::Cacheable,
+        "bash" => {
+            if is_read_only_bash(&str_arg(args, "command")) {
+                Kind::Cacheable
+            } else {
+                Kind::Mutating
+            }
+        }
+        "notes" => Kind::Neutral,
+        // Builds are handled by the engine (on_change / on_build_failed).
+        "build" => Kind::Neutral,
+        _ => Kind::Investigative,
+    }
+}
+
+/// Commands that only read, when nothing redirects or chains them.
+const READ_ONLY_COMMANDS: &[&str] = &[
+    "ls", "cat", "head", "tail", "wc", "grep", "rg", "egrep", "fgrep", "find", "file", "stat", "pwd",
+    "which", "tree", "du", "sort", "uniq", "cut", "nl",
+];
+
+/// True for a shell command that cannot change anything: every pipeline
+/// stage starts with a read-only command, and there is no redirect,
+/// sequencing or substitution.
+pub fn is_read_only_bash(command: &str) -> bool {
+    let c = command.trim();
+    if c.is_empty()
+        || [">", ";", "&&", "||", "$(", "`", "&", "\n"]
+            .iter()
+            .any(|t| c.contains(t))
+    {
+        return false;
+    }
+    c.split('|').all(|stage| {
+        let words: Vec<&str> = stage.split_whitespace().collect();
+        let Some(first) = words.first() else {
+            return false;
+        };
+        if words.iter().any(|w| {
+            matches!(*w, "-exec" | "-execdir" | "-delete" | "-ok" | "-okdir" | "-fprint" | "-fprint0" | "-fprintf" | "-fls")
+        }) {
+            return false;
+        }
+        let args = &words[1..];
+        // A short option cluster (`-rno`) containing `letter`.
+        let short_has = |letter: char| {
+            args.iter().any(|a| a.starts_with('-') && !a.starts_with("--") && a[1..].contains(letter))
+        };
+        let long_has = |prefix: &str| args.iter().any(|a| a.starts_with(prefix));
+        match *first {
+            "git" => match words.get(1) {
+                Some(&("status" | "log" | "diff" | "show")) => !long_has("--output"),
+                // Listing only: no names, no -d / -D / -m / -c / -u.
+                Some(&"branch") => args[1..].iter().all(|a| {
+                    matches!(
+                        *a,
+                        "--list" | "-l" | "-a" | "--all" | "-r" | "--remotes" | "-v" | "-vv" | "--verbose" | "--show-current" | "--no-color"
+                    )
+                }),
+                _ => false,
+            },
+            "xcodebuild" => words.contains(&"-list"),
+            // `sort -o FILE` / `tree -o FILE` write; `sort --compress-program`
+            // and `rg --pre` run programs; `uniq IN OUT` writes OUT.
+            "sort" => !short_has('o') && !long_has("--output") && !long_has("--compress-program"),
+            "tree" => !short_has('o'),
+            "rg" => !long_has("--pre"),
+            "uniq" => args.iter().filter(|a| !a.starts_with('-')).count() <= 1,
+            w => READ_ONLY_COMMANDS.contains(&w),
+        }
+    })
+}
+
+/// Canonical cache key: tool name + arguments with sorted keys, trimmed
+/// strings, absolute paths, and an empty / match-all glob dropped.
+pub fn call_key(wd: &Path, name: &str, args: &Value) -> String {
+    let mut map = Map::new();
+    if let Some(obj) = args.as_object() {
+        for (k, v) in obj {
+            let v = match v {
+                Value::String(s) => {
+                    let t = s.trim();
+                    if k == "path" {
+                        Value::String(crate::tools::display_path(wd, t).to_string_lossy().into_owned())
+                    } else if k == "file_glob" && matches!(t, "" | "*" | "**" | "**/*" | "*.*") {
+                        continue;
+                    } else {
+                        Value::String(t.to_string())
+                    }
+                }
+                other => other.clone(),
+            };
+            map.insert(k.clone(), v);
+        }
+    }
+    if matches!(name, "list_dir") && !map.contains_key("path") {
+        map.insert(
+            "path".into(),
+            Value::String(crate::tools::display_path(wd, ".").to_string_lossy().into_owned()),
+        );
+    }
+    format!("{name} {}", Value::Object(map))
+}
+
+fn is_ident_char(c: char) -> bool {
+    c.is_ascii_alphanumeric() || c == '_'
+}
+
+fn is_ident(s: &str) -> bool {
+    let mut chars = s.chars();
+    chars
+        .next()
+        .is_some_and(|c| c.is_ascii_alphabetic() || c == '_')
+        && chars.all(is_ident_char)
+}
+
+/// The symbol a search pattern looks for: `(name, is_type)`.
+/// `class SKView` / `SKView` -> type; `scene` -> member candidate.
+fn search_symbol(pattern: &str) -> Option<(String, bool)> {
+    let words: Vec<&str> = pattern.split_whitespace().collect();
+    let (kw, ident) = match words.as_slice() {
+        [one] => (None, *one),
+        [kw, ident] => (Some(*kw), *ident),
+        _ => return None,
+    };
+    if !is_ident(ident) {
+        return None;
+    }
+    if let Some(kw) = kw {
+        if !matches!(
+            kw,
+            "class" | "struct" | "enum" | "protocol" | "actor" | "typealias" | "extension" | "func" | "var" | "let"
+        ) {
+            return None;
+        }
+    }
+    let first = ident.chars().next()?;
+    let upper_camel = first.is_ascii_uppercase() && ident.chars().any(|c| c.is_ascii_lowercase());
+    if upper_camel {
+        Some((ident.to_string(), true))
+    } else if first.is_ascii_lowercase() {
+        Some((ident.to_string(), false))
+    } else {
+        None
+    }
+}
+
+/// Occurrences of `keyword name` in `text` where `name` is a whole word.
+fn has_decl(text: &str, keyword: &str, name: &str) -> bool {
+    let needle = format!("{keyword} {name}");
+    let mut from = 0;
+    while let Some(pos) = text[from..].find(&needle) {
+        let start = from + pos;
+        let end = start + needle.len();
+        let before_ok = text[..start]
+            .chars()
+            .next_back()
+            .is_none_or(|c| !is_ident_char(c));
+        let after_ok = text[end..].chars().next().is_none_or(|c| !is_ident_char(c));
+        if before_ok && after_ok {
+            return true;
+        }
+        from = end;
+    }
+    false
+}
+
+fn declares_type(text: &str, name: &str) -> bool {
+    ["class", "struct", "enum", "protocol", "actor", "typealias"]
+        .iter()
+        .any(|k| has_decl(text, k, name))
+}
+
+fn declares_member(text: &str, name: &str) -> bool {
+    ["var", "let", "func", "case"].iter().any(|k| has_decl(text, k, name))
+}
+
+/// Identifiers quoted in compiler-error lines of the prompt:
+/// `error: Cannot assign to property: 'scene' is a get-only property`
+/// gives `scene`.
+pub fn error_names(text: &str) -> Vec<String> {
+    let mut out: Vec<String> = Vec::new();
+    for line in text.lines().filter(|l| l.to_ascii_lowercase().contains("error:")) {
+        for q in ['\'', '`', '"'] {
+            let parts: Vec<&str> = line.split(q).collect();
+            for (i, part) in parts.iter().enumerate() {
+                if i % 2 == 1 && i + 1 < parts.len() && is_ident(part) && !out.iter().any(|o| o == part) {
+                    out.push(part.to_string());
+                }
+            }
+        }
+    }
+    out
+}
+
+/// Apple framework for a type name, from its prefix.
+pub fn sdk_module(name: &str) -> Option<&'static str> {
+    const PREFIXES: &[(&str, &str)] = &[
+        ("SCN", "SceneKit"),
+        ("MTK", "MetalKit"),
+        ("MTL", "Metal"),
+        ("SK", "SpriteKit"),
+        ("UI", "UIKit"),
+        ("NS", "Foundation"),
+        ("CG", "CoreGraphics"),
+        ("CA", "QuartzCore"),
+        ("GK", "GameplayKit"),
+        ("AV", "AVFoundation"),
+        ("MK", "MapKit"),
+        ("CL", "CoreLocation"),
+        ("AR", "ARKit"),
+        ("WK", "WebKit"),
+        ("UN", "UserNotifications"),
+        ("CK", "CloudKit"),
+        ("PH", "Photos"),
+        ("CI", "CoreImage"),
+        ("CM", "CoreMotion"),
+        ("VN", "Vision"),
+        ("ML", "CoreML"),
+        ("HK", "HealthKit"),
+        ("RK", "RealityKit"),
+        ("GC", "GameController"),
+    ];
+    for (prefix, module) in PREFIXES {
+        if let Some(rest) = name.strip_prefix(prefix) {
+            if rest.chars().next().is_some_and(|c| c.is_ascii_uppercase()) {
+                return Some(module);
+            }
+        }
+    }
+    const SWIFTUI: &[&str] = &[
+        "View", "Text", "Image", "Color", "Scene", "App", "Button", "VStack", "HStack", "ZStack",
+        "List", "NavigationStack", "GeometryReader", "Binding", "State", "Environment",
+        "UIViewRepresentable", "SpriteView", "SceneView",
+    ];
+    const FOUNDATION: &[&str] = &["URL", "Data", "Date", "UUID", "Timer", "JSONDecoder", "JSONEncoder"];
+    if SWIFTUI.contains(&name) {
+        return Some("SwiftUI");
+    }
+    if FOUNDATION.contains(&name) {
+        return Some("Foundation");
+    }
+    None
+}
+
+/// The declared type of the receiver of `.member` in a search result, read
+/// from the file the match is in: `skView.scene` + `let skView =
+/// SKView(frame: .zero)` gives `SKView`.
+fn receiver_type(wd: &Path, output: &str, member: &str) -> Option<String> {
+    let suffix = format!(".{member}");
+    for line in output.lines() {
+        let mut it = line.splitn(3, ':');
+        let (Some(path), Some(_), Some(code)) = (it.next(), it.next(), it.next()) else {
+            continue;
+        };
+        let Some(pos) = code.find(&suffix) else {
+            continue;
+        };
+        let recv: String = code[..pos]
+            .chars()
+            .rev()
+            .take_while(|c| is_ident_char(*c))
+            .collect::<Vec<_>>()
+            .into_iter()
+            .rev()
+            .collect();
+        if recv.is_empty() {
+            continue;
+        }
+        let file = wd.join(path);
+        let Ok(meta) = std::fs::metadata(&file) else {
+            continue;
+        };
+        if meta.len() > 256 * 1024 {
+            continue;
+        }
+        let Ok(text) = std::fs::read_to_string(&file) else {
+            continue;
+        };
+        for kw in ["let", "var"] {
+            for sep in [" = ", ": "] {
+                let needle = format!("{kw} {recv}{sep}");
+                if let Some(p) = text.find(&needle) {
+                    let ty: String = text[p + needle.len()..]
+                        .chars()
+                        .take_while(|c| is_ident_char(*c))
+                        .collect();
+                    if ty.chars().next().is_some_and(|c| c.is_ascii_uppercase()) {
+                        return Some(ty);
+                    }
+                }
+            }
+        }
+    }
+    None
+}
+
+/// Modules imported by the project's Swift / Objective-C sources (bounded
+/// walk: at most 2000 files of at most 256 KB, build and hidden folders
+/// skipped).
+pub fn project_imports(wd: &Path) -> Vec<String> {
+    let mut out: Vec<String> = Vec::new();
+    let mut budget = 2000usize;
+    walk_sources(wd, 0, &mut budget, &mut |text| {
+        for line in text.lines() {
+            let l = line.trim_start();
+            let l = l.strip_prefix("@testable ").unwrap_or(l);
+            let l = l
+                .strip_prefix("@import ")
+                .or_else(|| l.strip_prefix("import "));
+            let Some(rest) = l else { continue };
+            let mut words = rest.split_whitespace();
+            let mut module = words.next().unwrap_or("");
+            if matches!(module, "struct" | "class" | "enum" | "func" | "protocol" | "typealias" | "var" | "let") {
+                module = words.next().unwrap_or("");
+            }
+            let module: String = module.chars().take_while(|c| is_ident_char(*c)).collect();
+            if !module.is_empty() && !out.contains(&module) {
+                out.push(module);
+            }
+        }
+    });
+    out
+}
+
+fn walk_sources(dir: &Path, depth: usize, budget: &mut usize, f: &mut dyn FnMut(&str)) {
+    if depth > 8 || *budget == 0 {
+        return;
+    }
+    let Ok(rd) = std::fs::read_dir(dir) else { return };
+    let mut entries: Vec<_> = rd.filter_map(|e| e.ok()).collect();
+    entries.sort_by_key(|e| e.file_name());
+    for e in entries {
+        if *budget == 0 {
+            return;
+        }
+        let name = e.file_name().to_string_lossy().into_owned();
+        if name.starts_with('.')
+            || matches!(name.as_str(), "build" | "DerivedData" | "node_modules" | "Pods" | "target" | ".build")
+        {
+            continue;
+        }
+        let Ok(ft) = e.file_type() else { continue };
+        if ft.is_dir() {
+            walk_sources(&e.path(), depth + 1, budget, f);
+        } else if ft.is_file()
+            && [".swift", ".m", ".mm", ".h"].iter().any(|x| name.ends_with(x))
+        {
+            *budget -= 1;
+            if e.metadata().is_ok_and(|m| m.len() <= 256 * 1024) {
+                if let Ok(text) = std::fs::read_to_string(e.path()) {
+                    f(&text);
+                }
+            }
+        }
+    }
+}
