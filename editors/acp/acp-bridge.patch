+/// A reply with a tool call is not discarded even if its reasoning
+/// repeats (the model acted), unless it ran into max_tokens.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn step4_tool_call_after_long_reasoning_is_kept() {
+    let dir = fresh_dir("loop-tool");
+    std::fs::write(dir.join("a.txt"), "x").unwrap();
+    let call = Reply::Message(
