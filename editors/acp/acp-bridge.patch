+/// Requests seen by [`mock_llm_sequence_router`].
+type Recorded = Arc<std::sync::Mutex<Vec<Value>>>;
+
+/// Mock LLM that answers the Nth chat request with `script[N]` (the last
+/// entry repeats) and records every request body.
+fn mock_llm_sequence_router(script: Vec<Value>) -> (Router, Recorded) {
+    let recorded: Recorded = Arc::default();
+    let router = Router::new()
+        .route("/v1/models", get(mock_models))
+        .route("/v1/chat/completions", post(mock_chat_completions_sequence))
+        .route("/api/tags", get(mock_ollama_tags))
+        .with_state((Arc::new(script), Arc::clone(&recorded)));
+    (router, recorded)
+}
+
+async fn mock_chat_completions_sequence(
+    State((script, recorded)): State<(Arc<Vec<Value>>, Recorded)>,
+    req: Request<Body>,
+) -> impl IntoResponse {
+    let body_bytes = axum::body::to_bytes(req.into_body(), 4 * 1024 * 1024)
+        .await
+        .unwrap();
+    let body: Value = serde_json::from_slice(&body_bytes).unwrap();
+    let n = {
+        let mut r = recorded.lock().unwrap();
+        r.push(body);
+        r.len() - 1
+    };
+    let message = script.get(n).or(script.last()).cloned().unwrap();
+    axum::Json(json!({"choices": [{"message": message, "finish_reason": "stop"}]})).into_response()
+}
+
+fn final_answer(text: &str) -> Value {
+    json!({"role": "assistant", "content": text})
+}
