+/// short and run to completion.
+pub fn execute_tool_with_cancel(
+    working_dir: &Path,
+    name: &str,
+    arguments: &Value,
+    cancel: Option<&CancelToken>,
+) -> ToolOutcome {
+    if name == "bash" {
