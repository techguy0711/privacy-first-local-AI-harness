+/// SIGTERM (how Foundation's Process.terminate() stops an agent) shuts down
+/// like Ctrl-C: the running turn is cancelled and answers, the shell
+/// command's process is killed, and the session lock is released. Also
+/// when the signal comes after stdin was closed while a turn still runs.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn fix_sigterm_cancels_turns_and_releases_locks() {
+    for close_stdin_first in [false, true] {
+        let (root, _, project) = persist_layout("sigterm");
+        let config = persist_mcp_config(&root);
+        let log = root.join("mock.jsonl");
+        let pidfile = project.join("sleep.pid");
+        let command = format!("sleep 47 & echo $! > '{}'; wait", pidfile.display());
+        let replies = vec![tool_call("b1", "bash", json!({"command": command})), answer("never")];
+        let (mut b, _) = Bridge::start_with_config(
+            script(replies),
+            &[("LLM_PERSIST", "1"), ("LLM_BASH_TIMEOUT_SECS", "120")],
+            Some(&config),
+        )
+        .await;
+        b.initialize(1);
+        let sid = b.new_session(project.to_str().unwrap(), xcode_server(&[("MOCK_LOG", log.to_str().unwrap())]));
+        let lock = root.join("data/acp-bridge/sessions").join(&sid).join(".lock");
+        let id = b.request("session/prompt", json!({"sessionId": &sid, "prompt": [{"type": "text", "text": "wait"}]}));
+        let deadline = Instant::now() + Duration::from_secs(20);
+        while !std::fs::read_to_string(&pidfile).is_ok_and(|s| !s.trim().is_empty()) {
+            assert!(Instant::now() < deadline, "the shell command never started\n{}", b.stderr());
+            std::thread::sleep(Duration::from_millis(50));
+        }
+        let sleep_pid: u64 = std::fs::read_to_string(&pidfile).unwrap().trim().parse().unwrap();
+        assert!(pid_alive(sleep_pid));
+        assert!(lock.is_file(), "the session is locked while in use");
+        if close_stdin_first {
+            drop(b.child.stdin.take());
+            std::thread::sleep(Duration::from_millis(300));
+            assert!(b.child.try_wait().unwrap().is_none(), "a running turn keeps the process up after EOF");
+        }
+        let started = Instant::now();
+        b.signal("TERM");
+        let (_, r) = b.until_response(id, Duration::from_secs(10));
+        assert_eq!(r["result"]["stopReason"], "cancelled", "{r}");
+        assert!(b.exited_within(Duration::from_secs(10)), "acp-bridge exits after SIGTERM\n{}", b.stderr());
+        assert!(started.elapsed() < Duration::from_secs(8), "{:?}", started.elapsed());
+        assert!(wait_dead(sleep_pid), "the shell command's process is killed (close_stdin_first={close_stdin_first})");
+        assert!(!lock.exists(), "the session lock is released (close_stdin_first={close_stdin_first})");
+        let mcp = mock_starts(&log);
+        assert_eq!(mcp.len(), 1);
+        assert!(wait_dead(mcp[0]), "Xcode's MCP server is stopped");
+        let stderr = b.stderr();
+        assert!(stderr.contains("SIGTERM"), "{stderr}");
+        let _ = std::fs::remove_dir_all(&root);
+    }
+}
