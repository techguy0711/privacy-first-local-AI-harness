+// ---------------------------------------------------------------------------
+// The recorded SKView failure (xcode-debug/old-5, 2026-10-09 17:21): gemma4
+// had to fix `skView.scene = gameScene` (SKView.scene is get-only; the fix is
+// `skView.presentScene(gameScene)`), did not know SpriteKit's API, and spent
+// 21 calls / 16 minutes reading and searching without a single edit.
+// ---------------------------------------------------------------------------
+
+/// The calls the model made, in order.
+pub fn recorded_skview_calls() -> Vec<(&'static str, Value)> {
+    let scene = |glob: Option<&str>| match glob {
+        Some(g) => json!({"pattern": "scene", "file_glob": g}),
+        None => json!({"pattern": "scene"}),
+    };
+    vec![
+        ("read_file", json!({"path": "MyApp/GameView.swift"})),
+        ("read_file", json!({"path": "MyApp/GameScene.swift"})),
+        ("search_code", scene(None)),
+        ("read_file", json!({"path": "MyApp/GameEntities.swift"})),
+        ("search_code", json!({"pattern": "class SKView"})),
+        ("search_code", json!({"pattern": "scene ="})),
+        ("search_code", scene(None)),
+        ("search_code", scene(None)),
+        ("read_file", json!({"path": "MyApp/GameScene.swift"})),
+        ("search_code", scene(None)),
+        ("search_code", json!({"pattern": "SKScene"})),
+        ("search_code", scene(Some("**/*.swift"))),
+        ("search_code", scene(Some("*.swift"))),
+        ("search_code", json!({"pattern": "struct SKView"})),
+        ("search_code", scene(None)),
+        ("search_code", json!({"pattern": "SKView"})),
+        ("search_code", scene(Some("GameEntities.swift"))),
+        ("search_code", scene(Some("ParticleEffect.swift"))),
+        ("search_code", scene(Some("MyApp.swift"))),
+        ("search_code", scene(Some("ContentView.swift"))),
+        ("search_code", scene(Some("GameView.swift"))),
+    ]
+}
+
+/// A copy of tests/fixtures/skview in a fresh "Untitled Project" folder
+/// (the recorded project's name).
+pub fn skview_project(tag: &str) -> PathBuf {
+    let root = fresh_dir(tag).join("Untitled Project");
+    let src = Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/skview");
+    copy_dir(&src, &root);
+    root
+}
+
+pub fn copy_dir(src: &Path, dst: &Path) {
+    std::fs::create_dir_all(dst).unwrap();
+    for e in std::fs::read_dir(src).unwrap() {
+        let e = e.unwrap();
+        let to = dst.join(e.file_name());
+        if e.file_type().unwrap().is_dir() {
+            copy_dir(&e.path(), &to);
+        } else {
+            std::fs::copy(e.path(), &to).unwrap();
+        }
+    }
+}
+
+/// The prompt Xcode sent (its project-structure block and the user line).
+pub fn skview_prompt(project: &Path) -> String {
+    format!(
+        "Project structure (these are Xcode workspace-relative paths and do not correspond to filesystem paths. Use XcodeRead, XcodeWrite, XcodeGrep, and XcodeGlob to interact with these files):\n\
+         Untitled Project/MyApp/ContentView.swift\nUntitled Project/MyApp/GameEntities.swift\n\
+         Untitled Project/MyApp/GameScene.swift\nUntitled Project/MyApp/GameView.swift\n\
+         Untitled Project/MyApp/MyApp.swift\nUntitled Project/MyApp/ParticleEffect.swift\n\n\
+         The user has no file currently open.\n\
+         Fix `{}/MyApp/GameView.swift:44: error: Cannot assign to property: 'scene' is a get-only property`",
+        project.display()
+    )
+}
+
+/// Replay the recorded calls (then a final answer) as the model.
+pub fn skview_replay_script() -> Vec<Reply> {
+    recorded_skview_calls()
+        .into_iter()
+        .enumerate()
+        .map(|(i, (name, args))| tool_call(&format!("r{i}"), name, args))
+        .chain([answer("I'm not sure why 'scene' is get-only.")])
+        .collect()
+}
+
+/// Tool results the model saw, in call order (from the last request).
+pub fn results_in(recorded: &Recorded) -> Vec<String> {
+    let reqs = recorded.lock().unwrap();
+    tool_results(reqs.last().unwrap())
+}
