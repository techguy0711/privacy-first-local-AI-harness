+/// The modules the session's project imports (cached on the session).
+async fn session_imports(state: &AppState, session_id: &str, wd: &Path) -> Vec<String> {
+    if let Some(cached) = state
+        .sessions_read()
+        .get(session_id)
+        .and_then(|s| s.imports.clone())
+    {
+        return cached;
+    }
+    let dir = wd.to_path_buf();
+    let imports = tokio::task::spawn_blocking(move || guards::project_imports(&dir))
+        .await
+        .unwrap_or_default();
+    if let Some(s) = state.sessions_write().get_mut(session_id) {
+        s.imports = Some(imports.clone());
+    }
+    imports
+}
