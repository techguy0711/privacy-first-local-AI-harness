+        assert_eq!(search["pattern"], "SKView");
+        assert_eq!(search["matchCount"], 6, "v{version}: {search}");
+        assert_eq!(search["results"].as_array().unwrap().len(), 6);
+        assert!(search["results"][0].as_str().unwrap().starts_with("MyApp/"), "{search}");
