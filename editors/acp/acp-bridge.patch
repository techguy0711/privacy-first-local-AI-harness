+        assert_eq!(read["filePath"], project.join("MyApp/MyApp.swift").to_str().unwrap());
+        assert_eq!(read["lineCount"], 10);
+        assert!(done[2]["rawOutput"]["items"].as_array().unwrap().iter().any(|i| i == "GameView.swift"));
+        assert_eq!(done[3]["rawOutput"], json!({"command": "echo hi", "output": "hi\n"}));
