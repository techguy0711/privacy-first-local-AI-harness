+// Step 6: working memory (notes)
+// ---------------------------------------------------------------------------
+
+/// After a `notes` call the next request ends with a `<working-notes>`
+/// block in its LAST message (never in the system message); the row is
+/// `Notes: append`, kind other, no locations; a 4th call in a turn is
+/// refused.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn step6_notes_are_shown_at_the_end_of_each_request() {
+    let dir = fresh_dir("notes");
+    std::fs::write(dir.join("a.txt"), "x").unwrap();
+    let replies = vec![
+        tool_call("n1", "notes", json!({"action": "append", "text": "Goal: fix GameView.swift:44 (scene is get-only)"})),
+        tool_call("r1", "read_file", json!({"path": "a.txt"})),
+        tool_call("n2", "notes", json!({"action": "append", "text": "a.txt holds x"})),
+        tool_call("n3", "notes", json!({"action": "read"})),
+        tool_call("n4", "notes", json!({"action": "append", "text": "too many"})),
+        answer("done"),
+    ];
+    let (mut b, recorded) = Bridge::start(script(replies), &[]).await;
+    b.initialize(1);
+    let sid = b.new_session(dir.to_str().unwrap(), json!([]));
+    let (notes, r) = b.prompt(&sid, "remember things");
+    assert_eq!(r["result"]["stopReason"], "end_turn", "{r}");
+    let reqs = recorded.lock().unwrap().clone();
+    assert!(tool_names(&reqs[0]).contains(&"notes".to_string()));
+    // Request 0: no notes yet -> no block.
+    assert!(!reqs[0].to_string().contains("<working-notes>"));
+    let system0 = reqs[0]["messages"][0].clone();
+    for (i, req) in reqs.iter().enumerate() {
+        assert_eq!(req["messages"][0], system0, "system message changed in request {i}");
+    }
+    let last = |i: usize| reqs[i]["messages"].as_array().unwrap().last().unwrap()["content"].as_str().unwrap().to_string();
+    assert!(last(1).ends_with("<working-notes>\nGoal: fix GameView.swift:44 (scene is get-only)\n</working-notes>"), "{}", last(1));
+    assert!(last(2).starts_with("x\n\n<working-notes>"), "block appended to the tool result: {}", last(2));
+    assert!(last(3).contains("Goal: fix GameView.swift:44 (scene is get-only)\na.txt holds x\n</working-notes>"));
+    let results = tool_results(reqs.last().unwrap());
+    assert!(results[3].starts_with("# Notes\nGoal:"), "{}", results[3]);
+    assert!(results[4].starts_with("Not run: notes limit for this turn reached (3 calls)"), "{}", results[4]);
+    // The stored history has no block (only the request copies do).
+    assert!(!results[1].contains("<working-notes>"));
+    let starts = updates(&notes, "tool_call");
+    assert_eq!(starts[0]["title"], "Notes: append");
+    assert_eq!(starts[0]["kind"], "other");
+    assert!(starts[0].get("locations").is_none());
+    // LLM_NOTES=0: no tool, no block.
+    b.shutdown();
+    let (mut b, recorded) = Bridge::start(script(vec![answer("ok")]), &[("LLM_NOTES", "0")]).await;
+    b.initialize(1);
+    let sid = b.new_session(dir.to_str().unwrap(), json!([]));
+    b.prompt(&sid, "hi");
+    assert!(!tool_names(&recorded.lock().unwrap()[0]).contains(&"notes".to_string()));
+    b.shutdown();
+    let _ = std::fs::remove_dir_all(&dir);
+}
