+/// The per-session web search budget is stored with the session: after a
+/// crash and session/resume the count goes on from where it was.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn fix_web_search_budget_survives_a_restart() {
+    let (root, _, project) = persist_layout("ws-budget");
+    let log = root.join("brave.jsonl");
+    let mock = brave_mock(&[("MOCK_LOG", log.to_str().unwrap())]);
+    let config = root.join("editors/acp/config.toml");
+    std::fs::write(
+        &config,
+        format!(
+            "[persist]\nstate_dir = \"../../data/acp-bridge\"\n\n[[mcp.servers]]\nname = \"brave\"\nurl = \"{}\"\nallow = [\"brave_web_search\"]\nrole = \"web_search\"\n",
+            mock.url
+        ),
+    )
+    .unwrap();
+    let env = [("LLM_WEB_SEARCH", "on"), ("LLM_PERSIST", "1"), ("LLM_INVESTIGATE_LIMIT", "0")];
+    let replies = vec![
+        tool_call("w1", "web_search", json!({"query": "SpriteKit SKView presentScene"})),
+        tool_call("w2", "web_search", json!({"query": "swift async let"})),
+        answer("searched twice"),
+    ];
+    let (mut b, _) = Bridge::start_with_config(script(replies), &env, Some(&config)).await;
+    b.initialize(1);
+    let sid = b.new_session(project.to_str().unwrap(), json!([]));
+    let (_, r) = b.prompt(&sid, "look it up");
+    assert_eq!(r["result"]["text"], "searched twice", "{r}");
+    b.kill();
+    let meta_path = root.join("data/acp-bridge/sessions").join(&sid).join("meta.json");
+    let meta: Value = serde_json::from_str(&std::fs::read_to_string(&meta_path).unwrap()).unwrap();
+    assert_eq!(meta["webSearches"], 2, "{meta}");
+
+    let replies = vec![tool_call("w3", "web_search", json!({"query": "SwiftUI sheet dismiss"})), answer("once more")];
+    let (mut b, _) = Bridge::start_with_config(script(replies), &env, Some(&config)).await;
+    b.initialize(1);
+    let (_, r) = b.call("session/resume", json!({"sessionId": &sid, "cwd": project.to_str().unwrap()}));
+    assert_eq!(r["result"], json!({}), "{r}");
+    let (_, r) = b.prompt(&sid, "and one more");
+    assert_eq!(r["result"]["text"], "once more", "{r}");
+    b.shutdown();
+    let meta: Value = serde_json::from_str(&std::fs::read_to_string(&meta_path).unwrap()).unwrap();
+    assert_eq!(meta["webSearches"], 3, "the count continues after the restart: {meta}");
+    assert_eq!(mock_calls(&mock_log(&log)).len(), 3);
+    let _ = std::fs::remove_dir_all(&root);
+}
