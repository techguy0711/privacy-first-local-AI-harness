+    }
+
+    #[test]
+    fn diagnostics_notes() {
+        let r = McpResult {
+            structured: Some(json!({"content": "Untitled Project/MyApp/GameView.swift:45:16: error: Value of type 'SKView' has no member 'scaleMode'\nUntitled Project/MyApp/GameView.swift:50:9: warning: unused", "diagnosticsCount": 2, "success": true})),
+            ..Default::default()
+        };
+        assert_eq!(
+            diagnostics_note("Untitled Project/MyApp/GameView.swift", &r).unwrap(),
+            "[Xcode diagnostics for GameView.swift: 1 error]\nL45: Value of type 'SKView' has no member 'scaleMode'"
+        );
+        let clean = McpResult { structured: Some(json!({"content": "No diagnostics found.", "diagnosticsCount": 0})), ..Default::default() };
+        assert_eq!(diagnostics_note("A.swift", &clean).unwrap(), "[Xcode diagnostics: no errors]");
+        let many = McpResult {
+            text: (1..=9).map(|i| format!("A.swift:{i}:1: error: {}\n", "x".repeat(150))).collect(),
+            ..Default::default()
+        };
+        let note = diagnostics_note("A.swift", &many).unwrap();
+        assert!(note.starts_with("[Xcode diagnostics for A.swift: 9 errors]"));
+        assert!(note.len() <= 600 && note.lines().count() <= 6, "{note}");
+        assert_eq!(diagnostics_note("A.swift", &McpResult { is_error: true, ..Default::default() }), None);
+    }
+
+    #[test]
+    fn diagnostics_warnings_and_summaries_are_not_errors() {
+        let text = |t: &str| McpResult { text: t.to_string(), ..Default::default() };
+        let structured = |content: &str, count: u64| McpResult {
+            structured: Some(json!({"content": content, "diagnosticsCount": count, "filePath": "P/GameView.swift", "success": true})),
+            ..Default::default()
+        };
+        const NONE: &str = "[Xcode diagnostics: no errors]";
+        // The verifier's probes.
+        let warn = "P/MyApp/GameView.swift:12:9: warning: initialization of variable 'errorMessage' was never used";
+        assert_eq!(diagnostics_note("GameView.swift", &structured(warn, 1)).unwrap(), NONE);
+        assert_eq!(diagnostics_note("GameView.swift", &text(warn)).unwrap(), NONE);
+        assert_eq!(diagnostics_note("A.swift", &text("No errors or warnings")).unwrap(), NONE);
+        assert_eq!(diagnostics_note("A.swift", &text("Found 0 errors and 1 warning")).unwrap(), NONE);
+        assert_eq!(diagnostics_note("A.swift", &structured("Found 0 errors and 1 warning", 1)), None, "count says 1 but no line reads as one");
+        // Xcode's own texts (IDERefreshCodeIssuesInFileAction strings).
+        assert_eq!(diagnostics_note("ErrorView.swift", &text("No issues found in 'ErrorView.swift'")).unwrap(), NONE);
+        assert_eq!(diagnostics_note("ErrorView.swift", &structured("No issues found in 'ErrorView.swift'", 0)).unwrap(), NONE);
+        // A warning quoting a variable named `error`, a note, a remark.
+        let mixed = "Current issues in 'GameView.swift':\nP/GameView.swift:3:5: warning: variable 'error' was written to, but never read\nP/GameView.swift:4:1: note: did you mean 'error'?\nP/GameView.swift:45:16: error: value of type 'SKView' has no member 'scaleMode'\nP/GameView.swift:50:2: fatal error: 'Missing.h' file not found";
+        assert_eq!(
+            diagnostics_note("P/GameView.swift", &structured(mixed, 4)).unwrap(),
+            "[Xcode diagnostics for GameView.swift: 2 errors]\nL45: value of type 'SKView' has no member 'scaleMode'\nL50: 'Missing.h' file not found"
+        );
+        // Other plausible layouts.
+        assert_eq!(diagnostics_note("A.swift", &text("[Error] Line 7: cannot find 'x' in scope")).unwrap(), "[Xcode diagnostics for A.swift: 1 error]\nL7: Line 7: cannot find 'x' in scope");
+        assert_eq!(diagnostics_note("A.swift", &text("- Error (line 9): missing return")).unwrap(), "[Xcode diagnostics for A.swift: 1 error]\nL9: (line 9): missing return");
+        assert_eq!(diagnostics_note("A.swift", &text("45:16: error: x")).unwrap(), "[Xcode diagnostics for A.swift: 1 error]\nL45: x");
+        assert_eq!(diagnostics_note("A.swift", &text("10 errors found")), None, "a summary is not an error line");
+        // Not usable.
+        assert_eq!(diagnostics_note("A.swift", &McpResult { structured: Some(json!({"content": "", "diagnosticsCount": 0, "success": false})), ..Default::default() }), None);
+    }
+
+    #[test]
+    fn navigator_paths_need_a_single_suffix_match() {
+        let c = vec!["Untitled Project/MyApp/GameView.swift".to_string(), "Untitled Project/Other/GameView.swift".to_string()];
+        assert_eq!(pick_navigator_path(&c, "MyApp/GameView.swift").as_deref(), Some("Untitled Project/MyApp/GameView.swift"));
+        assert_eq!(pick_navigator_path(&c, "GameView.swift"), None, "ambiguous");
+        assert_eq!(pick_navigator_path(&c, "Missing.swift"), None);
+    }
+}
