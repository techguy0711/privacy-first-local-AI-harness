+/// Start the MCP servers the client passed (`mcpServers` of `session/new`
+/// / `session/resume`) for a session, in the background. Only stdio
+/// servers whose command is in `[mcp] allowed_commands` (and, with
+/// `allow_client_http`, loopback HTTP servers) are used; the first one is
+/// kept (Xcode passes exactly one, `xcode-tools`).
+pub fn attach_mcp_servers(state: &AppState, session_id: &str, servers: &Value) {
+    let Some(list) = servers.as_array().filter(|l| !l.is_empty()) else {
+        return;
+    };
+    let mcp = &state.config.agent.mcp;
+    if !mcp.enabled || !mcp.client_servers {
+        info!(count = list.len(), "Ignoring the client's MCP servers (MCP off)");
+        return;
+    }
+    let cwd = match state.sessions_read().get(session_id) {
+        Some(s) => s.working_dir.clone(),
+        None => return,
+    };
+    // Remembered (in memory only) so a session evicted while idle gets
+    // them back when its next prompt restores it.
+    lock_mcp_specs(&state.mcp_specs).insert(session_id.to_string(), servers.clone());
+    let mut attached = false;
+    for entry in list {
+        let spec = match crate::mcp::parse_acp_server(entry) {
+            Ok(spec) => spec,
+            Err(e) => {
+                warn!(error = %e, "Ignoring an MCP server");
+                continue;
+            }
+        };
+        let allowed = match &spec {
+            crate::mcp::McpSpec::Stdio { command, args, .. } => {
+                let ok = crate::mcp::command_allowed(command, &mcp.allowed_commands);
+                if !ok {
+                    warn!(server = spec.name(), command = %command, "Not starting MCP server: command is not in [mcp] allowed_commands");
+                }
+                let args_ok = crate::mcp::args_allowed(command, args);
+                if let Err(why) = &args_ok {
+                    warn!(server = spec.name(), command = %command, reason = %why, "Not starting MCP server: arguments refused");
+                }
+                ok && args_ok.is_ok()
+            }
+            crate::mcp::McpSpec::Http { url, .. } => {
+                let ok = mcp.allow_client_http && crate::mcp::loopback_url(url).is_ok();
+                if !ok {
+                    warn!(server = spec.name(), url = %url, "Ignoring HTTP MCP server (allow_client_http is off, or not a loopback URL)");
+                }
+                ok
+            }
+        };
+        if !allowed {
+            continue;
+        }
+        let mut sessions = state.sessions_write();
+        let Some(session) = sessions.get_mut(session_id) else { return };
+        if attached {
+            info!(server = spec.name(), "Ignoring an additional MCP server (one per session)");
+            continue;
+        }
+        attached = true;
+        // A resumed session that is still in memory: keep a working
+        // connection to the same server, replace anything else (Xcode
+        // passes a new session id after its own restart).
+        if let Some(old) = &session.xcode {
+            if old.spec == spec && old.healthy() {
+                info!(server = spec.name(), "MCP server already connected for this session");
+                continue;
+            }
+            info!(server = spec.name(), "Replacing the session's MCP server connection");
+        }
+        info!(server = spec.name(), "Connecting to the client's MCP server in the background");
+        let policy = mcp.policy(spec.name());
+        session.xcode = Some(crate::xcode::XcodeConn::start(spec, policy, cwd.clone()));
+    }
+}
