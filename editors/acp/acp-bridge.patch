+        // Add grass, clouds, trees
+        let grass = SKSpriteNode(color: .green, size: CGSize(width: self.size.width, height: self.size.height * 0.3))
+        grass.position = CGPoint(x: self.size.width / 2, y: self.size.height * 0.15)
+        grass.zPosition = -1
+        addChild(grass)
+        
+        // Add some clouds
+        for _ in 0..<5 {
+            let cloud = SKSpriteNode(color: .white, size: CGSize(width: 100, height: 40))
+            cloud.position = CGPoint(x: CGFloat.random(in: 0...self.size.width), y: CGFloat.random(in: self.size.height * 0.6...self.size.height * 0.9))
+            cloud.zPosition = -2
+            addChild(cloud)
+        }
+
+        // Add some trees
+        for _ in 0..<3 {
+            let tree = SKSpriteNode(color: .darkGray, size: CGSize(width: 40, height: 100))
+            tree.position = CGPoint(x: CGFloat.random(in: 0...self.size.width), y: CGFloat.random(in: 0...self.size.height * 0.3))
+            tree.zPosition = -1
+            addChild(tree)
+        }
+    }
+    
+    func spawnBear() {
+        let bear = Bear(position: CGPoint(x: CGFloat.random(in: 50...self.size.width-50), y: self.size.height + 50))
+        addChild(bear)
+        bear.moveDown()
+    }
+    
+    override func update(_ currentTime: TimeInterval) {
+        if lastUpdateTime == 0 {
+            lastUpdateTime = currentTime
+        }
+        
+        let dt = currentTime - lastUpdateTime
+        lastUpdateTime = currentTime
+        
+        bearSpawnTimer += dt
+        if bearSpawnTimer > 2.0 {
+            spawnBear()
+            bearSpawnTimer = 0
+        }
+    }
+    
+    func handleTap(at point: CGPoint, isFolded: Bool) {
+        if isFolded {
+            // Only shoot if tapped in the bottom region (fold region)
+            if point.y < self.size.height * 0.5 {
+                let arrow = Arrow(position: point)
+                addChild(arrow)
+                
+                // Find nearest bear in the top half
+                if let nearestBear = findNearestBear(to: point) {
+                    arrow.shoot(to: nearestBear.position)
+                    
+                    // Check for collision (simplified)
+                    let wait = SKAction.wait(forDuration: 1.0)
+                    arrow.run(wait) { [weak self] in
+                        guard let self = self else { return }
+                        if arrow.parent != nil {
+                            if arrow.frame.intersects(nearestBear.frame) {
+                                let hit = HitEffect(at: nearestBear.position)
+                                self.addChild(hit)
+                                nearestBear.removeFromParent()
+                            }
+                        }
+                    }
+                }
+            }
+        } else {
+            // Fully open: tap anywhere, shoot from bottom
+            let shootPoint = CGPoint(x: point.x, y: self.size.height * 0.2)
+            let arrow = Arrow(position: shootPoint)
+            addChild(arrow)
+            
+            if let nearestBear = findNearestBear(to: point) {
+                arrow.shoot(to: nearestBear.position)
+                
+                let wait = SKAction.wait(forDuration: 1.0)
+                arrow.run(wait) { [weak self] in
+                    guard let self = self else { return }
+                    if arrow.parent != nil {
+                        if arrow.frame.intersects(nearestBear.frame) {
+                            let hit = HitEffect(at: nearestBear.position)
+                            self.addChild(hit)
+                            nearestBear.removeFromParent()
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    private func findNearestBear(to point: CGPoint) -> Bear? {
+        var nearest: Bear?
+        var best = CGFloat.greatestFiniteMagnitude
+        for case let bear as Bear in children {
+            let d = hypot(bear.position.x - point.x, bear.position.y - point.y)
+            if d < best {
+                best = d
+                nearest = bear
+            }
+        }
+        return nearest
+    }
+}
