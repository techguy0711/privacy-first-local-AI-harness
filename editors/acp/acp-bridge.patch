+/// After a successful `write_file` / `edit` of a Swift file: Xcode's live
+/// diagnostics for it (XcodeRefreshCodeIssuesInFile), as a note for the
+/// tool result. `None` when Xcode's tools are not there, the file cannot be
+/// mapped to one navigator path, or the call fails / times out (the edit
+/// itself never fails because of it).
+async fn xcode_diagnostics(turn: &TurnCtx, name: &str, args: &Value, cancel: &CancelToken) -> Option<String> {
+    if !matches!(name, "write_file" | "edit") {
+        return None;
+    }
+    let rel = args.get("path").and_then(Value::as_str)?;
+    if !rel.ends_with(".swift") {
+        return None;
+    }
+    let (conn, client) = turn.xcode.clone()?;
+    conn.usable(&client, "XcodeRefreshCodeIssuesInFile")?;
+    conn.usable(&client, "XcodeGlob")?;
+    let nav = conn.navigator_path(&client, rel, cancel).await?;
+    let started = std::time::Instant::now();
+    let r = conn
+        .call(
+            &client,
+            "XcodeRefreshCodeIssuesInFile",
+            json!({"filePath": nav}),
+            crate::xcode::diagnostics_timeout(),
+            Some(cancel),
+            None,
+        )
+        .await;
+    match r {
+        Ok(r) => {
+            let note = crate::xcode::diagnostics_note(&nav, &r);
+            info!(file = %nav, ms = started.elapsed().as_millis() as u64, note = note.as_deref().unwrap_or(""), "Xcode diagnostics");
+            note
+        }
+        Err(e) => {
+            warn!(file = %nav, error = %e, "Xcode diagnostics failed");
+            None
+        }
+    }
+}
