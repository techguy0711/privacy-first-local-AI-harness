+/// Under a tiny context the oldest rounds are dropped: each dropped round
+/// is summarized exactly once into the notes ("Dropped context"), the
+/// request ends with the dropped-context line, and the system message
+/// stays byte-identical in every request.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn step6_dropped_rounds_are_summarized_once() {
+    let dir = fresh_dir("drops");
+    for i in 0..8 {
+        std::fs::write(dir.join(format!("f{i}.txt")), format!("{i}").repeat(3000)).unwrap();
+    }
+    let mut replies: Vec<Reply> = (0..8)
+        .map(|i| tool_call(&format!("c{i}"), "read_file", json!({"path": format!("f{i}.txt")})))
+        .collect();
+    replies.push(answer("read them all"));
+    let (mut b, recorded) = Bridge::start(
+        script(replies),
+        &[("LLM_MODEL_CONTEXT", "6000"), ("LLM_RESERVE_OUTPUT_TOKENS", "1000"), ("LLM_INVESTIGATE_LIMIT", "0")],
+    )
+    .await;
+    b.initialize(1);
+    let sid = b.new_session(dir.to_str().unwrap(), json!([]));
+    let (_, r) = b.prompt(&sid, "read the eight files");
+    assert_eq!(r["result"]["stopReason"], "end_turn", "{r}");
+    let reqs = recorded.lock().unwrap().clone();
+    let system0 = reqs[0]["messages"][0].clone();
+    assert!(reqs.iter().all(|q| q["messages"][0] == system0), "system message must not change");
+    let last_req = reqs.last().unwrap()["messages"].as_array().unwrap().last().unwrap()["content"]
+        .as_str()
+        .unwrap()
+        .to_string();
+    let shown: String = last_req.chars().rev().take(1500).collect::<Vec<_>>().into_iter().rev().collect();
+    assert!(last_req.contains("Older rounds were removed to fit the context window"), "{shown}");
+    let log = b.shutdown();
+    let bullets: Vec<&str> = log
+        .lines()
+        .filter(|l| l.contains("Summarized dropped rounds"))
+        .collect();
+    assert!(!bullets.is_empty(), "no drops? {log}");
+    // Each file shows up in at most one summary: no re-summarizing per round.
+    for i in 0..8 {
+        let n = bullets.iter().filter(|l| l.contains(&format!("f{i}.txt"))).count();
+        assert!(n <= 1, "f{i}.txt summarized {n} times:\n{}", bullets.join("\n"));
+    }
+    assert!(bullets.iter().any(|l| l.contains("read f0.txt")), "{}", bullets.join("\n"));
+    assert!(last_req.contains("Dropped context:"), "{shown}");
+    let _ = std::fs::remove_dir_all(&dir);
+}
