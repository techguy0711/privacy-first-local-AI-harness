+//! Verify build — the harness side of the build-and-fix loop.
+//!
+//! When the model finishes a turn in which a file-changing tool succeeded,
+//! the engine builds the project in the session's working directory and,
+//! if the build fails, hands the errors back to the model. This module
+//! holds the configuration, the per-ecosystem build command detection, the
+//! build runner and the error extraction.
+
+use crate::process::{self, CancelToken};
+use serde::Deserialize;
+use serde_json::Value;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::time::Duration;
+use tracing::{debug, info, warn};
+
+/// Default number of verify builds per turn.
+pub const DEFAULT_MAX_ATTEMPTS: usize = 3;
+/// Default build timeout in seconds.
+pub const DEFAULT_TIMEOUT_SECS: u64 = 300;
+/// Timeout for the `xcodebuild -list` / `-showBuildSettings` queries.
+const XCODE_QUERY_TIMEOUT: Duration = Duration::from_secs(120);
+/// Error report limits (lines / characters).
+const MAX_ERROR_LINES: usize = 40;
+const MAX_ERROR_CHARS: usize = 4000;
+
+/// Which build runs after a turn that changed files.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum VerifyMode {
+    /// Detect the build command from the working directory.
+    Auto,
+    /// Never build.
+    Off,
+    /// Run this shell command (`bash -c`) in the working directory.
+    Command(String),
+}
+
+impl VerifyMode {
+    /// `auto` (or empty) / `off` / anything else is a shell command.
+    pub fn parse(value: &str) -> Self {
+        let v = value.trim();
+        match v.to_ascii_lowercase().as_str() {
+            "" | "auto" => VerifyMode::Auto,
+            "off" | "none" | "false" | "0" | "no" | "disabled" => VerifyMode::Off,
+            _ => VerifyMode::Command(v.to_string()),
+        }
+    }
+}
+
+/// `[verify]` table of the config file.
+#[derive(Debug, Deserialize, Default, Clone)]
+pub struct VerifySection {
+    /// `"auto"` (default), `"off"`, or a shell command.
+    pub command: Option<String>,
+    /// Builds per turn (default 3).
+    pub max_attempts: Option<usize>,
+    /// Build timeout in seconds (default 300).
+    pub timeout_secs: Option<u64>,
+}
+
+/// Resolved verify settings.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct VerifyConfig {
+    pub mode: VerifyMode,
+    /// Maximum verify builds per turn (>= 1).
+    pub max_attempts: usize,
+    pub timeout_secs: u64,
+}
+
+impl Default for VerifyConfig {
+    fn default() -> Self {
+        Self {
+            mode: VerifyMode::Auto,
+            max_attempts: DEFAULT_MAX_ATTEMPTS,
+            timeout_secs: DEFAULT_TIMEOUT_SECS,
+        }
+    }
+}
+
+impl VerifyConfig {
+    /// Config file values overridden by `LLM_VERIFY`,
+    /// `LLM_VERIFY_MAX_ATTEMPTS` and `LLM_VERIFY_TIMEOUT_SECS`.
+    pub fn resolve(file: &VerifySection) -> Self {
+        let mode = std::env::var("LLM_VERIFY")
+            .ok()
+            .or_else(|| file.command.clone())
+            .map(|v| VerifyMode::parse(&v))
+            .unwrap_or(VerifyMode::Auto);
+        let max_attempts = std::env::var("LLM_VERIFY_MAX_ATTEMPTS")
+            .ok()
+            .and_then(|v| v.trim().parse::<usize>().ok())
+            .or(file.max_attempts)
+            .filter(|&n| n > 0)
+            .unwrap_or(DEFAULT_MAX_ATTEMPTS);
+        let timeout_secs = std::env::var("LLM_VERIFY_TIMEOUT_SECS")
+            .ok()
+            .and_then(|v| v.trim().parse::<u64>().ok())
+            .or(file.timeout_secs)
+            .filter(|&n| n > 0)
+            .unwrap_or(DEFAULT_TIMEOUT_SECS);
+        Self {
+            mode,
+            max_attempts,
+            timeout_secs,
+        }
+    }
+
+    /// Environment variables only (no config file).
+    pub fn from_env() -> Self {
+        Self::resolve(&VerifySection::default())
+    }
+}
+
+/// A concrete build command for one working directory.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct VerifyPlan {
+    /// Shell command, run with `bash -c` in the working directory.
+    pub command: String,
+    /// Short form for the client-facing title (`Build: <label>`).
+    pub label: String,
+    /// Extra environment for the command.
+    pub env: Vec<(String, String)>,
+}
+
+impl VerifyPlan {
+    fn new(command: impl Into<String>, label: impl Into<String>) -> Self {
+        Self {
+            command: command.into(),
+            label: label.into(),
+            env: Vec::new(),
+        }
+    }
+
+    /// Plan for an explicit `LLM_VERIFY` command.
+    pub fn custom(command: &str) -> Self {
+        Self::new(command, command)
+    }
+}
+
+/// Single-quote `s` for bash.
+fn quote(s: &str) -> String {
+    if !s.is_empty()
+        && s
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || "-_./=:@%+,".contains(c))
+    {
+        s.to_string()
+    } else {
+        format!("'{}'", s.replace('\'', "'\\''"))
+    }
+}
+
+/// Stable 64-bit FNV-1a hash (independent of the Rust version).
+fn fnv1a(text: &str) -> u64 {
+    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+    for b in text.as_bytes() {
+        h ^= u64::from(*b);
+        h = h.wrapping_mul(0x0100_0000_01b3);
+    }
+    h
+}
+
+/// `~/Library/Caches/acp-bridge/DerivedData/<name>-<hash of cwd>`: outside
+/// the project, stable per working directory.
+pub fn derived_data_dir(cwd: &Path) -> PathBuf {
+    let base = std::env::var_os("HOME")
+        .filter(|h| !h.is_empty())
+        .map(|h| PathBuf::from(h).join("Library/Caches/acp-bridge/DerivedData"))
+        .unwrap_or_else(|| std::env::temp_dir().join("acp-bridge-DerivedData"));
+    let name: String = cwd
+        .file_name()
+        .and_then(|n| n.to_str())
+        .unwrap_or("project")
+        .chars()
+        .map(|c| if c.is_ascii_alphanumeric() { c } else { '_' })
+        .collect();
+    base.join(format!("{name}-{:016x}", fnv1a(&cwd.to_string_lossy())))
+}
+
+/// Sorted names of the entries directly inside `dir`.
+fn dir_names(dir: &Path) -> Vec<String> {
+    let mut names: Vec<String> = std::fs::read_dir(dir)
+        .map(|rd| {
+            rd.filter_map(|e| e.ok())
+                .map(|e| e.file_name().to_string_lossy().into_owned())
+                .collect()
+        })
+        .unwrap_or_default();
+    names.sort();
+    names
+}
+
+/// Detect the build command for `cwd` (first match wins):
+/// Xcode workspace / project, Package.swift, Cargo.toml, gradlew,
+/// package.json / tsconfig.json, go.mod. `None` = nothing to build.
+pub fn detect(cwd: &Path) -> Option<VerifyPlan> {
+    detect_with_cancel(cwd, None)
+}
+
+/// [`detect`] whose `xcodebuild` queries stop when `cancel` fires.
+pub fn detect_with_cancel(cwd: &Path, cancel: Option<&CancelToken>) -> Option<VerifyPlan> {
+    let names = dir_names(cwd);
+    let has = |n: &str| names.iter().any(|x| x == n);
+
+    let xcode = names
+        .iter()
+        .find(|n| n.ends_with(".xcworkspace"))
+        .map(|n| ("-workspace", n.as_str()))
+        .or_else(|| {
+            names
+                .iter()
+                .find(|n| n.ends_with(".xcodeproj"))
+                .map(|n| ("-project", n.as_str()))
+        });
+    if let Some((flag, container)) = xcode {
+        return detect_xcode(cwd, flag, container, cancel);
+    }
+    if has("Package.swift") {
+        return Some(VerifyPlan::new(
+            "swift build --disable-automatic-resolution",
+            "swift build",
+        ));
+    }
+    if has("Cargo.toml") {
+        return Some(VerifyPlan::new(
+            "cargo check --offline --message-format short",
+            "cargo check --offline",
+        ));
+    }
+    if has("gradlew") {
+        let task = if is_android(cwd) {
+            "compileDebugSources"
+        } else {
+            "classes"
+        };
+        let cmd = format!("./gradlew --offline {task}");
+        return Some(VerifyPlan::new(cmd.clone(), cmd));
+    }
+    if has("package.json") || has("tsconfig.json") {
+        let has_build_script = std::fs::read_to_string(cwd.join("package.json"))
+            .ok()
+            .and_then(|s| serde_json::from_str::<Value>(&s).ok())
+            .is_some_and(|p| p["scripts"]["build"].is_string());
+        if has_build_script {
+            return Some(VerifyPlan::new(
+                "npm run build --if-present",
+                "npm run build",
+            ));
+        }
+        if has("tsconfig.json") {
+            return Some(VerifyPlan::new(
+                "npx --no-install tsc --noEmit",
+                "tsc --noEmit",
+            ));
+        }
+        // No build script and no TypeScript: nothing would be checked.
+        return None;
+    }
+    if has("go.mod") {
+        let mut plan = VerifyPlan::new("go build ./...", "go build ./...");
+        plan.env = vec![
+            ("GOFLAGS".into(), "-mod=mod".into()),
+            ("GOPROXY".into(), "off".into()),
+        ];
+        return Some(plan);
+    }
+    None
+}
