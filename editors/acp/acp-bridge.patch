+/// MCP client errors.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum McpError {
+    Timeout,
+    Cancelled,
+    /// The server went away.
+    Closed(String),
+    /// JSON-RPC error response.
+    Rpc { code: i64, message: String },
+    Protocol(String),
+    Transport(String),
+    /// Refused before connecting (allowlist, loopback).
+    Policy(String),
+}
+
+impl std::fmt::Display for McpError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            McpError::Timeout => write!(f, "timed out"),
+            McpError::Cancelled => write!(f, "cancelled"),
+            McpError::Closed(why) => write!(f, "server closed: {why}"),
+            McpError::Rpc { code, message } => write!(f, "{message} ({code})"),
+            McpError::Protocol(m) => write!(f, "protocol error: {m}"),
+            McpError::Transport(m) => write!(f, "{m}"),
+            McpError::Policy(m) => write!(f, "{m}"),
+        }
+    }
