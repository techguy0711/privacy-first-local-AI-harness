+/// How a verify build ended.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum BuildStatus {
+    Passed,
+    /// Non-zero exit: the errors are for the model to fix.
+    Failed,
+    TimedOut,
+    Cancelled,
+    /// The command could not be started or was not found (exit 127):
+    /// not something the model can fix.
+    CouldNotRun,
+    /// Xcode's BuildProject reports the build was cancelled by a user
+    /// interaction in Xcode: stop and ask the user.
+    StoppedInXcode,
+}
+
+/// The Xcode workspace or project directly in `cwd` (workspace first).
+pub fn xcode_container(cwd: &Path) -> Option<String> {
+    let names = dir_names(cwd);
+    names
+        .iter()
+        .find(|n| n.ends_with(".xcworkspace"))
+        .or_else(|| names.iter().find(|n| n.ends_with(".xcodeproj")))
+        .cloned()
+}
+
+/// `text` with absolute paths under `cwd` made relative (all spellings of
+/// the cwd, incl. macOS's /private prefix).
+pub fn relativize(text: &str, cwd: &Path) -> String {
+    let mut l = text.trim().to_string();
+    for p in cwd_prefixes(cwd) {
+        l = l.replace(&format!("file://{p}/"), "");
+        l = l.replace(&format!("{p}/"), "");
+    }
+    l
+}
+
+/// Concise error report from Xcode's BuildProject `errors` (`[{filePath,
+/// lineNumber, message, type}]`): errors only, `path:line: error: message`,
+/// at most 15 lines.
+pub fn xcode_build_errors(errors: &[Value], cwd: &Path) -> String {
+    let lines: Vec<String> = errors
+        .iter()
+        .filter(|e| {
+            e.get("type")
+                .and_then(Value::as_str)
+                .is_none_or(|t| t.eq_ignore_ascii_case("error"))
+        })
+        .map(|e| {
+            let path = e.get("filePath").and_then(Value::as_str).unwrap_or("");
+            let msg = e.get("message").and_then(Value::as_str).unwrap_or("").trim();
+            let line = match e.get("lineNumber") {
+                Some(Value::Number(n)) => format!(":{n}"),
+                _ => String::new(),
+            };
+            if path.is_empty() {
+                format!("error: {msg}")
+            } else {
+                format!("{}{line}: error: {msg}", relativize(path, cwd))
+            }
+        })
+        .collect();
+    let mut seen = std::collections::HashSet::new();
+    let lines: Vec<String> = lines.into_iter().filter(|l| seen.insert(l.clone())).collect();
+    let mut out: Vec<String> = lines.iter().take(15).cloned().collect();
+    if lines.len() > 15 {
+        out.push(format!("... and {} more", lines.len() - 15));
+    }
+    out.join("\n")
+}
