+/// Android Gradle project (vs. plain JVM).
+fn is_android(cwd: &Path) -> bool {
+    let manifests = ["app/src/main/AndroidManifest.xml", "src/main/AndroidManifest.xml"];
+    if manifests.iter().any(|m| cwd.join(m).is_file()) {
+        return true;
+    }
+    [
+        "build.gradle",
+        "build.gradle.kts",
+        "app/build.gradle",
+        "app/build.gradle.kts",
+        "settings.gradle",
+        "settings.gradle.kts",
+    ]
+    .iter()
+    .filter_map(|f| std::fs::read_to_string(cwd.join(f)).ok())
+    .any(|text| text.contains("com.android"))
+}
+
+/// Run an `xcodebuild` query and parse its JSON output.
+fn xcode_query(cwd: &Path, args: &[&str], cancel: Option<&CancelToken>) -> Option<Value> {
+    let mut cmd = Command::new("xcodebuild");
+    cmd.args(args).current_dir(cwd);
+    let out = match process::run_command(cmd, XCODE_QUERY_TIMEOUT, cancel) {
+        Ok(out) => out,
+        Err(e) => {
+            warn!(error = %e, "xcodebuild query could not run");
+            return None;
+        }
+    };
+    if !out.success() {
+        warn!(args = ?args, code = ?out.code(), stderr = %out.stderr.trim(), "xcodebuild query failed");
+        return None;
+    }
+    // Some versions print log lines before the JSON document.
+    let text = out.stdout.as_str();
+    let start = text.find(['{', '['])?;
+    serde_json::from_str(&text[start..]).ok()
+}
+
+/// Pick a scheme from `xcodebuild -list -json` output: the one named like
+/// the container, else one named like a target, else the first.
+pub fn pick_scheme(list: &Value, container_stem: &str) -> Option<String> {
+    let info = list.get("workspace").or_else(|| list.get("project"))?;
+    let schemes: Vec<&str> = info["schemes"]
+        .as_array()?
+        .iter()
+        .filter_map(Value::as_str)
+        .collect();
+    let targets: Vec<&str> = info["targets"]
+        .as_array()
+        .map(|t| t.iter().filter_map(Value::as_str).collect())
+        .unwrap_or_default();
+    schemes
+        .iter()
+        .find(|s| **s == container_stem)
+        .or_else(|| schemes.iter().find(|s| targets.contains(s)))
+        .or_else(|| schemes.first())
+        .map(|s| s.to_string())
+}
+
+/// `-destination` for a target's `SUPPORTED_PLATFORMS` / `SDKROOT`
+/// (`xcodebuild -showBuildSettings -json`). Multiplatform targets prefer
+/// iOS, then macOS. Simulator destinations need no signing or device.
+pub fn destination_for(supported_platforms: &str, sdkroot: &str) -> Option<&'static str> {
+    const IOS: &str = "generic/platform=iOS Simulator";
+    const MACOS: &str = "platform=macOS";
+    const VISIONOS: &str = "generic/platform=visionOS Simulator";
+    const TVOS: &str = "generic/platform=tvOS Simulator";
+    const WATCHOS: &str = "generic/platform=watchOS Simulator";
+    let platforms: Vec<String> = supported_platforms
+        .split_whitespace()
+        .map(str::to_ascii_lowercase)
+        .collect();
+    let has = |names: &[&str]| platforms.iter().any(|p| names.contains(&p.as_str()));
+    if has(&["iphoneos", "iphonesimulator"]) {
+        return Some(IOS);
+    }
+    if has(&["macosx"]) {
+        return Some(MACOS);
+    }
+    if has(&["xros", "xrsimulator"]) {
+        return Some(VISIONOS);
+    }
+    if has(&["appletvos", "appletvsimulator"]) {
+        return Some(TVOS);
+    }
+    if has(&["watchos", "watchsimulator"]) {
+        return Some(WATCHOS);
+    }
+    // SDKROOT is a name (`iphoneos`) or a resolved SDK path.
+    let sdk = sdkroot
+        .rsplit('/')
+        .next()
+        .unwrap_or(sdkroot)
+        .to_ascii_lowercase();
+    if sdk.starts_with("iphone") {
+        Some(IOS)
+    } else if sdk.starts_with("macosx") {
+        Some(MACOS)
+    } else if sdk.starts_with("xr") {
+        Some(VISIONOS)
+    } else if sdk.starts_with("appletv") {
+        Some(TVOS)
+    } else if sdk.starts_with("watch") {
+        Some(WATCHOS)
+    } else {
+        None
+    }
+}
