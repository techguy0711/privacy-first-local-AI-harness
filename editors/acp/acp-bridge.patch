+// ---------------------------------------------------------------------------
+// Step 9: guarded web search through the local Brave server (mocked)
+// ---------------------------------------------------------------------------
+
+pub struct HttpMock {
+    child: Child,
+    pub url: String,
+}
+
+impl Drop for HttpMock {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+/// The mock MCP server in HTTP mode (plays Brave 2.1.4 on 127.0.0.1).
+pub fn brave_mock(env: &[(&str, &str)]) -> HttpMock {
+    let mut cmd = Command::new(mock_bin());
+    cmd.args(["--http", "0"]).stdout(Stdio::piped()).stderr(Stdio::null());
+    for (k, v) in env {
+        cmd.env(k, v);
+    }
+    let mut child = cmd.spawn().unwrap();
+    let mut line = String::new();
+    BufReader::new(child.stdout.take().unwrap()).read_line(&mut line).unwrap();
+    let port = line.trim().strip_prefix("LISTENING ").expect("port line").to_string();
+    HttpMock { child, url: format!("http://127.0.0.1:{port}/mcp") }
+}
+
+fn brave_config(dir: &Path, url: &str) -> PathBuf {
+    let path = dir.join("brave.toml");
+    std::fs::write(
+        &path,
+        format!("[[mcp.servers]]\nname = \"brave\"\nurl = \"{url}\"\nallow = [\"brave_web_search\"]\nrole = \"web_search\"\ncall_timeout_secs = 20\n"),
+    )
+    .unwrap();
+    path
+}
+
+/// Allowed queries reach the server with exactly the fixed arguments;
+/// queries with file names, code or project names never do; a repeated
+/// query is answered from the cache; at most 3 searches go out per turn;
+/// a server restart (404) is survived by re-initializing.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn step9_web_search_guard_budget_and_fixed_args() {
+    let project = skview_project("web");
+    std::fs::create_dir_all(project.join("MyGame.xcodeproj")).unwrap();
+    std::fs::write(project.join("MyGame.xcodeproj/project.pbxproj"), "PRODUCT_BUNDLE_IDENTIFIER = com.acme.mygame;\n").unwrap();
+    let dir = project.parent().unwrap().to_path_buf();
+    let log = dir.join("brave.jsonl");
