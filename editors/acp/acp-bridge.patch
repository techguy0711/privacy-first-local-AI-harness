+    fn sse_events_survive_any_chunking() {
+        let stream = "event: message\ndata: {\"jsonrpc\":\"2.0\",\"id\":1,\ndata: \"result\":{}}\n\n: comment\r\ndata: {\"id\":2}\r\n\r\ndata: tail";
+        let whole = {
