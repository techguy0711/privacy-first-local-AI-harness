+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn step8a_cancel_reaches_the_mcp_server() {
+    let project = skview_project("xt-cancel");
+    let dir = project.parent().unwrap().to_path_buf();
+    let log = dir.join("mock.jsonl");
+    let config = mcp_config(&dir, "[mcp.tools.\"xcode-tools\"]\nallow = [\"DocumentationSearch\", \"Sleep\"]\nexpose = [\"DocumentationSearch\", \"Sleep\"]\n");
+    let replies = vec![tool_call("s1", "mcp__xcode-tools__Sleep", json!({"ms": 20000})), answer("never")];
+    let (mut b, _) = Bridge::start_with_config(script(replies), &[], Some(&config)).await;
+    b.initialize(1);
+    let sid = b.new_session(project.to_str().unwrap(), xcode_server(&[("MOCK_LOG", log.to_str().unwrap())]));
+    let id = b.request("session/prompt", json!({"sessionId": &sid, "prompt": [{"type": "text", "text": "sleep"}]}));
+    b.wait_for(Duration::from_secs(20), |m| m["params"]["update"]["sessionUpdate"] == "tool_call");
+    std::thread::sleep(Duration::from_millis(200));
+    let started = Instant::now();
+    b.send(&json!({"jsonrpc": "2.0", "method": "session/cancel", "params": {"sessionId": &sid}}));
+    let (_, r) = b.until_response(id, Duration::from_secs(10));
+    assert!(started.elapsed() < Duration::from_secs(1), "cancel took {:?}", started.elapsed());
+    assert_eq!(r["result"]["stopReason"], "cancelled", "{r}");
+    std::thread::sleep(Duration::from_millis(300));
+    let lines = mock_log(&log);
+    let cancels: Vec<&Value> = lines.iter().filter(|l| l["msg"]["method"] == "notifications/cancelled").collect();
+    assert_eq!(cancels.len(), 1, "{lines:#?}");
+    b.shutdown();
+}
