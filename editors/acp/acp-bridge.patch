+    )
+    .await;
+    h.send(&json!({"jsonrpc":"2.0","id":1,"method":"session/new","params":{"cwd":&cwd}}));
+    let sid = h.read_line()["result"]["sessionId"].as_str().unwrap().to_string();
+    h.send(&json!({
+        "jsonrpc":"2.0","id":2,"method":"session/prompt",
+        "params":{"sessionId":&sid,"prompt":[{"type":"text","text":"run the slow thing"}]}
+    }));
+    // Wait for the bash call to start, then cancel.
+    loop {
+        let msg = h.read_message();
+        if msg["params"]["update"]["sessionUpdate"] == "tool_call" {
+            assert_eq!(msg["params"]["update"]["toolCallId"], "call_slow");
+            break;
+        }
+    }
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    let cancelled_at = std::time::Instant::now();
+    h.send(&cancel_notification(&sid));
+    let (notifications, response) = h.read_until_response(2);
+    assert!(cancelled_at.elapsed() < Duration::from_secs(5), "took {:?}", cancelled_at.elapsed());
+    assert_eq!(response["result"]["stopReason"], "cancelled");
+    let done = updates_of(&notifications, "tool_call_update");
+    assert_eq!(done.len(), 1, "{done:?}");
+    assert_eq!(done[0]["toolCallId"], "call_slow");
+    assert_eq!(done[0]["status"], "failed");
+    let text = done[0]["content"][0]["content"]["text"].as_str().unwrap();
+    assert!(text.contains("started") && text.contains("cancelled"), "{text}");
+    assert!(updates_of(&notifications, "tool_call").is_empty(), "second call never started");
+
+    std::thread::sleep(Duration::from_secs(1));
+    assert!(!marker.exists(), "the killed command must not continue");
+    assert!(!project.join("next").exists(), "the next call must not run");
+
+    // Next turn: every tool call in the history has a result.
+    h.send(&json!({
+        "jsonrpc":"2.0","id":3,"method":"session/prompt",
+        "params":{"sessionId":&sid,"prompt":[{"type":"text","text":"status?"}]}
+    }));
+    let (_n, response) = h.read_until_response(3);
+    assert_eq!(response["result"]["stopReason"], "end_turn");
+    let requests = recorded.lock().unwrap().clone();
+    let msgs = requests.last().unwrap()["messages"].as_array().unwrap().clone();
+    let results: Vec<&str> = msgs
+        .iter()
+        .filter(|m| m["role"] == "tool")
+        .filter_map(|m| m["tool_call_id"].as_str())
+        .collect();
+    assert_eq!(results, ["call_slow", "call_next"]);
+    h.shutdown();
+    let _ = std::fs::remove_dir_all(&project);
+}
