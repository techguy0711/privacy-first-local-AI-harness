+        }
+        "read_file" if !outcome.failed => Some(json!({
+            "filePath": display_path(working_dir, arg("path")).to_string_lossy(),
+            "content": cap(&outcome.output, 16 * 1024),
+            "lineCount": outcome.output.lines().count(),
+        })),
+        "list_dir" if !outcome.failed => Some(json!({
+            "path": display_path(working_dir, if arg("path").is_empty() { "." } else { arg("path") }).to_string_lossy(),
+            "items": outcome.output.lines().filter(|l| !l.trim().is_empty()).take(200).map(|l| l.trim_end().to_string()).collect::<Vec<_>>(),
+        })),
+        "bash" | "git_status" | "git_diff" | "git_log" | "git_commit" => Some(json!({
+            "command": command_line(name, arguments).unwrap_or_default(),
+            "output": cap(&outcome.output, 8 * 1024),
+        })),
+        _ => None,
+    }
