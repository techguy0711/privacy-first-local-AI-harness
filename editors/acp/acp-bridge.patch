+import SpriteKit
+
+class Arrow: SKSpriteNode {
+    init(position: CGPoint) {
+        let texture = SKTexture(imageNamed: "arrow") // I'll use a placeholder color if texture is missing
+        super.init(texture: texture, color: .white, size: CGSize(width: 20, height: 60))
+        self.position = position
+        self.zPosition = 10
+        self.name = "arrow"
+    }
+    
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+    
+    func shoot(to target: CGPoint) {
+        let dx = target.x - position.x
+        let dy = target.y - position.y
+        let angle = atan2(dy, dx)
+        
+        let moveAction = SKAction.move(by: CGVector(dx: dx, dy: dy), duration: 1.0)
+        moveAction.timingMode = .linear
+        
+        self.run(moveAction) {
+            self.removeFromParent()
+        }
+    }
+}
+
+class Bear: SKSpriteNode {
+    init(position: CGPoint) {
+        let texture = SKTexture(imageNamed: "bear")
+        super.init(texture: texture, color: .brown, size: CGSize(width: 50, height: 50))
+        self.position = position
+        self.zPosition = 5
+        self.name = "bear"
+    }
+    
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+    
+    func moveDown() {
+        let moveAction = SKAction.moveBy(x: 0, y: -500, duration: 4.0)
+        moveAction.timingMode = .easeIn
+        self.run(moveAction) {
+            self.removeFromParent()
+        }
+    }
+}
