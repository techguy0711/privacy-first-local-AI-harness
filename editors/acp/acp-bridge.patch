+//! Working memory: the `notes` tool, the `<working-notes>` block appended
+//! to every request, and automatic summaries of rounds the context budget
+//! dropped.
+//!
+//! Notes have two parts so the model's `replace` can never wipe the
+//! automatic one:
+//!
+//! ```text
+//! # Notes
+//! <model-maintained text, at most 2,000 characters>
+//! ## Dropped context (auto)
+//! - r7: read GameView.swift; search "scene" (4 hits: GameView.swift:44, …); …
+//! ```
+//!
+//! The block is appended to the LAST message of each request copy, never
+//! to the system prompt: the system turn stays byte-identical, so Ollama's
+//! cached prompt prefix stays valid.
+
+use serde_json::{json, Value};
+
+/// Maximum size of the model's part.
+pub const MODEL_CAP: usize = 2_000;
+/// Maximum size of the automatic part (oldest bullets collapse first).
+pub const AUTO_CAP: usize = 2_000;
+/// Maximum size of one `append`.
+const APPEND_MAX: usize = 400;
+/// `notes` calls allowed per turn.
+pub const PER_TURN_LIMIT: usize = 3;
+/// Characters of each part shown in the per-request block.
+const BLOCK_MODEL_CHARS: usize = 1_000;
+const BLOCK_AUTO_CHARS: usize = 600;
+/// Maximum size of one dropped-rounds summary bullet.
+const BULLET_MAX: usize = 600;
+/// Line in the block when rounds were dropped.
+pub const DROPPED_LINE: &str = "Older rounds were removed to fit the context window; their summary is under \"Dropped context\".";
+/// Headroom (characters) the engine reserves for the block in the context
+/// budget on top of its current size.
+pub const BLOCK_HEADROOM_CHARS: usize = 800;
+
+/// A session's working notes.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct Notes {
+    /// Written by the model with the `notes` tool.
+    pub model: String,
+    /// Summaries of dropped rounds, oldest first.
+    pub auto: Vec<String>,
+    /// Older auto bullets dropped to stay within [`AUTO_CAP`].
+    pub auto_omitted: usize,
+}
+
+fn cut(text: &str, max: usize) -> String {
+    if text.chars().count() <= max {
+        return text.to_string();
+    }
+    let mut s: String = text.chars().take(max.saturating_sub(1)).collect();
+    s.push('…');
+    s
+}
+
+/// The last `max` characters of `text`.
+fn tail_chars(text: &str, max: usize) -> String {
+    let n = text.chars().count();
+    if n <= max {
+        text.to_string()
+    } else {
+        format!("…{}", text.chars().skip(n - max + 1).collect::<String>())
+    }
+}
+
+impl Notes {
+    pub fn is_empty(&self) -> bool {
+        self.model.trim().is_empty() && self.auto.is_empty()
+    }
+
+    /// Run a `notes` tool call. `Ok` = result text, `Err` = failed call.
+    pub fn apply(&mut self, action: &str, text: &str) -> Result<String, String> {
+        match action {
+            "read" => Ok(if self.is_empty() {
+                "(no notes yet)".to_string()
+            } else {
+                self.render()
+            }),
+            "append" => {
+                let line = cut(text.trim(), APPEND_MAX);
+                if line.is_empty() {
+                    return Err("Error: text is empty".into());
+                }
+                let new_len = self.model.chars().count() + line.chars().count() + 1;
+                if new_len > MODEL_CAP {
+                    return Err(format!(
+                        "Error: notes are full ({MODEL_CAP} characters). Call notes with action \"replace\" and a condensed version."
+                    ));
+                }
+                if !self.model.is_empty() && !self.model.ends_with('\n') {
+                    self.model.push('\n');
+                }
+                self.model.push_str(&line);
+                Ok(format!("Noted ({} of {MODEL_CAP} characters used).", self.model.chars().count()))
+            }
+            "replace" => {
+                let t = text.trim();
+                let truncated = t.chars().count() > MODEL_CAP;
+                self.model = cut(t, MODEL_CAP);
+                Ok(if truncated {
+                    format!("Notes replaced, cut to {MODEL_CAP} characters.")
+                } else {
+                    format!("Notes replaced ({} characters).", self.model.chars().count())
+                })
+            }
+            other => Err(format!(
+                "Error: unknown action '{other}' (use read, append or replace)"
+            )),
+        }
+    }
+
+    /// Add one automatic summary bullet, collapsing the oldest ones past
+    /// [`AUTO_CAP`].
+    pub fn add_auto(&mut self, bullet: &str) {
+        self.auto.push(cut(bullet.trim(), BULLET_MAX));
+        while self.auto.len() > 1 && self.auto.iter().map(|b| b.chars().count() + 3).sum::<usize>() > AUTO_CAP {
+            self.auto.remove(0);
+            self.auto_omitted += 1;
+        }
+    }
+
+    /// The whole notes as Markdown (NOTES.md, and `notes read`).
+    pub fn render(&self) -> String {
+        let mut out = String::from("# Notes\n");
+        if !self.model.trim().is_empty() {
+            out.push_str(self.model.trim_end());
+            out.push('\n');
+        }
+        if !self.auto.is_empty() || self.auto_omitted > 0 {
+            out.push_str("## Dropped context (auto)\n");
+            if self.auto_omitted > 0 {
+                out.push_str(&format!("- ({} older summaries omitted)\n", self.auto_omitted));
+            }
+            for b in &self.auto {
+                out.push_str(&format!("- {b}\n"));
+            }
+        }
+        out
+    }
+
+    /// Parse [`render`](Self::render) output (NOTES.md on disk).
+    pub fn parse(text: &str) -> Self {
+        let mut notes = Notes::default();
+        let body = text.strip_prefix("# Notes\n").unwrap_or(text);
+        let (model, auto) = match body.split_once("## Dropped context (auto)\n") {
+            Some((m, a)) => (m, a),
+            None => (body, ""),
+        };
+        notes.model = cut(model.trim_end(), MODEL_CAP);
+        for line in auto.lines() {
+            let Some(b) = line.strip_prefix("- ") else { continue };
+            if let Some(n) = b
+                .strip_prefix('(')
+                .and_then(|r| r.strip_suffix(" older summaries omitted)"))
+                .and_then(|n| n.parse::<usize>().ok())
+            {
+                notes.auto_omitted = n;
+            } else {
+                notes.auto.push(b.to_string());
+            }
+        }
+        notes
+    }
+
+    /// The `<working-notes>` block for one request, if there is anything
+    /// to show (`dropped`: rounds were removed from this request).
+    pub fn block(&self, dropped: bool) -> Option<String> {
+        if self.is_empty() && !dropped {
+            return None;
+        }
+        let mut out = String::from("\n\n<working-notes>\n");
+        if !self.model.trim().is_empty() {
+            out.push_str(&cut(self.model.trim(), BLOCK_MODEL_CHARS));
+            out.push('\n');
+        }
+        if dropped {
+            out.push_str(DROPPED_LINE);
+            out.push('\n');
+        }
+        if !self.auto.is_empty() {
+            let auto: String = self.auto.iter().map(|b| format!("- {b}\n")).collect();
+            out.push_str("Dropped context:\n");
+            out.push_str(&tail_chars(&auto, BLOCK_AUTO_CHARS));
+            if !out.ends_with('\n') {
+                out.push('\n');
+            }
+        }
+        out.push_str("</working-notes>");
+        Some(out)
+    }
+}
+
+/// The `notes` tool definition (kept short: it costs prompt tokens).
+pub fn tool_definition() -> Value {
+    json!({
+        "type": "function",
+        "function": {
+            "name": "notes",
+            "description": "Your working memory for this conversation, shown to you every round. Keep the goal, key facts (file:line), decisions and open errors. Use rarely.",
+            "parameters": {
+                "type": "object",
+                "properties": {
+                    "action": {"type": "string", "enum": ["read", "append", "replace"]},
+                    "text": {"type": "string", "description": "For append/replace"}
+                },
+                "required": ["action"]
+            }
+        }
+    })
+}
+
+/// Append `block` to the text of the last message (string content, or a
+/// new text part for array content).
+pub fn append_to_last(messages: &mut [Value], block: &str) {
+    let Some(last) = messages.last_mut() else { return };
+    match last.get_mut("content") {
+        Some(Value::String(s)) => s.push_str(block),
+        Some(Value::Array(parts)) => parts.push(json!({"type": "text", "text": block.trim_start()})),
+        _ => last["content"] = Value::String(block.trim_start().to_string()),
+    }
+}
+
+fn role(m: &Value) -> &str {
+    m.get("role").and_then(Value::as_str).unwrap_or("")
+}
+
+fn call_args(call: &Value) -> Value {
+    match call["function"].get("arguments") {
+        Some(Value::String(s)) => serde_json::from_str(s).unwrap_or(Value::Null),
+        Some(v) => v.clone(),
+        None => Value::Null,
+    }
+}
+
+fn text_of(m: &Value) -> String {
+    match m.get("content") {
+        Some(Value::String(s)) => s.clone(),
+        Some(Value::Array(parts)) => parts
+            .iter()
+            .filter_map(|p| p.get("text").and_then(Value::as_str))
+            .collect::<Vec<_>>()
+            .join("\n"),
+        _ => String::new(),
+    }
+}
+
+fn file_name(path: &str) -> &str {
+    path.rsplit('/').next().unwrap_or(path)
+}
+
+/// One summary bullet for the messages at `indices` (sorted) of
+/// `messages`, built from the tool calls without an LLM call. `None` when
+/// there is nothing worth keeping.
+pub fn summarize(messages: &[Value], indices: &[usize], label: &str, build_failed_prefix: &str) -> Option<String> {
+    let mut reads: Vec<String> = Vec::new();
+    let mut parts: Vec<String> = Vec::new();
+    let mut k = 0;
+    while k < indices.len() {
+        let i = indices[k];
+        let m = &messages[i];
+        match role(m) {
+            "assistant" => {
+                let calls = m.get("tool_calls").and_then(Value::as_array).cloned().unwrap_or_default();
+                if calls.is_empty() {
+                    let t = text_of(m);
+                    let first = t.split(['.', '\n']).map(str::trim).find(|s| !s.is_empty()).unwrap_or("");
+                    if !first.is_empty() {
+                        parts.push(format!("said: {}", cut(first, 150)));
+                    }
+                }
+                for (n, call) in calls.iter().enumerate() {
+                    let result = indices
+                        .get(k + 1 + n)
+                        .map(|&j| &messages[j])
+                        .filter(|r| role(r) == "tool")
+                        .map(text_of)
+                        .unwrap_or_default();
+                    let failed = result.starts_with("Error") || result.starts_with("Not run");
+                    let args = call_args(call);
+                    let a = |key: &str| args.get(key).and_then(Value::as_str).unwrap_or("").to_string();
+                    let name = call["function"]["name"].as_str().unwrap_or("");
+                    match name {
+                        "read_file" => {
+                            let p = file_name(&a("path")).to_string();
+                            if !reads.contains(&p) {
+                                reads.push(p);
+                            }
+                        }
+                        "search_code" => {
+                            if result.starts_with("No matches") || result.is_empty() {
+                                parts.push(format!("search \"{}\" (no matches)", a("pattern")));
+                            } else {
+                                let hits: Vec<&str> = result.lines().filter(|l| l.contains(':')).collect();
+                                let first: Vec<String> = hits
+                                    .iter()
+                                    .take(2)
+                                    .map(|l| {
+                                        let mut it = l.splitn(3, ':');
+                                        format!("{}:{}", file_name(it.next().unwrap_or("")), it.next().unwrap_or(""))
+                                    })
+                                    .collect();
+                                parts.push(format!("search \"{}\" ({} hits: {})", a("pattern"), hits.len(), first.join(", ")));
+                            }
+                        }
+                        "write_file" | "edit" => parts.push(format!(
+                            "{} {} {}",
+                            if name == "edit" { "edit" } else { "write" },
+                            a("path"),
+                            if failed { "FAILED" } else { "OK" }
+                        )),
+                        "bash" => parts.push(format!(
+                            "ran `{}`{}",
+                            cut(&a("command"), 60),
+                            if failed { " (failed)" } else { "" }
+                        )),
+                        "notes" => {}
+                        other => parts.push(if failed { format!("{other} (failed)") } else { other.to_string() }),
+                    }
+                }
+                k += 1 + calls.len();
+                continue;
+            }
+            "user" => {
+                let t = text_of(m);
+                if let Some(rest) = t.strip_prefix(build_failed_prefix) {
+                    let first = rest.lines().map(str::trim).find(|l| !l.is_empty()).unwrap_or("");
+                    parts.push(format!("build FAILED: {}", cut(first, 140)));
+                }
+            }
+            _ => {}
+        }
+        k += 1;
+    }
+    if !reads.is_empty() {
+        parts.insert(0, format!("read {}", reads.join(", ")));
+    }
+    if parts.is_empty() {
+        return None;
+    }
+    Some(cut(&format!("{label}: {}", parts.join("; ")), BULLET_MAX))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn append_replace_read_and_caps() {
+        let mut n = Notes::default();
+        assert_eq!(n.apply("read", "").unwrap(), "(no notes yet)");
+        assert!(n.apply("append", "Goal: fix GameView.swift:44").unwrap().starts_with("Noted"));
+        n.apply("append", "SKView.scene is get-only").unwrap();
+        assert_eq!(n.model, "Goal: fix GameView.swift:44\nSKView.scene is get-only");
+        assert!(n.apply("append", "  ").is_err());
+        // One append is capped at 400 characters.
+        n.apply("replace", "").unwrap();
+        n.apply("append", &"x".repeat(1000)).unwrap();
+        assert_eq!(n.model.chars().count(), 400);
+        // The model part is capped at 2000: appends fail, replace cuts.
+        n.apply("append", &"y".repeat(400)).unwrap();
+        n.apply("append", &"y".repeat(400)).unwrap();
+        n.apply("append", &"y".repeat(400)).unwrap();
+        n.apply("append", &"y".repeat(390)).unwrap();
+        let err = n.apply("append", "one more").unwrap_err();
+        assert!(err.contains("notes are full"), "{err}");
+        assert!(n.apply("replace", &"z".repeat(3000)).unwrap().contains("cut to 2000"));
+        assert_eq!(n.model.chars().count(), MODEL_CAP);
+        assert!(n.apply("delete", "").is_err());
+        // replace never touches the automatic part.
+        n.add_auto("r1: read A.swift");
+        n.apply("replace", "short").unwrap();
+        assert_eq!(n.auto, vec!["r1: read A.swift".to_string()]);
+        assert!(n.apply("read", "").unwrap().contains("## Dropped context (auto)\n- r1: read A.swift"));
+    }
+
+    #[test]
+    fn auto_part_collapses_oldest_and_round_trips() {
+        let mut n = Notes::default();
+        for i in 0..20 {
+            n.add_auto(&format!("r{i}: {}", "w".repeat(200)));
+        }
+        assert!(n.auto_omitted > 0);
+        assert!(n.auto.last().unwrap().starts_with("r19"));
+        assert!(n.auto.iter().map(|b| b.len() + 3).sum::<usize>() <= AUTO_CAP);
+        n.model = "goal line".into();
+        let md = n.render();
+        assert!(md.contains("older summaries omitted"));
+        assert_eq!(Notes::parse(&md), n);
+        assert_eq!(Notes::parse(""), Notes::default());
+    }
+
+    #[test]
+    fn block_shows_both_parts_and_the_dropped_line() {
+        let mut n = Notes::default();
+        assert_eq!(n.block(false), None);
+        let b = n.block(true).unwrap();
+        assert!(b.contains(DROPPED_LINE) && b.starts_with("\n\n<working-notes>\n") && b.ends_with("</working-notes>"));
+        n.model = "m".repeat(1500);
+        for i in 0..10 {
+            n.add_auto(&format!("r{i}: {}", "a".repeat(150)));
+        }
+        let b = n.block(false).unwrap();
+        assert!(!b.contains(DROPPED_LINE));
+        assert!(b.len() < 1000 + 600 + 120, "{}", b.len());
+        assert!(b.contains("r9:"), "newest summary kept");
+        assert!(!b.contains("r0:"), "oldest cut from the block");
+    }
+
+    #[test]
+    fn append_to_string_and_array_content() {
+        let mut m = vec![json!({"role": "system", "content": "sys"}), json!({"role": "tool", "content": "result"})];
+        append_to_last(&mut m, "\n\n<working-notes>\nx\n</working-notes>");
+        assert_eq!(m[1]["content"], "result\n\n<working-notes>\nx\n</working-notes>");
+        assert_eq!(m[0]["content"], "sys");
+        let mut m = vec![json!({"role": "user", "content": [{"type": "text", "text": "hi"}, {"type": "image_url", "image_url": {"url": "data:"}}]})];
+        append_to_last(&mut m, "\n\n<working-notes>\nx\n</working-notes>");
+        assert_eq!(m[0]["content"][2], json!({"type": "text", "text": "<working-notes>\nx\n</working-notes>"}));
+    }
+
+    fn openai(id: &str, name: &str, args: Value, result: &str) -> Vec<Value> {
+        vec![
+            json!({"role": "assistant", "content": "", "tool_calls": [{"id": id, "type": "function", "function": {"name": name, "arguments": args.to_string()}}]}),
+            json!({"role": "tool", "tool_call_id": id, "content": result}),
+        ]
+    }
+
+    fn native(name: &str, args: Value, result: &str) -> Vec<Value> {
+        vec![
+            json!({"role": "assistant", "content": "", "tool_calls": [{"function": {"name": name, "arguments": args}}]}),
+            json!({"role": "tool", "content": result}),
+        ]
+    }
+
+    #[test]
+    fn summaries_from_dropped_groups_in_both_shapes() {
+        for shape in ["openai", "native"] {
+            let r = |id: &str, name: &str, args: Value, res: &str| {
+                if shape == "openai" { openai(id, name, args, res) } else { native(name, args, res) }
+            };
+            let mut m = vec![json!({"role": "system", "content": "s"}), json!({"role": "user", "content": "fix"})];
+            m.extend(r("a", "read_file", json!({"path": "MyApp/GameView.swift"}), "code"));
+            m.extend(r("b", "search_code", json!({"pattern": "scene"}), "MyApp/GameView.swift:44:skView.scene = s\nMyApp/GameView.swift:54:// scene\n"));
+            m.extend(r("c", "edit", json!({"path": "MyApp/GameView.swift", "old_text": "a", "new_text": "b"}), "Error: old_text not found"));
+            m.extend(r("d", "notes", json!({"action": "append", "text": "x"}), "Noted"));
+            m.push(json!({"role": "user", "content": "The build failed with these errors. Fix…:\nMyApp/GameView.swift:44:16: error: Cannot assign to property: 'scene' is a get-only property\n"}));
+            m.push(json!({"role": "assistant", "content": "I will use presentScene. Then build."}));
+            let idx: Vec<usize> = (2..m.len()).collect();
+            let b = summarize(&m, &idx, "r5", "The build failed with these errors. Fix…:").unwrap();
+            assert_eq!(
+                b,
+                "r5: read GameView.swift; search \"scene\" (2 hits: GameView.swift:44, GameView.swift:54); edit MyApp/GameView.swift FAILED; build FAILED: MyApp/GameView.swift:44:16: error: Cannot assign to property: 'scene' is a get-only property; said: I will use presentScene",
+                "{shape}"
+            );
+        }
+        let m = vec![json!({"role": "system", "content": "s"})];
+        assert_eq!(summarize(&m, &[], "r1", "x"), None);
+    }
+}
