+//! Reasoning-loop detection.
+//!
+//! gemma4's thinking sometimes repeats the same sentences until it hits
+//! `max_tokens` (one recorded Xcode reply repeated two sentences for 8
+//! minutes). Ollama only stops a single token repeated 100 times, so the
+//! engine checks every reply itself:
+//!
+//! - **Sentence repeat**: a natural-language sentence (at least 25
+//!   characters and 4 words, mostly letters) occurs at least 3 times in the
+//!   last 4,000 characters, and repeated sentences cover at least 40% of the
+//!   last 1,500 characters.
+//! - **Period repeat** (no punctuation to split on): the last 120
+//!   characters occur at least 3 times in the last 1,200.
+//! - **Overthinking**: reasoning longer than `LLM_MAX_REASONING_CHARS`.
+//!
+//! Code drafts in the reasoning are not sentences (too few plain words), so
+//! repeating a struct while drafting it does not count.
+
+use std::collections::HashMap;
+
+/// Default `LLM_MAX_REASONING_CHARS`.
+pub const DEFAULT_MAX_REASONING_CHARS: usize = 12_000;
+
+const WINDOW: usize = 4_000;
+const TAIL: usize = 1_500;
+const MIN_SENTENCE_CHARS: usize = 25;
+const MIN_WORDS: usize = 4;
+const MIN_REPEATS: usize = 3;
+const MIN_COVERAGE: f64 = 0.40;
+const PERIOD: usize = 120;
+const PERIOD_WINDOW: usize = 1_200;
+
+/// Why a text was flagged.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum LoopKind {
+    /// This (normalized) sentence keeps repeating.
+    SentenceRepeat(String),
+    /// The tail of the text repeats verbatim.
+    PeriodRepeat,
+    /// The reasoning is longer than the limit.
+    Overthinking(usize),
+}
+
+impl LoopKind {
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            LoopKind::SentenceRepeat(_) => "sentence_repeat",
+            LoopKind::PeriodRepeat => "period_repeat",
+            LoopKind::Overthinking(_) => "overthinking",
+        }
+    }
+}
+
+/// The last `n` characters of `text` (on a char boundary).
+fn tail(text: &str, n: usize) -> &str {
+    if text.len() <= n {
+        return text;
+    }
+    let mut start = text.len() - n;
+    while !text.is_char_boundary(start) {
+        start += 1;
+    }
+    &text[start..]
+}
+
+/// Plain words: at least two characters, letters and apostrophes only
+/// (surrounding punctuation stripped).
+fn plain_words(s: &str) -> usize {
+    s.split_whitespace()
+        .map(|w| w.trim_matches(|c: char| matches!(c, ',' | ':' | ';' | '"' | '(' | ')')))
+        .filter(|w| w.chars().count() >= 2 && w.chars().all(|c| c.is_alphabetic() || c == '\''))
+        .count()
+}
+
+/// Normalized natural-language sentences of `text` (lowercase, collapsed
+/// whitespace), with their byte length in the original.
+fn sentences(text: &str) -> Vec<(String, usize)> {
+    text.split(['.', '!', '?', '\n'])
+        .filter_map(|raw| {
+            let norm = raw.split_whitespace().collect::<Vec<_>>().join(" ").to_lowercase();
+            let chars = norm.chars().count();
+            if chars < MIN_SENTENCE_CHARS || plain_words(&norm) < MIN_WORDS {
+                return None;
+            }
+            let letters = norm.chars().filter(|c| c.is_alphabetic()).count();
+            (letters * 100 >= chars * 60).then_some((norm, raw.len() + 1))
+        })
+        .collect()
+}
+
+/// Check `text` (reasoning or reply content) for a repetition loop.
+pub fn detect_repetition(text: &str) -> Option<LoopKind> {
+    let window = tail(text, WINDOW);
+    let mut counts: HashMap<String, usize> = HashMap::new();
+    for (s, _) in sentences(window) {
+        *counts.entry(s).or_default() += 1;
+    }
+    if let Some((top, n)) = counts.iter().max_by_key(|(s, n)| (**n, s.len())) {
+        if *n >= MIN_REPEATS {
+            let t = tail(text, TAIL);
+            let covered: usize = sentences(t)
+                .iter()
+                .filter(|(s, _)| counts.get(s).is_some_and(|c| *c >= 2))
+                .map(|(_, len)| *len)
+                .sum();
+            if covered as f64 >= MIN_COVERAGE * t.len().max(1) as f64 {
+                return Some(LoopKind::SentenceRepeat(top.clone()));
+            }
+        }
+    }
+    // Only for text without sentence boundaries (code and normal prose
+    // have them, and are judged by sentences above).
+    let unpunctuated = tail(text, PERIOD_WINDOW)
+        .chars()
+        .filter(|c| matches!(c, '.' | '!' | '?' | '\n'))
+        .count()
+        < 3;
+    if unpunctuated && text.len() >= PERIOD * MIN_REPEATS {
+        let last = tail(text, PERIOD);
+        if last.trim().len() >= PERIOD / 2 && tail(text, PERIOD_WINDOW).matches(last).count() >= MIN_REPEATS {
+            return Some(LoopKind::PeriodRepeat);
+        }
+    }
+    None
+}
+
+/// Check a reply's reasoning: repetition, or longer than `max_chars`
+/// (0 = no length limit).
+pub fn detect_reasoning(reasoning: &str, max_chars: usize) -> Option<LoopKind> {
+    detect_repetition(reasoning).or_else(|| {
+        (max_chars > 0 && reasoning.len() > max_chars).then(|| LoopKind::Overthinking(reasoning.len()))
+    })
+}
