+#[derive(Debug, Clone)]
+pub struct BuildOutcome {
+    pub status: BuildStatus,
+    /// Concise error report (empty when the build passed).
+    pub errors: String,
+}
+
+/// Run `plan` in `cwd` with a timeout, killing its process group on timeout
+/// or cancel.
+pub async fn run(
+    plan: &VerifyPlan,
+    cwd: &Path,
+    timeout: Duration,
+    cancel: Option<CancelToken>,
+) -> BuildOutcome {
+    let mut cmd = Command::new("bash");
+    cmd.arg("-c").arg(&plan.command).current_dir(cwd);
+    for (k, v) in &plan.env {
+        cmd.env(k, v);
+    }
+    debug!(command = %plan.command, cwd = %cwd.display(), "Running verify build");
+    let out = match process::run_command_async(cmd, timeout, cancel).await {
+        Ok(out) => out,
+        Err(e) => {
+            return BuildOutcome {
+                status: BuildStatus::CouldNotRun,
+                errors: format!("could not start the build: {e}"),
+            }
+        }
+    };
+    let combined = if out.stdout.is_empty() {
+        out.stderr.clone()
+    } else if out.stderr.is_empty() {
+        out.stdout.clone()
+    } else {
+        format!("{}\n{}", out.stdout, out.stderr)
+    };
+    let status = if out.cancelled {
+        BuildStatus::Cancelled
+    } else if out.timed_out {
+        BuildStatus::TimedOut
+    } else if out.success() {
+        BuildStatus::Passed
+    } else if out.code() == Some(127) {
+        BuildStatus::CouldNotRun
+    } else {
+        BuildStatus::Failed
+    };
+    let errors = match status {
+        BuildStatus::Passed | BuildStatus::Cancelled => String::new(),
+        _ => extract_errors(&combined, cwd),
+    };
+    BuildOutcome { status, errors }
+}
+
+/// True when `line` is a compiler / build error line.
+fn is_error_line(line: &str) -> bool {
+    let t = line.trim_start();
+    t.contains(": error:")
+        || t.contains(": fatal error:")
+        || t.contains(": error[")
+        || t.starts_with("error:")
+        || t.starts_with("error[")
+        || t.contains("error TS")
+        || t.starts_with("e: ")
+        || t.starts_with("Undefined symbol")
+        || is_go_error(t)
+}
+
+/// An error line that only summarizes other errors (xcodebuild / swift
+/// driver / cargo wrap-ups).
+fn is_summary_line(line: &str) -> bool {
+    line.contains("the following command failed with exit code")
+        || line.contains("command failed with exit code")
+        || line.starts_with("error: could not compile")
+}
+
+/// Go reports errors as `path.go:line:col: message` with no `error:` word.
+fn is_go_error(t: &str) -> bool {
+    let Some((path, rest)) = t.split_once(".go:") else {
+        return false;
+    };
+    if path.is_empty() || path.contains(char::is_whitespace) {
+        return false;
+    }
+    let mut parts = rest.splitn(3, ':');
+    let line_ok = parts
+        .next()
+        .is_some_and(|n| !n.is_empty() && n.chars().all(|c| c.is_ascii_digit()));
+    let col_ok = parts
+        .next()
+        .is_some_and(|n| !n.is_empty() && n.chars().all(|c| c.is_ascii_digit()));
+    line_ok && col_ok && parts.next().is_some_and(|m| m.starts_with(' '))
+}
+
+/// Spellings of `cwd` that may prefix paths in compiler output (as given,
+/// canonical, and with/without macOS's `/private` prefix), longest first.
+fn cwd_prefixes(cwd: &Path) -> Vec<String> {
+    let mut base = vec![cwd.to_string_lossy().into_owned()];
+    if let Ok(c) = cwd.canonicalize() {
+        base.push(c.to_string_lossy().into_owned());
+    }
+    let mut v: Vec<String> = Vec::new();
+    for p in base {
+        let p = p.trim_end_matches('/').to_string();
+        let alt = match p.strip_prefix("/private") {
+            Some(stripped) => stripped.to_string(),
+            None => format!("/private{p}"),
+        };
+        for candidate in [p, alt] {
+            if candidate.len() > 1 && !v.contains(&candidate) {
+                v.push(candidate);
+            }
+        }
+    }
+    v.sort_by_key(|p| std::cmp::Reverse(p.len()));
+    v
+}
+
+/// Concise error report from build output: the error lines (deduplicated,
+/// paths relative to `cwd`), at most 40 lines / 4000 characters. Falls back
+/// to the last lines of output when no line looks like an error.
+pub fn extract_errors(output: &str, cwd: &Path) -> String {
+    let prefixes = cwd_prefixes(cwd);
+    let relativize = |line: &str| -> String {
+        let mut l = line.trim().to_string();
+        for p in &prefixes {
+            l = l.replace(&format!("file://{p}/"), "");
+            l = l.replace(&format!("{p}/"), "");
+        }
+        l
+    };
+
+    let mut seen = std::collections::HashSet::new();
+    let mut lines: Vec<String> = output
+        .lines()
+        .filter(|l| is_error_line(l))
+        .map(relativize)
+        .filter(|l| seen.insert(l.clone()))
+        .collect();
+    // Build-system summaries ("the following command failed …") say
+    // nothing the compiler errors don't; drop them when real errors exist.
+    if lines.iter().any(|l| !is_summary_line(l)) {
+        lines.retain(|l| !is_summary_line(l));
+    }
+    if lines.is_empty() {
+        let tail: Vec<&str> = output
+            .lines()
+            .filter(|l| !l.trim().is_empty())
+            .collect();
+        let start = tail.len().saturating_sub(MAX_ERROR_LINES);
+        lines = tail[start..].iter().map(|l| relativize(l)).collect();
+    }
+
+    let total = lines.len();
+    let mut report = String::new();
+    let mut shown = 0;
+    for line in &lines {
+        if shown == MAX_ERROR_LINES || report.len() + line.len() + 1 > MAX_ERROR_CHARS {
+            break;
+        }
+        report.push_str(line);
+        report.push('\n');
+        shown += 1;
+    }
+    if shown < total {
+        report.push_str(&format!("... and {} more\n", total - shown));
+    }
+    if report.trim().is_empty() {
+        "(the build failed without output)".to_string()
+    } else {
+        report.trim_end().to_string()
+    }
+}
