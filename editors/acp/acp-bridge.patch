+/// One tool from `tools/list`.
+#[derive(Debug, Clone, PartialEq)]
+pub struct McpTool {
+    pub name: String,
+    pub description: String,
+    pub input_schema: Value,
+    pub annotations: Value,
+}
+
+impl McpTool {
+    fn from_value(v: &Value) -> Option<Self> {
+        Some(Self {
+            name: v.get("name")?.as_str()?.to_string(),
+            description: v
+                .get("description")
+                .and_then(Value::as_str)
+                .unwrap_or("")
+                .to_string(),
+            input_schema: v.get("inputSchema").cloned().unwrap_or(json!({"type": "object"})),
+            annotations: v.get("annotations").cloned().unwrap_or(Value::Null),
+        })
+    }
+
+    pub fn open_world(&self) -> bool {
+        self.annotations.get("openWorldHint").and_then(Value::as_bool) == Some(true)
+    }
+
+    /// Whether the tool's schema has the parameter `name`.
+    pub fn has_param(&self, name: &str) -> bool {
+        self.input_schema
+            .get("properties")
+            .and_then(|p| p.get(name))
+            .is_some()
+    }
+}
+
+/// A `tools/call` result.
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct McpResult {
+    /// Text content items joined with newlines (resources inlined).
+    pub text: String,
+    pub structured: Option<Value>,
+    pub is_error: bool,
+    /// Image items (not passed on).
+    pub images: usize,
+}
+
+impl McpResult {
+    pub fn from_result(v: &Value) -> Self {
+        let mut texts: Vec<String> = Vec::new();
+        let mut images = 0;
+        for item in v.get("content").and_then(Value::as_array).into_iter().flatten() {
+            match item.get("type").and_then(Value::as_str) {
+                Some("text") => {
+                    if let Some(t) = item.get("text").and_then(Value::as_str) {
+                        texts.push(t.to_string());
+                    }
+                }
+                Some("image") | Some("audio") => images += 1,
+                Some("resource") => {
+                    let r = &item["resource"];
+                    match r.get("text").and_then(Value::as_str) {
+                        Some(t) => texts.push(t.to_string()),
+                        None => texts.push(format!(
+                            "[binary resource {}]",
+                            r.get("uri").and_then(Value::as_str).unwrap_or("")
+                        )),
+                    }
+                }
+                Some("resource_link") => texts.push(format!(
+                    "[resource: {} {}]",
+                    item.get("name").and_then(Value::as_str).unwrap_or(""),
+                    item.get("uri").and_then(Value::as_str).unwrap_or("")
+                )),
+                _ => {}
+            }
+        }
+        Self {
+            text: texts.join("\n"),
+            structured: v.get("structuredContent").cloned().filter(|s| !s.is_null()),
+            is_error: v.get("isError").and_then(Value::as_bool).unwrap_or(false),
+            images,
+        }
+    }
+
+    /// `structuredContent`, or the text parsed as a JSON object (mcpbridge
+    /// sometimes sends only text holding the JSON).
+    pub fn structured_or_text_json(&self) -> Option<Value> {
+        self.structured.clone().or_else(|| {
+            serde_json::from_str::<Value>(self.text.trim())
+                .ok()
+                .filter(Value::is_object)
+        })
+    }
+}
