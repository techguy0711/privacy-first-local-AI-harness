+/// Write a session's new messages to the store (and, with `all`, its
+/// notes and metadata). No-op without persistence; disk errors are logged.
+pub fn persist_session(state: &AppState, session_id: &str, all: bool) {
+    let Some(store) = &state.store else { return };
+    let (new, notes, meta) = {
+        let mut sessions = state.sessions_write();
+        let Some(s) = sessions.get_mut(session_id) else { return };
+        let from = s.persisted_len.max(1).min(s.messages.len());
+        let new = s.messages[from..].to_vec();
+        s.persisted_len = s.messages.len();
+        let notes = all.then(|| s.notes.clone());
+        let meta = all.then(|| session_meta(state, session_id, s));
+        (new, notes, meta)
+    };
+    store.append(session_id, &new);
+    if let Some(n) = notes {
+        store.write_notes(session_id, &n);
+    }
+    if let Some(m) = meta {
+        store.write_meta(&m);
+    }
+}
