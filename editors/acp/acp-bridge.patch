+//! Xcode's `xcode-tools` MCP server (its `mcpbridge`), per session.
+//!
+//! Xcode passes `{name: "xcode-tools", command: …/mcpbridge, env:
+//! [MCP_XCODE_PID, MCP_XCODE_SESSION_ID]}` in `session/new`. When the
+//! command is allowlisted, acp-bridge starts it in the background (the first
+//! connection can wait on Xcode's "Allow … to access Xcode?" dialog) and the
+//! session's turns use it once it is ready:
+//!
+//! - the model gets `docs_search` (Xcode's on-device DocumentationSearch,
+//!   top 3 results, short schema) and any other tool the config exposes;
+//! - the harness uses XcodeRefreshCodeIssuesInFile after Swift edits and
+//!   BuildProject for its builds;
+//! - a call that fails with Xcode's "<param> is required for this action.
+//!   Choose from the following open workspaces …" gets the workspace whose
+//!   path matches the session cwd injected and is retried once (the id is
+//!   then remembered for the session).
+
+use crate::mcp::{
+    hard_denied, ConnectOptions, McpClient, McpError, McpResult, McpSpec, McpTool, ToolPolicy,
+};
+use crate::process::CancelToken;
+use serde_json::{json, Value};
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+use tokio::sync::{mpsc, watch};
+use tracing::{info, warn};
+
+/// How long the background handshake may take (the Allow dialog waits for
+/// the user); turns only wait `connect_timeout_secs` for it.
+const BACKGROUND_HANDSHAKE: Duration = Duration::from_secs(600);
+/// Documents returned to the model, characters per document, in total.
+const DOCS_TOP: usize = 3;
+const DOC_CHARS: usize = 1_000;
+const DOCS_TOTAL_CHARS: usize = 3_500;
+/// `docs_search` calls per turn.
+pub const DOCS_PER_TURN: usize = 4;
+/// Name of the model-facing documentation tool.
+pub const DOCS_TOOL: &str = "docs_search";
+/// ACP title of a docs_search row (Xcode renders `mcp__xcode-tools__*`
+/// titles as its own tools).
+pub const DOCS_TITLE: &str = "mcp__xcode-tools__DocumentationSearch";
+
+fn lock<T>(m: &Mutex<T>) -> std::sync::MutexGuard<'_, T> {
+    m.lock().unwrap_or_else(|p| p.into_inner())
+}
+
+/// Connection state of a session's xcode-tools.
+#[derive(Clone, Debug)]
+pub enum ConnState {
+    Connecting,
+    Ready(Arc<McpClient>),
+    Failed(String),
+}
+
+/// A session's connection to xcode-tools.
+pub struct XcodeConn {
+    rx: watch::Receiver<ConnState>,
+    task: tokio::task::JoinHandle<()>,
+    waited: AtomicBool,
+    /// Last state kind reported to the user ("ready", "failed", ...).
+    reported: Mutex<Option<&'static str>>,
+    pub policy: ToolPolicy,
+    /// What was started (to tell a client's repeated spec from a new one).
+    pub spec: McpSpec,
+    /// The session cwd (picks the workspace among Xcode's open ones).
+    cwd: Mutex<PathBuf>,
+    /// (parameter name, id) once Xcode asked for a workspace id.
+    workspace: Mutex<Option<(String, String)>>,
+    /// Session-relative file path -> Xcode navigator path (None = unknown).
+    nav_paths: Mutex<HashMap<String, Option<String>>>,
+}
+
+impl std::fmt::Debug for XcodeConn {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("XcodeConn").field("state", &*self.rx.borrow()).finish()
+    }
+}
+
+impl Drop for XcodeConn {
+    fn drop(&mut self) {
+        // Stops a handshake still waiting; a ready client (and its child
+        // process) goes away with the channel.
+        self.task.abort();
+    }
+}
+
+impl XcodeConn {
+    /// Start connecting in the background.
+    pub fn start(spec: McpSpec, policy: ToolPolicy, cwd: PathBuf) -> Arc<Self> {
+        let (tx, rx) = watch::channel(ConnState::Connecting);
+        let name = spec.name().to_string();
+        let started = spec.clone();
+        let task = tokio::spawn(async move {
+            let opts = ConnectOptions {
+                handshake_timeout: BACKGROUND_HANDSHAKE,
+            };
+            let state = match McpClient::connect(&spec, &opts).await {
+                Ok(c) => ConnState::Ready(c),
+                Err(e) => {
+                    warn!(server = %name, error = %e, "Xcode tools unavailable");
+                    ConnState::Failed(e.to_string())
+                }
+            };
+            let _ = tx.send(state);
+            // Keep the sender (and so the state) alive with the connection.
+            std::future::pending::<()>().await;
+        });
+        Arc::new(Self {
+            rx,
+            task,
+            waited: AtomicBool::new(false),
+            reported: Mutex::new(None),
+            policy,
+            spec: started,
+            cwd: Mutex::new(cwd),
+            workspace: Mutex::new(None),
+            nav_paths: Mutex::new(HashMap::new()),
+        })
+    }
+
+    pub fn state(&self) -> ConnState {
+        self.rx.borrow().clone()
+    }
+
+    /// Still connecting, or connected and the server is running.
+    pub fn healthy(&self) -> bool {
+        match self.state() {
+            ConnState::Connecting => true,
+            ConnState::Ready(c) => c.closed().is_none(),
+            ConnState::Failed(_) => false,
+        }
+    }
+
+    pub fn client(&self) -> Option<Arc<McpClient>> {
+        match self.state() {
+            ConnState::Ready(c) if c.closed().is_none() => Some(c),
+            _ => None,
+        }
+    }
+
+    /// The state for a turn: the first turn waits up to `timeout` for the
+    /// handshake, later turns take the state as it is.
+    pub async fn state_for_turn(&self, timeout: Duration, cancel: &CancelToken) -> ConnState {
+        if !self.waited.swap(true, Ordering::SeqCst) {
+            let mut rx = self.rx.clone();
+            tokio::select! {
+                _ = rx.wait_for(|s| !matches!(s, ConnState::Connecting)) => {}
+                _ = tokio::time::sleep(timeout) => {}
+                _ = cancel.cancelled() => {}
+            }
+        }
+        match self.state() {
+            ConnState::Ready(c) => match c.closed() {
+                Some(why) => ConnState::Failed(why),
+                None => ConnState::Ready(c),
+            },
+            other => other,
+        }
+    }
+
+    /// True when `kind` differs from the state last reported (so each
+    /// state is reported once: connecting, then ready or failed).
+    pub fn report_change(&self, kind: &'static str) -> bool {
+        let mut r = lock(&self.reported);
+        if *r == Some(kind) {
+            false
+        } else {
+            *r = Some(kind);
+            true
+        }
+    }
+
+    /// The session moved to another cwd (`session/resume` of a session in
+    /// memory): forget the workspace id and the navigator paths of the old
+    /// project.
+    pub fn rebase(&self, cwd: &Path) {
+        let mut current = lock(&self.cwd);
+        if current.as_path() != cwd {
+            *current = cwd.to_path_buf();
+            *lock(&self.workspace) = None;
+            lock(&self.nav_paths).clear();
+        }
+    }
+
+    /// Whether `tool` may be called (allowed, present, not hard-denied).
+    pub fn usable(&self, client: &McpClient, tool: &str) -> Option<McpTool> {
+        let t = client.tool(tool)?;
+        (self.policy.allows(tool) && hard_denied(&t, false).is_none()).then_some(t)
+    }
+
+    /// Call a tool; when Xcode answers that a workspace id is required, pick
+    /// the open workspace whose path matches the cwd, remember it, inject
+    /// it and retry once. A remembered id is injected up front for tools
+    /// that take that parameter.
+    pub async fn call(
+        &self,
+        client: &McpClient,
+        tool: &str,
+        args: Value,
+        timeout: Duration,
+        cancel: Option<&CancelToken>,
+        progress: Option<mpsc::UnboundedSender<Value>>,
+    ) -> Result<McpResult, McpError> {
+        let mut args = if args.is_object() { args } else { json!({}) };
+        let known = lock(&self.workspace).clone();
+        if let (Some((param, id)), Some(t)) = (&known, client.tool(tool)) {
+            if t.has_param(param) && args.get(param).is_none() {
+                args[param.as_str()] = json!(id);
+            }
+        }
+        let first = client
+            .call(tool, args.clone(), timeout, cancel, progress.clone())
+            .await;
+        let text = match &first {
+            Ok(r) if r.is_error => r.text.clone(),
+            Err(McpError::Rpc { message, .. }) => message.clone(),
+            _ => return first,
+        };
+        let Some((param, entries)) = parse_workspace_error(&text) else {
+            return first;
+        };
+        let cwd = lock(&self.cwd).clone();
+        let Some(id) = pick_workspace(&entries, &cwd) else {
+            warn!(tool, cwd = %cwd.display(), "Xcode asked for a workspace id but none matches the session cwd");
+            return first;
+        };
+        info!(tool, param = %param, id = %id, "Injecting the Xcode workspace id and retrying");
+        *lock(&self.workspace) = Some((param.clone(), id.clone()));
+        args[param.as_str()] = json!(id);
+        client.call(tool, args, timeout, cancel, progress).await
+    }
+
+    /// Xcode navigator path for a session-relative file path, via XcodeGlob
+    /// (`**/<name>`, the candidate whose suffix matches). Cached; `None` when
+    /// there is no single match.
+    pub async fn navigator_path(&self, client: &McpClient, rel: &str, cancel: &CancelToken) -> Option<String> {
+        if let Some(hit) = lock(&self.nav_paths).get(rel) {
+            return hit.clone();
+        }
+        let base = rel.rsplit('/').next().unwrap_or(rel);
+        let r = self
+            .call(client, "XcodeGlob", json!({"pattern": format!("**/{base}")}), Duration::from_secs(10), Some(cancel), None)
+            .await
+            .ok()?;
+        let s = r.structured_or_text_json()?;
+        let matches: Vec<String> = s
+            .get("matches")
+            .and_then(Value::as_array)?
+            .iter()
+            .filter_map(|m| m.as_str().map(str::to_owned))
+            .collect();
+        let hit = pick_navigator_path(&matches, rel);
+        lock(&self.nav_paths).insert(rel.to_string(), hit.clone());
+        hit
+    }
+}
+
+/// Among Xcode navigator paths, the single one whose path ends with the
+/// file's relative path (`Untitled Project/MyApp/A.swift` for
+/// `MyApp/A.swift`); `None` if none or several match.
+pub fn pick_navigator_path(candidates: &[String], rel: &str) -> Option<String> {
+    let rel = rel.trim_start_matches("./");
+    let hits: Vec<&String> = candidates
+        .iter()
+        .filter(|c| c.as_str() == rel || c.ends_with(&format!("/{rel}")))
+        .collect();
+    match hits.as_slice() {
+        [one] => Some((*one).clone()),
+        _ => None,
+    }
+}
+
+/// Parse Xcode's "<param> is required for this action. Choose from the
+/// following open workspaces/windows: * <param>: X, workspacePath: P" error.
+pub fn parse_workspace_error(text: &str) -> Option<(String, Vec<(String, String)>)> {
+    let pos = text.find(" is required for this action")?;
+    let param: String = text[..pos]
+        .rsplit(|c: char| c.is_whitespace() || c == ':')
+        .next()?
+        .trim_matches('`')
+        .to_string();
+    if param.is_empty() {
+        return None;
+    }
+    let prefix = format!("* {param}: ");
+    let entries: Vec<(String, String)> = text
+        .lines()
+        .filter_map(|l| {
+            let rest = l.trim().strip_prefix(&prefix)?;
+            let (id, path) = rest.split_once(", workspacePath: ")?;
+            Some((id.trim().to_string(), path.trim().to_string()))
+        })
+        .collect();
+    (!entries.is_empty()).then_some((param, entries))
+}
+
+/// The workspace whose path is the cwd or lies directly inside it.
+pub fn pick_workspace(entries: &[(String, String)], cwd: &Path) -> Option<String> {
+    let mut cwds = vec![cwd.to_path_buf()];
+    if let Ok(c) = cwd.canonicalize() {
+        cwds.push(c);
+    }
+    entries
+        .iter()
+        .find(|(_, p)| {
+            let p = Path::new(p);
+            cwds.iter().any(|c| p == c || p.parent() == Some(c.as_path()) || p.starts_with(c))
+        })
+        .map(|(id, _)| id.clone())
+}
+
+/// The model-facing `docs_search` tool (Xcode's long schema is not passed
+/// through).
+pub fn docs_search_definition() -> Value {
+    json!({
+        "type": "function",
+        "function": {
+            "name": DOCS_TOOL,
+            "description": "Search Apple's developer documentation on this Mac (offline). Use it for Apple SDK types and methods you are unsure about, e.g. 'SKView presentScene'. Returns the top 3 matches.",
+            "parameters": {
+                "type": "object",
+                "properties": {
+                    "query": {"type": "string", "description": "Type and member names, e.g. 'SKView presentScene'"},
+                    "frameworks": {"type": "array", "items": {"type": "string"}, "description": "Optional, e.g. ['SpriteKit']"}
+                },
+                "required": ["query"]
+            }
+        }
+    })
+}
+
+fn cut(s: &str, max: usize) -> String {
+    if s.chars().count() <= max {
+        s.to_string()
+    } else {
+        format!("{}…", s.chars().take(max).collect::<String>())
+    }
+}
+
+/// Text for the model and `rawOutput` documents for a DocumentationSearch
+/// result: the top 3 documents as `title (uri)` + contents (1,000 chars
+/// each, 3,500 in total).
+pub fn shape_docs(query: &str, r: &McpResult) -> (String, Value) {
+    let docs: Vec<Value> = r
+        .structured_or_text_json()
+        .and_then(|s| s.get("documents").and_then(Value::as_array).cloned())
+        .unwrap_or_default();
+    if docs.is_empty() {
+        let text = if r.text.trim().is_empty() {
+            "No documentation found.".to_string()
+        } else {
+            cut(r.text.trim(), DOCS_TOTAL_CHARS)
+        };
+        return (text, json!({"query": query, "documents": []}));
+    }
+    let mut text = String::new();
+    let mut raw = Vec::new();
+    for d in docs.iter().take(DOCS_TOP) {
+        let title = d.get("title").and_then(Value::as_str).unwrap_or("");
+        let uri = d.get("uri").and_then(Value::as_str).unwrap_or("");
+        let contents = d.get("contents").and_then(Value::as_str).unwrap_or("");
+        let entry = format!("{title} ({uri})\n{}\n\n", cut(contents.trim(), DOC_CHARS));
+        if text.len() + entry.len() > DOCS_TOTAL_CHARS {
+            break;
+        }
+        text.push_str(&entry);
+        raw.push(json!({"title": title, "uri": uri}));
+    }
+    (text.trim_end().to_string(), json!({"query": query, "documents": raw}))
+}
+
+/// Time limit for XcodeRefreshCodeIssuesInFile (`LLM_XCODE_DIAG_TIMEOUT_SECS`,
+/// default 10; Apple: the tool "is not allowed to take more than a couple
+/// seconds").
+pub fn diagnostics_timeout() -> Duration {
+    Duration::from_secs(crate::process::env_secs("LLM_XCODE_DIAG_TIMEOUT_SECS", 10))
+}
+
+/// Severity words of compiler diagnostics (`fatal error` counts as error).
+const SEVERITIES: [&str; 5] = ["fatal error", "error", "warning", "note", "remark"];
+
+/// The severity of one diagnostics line and its message, or `None` for a
+/// line that is not a diagnostic (a heading, a summary like "Found 0 errors
+/// and 1 warning", "No issues found in 'ErrorView.swift'").
+///
+/// A severity counts as a label (`path:41:16: error: msg`, `error: msg`,
+/// `[Warning] msg`, `(note) msg`; the first label of the line wins, so a
+/// warning about a variable named `error` stays a warning) or as the first
+/// word of the line (`Error (line 41): msg`, `• warning unused value`).
+fn line_severity(line: &str) -> Option<(&'static str, String)> {
+    let lower = line.to_ascii_lowercase();
+    let b = lower.as_bytes();
+    let word_start = |s: usize| s == 0 || !(b[s - 1].is_ascii_alphanumeric() || matches!(b[s - 1], b'_' | b'\'' | b'"' | b'`'));
+    // 1. The first severity label.
+    let mut best: Option<(usize, &'static str, usize)> = None;
+    for sev in SEVERITIES {
+        let mut from = 0;
+        while let Some(i) = lower[from..].find(sev) {
+            let (s, e) = (from + i, from + i + sev.len());
+            if word_start(s) && matches!(b.get(e), Some(b':' | b']' | b')')) {
+                if best.is_none_or(|(p, ..)| s < p) {
+                    best = Some((s, sev, e + 1));
+                }
+                break;
+            }
+            from = e;
+        }
+    }
+    // 2. A severity as the line's first word.
+    if best.is_none() {
+        let s = lower.find(|c: char| c.is_ascii_alphanumeric())?;
+        for sev in SEVERITIES {
+            if lower[s..].starts_with(sev) && matches!(b.get(s + sev.len()), None | Some(b' ' | b'-' | b'(' | b'\t')) {
+                best = Some((s, sev, s + sev.len()));
+                break;
+            }
+        }
+    }
+    let (start, sev, msg_at) = best?;
+    let sev = if sev == "fatal error" { "error" } else { sev };
+    let msg = line[msg_at.min(line.len())..].trim_start_matches([' ', '-', ':', ']', ')']).trim();
+    // Line number: "path:41:16: error:" or "line 41" anywhere.
+    let before = &line[..start];
+    let mut number = before
+        .split(':')
+        .map(str::trim)
+        .find(|f| !f.is_empty() && f.chars().all(|c| c.is_ascii_digit()))
+        .map(str::to_owned);
+    if number.is_none() {
+        if let Some(i) = lower.find("line ") {
+            let digits: String = lower[i + 5..].chars().take_while(char::is_ascii_digit).collect();
+            if !digits.is_empty() {
+                number = Some(digits);
+            }
+        }
+    }
+    let text = match number {
+        Some(n) => format!("L{n}: {msg}"),
+        None => msg.to_string(),
+    };
+    Some((sev, text))
+}
+
+/// Whether a diagnostics text without any diagnostic line says there is
+/// nothing to report ("No issues found in …", "No errors", "0 errors").
+fn says_no_errors(text: &str) -> bool {
+    let lower = text.trim().to_ascii_lowercase();
+    if lower.is_empty() || ["no issues", "no errors", "no diagnostics"].iter().any(|p| lower.contains(p)) {
+        return true;
+    }
+    lower.match_indices("0 error").any(|(i, _)| i == 0 || !lower.as_bytes()[i - 1].is_ascii_digit())
+}
+
+/// The note appended to an edit's result from an XcodeRefreshCodeIssuesInFile
+/// result: `[Xcode diagnostics for X.swift: N errors] L41: …` (at most 5
+/// lines / 600 characters) or `[Xcode diagnostics: no errors]`. Only error
+/// lines count (warnings and notes do not). `None` when the result is
+/// unusable or its format is not recognized (diagnostics reported, but no
+/// line reads as one).
+pub fn diagnostics_note(file: &str, r: &McpResult) -> Option<String> {
+    if r.is_error {
+        return None;
+    }
+    let s = r.structured_or_text_json();
+    if s.as_ref().and_then(|v| v.get("success")).and_then(Value::as_bool) == Some(false) {
+        return None;
+    }
+    let count = s.as_ref().and_then(|v| v.get("diagnosticsCount")).and_then(Value::as_u64);
+    let content = s
+        .as_ref()
+        .and_then(|v| v.get("content").and_then(Value::as_str).map(str::to_owned))
+        .unwrap_or_else(|| r.text.clone());
+    const NO_ERRORS: &str = "[Xcode diagnostics: no errors]";
+    if count == Some(0) {
+        return Some(NO_ERRORS.to_string());
+    }
+    let lines: Vec<(&str, String)> = content.lines().filter_map(line_severity).collect();
+    let errors: Vec<&String> = lines.iter().filter(|(sev, _)| *sev == "error").map(|(_, t)| t).collect();
+    if errors.is_empty() {
+        // Only warnings / notes, or a "no issues" text: no errors. Issues in
+        // a format not recognized: say nothing rather than something wrong.
+        return (!lines.is_empty() || (count.is_none() && says_no_errors(&content))).then(|| NO_ERRORS.to_string());
+    }
+    let name = file.rsplit('/').next().unwrap_or(file);
+    let n = errors.len();
+    let mut note = format!(
+        "[Xcode diagnostics for {name}: {n} error{}]",
+        if n == 1 { "" } else { "s" }
+    );
+    for e in errors.iter().take(5) {
+        if note.len() + e.len() + 1 > 600 {
+            break;
+        }
+        note.push('\n');
+        note.push_str(e);
+    }
+    Some(note)
+}
+
+/// Model-facing name of an exposed MCP tool: `mcp__<server>__<tool>`,
+/// limited to `[A-Za-z0-9_-]` and 64 characters.
+pub fn exposed_name(server: &str, tool: &str) -> String {
+    let clean = |s: &str| -> String {
+        s.chars()
+            .map(|c| if c.is_ascii_alphanumeric() || c == '_' || c == '-' { c } else { '_' })
+            .collect()
+    };
+    let name = format!("mcp__{}__{}", clean(server), clean(tool));
+    name.chars().take(64).collect()
+}
+
+/// A passthrough tool definition: the server's schema without Xcode's
+/// workspace parameters (injected by acp-bridge), `$schema` dropped, and
+/// descriptions capped.
+pub fn passthrough_definition(server: &str, tool: &McpTool) -> Value {
+    let mut schema = tool.input_schema.clone();
+    if let Some(obj) = schema.as_object_mut() {
+        obj.remove("$schema");
+        obj.insert("type".into(), json!("object"));
+        if let Some(props) = obj.get_mut("properties").and_then(Value::as_object_mut) {
+            props.remove("tabIdentifier");
+            props.remove("workspaceIdentifier");
+            for p in props.values_mut() {
+                if let Some(d) = p.get("description").and_then(Value::as_str) {
+                    p["description"] = json!(cut(d, 300));
+                }
+            }
+        }
+        if let Some(req) = obj.get_mut("required").and_then(Value::as_array_mut) {
+            req.retain(|r| r != "tabIdentifier" && r != "workspaceIdentifier");
+        }
+    }
+    json!({
+        "type": "function",
+        "function": {
+            "name": exposed_name(server, &tool.name),
+            "description": cut(&tool.description, 300),
+            "parameters": schema
+        }
+    })
+}
+
+/// Text for the model from a passthrough call (capped at 8,000 chars).
+pub fn result_text(r: &McpResult) -> String {
+    let mut t = if r.text.trim().is_empty() {
+        r.structured.as_ref().map(Value::to_string).unwrap_or_default()
+    } else {
+        r.text.clone()
+    };
+    if r.images > 0 {
+        t.push_str(&format!("\n[{} image(s) omitted]", r.images));
+    }
+    let t = cut(&t, 8_000);
+    if r.is_error {
+        format!("Error: {t}")
+    } else {
+        t
+    }
+}
