+async fn step5_tool_rows_carry_raw_output() {
+    for version in [1u64, 2] {
+        let project = skview_project("rawout");
+        let replies = vec![
+            tool_call("s", "search_code", json!({"pattern": "SKView"})),
+            tool_call("r", "read_file", json!({"path": "MyApp/MyApp.swift"})),
+            tool_call("l", "list_dir", json!({"path": "MyApp"})),
+            tool_call("b", "bash", json!({"command": "echo hi"})),
+            tool_call("w", "write_file", json!({"path": "MyApp/X.swift", "content": "let x = 1\n"})),
