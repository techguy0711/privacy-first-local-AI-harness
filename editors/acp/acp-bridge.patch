+/// A fake `xcodebuild` (first on PATH) that logs its arguments: lets the
+/// xcodebuild path run without Xcode (and without touching DerivedData).
+pub fn fake_xcodebuild(dir: &Path) -> (PathBuf, PathBuf) {
+    let bin = dir.join("fakebin");
+    std::fs::create_dir_all(&bin).unwrap();
+    let log = dir.join("xcodebuild.log");
+    let script = format!(
+        "#!/bin/bash\necho \"$*\" >> '{}'\nfor a in \"$@\"; do\n  if [ \"$a\" = -list ]; then echo '{{\"project\":{{\"name\":\"Untitled Project\",\"schemes\":[\"MyApp\"],\"targets\":[\"MyApp\"]}}}}'; exit 0; fi\n  if [ \"$a\" = -showBuildSettings ]; then echo '[{{\"buildSettings\":{{\"SUPPORTED_PLATFORMS\":\"iphoneos iphonesimulator\",\"SDKROOT\":\"iphoneos\"}}}}]'; exit 0; fi\ndone\necho '** BUILD SUCCEEDED **'\n",
+        log.display()
+    );
+    let path = bin.join("xcodebuild");
+    std::fs::write(&path, script).unwrap();
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o755)).unwrap();
+    }
+    let path_env = format!("{}:{}", bin.display(), std::env::var("PATH").unwrap_or_default());
+    (PathBuf::from(path_env), log)
+}
+
