+/// The context budget reserves LLM_RESERVE_OUTPUT_TOKENS, not the full
+/// LLM_MAX_TOKENS: with max_tokens 8192 in a 12000-token context the old
+/// budget (2784) would have dropped rounds; the reserve of 2000 keeps them.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn step1_context_budget_uses_the_output_reservation() {
+    let dir = fresh_dir("reserve");
+    let d = dir.clone();
+    let writes: Vec<Reply> = (0..4)
+        .map(|i| {
+            tool_call(
+                &format!("c{i}"),
+                "write_file",
+                json!({"path": format!("f{i}.txt"), "content": format!("{i}").repeat(4000)}),
+            )
+        })
+        .chain([answer("done")])
+        .collect();
+    let (mut b, recorded) = Bridge::start(
+        script(writes),
+        &[
+            ("LLM_MODEL_CONTEXT", "12000"),
+            ("LLM_MAX_TOKENS", "8192"),
+            ("LLM_RESERVE_OUTPUT_TOKENS", "2000"),
+        ],
+    )
+    .await;
+    b.initialize(1);
+    let sid = b.new_session(d.to_str().unwrap(), json!([]));
+    let (_, r) = b.prompt(&sid, "write four files");
+    assert_eq!(r["result"]["stopReason"], "end_turn", "{r}");
+    let reqs = recorded.lock().unwrap().clone();
+    let last = reqs.last().unwrap();
+    let msgs = last["messages"].as_array().unwrap();
+    let tokens =
+        acp_bridge::context::estimate_request_tokens(msgs, last["tools"].to_string().len());
+    let budget = acp_bridge::context::budget_tokens(12000, Some(2000));
+    let old_budget = acp_bridge::context::budget_tokens(12000, Some(8192));
+    assert!(tokens <= budget, "{tokens} > {budget}");
+    assert!(tokens > old_budget, "request was shrunk to the max_tokens budget: {tokens}");
+    // Nothing was dropped: all four write_file calls are still there, intact.
+    let calls = msgs.iter().filter(|m| m["tool_calls"].is_array()).count();
+    assert_eq!(calls, 4);
+    assert!(!b.shutdown().contains("Shrank the request"));
+    let _ = std::fs::remove_dir_all(&dir);
+}
