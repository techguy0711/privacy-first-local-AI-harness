+/// Run one tool call of the model: report it to the client (start and
+/// done), consult the guard, execute it, and add its result to the history.
+#[allow(clippy::too_many_arguments)]
+async fn run_tool_call(
+    state: &AppState,
+    session_id: &str,
+    working_dir: &Path,
+    backend: llm::Backend,
+    tool_call_id: &str,
+    name: &str,
+    args: &Value,
+    turn: &mut TurnCtx,
+    vs: &mut VerifyState,
+    notify: &(dyn Fn(Notification) + Send + Sync),
+    cancel: &CancelToken,
+) {
+    if name == "build" {
+        return build_tool_call(
+            state,
+            session_id,
+            working_dir,
+            backend,
+            tool_call_id,
+            turn,
+            vs,
+            notify,
+            cancel,
+        )
+        .await;
+    }
+    // write_file / edit announce their diff up front, as content[0] of the
+    // start (Xcode only reads index 0).
+    let start_content: Vec<crate::acp::ToolCallContent> =
+        tools::plan_file_change(working_dir, name, args)
+            .iter()
+            .map(diff_content)
+            .collect();
+    notify(Notification::ToolStart {
+        id: tool_call_id.to_string(),
+        name: name.into(),
+        title: tools::tool_title(name, args),
+        raw_input: tools::tool_raw_input(working_dir, name, args),
+        locations: tools::tool_locations(working_dir, name, args)
+            .iter()
+            .map(|p| p.to_string_lossy().into_owned())
+            .collect(),
+        content: start_content.clone(),
+    });
+
+    let mut raw_override: Option<Value> = None;
+    let (outcome, note, guarded) = match turn.guard.before(name, args) {
+        guards::Decision::Answer { text, failed } => {
+            debug!(tool = name, failed, "Tool call answered by the guard");
+            (tools::ToolOutcome { output: text, failed }, None, true)
+        }
+        guards::Decision::Run => {
+            let outcome = match name {
+                "docs_search" => {
+                    let (outcome, raw) = docs_search_call(turn, args, cancel).await;
+                    raw_override = raw;
+                    outcome
+                }
+                "notes" if state.config.agent.notes => {
+                    notes_tool_call(state, session_id, args, turn)
+                }
+                "web_search" => {
+                    let (outcome, raw) = web_search_call(state, session_id, working_dir, turn, args, cancel).await;
+                    raw_override = raw;
+                    outcome
+                }
+                n if turn.passthrough.contains_key(n) => passthrough_call(turn, n, args, cancel).await,
+                _ => tools::execute_tool_async(working_dir, name, args, cancel).await,
+            };
+            let mut note = turn.guard.after(name, args, &outcome);
+            if !outcome.failed {
+                if let Some(diag) = xcode_diagnostics(turn, name, args, cancel).await {
+                    note = Some(match note {
+                        Some(n) => format!("{diag}\n{n}"),
+                        None => diag,
+                    });
+                }
+            }
+            (outcome, note, false)
+        }
+    };
+
+    let mut content = if guarded {
+        vec![crate::acp::ToolCallContent::plain(&outcome.output, MAX_TOOL_OUTPUT_CHARS)]
+    } else {
+        tool_result_content(name, args, &outcome, &start_content)
+    };
+    if let Some(note) = &note {
+        if content.is_empty() {
+            content = start_content.clone();
+        }
+        content.push(crate::acp::ToolCallContent::plain(note, MAX_TOOL_OUTPUT_CHARS));
+    }
+    let raw_output = if guarded {
+        None
+    } else {
+        raw_override.or_else(|| tools::tool_raw_output(working_dir, name, args, &outcome))
+    };
+    notify(Notification::ToolDone {
+        id: tool_call_id.to_string(),
+        name: name.into(),
+        status: if outcome.failed { "failed" } else { "completed" }.into(),
+        content,
+        raw_output,
+    });
+    let changed = match name {
+        "write_file" | "edit" => true,
+        "bash" => !guards::is_read_only_bash(
+            args.get("command").and_then(Value::as_str).unwrap_or(""),
+        ),
+        _ => false,
+    };
+    if !outcome.failed && !guarded && changed {
+        vs.changed = true;
+    }
+    // Anything that may have written files (even a failed shell command)
+    // makes the web-search guard collect the workspace names again, so a
+    // type the model just declared is refused in its next query.
+    if !guarded && (matches!(name, "write_file" | "edit" | "bash") || turn.passthrough.contains_key(name)) {
+        if let Some(s) = state.sessions_write().get_mut(session_id) {
+            s.workspace_terms = None;
+        }
+    }
+    debug!(tool = name, result_len = outcome.output.len(), failed = outcome.failed, "Tool executed");
+    let result = match note {
+        Some(note) => format!("{}\n\n{note}", outcome.output),
+        None => outcome.output,
+    };
+    push_message(state, session_id, backend.format_tool_result(tool_call_id, &result));
+    // Notes and the web search count are stored right away (meta too).
+    persist_session(state, session_id, matches!(name, "notes" | "web_search"));
+}
