index 0000000..7f59a3a
--- /dev/null
+++ b/src/process.rs
@@ -0,0 +1,384 @@
+//! Child processes with a timeout and cancellation.
+//!
+//! Every command runs in its own process group (Unix), and a timeout or a
+//! cancel kills the whole group, so `bash -c "make"` or `xcodebuild` cannot
+//! leave compiler children running after the call returns.
+
+use std::io::Read;
+use std::process::{Child, Command, ExitStatus, Stdio};
+use std::sync::{Arc, Mutex};
+use std::thread::JoinHandle;
+use std::time::{Duration, Instant};
+use tokio::sync::watch;
+
+/// How often a running child is polled for exit / timeout / cancel.
+const POLL_INTERVAL: Duration = Duration::from_millis(20);
+/// Time between SIGTERM and SIGKILL when a process group is stopped.
+const TERM_GRACE: Duration = Duration::from_secs(2);
+/// Time allowed for the output pipes to close after the group was killed.
+const DRAIN_GRACE: Duration = Duration::from_secs(2);
+/// Bytes kept per output stream; the rest is read and dropped.
+const MAX_CAPTURE_BYTES: usize = 8 * 1024 * 1024;
+
+/// Cancellation signal shared between the request loop and a running turn.
+/// Cloning shares the same signal; once cancelled it stays cancelled.
+#[derive(Clone, Debug)]
+pub struct CancelToken {
+    tx: Arc<watch::Sender<bool>>,
+}
+
+impl Default for CancelToken {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl CancelToken {
+    pub fn new() -> Self {
+        let (tx, _rx) = watch::channel(false);
+        Self { tx: Arc::new(tx) }
+    }
+
+    /// Request cancellation (idempotent).
+    pub fn cancel(&self) {
+        self.tx.send_replace(true);
+    }
+
+    pub fn is_cancelled(&self) -> bool {
+        *self.tx.borrow()
+    }
+
+    /// Resolves once [`cancel`](Self::cancel) has been called (immediately
+    /// if it already was).
+    pub async fn cancelled(&self) {
+        let mut rx = self.tx.subscribe();
+        let _ = rx.wait_for(|cancelled| *cancelled).await;
+    }
+}
+
+/// What a finished (or stopped) command produced.
+#[derive(Debug, Clone)]
+pub struct RunOutput {
+    pub stdout: String,
+    pub stderr: String,
+    /// Exit status when the process exited on its own; `None` when it was
+    /// stopped because of a timeout or a cancel.
+    pub status: Option<ExitStatus>,
+    pub timed_out: bool,
+    pub cancelled: bool,
+}
+
+impl RunOutput {
+    /// True when the command exited on its own with status 0.
+    pub fn success(&self) -> bool {
+        !self.timed_out && !self.cancelled && self.status.is_some_and(|s| s.success())
+    }
+
+    /// Exit code when the command exited on its own.
+    pub fn code(&self) -> Option<i32> {
+        self.status.and_then(|s| s.code())
+    }
+}
+
+/// One output pipe read on its own thread into a shared buffer, so the
+/// bytes read so far are available even if the reader never finishes.
+struct Capture {
+    buf: Arc<Mutex<Vec<u8>>>,
+    handle: Option<JoinHandle<()>>,
+}
+
+impl Capture {
+    fn spawn<R: Read + Send + 'static>(pipe: Option<R>) -> Self {
+        let buf = Arc::new(Mutex::new(Vec::new()));
+        let handle = pipe.map(|mut pipe| {
+            let buf = Arc::clone(&buf);
+            std::thread::spawn(move || {
+                let mut chunk = [0u8; 8192];
+                loop {
+                    match pipe.read(&mut chunk) {
+                        Ok(0) | Err(_) => break,
+                        Ok(n) => {
+                            let mut b = buf.lock().unwrap_or_else(|p| p.into_inner());
+                            let room = MAX_CAPTURE_BYTES.saturating_sub(b.len());
+                            b.extend_from_slice(&chunk[..n.min(room)]);
+                        }
+                    }
+                }
+            })
+        });
+        Self { buf, handle }
+    }
+
+    fn finished(&self) -> bool {
+        self.handle.as_ref().is_none_or(|h| h.is_finished())
+    }
+
+    fn text(&mut self) -> String {
+        if self.finished() {
+            if let Some(h) = self.handle.take() {
+                let _ = h.join();
+            }
+        }
+        let b = self.buf.lock().unwrap_or_else(|p| p.into_inner());
+        String::from_utf8_lossy(&b).into_owned()
+    }
+}
+
+/// Send `signal` to the process group led by `pid`.
+#[cfg(unix)]
+fn signal_group(pid: u32, signal: i32) {
+    extern "C" {
+        fn kill(pid: i32, sig: i32) -> i32;
+    }
+    if let Ok(pid) = i32::try_from(pid) {
+        // SAFETY: plain libc call with integer arguments; a negative pid
+        // addresses the whole process group.
+        unsafe {
+            kill(-pid, signal);
+        }
+    }
+}
+
+/// Stop the child's whole process group: SIGTERM, a short grace period,
+/// then SIGKILL. Reaps the child.
+fn kill_group(child: &mut Child) {
+    #[cfg(unix)]
+    {
+        const SIGTERM: i32 = 15;
+        const SIGKILL: i32 = 9;
+        let pid = child.id();
+        signal_group(pid, SIGTERM);
+        let until = Instant::now() + TERM_GRACE;
+        while Instant::now() < until {
+            if matches!(child.try_wait(), Ok(Some(_))) {
+                break;
+            }
+            std::thread::sleep(POLL_INTERVAL);
+        }
+        // The leader may be gone while other members ignored SIGTERM.
+        signal_group(pid, SIGKILL);
+    }
+    let _ = child.kill();
+    let _ = child.wait();
+}
+
+/// SIGKILL the whole process group led by `pid` (no-op off Unix).
+pub fn kill_process_group(pid: u32) {
+    #[cfg(unix)]
+    signal_group(pid, 9);
+    #[cfg(not(unix))]
+    let _ = pid;
+}
+
+/// Kill whatever is left of the group after its leader exited (background
+/// jobs that keep the output pipes open).
+fn kill_leftovers(pid: u32) {
+    #[cfg(unix)]
+    signal_group(pid, 9);
+    #[cfg(not(unix))]
+    let _ = pid;
+}
+
+/// Run `cmd` to completion, with stdin closed and stdout / stderr captured.
+///
+/// The child gets its own process group. When `timeout` passes or `cancel`
+/// fires, the whole group is stopped and the output read so far is
+/// returned with `timed_out` / `cancelled` set. If the command exits but a
+/// background job keeps its output open, the job is killed at the timeout
+/// (or on cancel) and the command's own status is kept.
+pub fn run_command(
+    mut cmd: Command,
+    timeout: Duration,
+    cancel: Option<&CancelToken>,
+) -> std::io::Result<RunOutput> {
+    cmd.stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped());
+    #[cfg(unix)]
+    {
+        use std::os::unix::process::CommandExt;
+        cmd.process_group(0);
+    }
+    let mut child = cmd.spawn()?;
+    let pid = child.id();
+    let mut out = Capture::spawn(child.stdout.take());
+    let mut err = Capture::spawn(child.stderr.take());
+
+    let deadline = Instant::now() + timeout;
+    let is_cancelled = || cancel.is_some_and(|c| c.is_cancelled());
+    let mut timed_out = false;
+    let mut cancelled = false;
+
+    let status = loop {
+        match child.try_wait() {
+            Ok(Some(status)) => break Some(status),
+            Ok(None) => {}
+            Err(_) => {
+                kill_group(&mut child);
+                break None;
+            }
+        }
+        if is_cancelled() {
+            cancelled = true;
+        } else if Instant::now() >= deadline {
+            timed_out = true;
+        }
+        if cancelled || timed_out {
+            kill_group(&mut child);
+            break None;
+        }
+        std::thread::sleep(POLL_INTERVAL);
+    };
+
+    // Let the pipes drain. A background job that inherited them keeps them
+    // open; stop it at the deadline (or on cancel).
+    let mut drain_until = if status.is_some() {
+        deadline
+    } else {
+        Instant::now() + DRAIN_GRACE
+    };
+    let mut leftovers_killed = status.is_none();
+    while !(out.finished() && err.finished()) {
+        let now = Instant::now();
+        if !leftovers_killed && (now >= drain_until || is_cancelled()) {
+            kill_leftovers(pid);
+            leftovers_killed = true;
+            drain_until = now + DRAIN_GRACE;
+        } else if leftovers_killed && now >= drain_until {
+            // Something outside the group still holds a pipe; keep what
+            // was read so far.
+            break;
+        }
+        std::thread::sleep(POLL_INTERVAL);
+    }
+
+    Ok(RunOutput {
+        stdout: out.text(),
+        stderr: err.text(),
+        status,
+        timed_out,
+        cancelled,
+    })
+}
+
+/// [`run_command`] on the blocking thread pool, for async callers.
+pub async fn run_command_async(
+    cmd: Command,
+    timeout: Duration,
+    cancel: Option<CancelToken>,
+) -> std::io::Result<RunOutput> {
+    tokio::task::spawn_blocking(move || run_command(cmd, timeout, cancel.as_ref()))
+        .await
+        .unwrap_or_else(|e| Err(std::io::Error::other(e.to_string())))
+}
+
+/// Seconds from environment variable `key` if it holds a positive integer,
+/// else `default`.
+pub fn env_secs(key: &str, default: u64) -> u64 {
+    std::env::var(key)
+        .ok()
+        .and_then(|v| v.trim().parse::<u64>().ok())
+        .filter(|&n| n > 0)
+        .unwrap_or(default)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn sh(script: &str) -> Command {
+        let mut c = Command::new("bash");
+        c.arg("-c").arg(script);
+        c
+    }
+
+    #[test]
+    fn captures_output_and_status() {
+        let out = run_command(sh("echo out; echo err >&2; exit 3"), Duration::from_secs(10), None)
+            .unwrap();
+        assert_eq!(out.stdout, "out\n");
+        assert_eq!(out.stderr, "err\n");
+        assert_eq!(out.code(), Some(3));
+        assert!(!out.success());
+        assert!(!out.timed_out && !out.cancelled);
+        assert!(run_command(sh("true"), Duration::from_secs(10), None).unwrap().success());
+    }
+
+    #[test]
+    fn timeout_kills_the_whole_process_group() {
+        let dir = std::env::temp_dir().join(format!("acp-proc-test-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let marker = dir.join("survived");
+        let _ = std::fs::remove_file(&marker);
+        // A grandchild that would create the marker after 2s.
+        let script = format!(
+            "echo started; (sleep 2; touch '{}') & sleep 30",
+            marker.display()
+        );
+        let started = Instant::now();
+        let out = run_command(sh(&script), Duration::from_millis(500), None).unwrap();
+        assert!(out.timed_out);
+        assert!(out.status.is_none());
+        assert_eq!(out.stdout, "started\n");
+        assert!(started.elapsed() < Duration::from_secs(5), "took {:?}", started.elapsed());
+        std::thread::sleep(Duration::from_secs(3));
+        assert!(!marker.exists(), "grandchild outlived the timeout");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn cancel_stops_a_running_command() {
+        let token = CancelToken::new();
+        let t2 = token.clone();
+        std::thread::spawn(move || {
+            std::thread::sleep(Duration::from_millis(300));
+            t2.cancel();
+        });
+        let started = Instant::now();
+        let out = run_command(sh("sleep 30"), Duration::from_secs(60), Some(&token)).unwrap();
+        assert!(out.cancelled);
+        assert!(!out.success());
+        assert!(started.elapsed() < Duration::from_secs(5));
+    }
+
+    #[test]
+    fn background_job_holding_the_pipe_is_killed_at_the_deadline() {
+        let started = Instant::now();
+        let out = run_command(sh("echo hi; sleep 30 &"), Duration::from_secs(1), None).unwrap();
+        // The command itself succeeded; its leftover job was killed.
+        assert!(out.success(), "{out:?}");
+        assert_eq!(out.stdout, "hi\n");
+        assert!(started.elapsed() < Duration::from_secs(5));
+    }
+
+    #[tokio::test]
+    async fn cancel_token_wakes_waiters() {
+        let token = CancelToken::new();
+        assert!(!token.is_cancelled());
+        let t2 = token.clone();
+        let waiter = tokio::spawn(async move { t2.cancelled().await });
+        tokio::time::sleep(Duration::from_millis(50)).await;
+        token.cancel();
+        tokio::time::timeout(Duration::from_secs(2), waiter)
+            .await
+            .expect("waiter woke")
+            .unwrap();
+        assert!(token.is_cancelled());
+        // Already cancelled: resolves at once.
+        tokio::time::timeout(Duration::from_millis(100), token.cancelled())
+            .await
+            .unwrap();
+    }
+
+    #[test]
+    fn env_secs_parses_positive_integers() {
+        std::env::set_var("ACP_TEST_SECS", "7");
+        assert_eq!(env_secs("ACP_TEST_SECS", 3), 7);
+        std::env::set_var("ACP_TEST_SECS", "0");
+        assert_eq!(env_secs("ACP_TEST_SECS", 3), 3);
+        std::env::set_var("ACP_TEST_SECS", "x");
+        assert_eq!(env_secs("ACP_TEST_SECS", 3), 3);
+        std::env::remove_var("ACP_TEST_SECS");
+        assert_eq!(env_secs("ACP_TEST_SECS", 3), 3);
+    }
+}
