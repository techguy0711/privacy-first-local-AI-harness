+//! Session persistence: per-session history and notes on disk, so a client
+//! can come back to a conversation with `session/resume` after acp-bridge
+//! (or the editor) restarted.
+//!
+//! Layout: `<state_dir>/sessions/<session id>/`
+//! - `meta.json`: id, cwd, title, created / updated time, model, …
+//! - `history.jsonl`: the conversation as sent to the model, one message
+//!   per line, WITHOUT the system prompt (rebuilt from the current config on
+//!   resume); images replaced by `[image omitted]`
+//! - `NOTES.md`: the working notes
+//! - `.lock`: pid of the acp-bridge process using the session (stale once
+//!   that pid is gone or belongs to a process started after the lock)
+//!
+//! Directories are 0700, files 0600. Every string is redacted before it is
+//! written (values of key / token / secret environment variables, PEM
+//! private keys, well-known token prefixes). Disk errors are logged and
+//! never fail a turn. Retention: sessions older than `retention_days`
+//! (default 30; 0 = deleted on close, or a day after a crash), and beyond 200 sessions /
+//! 500 MB the oldest, are deleted at startup and daily; a session locked by
+//! a live process never is.
+
+use crate::notes::Notes;
+use serde::Deserialize;
+use serde_json::{json, Value};
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+use tracing::{debug, info, warn};
+
+/// Default days a stored session is kept.
+pub const DEFAULT_RETENTION_DAYS: u64 = 30;
+const MAX_SESSIONS: usize = 200;
+const MAX_BYTES: u64 = 500 * 1024 * 1024;
+/// Past this size, tool results are stored as a placeholder.
+const HISTORY_SOFT_CAP: u64 = 20 * 1024 * 1024;
+/// Page size of `session/list`.
+pub const LIST_PAGE: usize = 50;
+
+/// `[persist]` table of the config file.
+#[derive(Debug, Deserialize, Default, Clone)]
+pub struct PersistSection {
+    /// Default true (`LLM_PERSIST`).
+    pub enabled: Option<bool>,
+    /// Where sessions are stored; relative paths are relative to the config
+    /// file's directory (`LLM_STATE_DIR`: relative to the current
+    /// directory). Persistence needs one: there is no built-in default.
+    pub state_dir: Option<String>,
+    /// Days a session is kept (`LLM_SESSION_RETENTION_DAYS`, default 30;
+    /// 0 = delete a session's files when it is closed).
+    pub retention_days: Option<u64>,
+}
+
+/// Resolved persistence settings.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PersistSettings {
+    pub enabled: bool,
+    pub state_dir: Option<PathBuf>,
+    pub retention_days: u64,
+}
+
+impl Default for PersistSettings {
+    fn default() -> Self {
+        Self {
+            enabled: true,
+            state_dir: None,
+            retention_days: DEFAULT_RETENTION_DAYS,
+        }
+    }
+}
+
+impl PersistSettings {
+    pub fn resolve(file: &PersistSection, config_dir: Option<&Path>) -> Self {
+        let enabled = crate::config::env_bool("LLM_PERSIST")
+            .or(file.enabled)
+            .unwrap_or(true);
+        let state_dir = match std::env::var("LLM_STATE_DIR").ok().filter(|v| !v.trim().is_empty()) {
+            Some(v) => Some(std::path::absolute(v.trim()).unwrap_or_else(|_| PathBuf::from(v.trim()))),
+            None => file.state_dir.as_ref().filter(|v| !v.trim().is_empty()).map(|v| {
+                let p = PathBuf::from(v.trim());
+                if p.is_absolute() {
+                    p
+                } else {
+                    let base = config_dir.map(Path::to_path_buf).unwrap_or_else(|| PathBuf::from("."));
+                    normalize(&base.join(p))
+                }
+            }),
+        };
+        let retention_days = crate::config::env_parse::<u64>("LLM_SESSION_RETENTION_DAYS")
+            .or(file.retention_days)
+            .unwrap_or(DEFAULT_RETENTION_DAYS);
+        Self {
+            enabled,
+            state_dir,
+            retention_days,
+        }
+    }
+
+    /// Persistence is on: enabled and a state directory configured.
+    pub fn active(&self) -> bool {
+        self.enabled && self.state_dir.is_some()
+    }
+}
+
+/// `a/b/../c` -> `a/c` (lexically).
+fn normalize(p: &Path) -> PathBuf {
+    use std::path::Component;
+    let abs = std::path::absolute(p).unwrap_or_else(|_| p.to_path_buf());
+    let mut out = PathBuf::new();
+    for c in abs.components() {
+        match c {
+            Component::CurDir => {}
+            Component::ParentDir => {
+                out.pop();
+            }
+            other => out.push(other.as_os_str()),
+        }
+    }
+    out
+}
+
+/// RFC 3339 (UTC, seconds) for a time.
+pub fn rfc3339(t: SystemTime) -> String {
+    let secs = t.duration_since(UNIX_EPOCH).unwrap_or_default().as_secs() as i64;
+    let days = secs.div_euclid(86_400);
+    let rem = secs.rem_euclid(86_400);
+    // Civil date from days since 1970-01-01 (Howard Hinnant's algorithm).
+    let z = days + 719_468;
+    let era = z.div_euclid(146_097);
+    let doe = z.rem_euclid(146_097);
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+    let y = yoe + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 };
+    let y = if m <= 2 { y + 1 } else { y };
+    format!(
+        "{y:04}-{m:02}-{d:02}T{:02}:{:02}:{:02}Z",
+        rem / 3600,
+        (rem / 60) % 60,
+        rem % 60
+    )
+}
+
+fn now_unix() -> u64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_secs()
+}
+
+// ---------------------------------------------------------------------------
+// Redaction
+// ---------------------------------------------------------------------------
+
+/// Secret values from the environment (keys, tokens, secrets of 12 or more
+/// characters, plus LLM_API_KEY / BRAVE_API_KEY).
+fn env_secret_values() -> Vec<String> {
+    let mut v: Vec<String> = std::env::vars()
+        .filter(|(k, val)| {
+            let k = k.to_ascii_uppercase();
+            let named = k == "LLM_API_KEY" || k == "BRAVE_API_KEY";
+            let keyish = k.ends_with("_KEY") || k.ends_with("_TOKEN") || k.ends_with("_SECRET") || k.contains("PASSWORD");
+            (named && val.len() >= 6) || (keyish && val.len() >= 12)
+        })
+        .map(|(_, val)| val)
+        .collect();
+    v.sort_by_key(|s| std::cmp::Reverse(s.len()));
+    v
+}
+
+const TOKEN_PREFIXES: &[&str] = &["sk-", "ghp_", "gho_", "ghs_", "github_pat_", "xoxb-", "xoxp-", "xoxa-", "xoxs-", "AKIA", "AIza"];
+
+/// Redact secrets from one string.
+pub fn redact_str(text: &str, secrets: &[String]) -> String {
+    let mut out = text.to_string();
+    for s in secrets {
+        if !s.is_empty() && out.contains(s.as_str()) {
+            out = out.replace(s.as_str(), "[redacted]");
+        }
+    }
+    // PEM private keys.
+    while let Some(start) = out.find("-----BEGIN") {
+        let header_end = out[start..].find("-----\n").or_else(|| out[start + 10..].find("-----").map(|p| p + 10));
+        let is_key = out[start..].lines().next().is_some_and(|l| l.contains("PRIVATE KEY"));
+        if !is_key {
+            break;
+        }
+        let end = out[start..]
+            .find("-----END")
+            .and_then(|e| out[start + e + 8..].find("-----").map(|f| start + e + 8 + f + 5))
+            .unwrap_or(out.len());
+        let _ = header_end;
+        out.replace_range(start..end, "[redacted private key]");
+    }
+    // Well-known token prefixes.
+    for p in TOKEN_PREFIXES {
+        let mut from = 0;
+        while let Some(pos) = out[from..].find(p) {
+            let start = from + pos;
+            let before_ok = out[..start].chars().next_back().is_none_or(|c| !c.is_ascii_alphanumeric());
+            let len = out[start..]
+                .chars()
+                .take_while(|c| c.is_ascii_alphanumeric() || matches!(c, '-' | '_'))
+                .count();
+            if before_ok && len >= p.len() + 12 {
+                out.replace_range(start..start + len, "[redacted]");
+                from = start + "[redacted]".len();
+            } else {
+                from = start + p.len();
+            }
+        }
+    }
+    out
+}
+
+/// Redact every string in a message and replace images.
+pub fn sanitize_message(msg: &Value, secrets: &[String]) -> Value {
+    fn walk(v: &Value, secrets: &[String]) -> Value {
+        match v {
+            Value::String(s) => Value::String(redact_str(s, secrets)),
+            Value::Array(a) => Value::Array(
+                a.iter()
+                    .map(|p| {
+                        if p.get("type").and_then(Value::as_str) == Some("image_url") {
+                            json!({"type": "text", "text": "[image omitted]"})
+                        } else {
+                            walk(p, secrets)
+                        }
+                    })
+                    .collect(),
+            ),
+            Value::Object(o) => {
+                let mut out = serde_json::Map::new();
+                for (k, val) in o {
+                    if k == "images" {
+                        continue;
+                    }
+                    out.insert(k.clone(), walk(val, secrets));
+                }
+                if o.get("images").and_then(Value::as_array).is_some_and(|a| !a.is_empty()) {
+                    let n = o["images"].as_array().map_or(0, |a| a.len());
+                    let text = out.get("content").and_then(Value::as_str).unwrap_or("").to_string();
+                    out.insert("content".into(), Value::String(format!("{text}\n[{n} image(s) omitted]")));
+                }
+                Value::Object(out)
+            }
+            other => other.clone(),
+        }
+    }
+    walk(msg, secrets)
+}
+
+// ---------------------------------------------------------------------------
+// Store
+// ---------------------------------------------------------------------------
+
+/// A stored session's metadata.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Meta {
+    pub session_id: String,
+    pub cwd: String,
+    pub title: Option<String>,
+    pub created_at: String,
+    pub updated_at: String,
+    pub updated_unix: u64,
+    pub model: String,
+    pub protocol_version: u16,
+    pub summarized_upto: usize,
+    /// Web searches made in the session (its budget survives a restart).
+    pub web_searches: usize,
+}
+
+impl Meta {
+    fn to_json(&self) -> Value {
+        json!({
+            "format": 1,
+            "sessionId": self.session_id,
+            "cwd": self.cwd,
+            "title": self.title,
+            "createdAt": self.created_at,
+            "updatedAt": self.updated_at,
+            "updatedAtUnix": self.updated_unix,
+            "model": self.model,
+            "protocolVersion": self.protocol_version,
+            "acpBridgeVersion": env!("CARGO_PKG_VERSION"),
+            "summarizedUpto": self.summarized_upto,
+            "webSearches": self.web_searches,
+        })
+    }
+
+    fn from_json(v: &Value) -> Option<Self> {
+        Some(Self {
+            session_id: v.get("sessionId")?.as_str()?.to_string(),
+            cwd: v.get("cwd")?.as_str()?.to_string(),
+            title: v.get("title").and_then(Value::as_str).map(str::to_owned),
+            created_at: v.get("createdAt").and_then(Value::as_str).unwrap_or("").to_string(),
+            updated_at: v.get("updatedAt").and_then(Value::as_str).unwrap_or("").to_string(),
+            updated_unix: v.get("updatedAtUnix").and_then(Value::as_u64).unwrap_or(0),
+            model: v.get("model").and_then(Value::as_str).unwrap_or("").to_string(),
+            protocol_version: v.get("protocolVersion").and_then(Value::as_u64).unwrap_or(1) as u16,
+            summarized_upto: v.get("summarizedUpto").and_then(Value::as_u64).unwrap_or(0) as usize,
+            web_searches: v.get("webSearches").and_then(Value::as_u64).unwrap_or(0) as usize,
+        })
+    }
+
+    /// ACP `SessionInfo`.
+    pub fn session_info(&self) -> Value {
+        json!({"sessionId": self.session_id, "cwd": self.cwd, "title": self.title, "updatedAt": self.updated_at})
+    }
+}
+
+/// A session read back from disk.
+#[derive(Debug, Clone)]
+pub struct Loaded {
+    pub meta: Meta,
+    /// History without the system prompt (dangling tool calls answered).
+    pub history: Vec<Value>,
+    pub notes: Notes,
+}
+
+/// Why a session could not be read back.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum LoadError {
+    NotFound,
+    InUse(u32),
+    Io(String),
+}
+
+/// The on-disk session store.
+#[derive(Debug)]
+pub struct Store {
+    root: PathBuf,
+    pub retention_days: u64,
+}
+
+#[cfg(unix)]
+fn set_mode(path: &Path, mode: u32) {
+    use std::os::unix::fs::PermissionsExt;
+    let _ = std::fs::set_permissions(path, std::fs::Permissions::from_mode(mode));
+}
+#[cfg(not(unix))]
+fn set_mode(_: &Path, _: u32) {}
+
+fn write_private(path: &Path, contents: &[u8]) -> std::io::Result<()> {
+    let tmp = path.with_extension("tmp");
+    {
+        let mut opts = std::fs::OpenOptions::new();
+        opts.create(true).write(true).truncate(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            opts.mode(0o600);
+        }
+        let mut f = opts.open(&tmp)?;
+        f.write_all(contents)?;
+        f.flush()?;
+    }
+    std::fs::rename(&tmp, path)
+}
+
+/// Whether a process is alive.
+pub fn pid_alive(pid: u32) -> bool {
+    #[cfg(unix)]
+    {
+        extern "C" {
+            fn kill(pid: i32, sig: i32) -> i32;
+        }
+        // SAFETY: signal 0 only checks that the process exists.
+        let Ok(p) = i32::try_from(pid) else { return false };
+        unsafe { kill(p, 0) == 0 || std::io::Error::last_os_error().raw_os_error() == Some(1) }
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = pid;
+        false
+    }
+}
+
+/// Seconds since `pid` started, from `ps -o etime=` (`[[dd-]hh:]mm:ss`).
+/// `None` when `ps` cannot tell.
+fn process_age_secs(pid: u32) -> Option<u64> {
+    let ps = if Path::new("/bin/ps").exists() { "/bin/ps" } else { "ps" };
+    let out = std::process::Command::new(ps)
+        .args(["-o", "etime=", "-p", &pid.to_string()])
+        .env("LC_ALL", "C")
+        .stdin(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .output()
+        .ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    parse_etime(String::from_utf8_lossy(&out.stdout).trim())
+}
+
+/// `[[dd-]hh:]mm:ss` -> seconds.
+fn parse_etime(s: &str) -> Option<u64> {
+    let (days, rest) = match s.split_once('-') {
+        Some((d, r)) => (d.trim().parse::<u64>().ok()?, r),
+        None => (0, s),
+    };
+    let parts: Vec<u64> = rest.split(':').map(|p| p.trim().parse().ok()).collect::<Option<_>>()?;
+    let secs = match parts.as_slice() {
+        [m, s] => m * 60 + s,
+        [h, m, s] => h * 3600 + m * 60 + s,
+        _ => return None,
+    };
+    Some(days * 86_400 + secs)
+}
+
+/// Whether the `.lock` at `path`, naming `pid`, is held by a live process.
+/// A lock is stale when the pid is gone, or when the process now using that
+/// pid started after the lock was written (the pid was reused after the
+/// holder died, e.g. by SIGKILL). When `ps` cannot tell, a live pid holds it.
+fn lock_held(path: &Path, pid: u32) -> bool {
+    if !pid_alive(pid) {
+        return false;
+    }
+    let written = std::fs::metadata(path)
+        .and_then(|m| m.modified())
+        .ok()
+        .and_then(|t| t.duration_since(UNIX_EPOCH).ok())
+        .map(|d| d.as_secs());
+    match (written, process_age_secs(pid)) {
+        (Some(written), Some(age)) => now_unix().saturating_sub(age) <= written + 2,
+        _ => true,
+    }
+}
+
+/// The pid in a session's `.lock` when a live process other than this one
+/// holds it.
+fn other_holder(lock: &Path) -> Option<u32> {
+    let pid = std::fs::read_to_string(lock).ok()?.trim().parse::<u32>().ok()?;
+    (pid != std::process::id() && lock_held(lock, pid)).then_some(pid)
+}
+
+/// True for a session id we could have minted (a UUID): blocks `../x`.
+pub fn valid_id(id: &str) -> bool {
+    uuid::Uuid::parse_str(id).is_ok() && id.len() == 36
+}
+
+impl Store {
+    /// Open (and create) `<state_dir>/sessions`; `None` when persistence is
+    /// off or the directory cannot be created.
+    pub fn open(settings: &PersistSettings) -> Option<Self> {
+        if !settings.active() {
+            return None;
+        }
+        let state = settings.state_dir.clone()?;
+        let root = state.join("sessions");
+        if let Err(e) = std::fs::create_dir_all(&root) {
+            warn!(dir = %root.display(), error = %e, "Session persistence off: cannot create the state directory");
+            return None;
+        }
+        set_mode(&state, 0o700);
+        set_mode(&root, 0o700);
+        info!(dir = %root.display(), retention_days = settings.retention_days, "Session persistence on");
+        Some(Self {
+            root,
+            retention_days: settings.retention_days,
+        })
+    }
+
+    pub fn root(&self) -> &Path {
+        &self.root
+    }
+
+    pub fn dir(&self, id: &str) -> PathBuf {
+        self.root.join(id)
+    }
+
+    pub fn exists(&self, id: &str) -> bool {
+        valid_id(id) && self.dir(id).join("meta.json").is_file()
+    }
+
+    /// Start storing a new session.
+    pub fn create(&self, meta: &Meta) {
+        let dir = self.dir(&meta.session_id);
+        if let Err(e) = std::fs::create_dir_all(&dir) {
+            warn!(error = %e, "Cannot create the session directory");
+            return;
+        }
+        set_mode(&dir, 0o700);
+        let _ = self.lock(&meta.session_id);
+        self.write_meta(meta);
+    }
+
+    pub fn write_meta(&self, meta: &Meta) {
+        let path = self.dir(&meta.session_id).join("meta.json");
+        let secrets = env_secret_values();
+        let v = sanitize_message(&meta.to_json(), &secrets);
+        if let Err(e) = write_private(&path, format!("{v:#}\n").as_bytes()) {
+            warn!(error = %e, "Cannot write session meta.json");
+        }
+    }
+
+    pub fn write_notes(&self, id: &str, notes: &Notes) {
+        let path = self.dir(id).join("NOTES.md");
+        let text = redact_str(&notes.render(), &env_secret_values());
+        if let Err(e) = write_private(&path, text.as_bytes()) {
+            warn!(error = %e, "Cannot write NOTES.md");
+        }
+    }
+
+    /// Append messages to `history.jsonl` (one line each, flushed).
+    pub fn append(&self, id: &str, messages: &[Value]) {
+        if messages.is_empty() {
+            return;
+        }
+        let path = self.dir(id).join("history.jsonl");
+        let big = std::fs::metadata(&path).is_ok_and(|m| m.len() > HISTORY_SOFT_CAP);
+        let secrets = env_secret_values();
+        let mut opts = std::fs::OpenOptions::new();
+        opts.create(true).append(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            opts.mode(0o600);
+        }
+        let mut f = match opts.open(&path) {
+            Ok(f) => f,
+            Err(e) => {
+                warn!(error = %e, "Cannot write history.jsonl");
+                return;
+            }
+        };
+        for m in messages {
+            let mut m = sanitize_message(m, &secrets);
+            if big && m.get("role").and_then(Value::as_str) == Some("tool") {
+                let n = m.get("content").and_then(Value::as_str).map_or(0, |c| c.chars().count());
+                m["content"] = json!(format!("[{n} characters omitted: the stored history is over 20 MB]"));
+            }
+            if writeln!(f, "{m}").and_then(|_| f.flush()).is_err() {
+                warn!("Cannot append to history.jsonl");
+                return;
+            }
+        }
+    }
+
+    /// Take the session's lock for this process (a stale lock of a dead
+    /// process is taken over).
+    pub fn lock(&self, id: &str) -> Result<(), LoadError> {
+        let path = self.dir(id).join(".lock");
+        if let Some(pid) = other_holder(&path) {
+            return Err(LoadError::InUse(pid));
+        }
+        write_private(&path, std::process::id().to_string().as_bytes()).map_err(|e| LoadError::Io(e.to_string()))
+    }
+
+    /// Release the session's lock if this process holds it.
+    pub fn unlock(&self, id: &str) {
+        let path = self.dir(id).join(".lock");
+        if std::fs::read_to_string(&path).is_ok_and(|t| t.trim() == std::process::id().to_string()) {
+            let _ = std::fs::remove_file(path);
+        }
+    }
+
+    /// Delete a session's files (retention 0).
+    pub fn delete(&self, id: &str) {
+        if valid_id(id) {
+            let _ = std::fs::remove_dir_all(self.dir(id));
+        }
+    }
+
+    pub fn read_meta(&self, id: &str) -> Option<Meta> {
+        let text = std::fs::read_to_string(self.dir(id).join("meta.json")).ok()?;
+        Meta::from_json(&serde_json::from_str(&text).ok()?)
+    }
+
+    /// Read a session back (and lock it for this process).
+    pub fn load(&self, id: &str) -> Result<Loaded, LoadError> {
+        if !self.exists(id) {
+            return Err(LoadError::NotFound);
+        }
+        let meta = self.read_meta(id).ok_or(LoadError::NotFound)?;
+        self.lock(id)?;
+        let text = std::fs::read_to_string(self.dir(id).join("history.jsonl")).unwrap_or_default();
+        let mut history: Vec<Value> = Vec::new();
+        let lines: Vec<&str> = text.lines().collect();
+        for (i, line) in lines.iter().enumerate() {
+            match serde_json::from_str::<Value>(line) {
+                Ok(v) => history.push(v),
+                // A crash can leave a partial last line.
+                Err(_) if i + 1 == lines.len() => debug!("Skipping a partial last history line"),
+                Err(e) => warn!(line = i + 1, error = %e, "Skipping a corrupt history line"),
+            }
+        }
+        answer_dangling_calls(&mut history);
+        let notes = std::fs::read_to_string(self.dir(id).join("NOTES.md"))
+            .map(|t| Notes::parse(&t))
+            .unwrap_or_default();
+        Ok(Loaded { meta, history, notes })
+    }
+
+    /// Stored sessions with at least one message, newest first, optionally
+    /// only those of `cwd`.
+    pub fn list(&self, cwd: Option<&str>) -> Vec<Meta> {
+        let mut out: Vec<Meta> = std::fs::read_dir(&self.root)
+            .map(|rd| {
+                rd.filter_map(|e| e.ok())
+                    .filter(|e| e.path().join("history.jsonl").is_file())
+                    .filter_map(|e| self.read_meta(&e.file_name().to_string_lossy()))
+                    .filter(|m| cwd.is_none_or(|c| m.cwd == c))
+                    .collect()
+            })
+            .unwrap_or_default();
+        out.sort_by_key(|m| std::cmp::Reverse(m.updated_unix));
+        out
+    }
+
+    /// Delete sessions past the retention (sessions that never got a
+    /// message, and with `retention_days = 0` sessions left unclosed, after
+    /// a day), then the oldest beyond 200 sessions / 500 MB.
+    /// Sessions locked by a live process are kept.
+    pub fn cleanup(&self) -> usize {
+        let mut entries: Vec<(PathBuf, u64, u64)> = Vec::new(); // (dir, updated, bytes)
+        for e in std::fs::read_dir(&self.root).into_iter().flatten().filter_map(|e| e.ok()) {
+            let dir = e.path();
+            let name = e.file_name().to_string_lossy().into_owned();
+            if !valid_id(&name) || !dir.is_dir() {
+                continue;
+            }
+            // Held by a live process (this one included): kept.
+            let held = std::fs::read_to_string(dir.join(".lock"))
+                .ok()
+                .and_then(|t| t.trim().parse::<u32>().ok())
+                .is_some_and(|pid| pid == std::process::id() || lock_held(&dir.join(".lock"), pid));
+            if held {
+                continue;
+            }
+            let updated = self.read_meta(&name).map(|m| m.updated_unix).filter(|&u| u > 0).unwrap_or_else(|| {
+                e.metadata()
+                    .and_then(|m| m.modified())
+                    .ok()
+                    .and_then(|t| t.duration_since(UNIX_EPOCH).ok())
+                    .map_or(0, |d| d.as_secs())
+            });
+            let bytes: u64 = std::fs::read_dir(&dir)
+                .into_iter()
+                .flatten()
+                .filter_map(|f| f.ok()?.metadata().ok())
+                .map(|m| m.len())
+                .sum();
+            entries.push((dir, updated, bytes));
+        }
+        entries.sort_by_key(|(_, u, _)| *u);
+        let now = now_unix();
+        let max_age = self.retention_days.saturating_mul(86_400);
+        let mut removed = 0;
+        let mut keep: Vec<(PathBuf, u64, u64)> = Vec::new();
+        for (dir, updated, bytes) in entries {
+            let age = now.saturating_sub(updated);
+            let empty = !dir.join("history.jsonl").exists();
+            // retention_days = 0: sessions are deleted when closed; one
+            // left behind (crash, SIGKILL, never closed) goes after a day.
+            let max_age = if self.retention_days == 0 { 86_400 } else { max_age };
+            if age > max_age || (empty && age > 86_400) {
+                if std::fs::remove_dir_all(&dir).is_ok() {
+                    removed += 1;
+                }
+            } else {
+                keep.push((dir, updated, bytes));
+            }
+        }
+        let mut total: u64 = keep.iter().map(|(_, _, b)| b).sum();
+        let mut count = keep.len();
+        for (dir, _, bytes) in keep {
+            if count <= MAX_SESSIONS && total <= MAX_BYTES {
+                break;
+            }
+            if std::fs::remove_dir_all(&dir).is_ok() {
+                removed += 1;
+                count -= 1;
+                total = total.saturating_sub(bytes);
+            }
+        }
+        if removed > 0 {
+            info!(removed, "Deleted old stored sessions");
+        }
+        removed
+    }
+
+    /// Run [`cleanup`](Self::cleanup) now and then daily, in the background.
+    pub fn spawn_cleanup(store: std::sync::Arc<Store>) {
+        tokio::spawn(async move {
+            loop {
+                let s = std::sync::Arc::clone(&store);
+                let _ = tokio::task::spawn_blocking(move || s.cleanup()).await;
+                tokio::time::sleep(Duration::from_secs(86_400)).await;
+            }
+        });
+    }
+}
+
+/// Make the stored history valid for the model again: an assistant message
+/// whose tool calls have no results (the process died mid-turn) gets
+/// "Not run" results.
+pub fn answer_dangling_calls(history: &mut Vec<Value>) {
+    let mut i = 0;
+    while i < history.len() {
+        let calls: Vec<Value> = history[i]
+            .get("tool_calls")
+            .and_then(Value::as_array)
+            .cloned()
+            .unwrap_or_default();
+        if history[i].get("role").and_then(Value::as_str) == Some("assistant") && !calls.is_empty() {
+            let mut have = 0;
+            while have < calls.len()
+                && history.get(i + 1 + have).and_then(|m| m.get("role")).and_then(Value::as_str) == Some("tool")
+            {
+                have += 1;
+            }
+            for (k, call) in calls.iter().enumerate().skip(have) {
+                let mut result = json!({"role": "tool", "content": "Not run: the session was interrupted."});
+                if let Some(id) = call.get("id").and_then(Value::as_str) {
+                    result["tool_call_id"] = json!(id);
+                }
+                history.insert(i + 1 + k, result);
+            }
+            i += calls.len() + 1;
+        } else {
+            i += 1;
+        }
+    }
+}
