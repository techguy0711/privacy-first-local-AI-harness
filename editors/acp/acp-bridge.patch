diff --git a/tests/tooling_test.rs b/tests/tooling_test.rs
new file mode 100644
index 0000000..f74d096
--- /dev/null
+++ b/tests/tooling_test.rs
@@ -0,0 +1,2308 @@
+//! End-to-end tests for the agent tooling (quick fixes, guards, Xcode
+//! aliases, loop check, rawOutput, notes, MCP / xcode-tools, web search,
+//! persistence). Each test spawns the acp-bridge binary, talks ACP over
+//! stdin/stdout, and points it at a scripted mock LLM (and, where needed,
+//! the `mock_mcp_server` example playing Xcode's mcpbridge or the Brave MCP
+//! server). Nothing here talks to Ollama, Xcode or the network.
+
+use axum::{
+    body::Body,
+    extract::{Request, State},
+    response::IntoResponse,
+    routing::{get, post},
+    Router,
+};
+use serde_json::{json, Value};
+use std::io::{BufRead, BufReader, Write};
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::sync::mpsc as std_mpsc;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+// ---------------------------------------------------------------------------
+// Scripted mock LLM
+// ---------------------------------------------------------------------------
+
+/// One reply of the mock LLM.
+#[derive(Clone, Debug)]
+pub enum Reply {
+    /// `choices[0].message` (OpenAI shape) with `finish_reason`.
+    Message(Value, &'static str),
+    /// Sleep, then answer with the inner reply.
+    Delay(Duration, Box<Reply>),
+    /// Plain HTTP status with no body.
+    Status(u16),
+}
+
+/// Decides the reply to request number `n` (0-based) from its body.
+pub type Responder = Arc<dyn Fn(&Value, usize) -> Reply + Send + Sync>;
+
+/// Every request body the mock received.
+pub type Recorded = Arc<Mutex<Vec<Value>>>;
+
+#[derive(Clone)]
+struct MockState {
+    responder: Responder,
+    recorded: Recorded,
+}
+
+fn mock_router(responder: Responder) -> (Router, Recorded) {
+    let recorded: Recorded = Arc::default();
+    let state = MockState {
+        responder,
+        recorded: Arc::clone(&recorded),
+    };
+    let router = Router::new()
+        .route("/v1/models", get(|| async { axum::Json(json!({"data": [{"id": "test-model"}]})) }))
+        .route("/api/tags", get(|| async { axum::Json(json!({"models": [{"name": "test-model"}]})) }))
+        .route("/v1/chat/completions", post(mock_chat))
+        .with_state(state);
+    (router, recorded)
+}
+
+async fn mock_chat(State(st): State<MockState>, req: Request<Body>) -> axum::response::Response {
+    let bytes = axum::body::to_bytes(req.into_body(), 16 * 1024 * 1024)
+        .await
+        .unwrap();
+    let body: Value = serde_json::from_slice(&bytes).unwrap();
+    let n = {
+        let mut r = st.recorded.lock().unwrap();
+        r.push(body.clone());
+        r.len() - 1
+    };
+    let mut reply = (st.responder)(&body, n);
+    loop {
+        match reply {
+            Reply::Delay(d, inner) => {
+                tokio::time::sleep(d).await;
+                reply = *inner;
+            }
+            Reply::Status(code) => {
+                return axum::http::StatusCode::from_u16(code).unwrap().into_response();
+            }
+            Reply::Message(message, finish) => {
+                return axum::Json(json!({"choices": [{"message": message, "finish_reason": finish}]}))
+                    .into_response();
+            }
+        }
+    }
+}
+
+/// A fixed script: request N gets `script[N]`, the last entry repeats.
+pub fn script(replies: Vec<Reply>) -> Responder {
+    Arc::new(move |_, n| replies.get(n).or(replies.last()).cloned().unwrap())
+}
+
+pub fn tool_call(id: &str, name: &str, args: Value) -> Reply {
+    Reply::Message(
+        json!({"role": "assistant", "content": "", "reasoning": format!("Call {name}."),
+               "tool_calls": [{"id": id, "type": "function",
+                               "function": {"name": name, "arguments": args.to_string()}}]}),
+        "tool_calls",
+    )
+}
+
+pub fn answer(text: &str) -> Reply {
+    Reply::Message(json!({"role": "assistant", "content": text}), "stop")
+}
+
+// ---------------------------------------------------------------------------
+// acp-bridge process
+// ---------------------------------------------------------------------------
+
+pub struct Bridge {
+    child: Child,
+    rx: std_mpsc::Receiver<Value>,
+    pub stderr: Arc<Mutex<String>>,
+    _server: Option<tokio::task::JoinHandle<()>>,
+    next_id: u64,
+}
+
+pub async fn serve(router: Router) -> (String, tokio::task::JoinHandle<()>) {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    let handle = tokio::spawn(async move {
+        axum::serve(listener, router).await.unwrap();
+    });
+    (format!("http://{addr}"), handle)
+}
+
+impl Bridge {
+    /// Start the mock LLM with `responder` and acp-bridge pointed at it.
+    pub async fn start(responder: Responder, env: &[(&str, &str)]) -> (Self, Recorded) {
+        Self::start_with_config(responder, env, None).await
+    }
+
+    /// [`start`](Self::start) with a config file argument.
+    pub async fn start_with_config(
+        responder: Responder,
+        env: &[(&str, &str)],
+        config: Option<&Path>,
+    ) -> (Self, Recorded) {
+        let (router, recorded) = mock_router(responder);
+        let (url, handle) = serve(router).await;
+        let mut all: Vec<(String, String)> = vec![("LLM_BASE_URL".into(), format!("{url}/v1"))];
+        all.extend(env.iter().map(|(k, v)| (k.to_string(), v.to_string())));
+        let mut b = Self::spawn(&all, config);
+        b._server = Some(handle);
+        (b, recorded)
+    }
+
+    /// Read messages until one satisfies `pred`; returns all read so far
+    /// (they are not seen again by later reads).
+    pub fn wait_for(&mut self, timeout: Duration, pred: impl Fn(&Value) -> bool) -> Vec<Value> {
+        let deadline = Instant::now() + timeout;
+        let mut seen = Vec::new();
+        loop {
+            let left = deadline.saturating_duration_since(Instant::now());
+            let msg = self.rx.recv_timeout(left).unwrap_or_else(|_| {
+                panic!("condition not met within {timeout:?}; got {seen:#?}\nstderr:\n{}", self.stderr())
+            });
+            let hit = pred(&msg);
+            seen.push(msg);
+            if hit {
+                return seen;
+            }
+        }
+    }
+
+    /// Spawn acp-bridge with `env` (and an optional config file argument).
+    pub fn spawn(env: &[(String, String)], config: Option<&Path>) -> Self {
+        let mut cmd = Command::new(env!("CARGO_BIN_EXE_acp-bridge"));
+        cmd.stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .env("LLM_MODEL", "test-model")
+            .env("LLM_API_KEY", "test-key")
+            .env("LLM_TIMEOUT", "20")
+            .env("LLM_VERIFY", "off")
+            .env("RUST_LOG", "acp_bridge=debug")
+            // Keep tests hermetic: no web search / persistence unless a
+            // test turns them on.
+            .env("LLM_WEB_SEARCH", "off")
+            .env("LLM_PERSIST", "0")
+            .env_remove("LLM_WEB_ALLOWLIST");
+        for (k, v) in env {
+            cmd.env(k, v);
+        }
+        if let Some(c) = config {
+            cmd.arg(c);
+        }
+        let mut child = cmd.spawn().expect("spawn acp-bridge");
+        let stdout = child.stdout.take().unwrap();
+        let stderr = child.stderr.take().unwrap();
+        let (tx, rx) = std_mpsc::channel();
+        std::thread::spawn(move || {
+            for line in BufReader::new(stdout).lines() {
+                let Ok(line) = line else { break };
+                if line.trim().is_empty() {
+                    continue;
+                }
+                match serde_json::from_str::<Value>(&line) {
+                    Ok(v) => {
+                        if tx.send(v).is_err() {
+                            break;
+                        }
+                    }
+                    Err(_) => panic!("invalid JSON on stdout: {line}"),
+                }
+            }
+        });
+        let log = Arc::new(Mutex::new(String::new()));
+        let log2 = Arc::clone(&log);
+        std::thread::spawn(move || {
+            for line in BufReader::new(stderr).lines() {
+                let Ok(line) = line else { break };
+                let mut l = log2.lock().unwrap();
+                l.push_str(&strip_ansi(&line));
+                l.push('\n');
+            }
+        });
+        Self {
+            child,
+            rx,
+            stderr: log,
+            _server: None,
+            next_id: 100,
+        }
+    }
+
+    pub fn pid(&self) -> u32 {
+        self.child.id()
+    }
+
+    pub fn send(&mut self, msg: &Value) {
+        let stdin = self.child.stdin.as_mut().unwrap();
+        writeln!(stdin, "{msg}").unwrap();
+        stdin.flush().unwrap();
+    }
+
+    /// Send a request and return its id.
+    pub fn request(&mut self, method: &str, params: Value) -> u64 {
+        self.next_id += 1;
+        let id = self.next_id;
+        self.send(&json!({"jsonrpc": "2.0", "id": id, "method": method, "params": params}));
+        id
+    }
+
+    /// Messages up to and including the response to `id`.
+    pub fn until_response(&mut self, id: u64, timeout: Duration) -> (Vec<Value>, Value) {
+        let deadline = Instant::now() + timeout;
+        let mut notes = Vec::new();
+        loop {
+            let left = deadline.saturating_duration_since(Instant::now());
+            let msg = self.rx.recv_timeout(left).unwrap_or_else(|_| {
+                panic!(
+                    "no response to {id} within {timeout:?}; got {notes:#?}\nstderr:\n{}",
+                    self.stderr()
+                )
+            });
+            if msg.get("id") == Some(&json!(id)) && msg.get("method").is_none() {
+                return (notes, msg);
+            }
+            notes.push(msg);
+        }
+    }
+
+    /// Request + wait for its response.
+    pub fn call(&mut self, method: &str, params: Value) -> (Vec<Value>, Value) {
+        let id = self.request(method, params);
+        self.until_response(id, Duration::from_secs(60))
+    }
+
+    pub fn initialize(&mut self, version: u64) -> Value {
+        self.call("initialize", json!({"protocolVersion": version})).1
+    }
+
+    pub fn new_session(&mut self, cwd: &str, mcp: Value) -> String {
+        let (_, r) = self.call("session/new", json!({"cwd": cwd, "mcpServers": mcp}));
+        r["result"]["sessionId"]
+            .as_str()
+            .unwrap_or_else(|| panic!("session/new failed: {r}"))
+            .to_string()
+    }
+
+    pub fn prompt(&mut self, sid: &str, text: &str) -> (Vec<Value>, Value) {
+        let id = self.request(
+            "session/prompt",
+            json!({"sessionId": sid, "prompt": [{"type": "text", "text": text}]}),
+        );
+        self.until_response(id, Duration::from_secs(90))
+    }
+
+    pub fn stderr(&self) -> String {
+        self.stderr.lock().unwrap().clone()
+    }
+
+    /// Kill the process (SIGKILL: no clean shutdown, like a crash).
+    pub fn kill(mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+
+    /// Close stdin and wait for the process to exit.
+    pub fn shutdown(mut self) -> String {
+        drop(self.child.stdin.take());
+        let deadline = Instant::now() + Duration::from_secs(20);
+        while Instant::now() < deadline {
+            if let Ok(Some(_)) = self.child.try_wait() {
+                break;
+            }
+            std::thread::sleep(Duration::from_millis(50));
+        }
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+        std::thread::sleep(Duration::from_millis(100));
+        self.stderr()
+    }
+}
+
+impl Drop for Bridge {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+/// `line` without ANSI color escapes (tracing colors its output).
+pub fn strip_ansi(line: &str) -> String {
+    let mut out = String::with_capacity(line.len());
+    let mut chars = line.chars().peekable();
+    while let Some(c) = chars.next() {
+        if c == '\u{1b}' && chars.peek() == Some(&'[') {
+            chars.next();
+            for c in chars.by_ref() {
+                if c.is_ascii_alphabetic() {
+                    break;
+                }
+            }
+        } else {
+            out.push(c);
+        }
+    }
+    out
+}
+
+pub fn updates<'a>(notifications: &'a [Value], kind: &str) -> Vec<&'a Value> {
+    notifications
+        .iter()
+        .filter(|n| n["params"]["update"]["sessionUpdate"] == kind)
+        .map(|n| &n["params"]["update"])
+        .collect()
+}
+
+pub fn tool_names(request: &Value) -> Vec<String> {
+    request["tools"]
+        .as_array()
+        .map(|t| {
+            t.iter()
+                .filter_map(|d| d["function"]["name"].as_str().map(str::to_owned))
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+pub fn fresh_dir(tag: &str) -> PathBuf {
+    static N: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+    let dir = std::env::temp_dir().join(format!(
+        "acp-tooling-{tag}-{}-{}-{}",
+        std::process::id(),
+        N.fetch_add(1, std::sync::atomic::Ordering::SeqCst),
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos()
+    ));
+    std::fs::create_dir_all(&dir).unwrap();
+    dir
+}
+
+/// The tool result messages (`role: tool`) in a request body.
+pub fn tool_results(request: &Value) -> Vec<String> {
+    request["messages"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .filter(|m| m["role"] == "tool")
+        .map(|m| m["content"].as_str().unwrap_or("").to_string())
+        .collect()
