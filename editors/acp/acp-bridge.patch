+/// Resolved MCP settings.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct McpSettings {
+    pub enabled: bool,
+    /// Use servers the client passes (allowlisted commands only).
+    pub client_servers: bool,
+    pub allowed_commands: Vec<String>,
+    pub allow_client_http: bool,
+    pub connect_timeout_secs: u64,
+    pub web_search: bool,
+    pub tools: HashMap<String, ToolPolicy>,
+    pub servers: Vec<ServerConfig>,
+}
+
+impl Default for McpSettings {
+    fn default() -> Self {
+        let mut tools = HashMap::new();
+        tools.insert(XCODE_TOOLS.to_string(), default_xcode_policy());
+        Self {
+            enabled: true,
+            client_servers: true,
+            allowed_commands: default_allowed_commands(),
+            allow_client_http: false,
+            connect_timeout_secs: 30,
+            web_search: true,
+            tools,
+            servers: Vec::new(),
+        }
+    }
+}
+
+impl McpSettings {
+    /// File values overridden by `LLM_MCP` and `LLM_WEB_SEARCH`.
+    pub fn resolve(file: &McpSection) -> Self {
+        let d = Self::default();
+        let mut tools = d.tools.clone();
+        for (server, p) in &file.tools {
+            let base = tools.get(server).cloned().unwrap_or(ToolPolicy {
+                allow: Vec::new(),
+                expose: Vec::new(),
+                call_timeout_secs: 60,
+            });
+            tools.insert(
+                server.clone(),
+                ToolPolicy {
+                    allow: p.allow.clone().unwrap_or(base.allow),
+                    expose: p.expose.clone().unwrap_or(base.expose),
+                    call_timeout_secs: p.call_timeout_secs.unwrap_or(base.call_timeout_secs),
+                },
+            );
+        }
+        let enabled = crate::config::env_bool("LLM_MCP")
+            .or(file.enabled)
+            .unwrap_or(true);
+        let web_search = crate::config::env_bool("LLM_WEB_SEARCH")
+            .or(file.web_search)
+            .unwrap_or(true);
+        Self {
+            enabled,
+            client_servers: !matches!(
+                file.client_servers.as_deref().map(str::trim),
+                Some("off" | "none" | "false")
+            ),
+            allowed_commands: file.allowed_commands.clone().unwrap_or(d.allowed_commands),
+            allow_client_http: file.allow_client_http.unwrap_or(false),
+            connect_timeout_secs: file.connect_timeout_secs.filter(|&n| n > 0).unwrap_or(30),
+            web_search,
+            tools,
+            servers: file.servers.clone(),
+        }
+    }
+
+    /// Tool policy for a server (unknown servers: nothing allowed).
+    pub fn policy(&self, server: &str) -> ToolPolicy {
+        self.tools.get(server).cloned().unwrap_or(ToolPolicy {
+            allow: Vec::new(),
+            expose: Vec::new(),
+            call_timeout_secs: 60,
+        })
+    }
+}
