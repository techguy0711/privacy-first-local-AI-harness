+import SwiftUI
+import SpriteKit
+
+struct GameView: View {
+    @State private var isFolded: Bool = true
+    
+    var body: some View {
+        GeometryReader { geometry in
+            ZStack {
+                SKViewRepresentable(
+                    gameScene: GameScene(size: geometry.size),
+                    isFolded: $isFolded
+                )
+                .ignoresSafeArea()
+                
+                if isFolded {
+                    Rectangle()
+                        .fill(Color.black.opacity(0.2))
+                        .frame(height: geometry.size.height * 0.5)
+                        .offset(y: geometry.size.height * 0.25)
+                }
+                
+                VStack {
+                    Spacer()
+                    Button("Toggle Fold") {
+                        isFolded.toggle()
+                    }
+                    .padding()
+                    .background(Color.white.opacity(0.7))
+                    .cornerRadius(10)
+                    .padding()
+                }
+            }
+        }
+    }
+}
+
+struct SKViewRepresentable: UIViewRepresentable {
+    let gameScene: GameScene
+    @Binding var isFolded: Bool
+    
+    func makeUIView(context: Context) -> SKView {
+        let skView = SKView(frame: .zero)
+        skView.scene = gameScene
+        skView.scaleMode = .fill
+        
+        let tapGesture = UITapGestureRecognizer(target: context.coordinator, action: #selector(Coordinator.handleTap(_:)))
+        skView.addGestureRecognizer(tapGesture)
+        
+        return skView
+    }
+    
+    func updateUIView(_ uiView: SKView, context: Context) {
+        // Update scene properties if needed
+    }
+    
+    func makeCoordinator() -> Coordinator {
+        Coordinator(gameScene: gameScene, isFolded: &isFolded)
+    }
+    
+    class Coordinator: NSObject {
+        var gameScene: GameScene
+        var isFolded: Binding<Bool>
+        
+        init(gameScene: GameScene, isFolded: Binding<Bool>) {
+            self.gameScene = gameScene
+            self.isFolded = isFolded
+        }
+        
+        @objc func handleTap(_ gesture: UITapGestureRecognizer) {
+            let location = gesture.location(in: gesture.view)
+            let scenePoint = gameScene.convertPoint(fromView: location)
+            gameScene.handleTap(at: scenePoint, isFolded: isFolded.wrappedValue)
+        }
+    }
+}
