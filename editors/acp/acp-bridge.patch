+    let c = connect(&[("MOCK_LOG", log.to_str().unwrap()), ("MOCK_PING", "1"), ("MOCK_UNKNOWN_REQUEST", "1")]).await;
+    // Give the reader time to answer.
+    c.call("Sleep", json!({"ms": 100}), Duration::from_secs(5), None, None).await.unwrap();
+    let lines = log_lines(&log);
+    let answers: Vec<&Value> = lines.iter().map(|l| &l["msg"]).filter(|m| m["id"].is_string()).collect();
+    let ping = answers.iter().find(|m| m["id"] == "srv-ping").expect("ping answered");
+    assert_eq!(ping["result"], json!({}));
+    let refused = answers.iter().find(|m| m["id"] == "srv-sample").expect("request refused");
+    assert_eq!(refused["error"]["code"], -32601);
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+#[tokio::test]
+async fn child_gets_a_clean_env_and_dies_with_the_client() {
+    let dir = tmp("env");
+    let log = dir.join("log.jsonl");
+    std::env::set_var("LLM_API_KEY", "sk-should-never-leak-1234567890");
+    let c = connect(&[
+        ("MOCK_LOG", log.to_str().unwrap()),
+        ("MCP_XCODE_PID", "15054"),
+        ("MCP_XCODE_SESSION_ID", "BDE7A0AD-1BE4-4301-9C6F-3D2AB9BBE6DA"),
+    ])
+    .await;
+    std::env::remove_var("LLM_API_KEY");
+    let pid = c.pid().unwrap();
+    assert!(alive(pid));
+    let start = log_lines(&log).into_iter().find(|l| l["event"] == "start").unwrap();
+    let env = start["env"].as_object().unwrap();
+    assert_eq!(env["MCP_XCODE_SESSION_ID"], "BDE7A0AD-1BE4-4301-9C6F-3D2AB9BBE6DA");
+    assert_eq!(env["MCP_XCODE_PID"], "15054");
+    assert!(!env.contains_key("LLM_API_KEY"));
+    assert!(!env.contains_key("RUST_LOG") && !env.contains_key("CARGO"), "{env:?}");
+    assert!(env.contains_key("PATH") && env.contains_key("HOME"));
+    drop(c);
+    let deadline = Instant::now() + Duration::from_secs(3);
+    while alive(pid) && Instant::now() < deadline {
+        tokio::time::sleep(Duration::from_millis(50)).await;
+    }
+    assert!(!alive(pid), "mock server {pid} outlived the client");
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+#[tokio::test]
+async fn handshake_timeout_when_initialize_hangs() {
+    let started = Instant::now();
+    let err = McpClient::connect(
+        &stdio_spec(&[("MOCK_INIT_DELAY_MS", "5000")]),
+        &ConnectOptions { handshake_timeout: Duration::from_millis(300) },
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err, McpError::Timeout);
+    assert!(started.elapsed() < Duration::from_secs(2));
+}
+
+// ---------------------------------------------------------------------------
+// HTTP (Brave-like)
+// ---------------------------------------------------------------------------
+
+pub struct HttpMock {
+    child: Child,
+    pub url: String,
+}
+
+impl Drop for HttpMock {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+pub fn start_http_mock(env: &[(&str, &str)]) -> HttpMock {
+    let mut cmd = Command::new(mock_bin());
+    cmd.args(["--http", "0"]).stdout(Stdio::piped()).stderr(Stdio::null());
+    for (k, v) in env {
+        cmd.env(k, v);
+    }
+    let mut child = cmd.spawn().unwrap();
+    let mut line = String::new();
+    std::io::BufReader::new(child.stdout.take().unwrap()).read_line(&mut line).unwrap();
+    let port = line.trim().strip_prefix("LISTENING ").expect("port line").to_string();
+    HttpMock { child, url: format!("http://127.0.0.1:{port}/mcp") }
+}
+
+fn http_spec(url: &str) -> McpSpec {
+    McpSpec::Http { name: "brave".into(), url: url.into(), headers: vec![] }
+}
+
+#[tokio::test]
+async fn http_sse_stateful_session_and_reinit_after_404() {
+    let dir = tmp("http");
+    let log = dir.join("log.jsonl");
+    let mock = start_http_mock(&[
+        ("MOCK_SSE", "1"),
+        ("MOCK_STATEFUL", "1"),
+        ("MOCK_RESTART_AFTER", "4"),
+        ("MOCK_LOG", log.to_str().unwrap()),
+    ]);
+    let c = McpClient::connect(&http_spec(&mock.url), &ConnectOptions::default()).await.unwrap();
+    assert_eq!(c.tools().iter().filter(|t| t.name.starts_with("brave_")).count(), 2);
+    // Request 4 (initialize, initialized, tools/list, this call) still works.
+    let r = c
+        .call("brave_web_search", json!({"query": "SpriteKit SKView presentScene"}), Duration::from_secs(5), None, None)
+        .await
+        .unwrap();
+    assert!(r.text.contains("presentScene"));
+    // The server "restarts": the session is gone -> 404 -> re-init + retry.
+    let r = c
+        .call("brave_web_search", json!({"query": "second"}), Duration::from_secs(5), None, None)
+        .await
+        .unwrap();
+    assert!(r.text.contains("second"));
+    c.close().await;
+    let lines = log_lines(&log);
+    assert_eq!(received(&lines, "initialize").len(), 2, "re-initialized once");
+    // Every non-initialize request after init carried the session and protocol headers.
+    let calls: Vec<&Value> = lines.iter().filter(|l| l["msg"]["method"] == "tools/call").collect();
+    assert!(calls.iter().all(|l| l["session"].as_str().is_some_and(|s| s.starts_with("sess-"))));
+    assert!(lines.iter().any(|l| l["delete"].is_string()), "DELETE on close");
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+#[tokio::test]
+async fn http_json_responses_and_406_without_accept() {
+    let mock = start_http_mock(&[]);
+    let c = McpClient::connect(&http_spec(&mock.url), &ConnectOptions::default()).await.unwrap();
+    let r = c.call("brave_web_search", json!({"query": "x"}), Duration::from_secs(5), None, None).await.unwrap();
+    assert!(!r.is_error);
+    // The mock (like the TypeScript SDK) insists on the Accept header.
+    let resp = reqwest::Client::builder()
+        .no_proxy()
+        .build()
+        .unwrap()
+        .post(&mock.url)
+        .header("Content-Type", "application/json")
+        .body(r#"{"jsonrpc":"2.0","id":1,"method":"ping"}"#)
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(resp.status().as_u16(), 406);
+}
+
+#[tokio::test]
+async fn non_loopback_and_down_servers_fail_fast() {
+    let started = Instant::now();
+    let err = McpClient::connect(&http_spec("http://10.255.255.1:8765/mcp"), &ConnectOptions::default())
+        .await
+        .unwrap_err();
+    assert!(matches!(err, McpError::Policy(_)), "{err}");
+    let err = McpClient::connect(&http_spec("http://example.com/mcp"), &ConnectOptions::default())
+        .await
+        .unwrap_err();
+    assert!(matches!(err, McpError::Policy(_)), "{err}");
+    assert!(started.elapsed() < Duration::from_millis(200), "refused before connecting");
+    // Nothing listening on a loopback port: a quick transport error.
+    let port = std::net::TcpListener::bind("127.0.0.1:0").unwrap().local_addr().unwrap().port();
+    let err = McpClient::connect(&http_spec(&format!("http://127.0.0.1:{port}/mcp")), &ConnectOptions::default())
+        .await
+        .unwrap_err();
+    assert!(matches!(err, McpError::Transport(_)), "{err}");
+}
