+    let first = done(&builds[0]["toolCallId"]);
+    assert_eq!(first["status"], "failed");
+    let first_text = first["content"][0]["content"]["text"].as_str().unwrap();
     assert!(
-        !thoughts.is_empty(),
-        "Expected at least one agent_thought_chunk notification"
+        first_text.contains("src/app.txt:1:1: error: BROKEN marker found")
