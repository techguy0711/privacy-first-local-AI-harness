+//! Minimal MCP client: protocol 2025-06-18 over stdio or Streamable HTTP.
+//!
+//! Hand-rolled on the crates acp-bridge already uses (tokio, reqwest,
+//! serde_json, url), so every connection goes through one place that can be
+//! audited:
+//!
+//! - **stdio**: the server is a child process in its own process group,
+//!   killed when the client is dropped. Its environment starts empty (only
+//!   `PATH`, `HOME`, `USER`, `LOGNAME`, `TMPDIR`, `LANG`, `LC_*` plus the
+//!   variables the server spec sets), so keys such as `LLM_API_KEY` never
+//!   reach it. Its stdout carries JSON-RPC lines (never inherited: acp-bridge's
+//!   own stdout is the ACP wire); its stderr goes to the debug log.
+//! - **Streamable HTTP**: loopback hosts only (`127.0.0.1`, `::1`,
+//!   `localhost`), no proxy, no redirects. Responses may be JSON or an SSE
+//!   stream; `Mcp-Session-Id` is kept and a 404 for it re-initializes once.
+//!
+//! The handshake is `initialize` (we ask for 2025-06-18 and accept
+//! 2025-06-18, 2025-03-26 or 2024-11-05), `notifications/initialized`, then
+//! `tools/list` (paged). Calls carry a progress token; a cancel or timeout
+//! sends `notifications/cancelled`. The server's `ping` is answered, any
+//! other server request gets -32601.
+
+use crate::process::CancelToken;
+use serde::Deserialize;
+use serde_json::{json, Value};
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+use tokio::sync::{mpsc, oneshot};
+use tracing::{debug, info, warn};
+
+/// Protocol version we ask for.
+pub const PROTOCOL_VERSION: &str = "2025-06-18";
+/// Versions we accept in the server's `initialize` reply.
+pub const ACCEPTED_VERSIONS: &[&str] = &["2025-06-18", "2025-03-26", "2024-11-05"];
+/// Server name Xcode gives its tool server.
+pub const XCODE_TOOLS: &str = "xcode-tools";
+/// `tools/list` pages followed at most.
+const MAX_LIST_PAGES: usize = 10;
+
+fn lock<T>(m: &Mutex<T>) -> std::sync::MutexGuard<'_, T> {
+    m.lock().unwrap_or_else(|p| p.into_inner())
+}
