+impl ToolPolicy {
+    pub fn allows(&self, tool: &str) -> bool {
+        self.allow.iter().any(|t| t == tool)
+    }
+    pub fn exposes(&self, tool: &str) -> bool {
+        self.allows(tool) && self.expose.iter().any(|t| t == tool)
+    }
+}
