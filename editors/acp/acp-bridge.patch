+    std::fs::write(project.join("MyApp/Broken.swift"), "let a = BROKEN\nlet b = BROKEN\n").unwrap();
+    let dir = project.parent().unwrap().to_path_buf();
+    let log = dir.join("mock.jsonl");
+    let config = mcp_config(&dir, "");
+    let replies = vec![
+        tool_call("w1", "write_file", json!({"path": "MyApp/Notes.swift", "content": "// notes\n"})),
+        answer("Done."),
+        tool_call("w2", "write_file", json!({"path": "MyApp/Broken.swift", "content": "let a = 1\nlet b = 2\n"})),
+        answer("Fixed both."),
+    ];
