+        let now = now_unix();
+        let crashed = uuid::Uuid::new_v4().to_string();
+        let recent = uuid::Uuid::new_v4().to_string();
+        let mut m = meta(&crashed, "/p", now - 3 * 86_400);
+        m.web_searches = 7;
+        store.create(&m);
+        store.create(&meta(&recent, "/p", now - 60));
+        for id in [&crashed, &recent] {
+            store.append(id, &[json!({"role": "user", "content": "x"})]);
+        }
+        assert_eq!(store.read_meta(&crashed).unwrap().web_searches, 7);
+        // Left by a dead process.
+        std::fs::write(store.dir(&crashed).join(".lock"), "999999").unwrap();
+        std::fs::write(store.dir(&recent).join(".lock"), "999999").unwrap();
+        assert_eq!(store.cleanup(), 1);
+        assert!(!store.dir(&crashed).exists());
+        assert!(store.dir(&recent).exists(), "less than a day old");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
