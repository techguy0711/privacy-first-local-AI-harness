+/// Message for a `DocumentationSearch` / `docs_search` call when Xcode's
+/// documentation search is not connected.
+pub const DOCS_UNAVAILABLE: &str = "DocumentationSearch is not available in this session; use your knowledge of the API and make the change.";
+
+/// Map a tool name the model borrowed from Xcode's `xcode-tools` MCP server
+/// (Xcode's hidden prompt tells it to use them) onto acp-bridge's own tool,
+/// with the arguments renamed. Also accepts the `mcp__xcode-tools__X` and
+/// `xcode-tools.X` spellings. Unknown names are returned unchanged.
+///
+/// - `XcodeRead{filePath,offset,limit}` -> `read_file`
+/// - `XcodeWrite{filePath,content}` -> `write_file`
+/// - `XcodeUpdate{filePath,oldString,newString,replaceAll}` -> `edit`
+/// - `XcodeGrep{pattern,glob}` -> `search_code`
+/// - `XcodeLS{path}` / `XcodeGlob{pattern,path}` -> `list_dir`
+/// - `BuildProject` -> `build` (the harness build, run now)
+/// - `DocumentationSearch{query,frameworks}` -> `docs_search`
+pub fn resolve_alias(name: &str, args: &Value) -> (String, Value) {
+    let bare = name
+        .strip_prefix("mcp__xcode-tools__")
+        .or_else(|| name.strip_prefix("xcode-tools."))
+        .or_else(|| name.strip_prefix("xcode-tools__"))
+        .or_else(|| name.strip_prefix("xcode_tools__"))
+        .unwrap_or(name);
+    let get = |k: &str| args.get(k).cloned();
+    let mut out = serde_json::Map::new();
+    let mut put = |k: &str, v: Option<Value>| {
+        if let Some(v) = v.filter(|v| !v.is_null()) {
+            out.insert(k.to_string(), v);
+        }
+    };
+    let canonical = match bare {
+        "XcodeRead" => {
+            put("path", get("filePath").or_else(|| get("path")));
+            put("offset", get("offset"));
+            put("limit", get("limit"));
+            "read_file"
+        }
+        "XcodeWrite" => {
+            put("path", get("filePath").or_else(|| get("path")));
+            put("content", get("content"));
+            "write_file"
+        }
+        "XcodeUpdate" => {
+            put("path", get("filePath").or_else(|| get("path")));
+            put("old_text", get("oldString").or_else(|| get("old_text")));
+            put("new_text", get("newString").or_else(|| get("new_text")));
+            put("replace_all", get("replaceAll"));
+            "edit"
+        }
+        "XcodeGrep" => {
+            put("pattern", get("pattern"));
+            put("file_glob", get("glob").or_else(|| get("file_glob")));
+            "search_code"
+        }
+        "XcodeLS" => {
+            put("path", get("path"));
+            "list_dir"
+        }
+        "XcodeGlob" => {
+            put("path", get("path"));
+            "list_dir"
+        }
+        "BuildProject" => "build",
+        "DocumentationSearch" => {
+            put("query", get("query"));
+            put("frameworks", get("frameworks"));
+            "docs_search"
+        }
+        _ if bare != name => bare,
+        _ => return (name.to_string(), args.clone()),
+    };
+    if out.is_empty() && bare == canonical {
+        return (canonical.to_string(), args.clone());
+    }
+    (canonical.to_string(), Value::Object(out))
+}
+
+/// A model-supplied path made relative to the working directory:
+/// an absolute path inside `working_dir` loses that prefix, a leading
+/// `./` is dropped, and Xcode's project-navigator prefix is removed. Xcode
+/// lists files as `<Project>/MyApp/X.swift` while the cwd is the project
+/// folder: when `<first component>` does not exist in the cwd and equals the
+/// cwd's name or the stem of a `*.xcodeproj` / `*.xcworkspace` in it, it is
+/// dropped. A real sub-folder with that name is left alone.
+pub fn normalize_path(working_dir: &Path, path: &str) -> String {
+    let mut p = path.trim().to_string();
+    if Path::new(&p).is_absolute() {
+        let mut prefixes = vec![working_dir.to_path_buf()];
+        if let Ok(c) = working_dir.canonicalize() {
+            prefixes.push(c);
+        }
+        for prefix in prefixes {
+            if let Ok(rest) = Path::new(&p).strip_prefix(&prefix) {
+                p = rest.to_string_lossy().into_owned();
+                if p.is_empty() {
+                    p = ".".into();
+                }
+                break;
+            }
+        }
+    }
+    while let Some(rest) = p.strip_prefix("./") {
+        p = rest.to_string();
+    }
+    if Path::new(&p).is_absolute() {
+        return p;
+    }
+    let (first, rest) = match p.split_once('/') {
+        Some((f, r)) => (f.to_string(), r.to_string()),
+        None => return p,
+    };
+    if first.is_empty() || first == "." || first == ".." || working_dir.join(&first).exists() {
+        return p;
+    }
+    let project_names: Vec<String> = std::iter::once(
+        working_dir
+            .file_name()
+            .map(|n| n.to_string_lossy().into_owned())
+            .unwrap_or_default(),
+    )
+    .chain(
+        std::fs::read_dir(working_dir)
+            .map(|rd| {
+                rd.filter_map(|e| e.ok())
+                    .map(|e| e.file_name().to_string_lossy().into_owned())
+                    .filter_map(|n| {
+                        n.strip_suffix(".xcodeproj")
+                            .or_else(|| n.strip_suffix(".xcworkspace"))
+                            .map(str::to_owned)
+                    })
+                    .collect::<Vec<_>>()
+            })
+            .unwrap_or_default(),
+    )
+    .filter(|n| !n.is_empty())
+    .collect();
+    if project_names.contains(&first) {
+        if rest.is_empty() {
+            ".".to_string()
+        } else {
+            rest
+        }
+    } else {
+        p
+    }
+}
+
+/// Normalize the path arguments of a built-in tool call (see
+/// [`normalize_path`]).
+pub fn normalize_args(working_dir: &Path, name: &str, args: &Value) -> Value {
+    let mut out = args.clone();
+    let Some(obj) = out.as_object_mut() else {
+        return out;
+    };
+    if matches!(
+        name,
+        "read_file" | "write_file" | "edit" | "list_dir" | "git_diff" | "git_log"
+    ) {
+        if let Some(Value::String(p)) = obj.get("path") {
+            let n = normalize_path(working_dir, p);
+            obj.insert("path".into(), Value::String(n));
+        }
+    }
+    if name == "git_commit" {
+        if let Some(Value::Array(paths)) = obj.get_mut("paths") {
+            for p in paths.iter_mut() {
+                if let Value::String(s) = p {
+                    *s = normalize_path(working_dir, s);
+                }
+            }
+        }
+    }
+    out
+}
