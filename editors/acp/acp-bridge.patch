+//! Mock MCP server for acp-bridge's tests. Plays Xcode's `mcpbridge`
+//! (stdio, the default) and the Brave search server (`--http <port>`, port
+//! 0 = any; prints `LISTENING <port>`). Never touches the network beyond
+//! its own loopback listener. Behaviour comes from environment variables:
+//!
+//! - `MOCK_TOOLS=<file>`: tool list (`{"tools": [...]}`); otherwise
+//!   `MOCK_GEN=26|27` picks tests/fixtures/mcp/xcode26|27-tools.json, and
+//!   `--http` defaults to brave-tools.json
+//! - `MOCK_PROTOCOL`: protocolVersion to answer (default: the requested one)
+//! - `MOCK_INIT_DELAY_MS`: delay before answering `initialize` (Xcode's
+//!   "Allow … to access Xcode?" dialog)
+//! - `MOCK_PAGE_SIZE`: tools per `tools/list` page
+//! - `MOCK_REQUIRE_WORKSPACE=1`: workspace-scoped tools fail unless the
+//!   26.x `tabIdentifier` / 27 `workspaceIdentifier` is passed, with Xcode's
+//!   error text listing `MOCK_WORKSPACE_PATH`
+//! - `MOCK_PROGRESS=1`: BuildProject sends progress notifications
+//! - `MOCK_BUILD`: `ok` (default), `cancelled`, `rpc_error`, or `check:<marker>`
+//!   (fails while a file under `MOCK_PROJECT_DIR` contains the marker)
+//! - `MOCK_BUILD_DELAY_MS`: BuildProject duration
+//! - `MOCK_DIAG_MARKER`: XcodeRefreshCodeIssuesInFile reports an error for
+//!   a file containing it; `MOCK_DIAG_DELAY_MS` delays the answer
+//! - `MOCK_PROJECT_DIR` / `MOCK_PROJECT_NAME`: the project XcodeGlob and
+//!   the checks read (navigator paths are `<name>/<relative path>`)
+//! - `MOCK_PING=1` / `MOCK_UNKNOWN_REQUEST=1`: after `initialized` the
+//!   server sends `ping` / `sampling/createMessage` to the client
+//! - `MOCK_SSE=1`, `MOCK_STATEFUL=1`, `MOCK_RESTART_AFTER=<n>` (HTTP): SSE
+//!   responses, `Mcp-Session-Id` sessions, forget all sessions after n
+//!   requests (the client then gets 404)
+//! - `MOCK_LOG=<file>`: one JSON line per received message, plus a start
+//!   line with the pid and the environment
+//! - `MOCK_TOOLS_LATE=<tool>` (stdio): the first `tools/list` leaves that
+//!   tool out; right after it the server sends
+//!   `notifications/tools/list_changed` and later lists include it (Xcode
+//!   finishing loading a workspace)
+
+use axum::{
+    body::Body,
+    extract::State,
+    http::{HeaderMap, StatusCode},
+    response::{IntoResponse, Response},
+    routing::{get, post},
+    Router,
+};
+use serde_json::{json, Value};
+use std::collections::{HashMap, HashSet};
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+use tokio::sync::mpsc;
+
+fn env(k: &str) -> Option<String> {
+    std::env::var(k).ok().filter(|v| !v.is_empty())
+}
+
+fn env_ms(k: &str) -> u64 {
+    env(k).and_then(|v| v.parse().ok()).unwrap_or(0)
+}
+
+fn log(entry: &Value) {
+    if let Some(path) = env("MOCK_LOG") {
+        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+            let _ = writeln!(f, "{entry}");
+        }
+    }
+}
+
+fn fixtures() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/mcp")
+}
+
+fn load_tools(http: bool) -> Vec<Value> {
+    let path = match env("MOCK_TOOLS") {
+        Some(p) => PathBuf::from(p),
+        None if http => fixtures().join("brave-tools.json"),
+        None => fixtures().join(format!("xcode{}-tools.json", env("MOCK_GEN").unwrap_or_else(|| "27".into()))),
+    };
+    let v: Value = serde_json::from_str(&std::fs::read_to_string(&path).expect("tool fixture")).expect("tool json");
+    let mut tools = v["tools"].as_array().cloned().unwrap_or_default();
+    // Test helpers.
+    tools.push(json!({"name": "Sleep", "description": "Sleep for ms milliseconds", "inputSchema": {"type": "object", "properties": {"ms": {"type": "integer"}}}}));
+    tools.push(json!({"name": "Fail", "description": "Always fails", "inputSchema": {"type": "object"}}));
+    tools
+}
+
+struct Server {
+    tools: Vec<Value>,
+    initialized: bool,
+    /// `tools/list` requests answered.
+    listed: usize,
+}
+
+/// Navigator path -> file under MOCK_PROJECT_DIR.
+fn project_file(nav: &str) -> Option<PathBuf> {
+    let dir = PathBuf::from(env("MOCK_PROJECT_DIR")?);
+    let name = env("MOCK_PROJECT_NAME").unwrap_or_default();
+    let rel = nav.strip_prefix(&format!("{name}/")).unwrap_or(nav);
+    Some(dir.join(rel))
+}
+
+fn walk(dir: &Path, root: &Path, out: &mut Vec<String>) {
+    let Ok(rd) = std::fs::read_dir(dir) else { return };
+    let mut entries: Vec<_> = rd.filter_map(|e| e.ok()).collect();
+    entries.sort_by_key(|e| e.file_name());
+    for e in entries {
+        let p = e.path();
+        if e.file_name().to_string_lossy().starts_with('.') {
+            continue;
+        }
+        if p.is_dir() {
+            walk(&p, root, out);
+        } else if let Ok(rel) = p.strip_prefix(root) {
+            out.push(rel.to_string_lossy().into_owned());
+        }
+    }
+}
+
+fn workspace_check(gen26: bool, tool: &str, args: &Value) -> Option<Value> {
+    if env("MOCK_REQUIRE_WORKSPACE").as_deref() != Some("1")
+        || matches!(tool, "DocumentationSearch" | "Sleep" | "Fail" | "brave_web_search" | "XcodeListWorkspaces" | "XcodeListWindows")
+    {
+        return None;
+    }
+    let (param, id) = if gen26 { ("tabIdentifier", "windowtab1") } else { ("workspaceIdentifier", "workspace-Gxw7GRzGoI") };
+    if args.get(param).and_then(Value::as_str) == Some(id) {
+        return None;
+    }
+    let path = env("MOCK_WORKSPACE_PATH").unwrap_or_else(|| "/tmp/Other.xcodeproj".into());
+    let text = if gen26 {
+        format!("{param} is required for this action. Choose from the following open windows:\n* {param}: windowtab9, workspacePath: /Users/someone/Unrelated.xcodeproj\n* {param}: {id}, workspacePath: {path}")
+    } else {
+        format!("Error: {param} is required for this action. Choose from the following open workspaces, or open one with XcodeOpenWorkspace:\n* {param}: workspace-Other1, workspacePath: /Users/someone/Unrelated.xcodeproj\n* {param}: {id}, workspacePath: {path}")
+    };
+    Some(json!({"content": [{"type": "text", "text": text}], "isError": true}))
+}
+
+fn text_result(structured: Value) -> Value {
+    json!({"content": [{"type": "text", "text": structured.to_string()}], "structuredContent": structured, "isError": false})
+}
+
+async fn call_tool(name: &str, args: Value, token: Option<Value>, out: mpsc::UnboundedSender<Value>) -> Result<Value, (i64, String)> {
+    let gen26 = env("MOCK_GEN").as_deref() == Some("26");
+    if let Some(err) = workspace_check(gen26, name, &args) {
+        return Ok(err);
+    }
+    match name {
+        "DocumentationSearch" => {
+            let q = args["query"].as_str().unwrap_or("").to_lowercase();
+            let docs = if q.contains("skview") || q.contains("presentscene") || q.contains("scene") {
+                json!([
+                    {"title": "presentScene(_:)", "uri": "https://developer.apple.com/documentation/spritekit/skview/presentscene(_:)",
+                     "contents": "Instance Method presentScene(_:). Presents a scene. func presentScene(_ scene: SKScene?). The scene property of SKView is read-only (get-only): to show a scene, call presentScene(_:) on the view instead of assigning to scene. If a scene is already presented, it is replaced.", "score": 0.91, "kind": "symbol"},
+                    {"title": "scene", "uri": "https://developer.apple.com/documentation/spritekit/skview/scene",
+                     "contents": "Instance Property scene. The scene currently presented by the view. var scene: SKScene? { get }. Use presentScene(_:) or presentScene(_:transition:) to change it.", "score": 0.88, "kind": "symbol"},
+                    {"title": "SKView", "uri": "https://developer.apple.com/documentation/spritekit/skview",
+                     "contents": "Class SKView. A view subclass that renders a SpriteKit scene. Present a scene by calling presentScene(_:).", "score": 0.80, "kind": "symbol"},
+                    {"title": "SpriteView", "uri": "https://developer.apple.com/documentation/spritekit/spriteview",
+                     "contents": "Structure SpriteView. A SwiftUI view that renders a SpriteKit scene.", "score": 0.71, "kind": "symbol"}
+                ])
+            } else {
+                json!([{"title": "No close match", "uri": "https://developer.apple.com/documentation", "contents": "No documentation matched.", "score": 0.1, "kind": "article"}])
+            };
+            if env("MOCK_DOCS_TEXT_ONLY").as_deref() == Some("1") {
+                return Ok(json!({"content": [{"type": "text", "text": json!({"documents": docs}).to_string()}], "isError": false}));
+            }
+            Ok(text_result(json!({"documents": docs})))
+        }
+        "BuildProject" => {
+            let steps = 3;
+            if env("MOCK_PROGRESS").as_deref() == Some("1") {
+                if let Some(t) = &token {
+                    for i in 1..=steps {
+                        let _ = out.send(json!({"jsonrpc": "2.0", "method": "notifications/progress",
+                            "params": {"progressToken": t, "progress": i, "total": steps, "message": format!("Building {i}/{steps}")}}));
+                        tokio::time::sleep(Duration::from_millis(30)).await;
+                    }
+                }
+            }
+            tokio::time::sleep(Duration::from_millis(env_ms("MOCK_BUILD_DELAY_MS"))).await;
+            let mode = env("MOCK_BUILD").unwrap_or_else(|| "ok".into());
+            if mode == "rpc_error" {
+                return Err((-32603, "Xcode tools require an open workspace".into()));
+            }
+            if mode == "cancelled" {
+                return Ok(text_result(json!({"buildResult": "The build was cancelled by a user interaction in Xcode. Stop what you are doing and ask the user how to proceed.", "errors": [], "fullLogPath": "/tmp/build.log"})));
+            }
+            let mut errors = Vec::new();
+            if let Some(marker) = mode.strip_prefix("check:") {
+                let mut files = Vec::new();
+                if let Some(dir) = env("MOCK_PROJECT_DIR") {
+                    walk(Path::new(&dir), Path::new(&dir), &mut files);
+                    for rel in files {
+                        let text = std::fs::read_to_string(Path::new(&dir).join(&rel)).unwrap_or_default();
+                        for (i, line) in text.lines().enumerate() {
+                            if line.contains(marker) {
+                                let col = line.find(marker).unwrap_or(0);
+                                let _ = col;
+                                errors.push(json!({"filePath": Path::new(&dir).join(&rel).to_string_lossy(), "lineNumber": i + 1,
+                                    "message": "Cannot assign to property: 'scene' is a get-only property", "type": "error"}));
+                                errors.push(json!({"filePath": Path::new(&dir).join(&rel).to_string_lossy(), "lineNumber": i + 1,
+                                    "message": "Variable 'x' was never used", "type": "warning"}));
+                            }
+                        }
+                    }
+                }
+            }
+            let result = if errors.iter().any(|e| e["type"] == "error") {
+                "The build failed; errors are summarized in the `errors` field."
+            } else {
+                "The project built successfully."
+            };
+            Ok(text_result(json!({"buildResult": result, "errors": errors, "fullLogPath": "/tmp/build.log", "elapsedTime": 1.5})))
+        }
+        "XcodeRefreshCodeIssuesInFile" => {
+            tokio::time::sleep(Duration::from_millis(env_ms("MOCK_DIAG_DELAY_MS"))).await;
+            let nav = args["filePath"].as_str().unwrap_or("");
+            let text = project_file(nav).and_then(|p| std::fs::read_to_string(p).ok());
+            let Some(text) = text else {
+                return Ok(json!({"content": [{"type": "text", "text": format!("File not found in project: {nav}")}], "isError": true}));
+            };
+            let mut diags = Vec::new();
+            if let Some(marker) = env("MOCK_DIAG_MARKER") {
+                for (i, line) in text.lines().enumerate() {
+                    if line.contains(&marker) {
+                        diags.push(format!("{}:{}:16: error: Value of type 'SKView' has no member 'scaleMode'", nav, i + 1));
+                    }
+                }
+            }
+            let content = if diags.is_empty() { "No diagnostics found.".to_string() } else { diags.join("\n") };
+            Ok(text_result(json!({"content": content, "diagnosticsCount": diags.len(), "filePath": nav, "success": true})))
+        }
+        "XcodeGlob" => {
+            let pattern = args["pattern"].as_str().unwrap_or("**/*");
+            let base = pattern.rsplit('/').next().unwrap_or(pattern).to_string();
+            let mut files = Vec::new();
+            if let Some(dir) = env("MOCK_PROJECT_DIR") {
+                walk(Path::new(&dir), Path::new(&dir), &mut files);
+            }
+            let name = env("MOCK_PROJECT_NAME").unwrap_or_default();
+            let matches: Vec<String> = files
+                .into_iter()
+                .filter(|f| base.contains('*') || f.rsplit('/').next() == Some(base.as_str()))
+                .map(|f| format!("{name}/{f}"))
+                .collect();
+            Ok(text_result(json!({"matches": matches, "pattern": pattern, "searchPath": name, "totalFound": matches.len(), "truncated": false})))
+        }
+        "brave_web_search" => {
+            if env("MOCK_BRAVE_EMPTY").as_deref() == Some("1") {
+                return Ok(json!({"content": [{"type": "text", "text": "No web results found"}], "isError": true}));
+            }
+            let q = args["query"].as_str().unwrap_or("");
+            let items: Vec<Value> = (1..=5)
+                .map(|i| json!({"type": "text", "text": json!({
+                    "url": format!("https://example.invalid/result-{i}"),
+                    "title": format!("<strong>Result {i}</strong> for {q}"),
+                    "description": format!("Snippet {i}: <strong>presentScene</strong>(_:) presents a scene in an SKView."),
+                    "extra_snippets": []
+                }).to_string()}))
+                .collect();
+            Ok(json!({"content": items, "isError": false}))
+        }
+        "Sleep" => {
+            tokio::time::sleep(Duration::from_millis(args["ms"].as_u64().unwrap_or(1000))).await;
+            Ok(json!({"content": [{"type": "text", "text": "slept"}], "isError": false}))
+        }
+        "Fail" => Ok(json!({"content": [{"type": "text", "text": "it failed"}], "isError": true})),
+        other => Err((-32602, format!("Unknown tool: {other}"))),
+    }
+}
+
+/// Answer one request (not tools/call). `None` for notifications.
+fn handle_simple(server: &mut Server, msg: &Value) -> Option<Value> {
+    let id = msg.get("id")?.clone();
+    let method = msg["method"].as_str().unwrap_or("");
+    let ok = |result: Value| json!({"jsonrpc": "2.0", "id": id, "result": result});
+    let err = |code: i64, message: &str| json!({"jsonrpc": "2.0", "id": id, "error": {"code": code, "message": message}});
+    Some(match method {
+        "initialize" => {
+            let requested = msg["params"]["protocolVersion"].as_str().unwrap_or("2025-06-18");
+            let version = env("MOCK_PROTOCOL").unwrap_or_else(|| requested.to_string());
+            ok(json!({"protocolVersion": version, "capabilities": {"tools": {"listChanged": true}},
+                      "serverInfo": {"name": "mock-xcode-tools", "version": "25317"}}))
+        }
+        "tools/list" => {
+            if !server.initialized {
+                return Some(err(-32600, "Received a request before initialization completed. The MCP client must send `initialize` and the `initialized` notification before issuing requests."));
+            }
+            let page: usize = env("MOCK_PAGE_SIZE").and_then(|v| v.parse().ok()).unwrap_or(1000);
+            let start: usize = msg["params"]["cursor"].as_str().and_then(|c| c.parse().ok()).unwrap_or(0);
+            let late = env("MOCK_TOOLS_LATE").filter(|_| server.listed == 0);
+            let tools: Vec<Value> = server
+                .tools
+                .iter()
+                .filter(|t| late.as_deref().is_none_or(|l| t["name"] != l))
+                .cloned()
+                .collect();
+            server.listed += 1;
+            let end = (start + page).min(tools.len());
+            let mut r = json!({"tools": tools[start..end]});
+            if end < tools.len() {
+                r["nextCursor"] = json!(end.to_string());
+            }
+            ok(r)
+        }
+        "ping" => ok(json!({})),
+        other => err(-32601, &format!("Method not found: {other}")),
+    })
+}
+
+async fn run_stdio() {
+    let pid = std::process::id();
+    log(&json!({"event": "start", "pid": pid, "env": std::env::vars().collect::<HashMap<_, _>>()}));
+    let mut server = Server { tools: load_tools(false), initialized: false, listed: 0 };
+    let (out_tx, mut out_rx) = mpsc::unbounded_channel::<Value>();
+    tokio::spawn(async move {
+        let mut stdout = tokio::io::stdout();
+        while let Some(msg) = out_rx.recv().await {
+            let mut line = msg.to_string();
+            line.push('\n');
+            if stdout.write_all(line.as_bytes()).await.is_err() {
+                break;
+            }
+            let _ = stdout.flush().await;
+        }
+    });
+    let calls: Arc<Mutex<HashMap<String, tokio::task::JoinHandle<()>>>> = Arc::default();
+    let mut lines = BufReader::new(tokio::io::stdin()).lines();
+    while let Ok(Some(line)) = lines.next_line().await {
+        let Ok(msg) = serde_json::from_str::<Value>(&line) else { continue };
+        log(&json!({"dir": "in", "msg": msg}));
+        let method = msg["method"].as_str().unwrap_or("").to_string();
+        match method.as_str() {
+            "initialize" => {
+                tokio::time::sleep(Duration::from_millis(env_ms("MOCK_INIT_DELAY_MS"))).await;
+                if let Some(r) = handle_simple(&mut server, &msg) {
+                    let _ = out_tx.send(r);
+                }
+            }
+            "notifications/initialized" => {
+                server.initialized = true;
+                if env("MOCK_PING").as_deref() == Some("1") {
+                    let _ = out_tx.send(json!({"jsonrpc": "2.0", "id": "srv-ping", "method": "ping"}));
+                }
+                if env("MOCK_UNKNOWN_REQUEST").as_deref() == Some("1") {
+                    let _ = out_tx.send(json!({"jsonrpc": "2.0", "id": "srv-sample", "method": "sampling/createMessage", "params": {}}));
+                }
+            }
+            "notifications/cancelled" => {
+                let rid = msg["params"]["requestId"].to_string();
+                if let Some(h) = calls.lock().unwrap().remove(&rid) {
+                    h.abort();
+                }
+            }
+            "tools/call" => {
+                let id = msg["id"].clone();
+                let name = msg["params"]["name"].as_str().unwrap_or("").to_string();
+                let args = msg["params"]["arguments"].clone();
+                let token = msg["params"]["_meta"]["progressToken"].clone();
+                let token = (!token.is_null()).then_some(token);
+                let tx = out_tx.clone();
+                let calls2 = Arc::clone(&calls);
+                let key = id.to_string();
+                let h = tokio::spawn(async move {
+                    let reply = match call_tool(&name, args, token, tx.clone()).await {
+                        Ok(r) => json!({"jsonrpc": "2.0", "id": id, "result": r}),
+                        Err((code, message)) => json!({"jsonrpc": "2.0", "id": id, "error": {"code": code, "message": message}}),
+                    };
+                    calls2.lock().unwrap().remove(&id.to_string());
+                    let _ = tx.send(reply);
+                });
+                calls.lock().unwrap().insert(key, h);
+            }
+            "" => {} // a response from the client (ping / refused request)
+            _ => {
+                if let Some(r) = handle_simple(&mut server, &msg) {
+                    let _ = out_tx.send(r);
+                }
+                if method == "tools/list" && server.listed == 1 && env("MOCK_TOOLS_LATE").is_some() {
+                    tokio::time::sleep(Duration::from_millis(100)).await;
+                    let _ = out_tx.send(json!({"jsonrpc": "2.0", "method": "notifications/tools/list_changed"}));
+                }
+            }
+        }
+    }
+}
+
+#[derive(Clone)]
+struct HttpState {
+    tools: Arc<Vec<Value>>,
+    sessions: Arc<Mutex<HashSet<String>>>,
+    requests: Arc<Mutex<usize>>,
+    restarted: Arc<Mutex<bool>>,
+}
+
+fn reply(body: &Value, sse: bool, session: Option<&str>) -> Response {
+    let mut resp = if sse {
+        let text = format!("event: message\ndata: {body}\n\n");
+        let mut r = Response::new(Body::from(text));
+        r.headers_mut().insert("content-type", "text/event-stream".parse().unwrap());
+        r
+    } else {
+        let mut r = Response::new(Body::from(body.to_string()));
+        r.headers_mut().insert("content-type", "application/json".parse().unwrap());
+        r
+    };
+    if let Some(sid) = session {
+        resp.headers_mut().insert("mcp-session-id", sid.parse().unwrap());
+    }
+    resp
+}
+
+async fn http_post(State(st): State<HttpState>, headers: HeaderMap, body: String) -> Response {
+    let accept = headers.get("accept").and_then(|v| v.to_str().ok()).unwrap_or("");
+    if !(accept.contains("application/json") && accept.contains("text/event-stream")) {
+        return (StatusCode::NOT_ACCEPTABLE, "Not Acceptable: Client must accept both application/json and text/event-stream").into_response();
+    }
+    let Ok(msg) = serde_json::from_str::<Value>(&body) else {
+        return (StatusCode::BAD_REQUEST, "Parse error").into_response();
+    };
+    log(&json!({"dir": "in", "msg": msg, "session": headers.get("mcp-session-id").and_then(|v| v.to_str().ok())}));
+    let stateful = env("MOCK_STATEFUL").as_deref() == Some("1");
+    let sse = env("MOCK_SSE").as_deref() == Some("1");
+    {
+        let mut n = st.requests.lock().unwrap();
+        *n += 1;
+        if let Some(limit) = env("MOCK_RESTART_AFTER").and_then(|v| v.parse::<usize>().ok()) {
+            let mut restarted = st.restarted.lock().unwrap();
+            if *n > limit && !*restarted {
+                *restarted = true;
+                st.sessions.lock().unwrap().clear();
+            }
+        }
+    }
+    let method = msg["method"].as_str().unwrap_or("");
+    let mut new_session = None;
+    if stateful {
+        if method == "initialize" {
+            let sid = format!("sess-{}", st.requests.lock().unwrap());
+            st.sessions.lock().unwrap().insert(sid.clone());
+            new_session = Some(sid);
+        } else {
+            let Some(sid) = headers.get("mcp-session-id").and_then(|v| v.to_str().ok()) else {
+                return (StatusCode::BAD_REQUEST, "Bad Request: Mcp-Session-Id header is required").into_response();
+            };
+            if !st.sessions.lock().unwrap().contains(sid) {
+                return (StatusCode::NOT_FOUND, "Session not found").into_response();
+            }
+        }
+    }
+    if msg.get("id").is_none() {
+        return StatusCode::ACCEPTED.into_response();
+    }
+    let mut server = Server { tools: (*st.tools).clone(), initialized: true, listed: 0 };
+    let body = if method == "tools/call" {
+        let (tx, _rx) = mpsc::unbounded_channel();
+        let id = msg["id"].clone();
+        match call_tool(msg["params"]["name"].as_str().unwrap_or(""), msg["params"]["arguments"].clone(), None, tx).await {
+            Ok(r) => json!({"jsonrpc": "2.0", "id": id, "result": r}),
+            Err((code, message)) => json!({"jsonrpc": "2.0", "id": id, "error": {"code": code, "message": message}}),
+        }
+    } else {
+        handle_simple(&mut server, &msg).unwrap_or(Value::Null)
+    };
+    reply(&body, sse, new_session.as_deref())
+}
+
+async fn http_delete(State(st): State<HttpState>, headers: HeaderMap) -> StatusCode {
+    log(&json!({"dir": "in", "delete": headers.get("mcp-session-id").and_then(|v| v.to_str().ok())}));
+    if let Some(sid) = headers.get("mcp-session-id").and_then(|v| v.to_str().ok()) {
+        st.sessions.lock().unwrap().remove(sid);
+    }
+    StatusCode::OK
+}
+
+async fn run_http(port: u16) {
+    log(&json!({"event": "start", "pid": std::process::id(), "mode": "http"}));
+    let st = HttpState {
+        tools: Arc::new(load_tools(true)),
+        sessions: Arc::default(),
+        requests: Arc::default(),
+        restarted: Arc::default(),
+    };
+    let app = Router::new()
+        .route("/mcp", post(http_post).delete(http_delete))
+        .route("/ping", get(|| async { axum::Json(json!({"message": "pong"})) }))
+        .with_state(st);
+    let listener = tokio::net::TcpListener::bind(("127.0.0.1", port)).await.expect("bind");
+    println!("LISTENING {}", listener.local_addr().unwrap().port());
+    let _ = std::io::stdout().flush();
+    axum::serve(listener, app).await.unwrap();
+}
+
+#[tokio::main]
+async fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    match args.iter().position(|a| a == "--http") {
+        Some(i) => run_http(args.get(i + 1).and_then(|p| p.parse().ok()).unwrap_or(0)).await,
+        None => run_stdio().await,
+    }
+}
