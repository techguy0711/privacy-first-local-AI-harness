+                } else {
+                    openai_round(&format!("c{i}"), "read_file", json!({"path": "a"}), &big(3000))
+                };
+                // Two calls in one message: both results must stay with it.
+                if !ollama {
+                    r[0]["tool_calls"].as_array_mut().unwrap().push(json!({
+                        "id": format!("d{i}"), "type": "function",
+                        "function": {"name": "list_dir", "arguments": "{}"}}));
+                    r.push(json!({"role": "tool", "tool_call_id": format!("d{i}"), "content": big(3000)}));
