+/// Session title for a `session/prompt`: the first non-empty line of the
+/// user's own text, at most 80 characters.
+///
+/// Skips what the Client injects ahead of that text: `<system-reminder>`
+/// blocks, a leading `<sender_context>` block, and Xcode's "Project
+/// structure (…)" block. Xcode 27 sends `[reminder, project structure,
+/// user text]` (the reminder only on a conversation's first turn), so
+/// without this every Xcode conversation was titled
+/// `<system-reminder>## Xcode`.
+pub fn derive_session_title(prompt: &Value) -> Option<String> {
+    let blocks: Vec<String> = match prompt {
+        Value::Array(parts) => parts
+            .iter()
+            .map(|p| extract_text_parts(std::slice::from_ref(p)))
+            .collect(),
+        other => vec![extract_user_text_from_prompt(other)],
+    };
+    blocks
+        .iter()
+        .map(|block| strip_sender_context(&strip_system_reminders(block)).0)
+        .filter(|block| !block.trim_start().starts_with("Project structure ("))
+        .find_map(|block| {
+            block
+                .lines()
+                .map(str::trim)
+                .find(|line| !line.is_empty())
+                .map(|line| line.chars().take(80).collect())
+        })
+}
