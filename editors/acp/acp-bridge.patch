+    let mut raw = arguments.clone();
+    let Some(obj) = raw.as_object_mut() else {
+        return raw;
+    };
+    let arg = |key: &str| arguments.get(key).and_then(|v| v.as_str());
+    match name {
+        "read_file" | "write_file" | "edit" => {
