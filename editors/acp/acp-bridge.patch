+//! MCP client tests against the `mock_mcp_server` example (stdio, as
+//! Xcode's mcpbridge, and HTTP, as the Brave server). No network, no Xcode.
+
+use acp_bridge::mcp::{ConnectOptions, McpClient, McpError, McpSpec};
+use acp_bridge::process::CancelToken;
+use serde_json::{json, Value};
+use std::io::BufRead;
+use std::path::PathBuf;
+use std::process::{Child, Command, Stdio};
+use std::time::{Duration, Instant};
+
+/// Path of the example binary (built by `cargo test` next to the tests).
+pub fn mock_bin() -> PathBuf {
+    let exe = std::env::current_exe().unwrap();
+    let dir = exe.parent().unwrap().parent().unwrap();
+    let p = dir.join("examples/mock_mcp_server");
+    assert!(p.is_file(), "mock server not built at {}", p.display());
+    p
+}
+
+fn tmp(tag: &str) -> PathBuf {
+    static N: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+    let d = std::env::temp_dir().join(format!(
+        "acp-mcp-{tag}-{}-{}",
+        std::process::id(),
+        N.fetch_add(1, std::sync::atomic::Ordering::SeqCst)
+    ));
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).unwrap();
+    d
+}
+
+fn stdio_spec(env: &[(&str, &str)]) -> McpSpec {
+    McpSpec::Stdio {
+        name: "xcode-tools".into(),
+        command: mock_bin().to_string_lossy().into_owned(),
+        args: vec![],
+        env: env.iter().map(|(k, v)| (k.to_string(), v.to_string())).collect(),
+    }
+}
+
+fn log_lines(path: &std::path::Path) -> Vec<Value> {
+    std::fs::read_to_string(path)
+        .unwrap_or_default()
+        .lines()
+        .filter_map(|l| serde_json::from_str(l).ok())
+        .collect()
+}
+
+fn received(log: &[Value], method: &str) -> Vec<Value> {
+    log.iter()
+        .filter(|l| l["msg"]["method"] == method)
+        .map(|l| l["msg"].clone())
+        .collect()
+}
+
+async fn connect(env: &[(&str, &str)]) -> std::sync::Arc<McpClient> {
+    McpClient::connect(&stdio_spec(env), &ConnectOptions::default())
+        .await
+        .expect("connect")
+}
+
+fn alive(pid: u32) -> bool {
+    Command::new("kill")
+        .args(["-0", &pid.to_string()])
+        .stderr(Stdio::null())
+        .status()
+        .map(|s| s.success())
+        .unwrap_or(false)
+}
