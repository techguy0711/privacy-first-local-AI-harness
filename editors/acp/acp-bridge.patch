+/// Note at the end of a request when old rounds were dropped and the
+/// notes are off.
+const DROPPED_NOTE_PLAIN: &str = "\n\n[Note: older messages of this conversation were removed to fit the model's context window.]";
+
+/// A `notes` tool call against the session's notes (at most
+/// `notes::PER_TURN_LIMIT` per turn).
+fn notes_tool_call(state: &AppState, session_id: &str, args: &Value, turn: &mut TurnCtx) -> tools::ToolOutcome {
+    if turn.notes_calls >= crate::notes::PER_TURN_LIMIT {
+        return tools::ToolOutcome {
+            output: format!(
+                "Not run: notes limit for this turn reached ({} calls). Continue with the task.",
+                crate::notes::PER_TURN_LIMIT
+            ),
+            failed: true,
+        };
+    }
+    turn.notes_calls += 1;
+    let action = args.get("action").and_then(Value::as_str).unwrap_or("read");
+    let text = args.get("text").and_then(Value::as_str).unwrap_or("");
+    let result = match state.sessions_write().get_mut(session_id) {
+        Some(s) => s.notes.apply(action, text),
+        None => Err("Error: session not found".into()),
+    };
+    match result {
+        Ok(output) => tools::ToolOutcome { output, failed: false },
+        Err(output) => tools::ToolOutcome { output, failed: true },
+    }
+}
