+// ---------------------------------------------------------------------------
+// Step 2: no-progress guard
+// ---------------------------------------------------------------------------
+
+/// Baseline: with the guard off the replay runs all 21 calls, no edit.
+/// With the guard on (default limit 6): duplicates are answered with a
+/// pointer, the SKView search carries the SDK hint, the nudge comes when
+/// the streak reaches 6, a user message follows at 10, read-only calls are
+/// refused from 14, and after three refusals the turn ends with a summary,
+/// after 12 LLM requests instead of 22.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn step2_guard_ends_the_recorded_skview_loop() {
+    // Baseline.
+    let project = skview_project("skview-off");
+    let (mut b, recorded) = Bridge::start(
+        script(skview_replay_script()),
+        &[("LLM_INVESTIGATE_LIMIT", "0")],
+    )
+    .await;
+    b.initialize(1);
+    let sid = b.new_session(project.to_str().unwrap(), json!([]));
+    let (_, r) = b.prompt(&sid, &skview_prompt(&project));
+    assert_eq!(r["result"]["stopReason"], "end_turn", "{r}");
+    assert_eq!(recorded.lock().unwrap().len(), 22, "all 21 recorded calls ran");
+    let all = results_in(&recorded).join("\n");
+    assert!(!all.contains("[acp-bridge]") && !all.contains("[Duplicate"));
+    b.shutdown();
+
+    // Guard on.
+    let project = skview_project("skview-guard");
+    let (mut b, recorded) = Bridge::start(script(skview_replay_script()), &[]).await;
+    b.initialize(1);
+    let sid = b.new_session(project.to_str().unwrap(), json!([]));
+    let (notes, r) = b.prompt(&sid, &skview_prompt(&project));
+    assert_eq!(r["result"]["stopReason"], "end_turn", "{r}");
+    let text = r["result"]["text"].as_str().unwrap();
+    assert!(text.starts_with("I could not settle on a fix. What I found:"), "{text}");
+    assert!(text.contains("search \"scene\": 4 matches (MyApp/GameView.swift:44"), "{text}");
+    let reqs = recorded.lock().unwrap().clone();
+    assert_eq!(reqs.len(), 12, "the turn ends after 12 LLM requests");
+
+    let results = tool_results(reqs.last().unwrap());
+    assert_eq!(results.len(), 11, "calls 1-11 are in the last request");
+    // Call 3 ("scene"): the member hint, the receiver's type read from the file.
+    assert!(
+        results[2].contains("'scene' from the compiler error is not declared in this project -- it is a member of an Apple SDK type (SKView, SpriteKit)"),
+        "{}", results[2]
+    );
+    assert!(results[2].contains("Use your knowledge of SKView's API"), "{}", results[2]);
+    // Call 5 ("class SKView"): the SDK hint, and the streak reaches 6 -> nudge.
+    assert!(results[4].contains("SKView is not declared in this project -- it is an Apple SDK type (SpriteKit)"), "{}", results[4]);
+    assert!(results[4].contains("[acp-bridge] 7 read/search calls without changing anything. Stop investigating."), "{}", results[4]);
+    assert!(!results[3].contains("Stop investigating"));
+    // Call 7: the 2nd identical search is answered with a pointer.
+    assert!(results[6].starts_with("[Duplicate: identical to your call in round 3; nothing changed since."), "{}", results[6]);
+    assert!(results[7].starts_with("[Duplicate: you have now made this exact call 3 times"), "{}", results[7]);
+    // Call 9 repeats a read from 7 rounds back: the full result again.
+    assert!(results[8].starts_with("[Duplicate of your call in round 2; nothing changed since. Same result again:]\nimport SpriteKit"), "{}", results[8]);
+    // Calls 10 and 11 are refused.
+    for r in &results[9..11] {
+        assert!(r.starts_with("Not run: investigation limit for this turn reached (14 calls without a change)"), "{r}");
+    }
+    // The user message follows round 7 (streak 10).
+    let msgs7 = reqs[7]["messages"].as_array().unwrap();
+    assert_eq!(msgs7.last().unwrap()["role"], "user");
+    assert!(msgs7.last().unwrap()["content"].as_str().unwrap().starts_with("Stop investigating now."));
+    assert_ne!(reqs[6]["messages"].as_array().unwrap().last().unwrap()["role"], "user");
+    // The client saw the duplicate as a normal, completed tool row.
+    let done = updates(&notes, "tool_call_update");
+    assert_eq!(done.len(), 12);
+    assert_eq!(done[6]["status"], "completed");
+    assert!(done[6]["content"][0]["content"]["text"].as_str().unwrap().starts_with("[Duplicate"));
+    assert_eq!(done[11]["status"], "failed");
+    let log = b.shutdown();
+    assert!(log.contains("Investigation streak: nudging"), "{log}");
+    assert!(log.contains("No progress: ending the turn"), "{log}");
+}
