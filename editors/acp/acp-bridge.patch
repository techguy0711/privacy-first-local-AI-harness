+/// `session/resume` (and the lazy restore of an evicted session): bring a
+/// stored session back into memory. The system prompt comes from the
+/// current config, the cwd from the request (or the stored one), the
+/// history and notes from disk; tool calls left unanswered by a crash get
+/// "Not run" results. A session already in memory is reused.
+pub fn session_restore(
+    state: &AppState,
+    session_id: &str,
+    cwd: Option<&str>,
+    protocol_version: crate::protocol::ProtocolVersion,
+) -> Result<(), AcpError> {
+    let Some(store) = &state.store else {
+        return Err(AcpError::SessionNotFound { session_id: session_id.into() });
+    };
+    if !crate::store::valid_id(session_id) {
+        return Err(AcpError::InvalidParams {
+            reason: format!("'{session_id}' is not a session id of this agent"),
+        });
+    }
+    if let Some(s) = state.sessions_write().get_mut(session_id) {
+        if let Some(cwd) = cwd {
+            let cwd = sanitize_cwd(cwd);
+            if s.working_dir != Path::new(&cwd) {
+                info!(session_id, cwd = %cwd, "Resumed session moves to a new cwd");
+                s.working_dir = PathBuf::from(&cwd);
+                // Everything derived from the old project goes: the
+                // web-search guard's names, imports, the build command, and
+                // Xcode's workspace id / navigator paths.
+                s.workspace_terms = None;
+                s.imports = None;
+                s.verify_plan = None;
+                if let Some(conn) = &s.xcode {
+                    conn.rebase(Path::new(&cwd));
+                }
+            }
+        }
+        s.touch();
+        return Ok(());
+    }
+    if state.config.max_sessions > 0 && state.sessions_read().len() >= state.config.max_sessions {
+        return Err(AcpError::SessionLimitReached { max: state.config.max_sessions });
+    }
+    let loaded = match store.load(session_id) {
+        Ok(l) => l,
+        Err(crate::store::LoadError::NotFound) => {
+            return Err(AcpError::SessionNotFound { session_id: session_id.into() })
+        }
+        Err(crate::store::LoadError::InUse(pid)) => {
+            return Err(AcpError::SessionBusy {
+                reason: format!("session {session_id} is in use by another acp-bridge process (pid {pid})"),
+            })
+        }
+        Err(crate::store::LoadError::Io(e)) => {
+            return Err(AcpError::SessionBusy { reason: format!("cannot open session {session_id}: {e}") })
+        }
+    };
+    let cwd = cwd.map(sanitize_cwd).unwrap_or_else(|| loaded.meta.cwd.clone());
+    if cwd != loaded.meta.cwd {
+        info!(session_id, stored = %loaded.meta.cwd, cwd = %cwd, "Resumed session moves to a new cwd");
+    }
+    let mut session = Session::new(system_message(state, &cwd), PathBuf::from(&cwd), protocol_version);
+    let restored = loaded.history.len();
+    session.messages.extend(loaded.history);
+    session.persisted_len = session.messages.len();
+    session.notes = loaded.notes;
+    session.summarized_upto = loaded.meta.summarized_upto.min(session.messages.len().saturating_sub(1));
+    session.title = loaded.meta.title.clone();
+    // The per-session web search budget survives a restart / eviction.
+    session.web_searches = loaded.meta.web_searches;
+    if !loaded.meta.created_at.is_empty() {
+        session.created_at = loaded.meta.created_at.clone();
+    }
+    if state.config.max_history_turns > 0 {
+        let before = session.messages.len();
+        session.trim_history(state.config.max_history_turns);
+        session.summarized_upto = session.summarized_upto.saturating_sub(before - session.messages.len());
+    }
+    // Everything loaded is already on disk (trim_history counted the
+    // removed lines in history_offset).
+    session.persisted_len = session.messages.len();
+    state.sessions_write().insert(session_id.to_string(), session);
+    info!(session_id, messages = restored, "Restored a stored session");
+    Ok(())
+}
