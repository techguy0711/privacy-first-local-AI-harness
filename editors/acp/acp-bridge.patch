+            .field("name", &self.name)
+            .field("pid", &self.pid())
+            .finish()
+    }
+}
+
+/// Environment for a stdio server: a few basics from ours plus the spec's.
+pub fn child_env(spec_env: &[(String, String)]) -> Vec<(String, String)> {
+    let mut env: Vec<(String, String)> = std::env::vars()
+        .filter(|(k, _)| {
+            matches!(k.as_str(), "PATH" | "HOME" | "USER" | "LOGNAME" | "TMPDIR" | "LANG")
+                || k.starts_with("LC_")
+        })
+        .collect();
+    for (k, v) in spec_env {
+        env.retain(|(ek, _)| ek != k);
+        env.push((k.clone(), v.clone()));
+    }
+    env
+}
+
+fn rpc_error(v: &Value) -> Option<McpError> {
+    let e = v.get("error")?;
+    Some(McpError::Rpc {
+        code: e.get("code").and_then(Value::as_i64).unwrap_or(0),
+        message: e
+            .get("message")
+            .and_then(Value::as_str)
+            .unwrap_or("error")
+            .to_string(),
+    })
+}
+
+impl McpClient {
+    /// Connect, handshake and list the tools.
+    pub async fn connect(spec: &McpSpec, opts: &ConnectOptions) -> Result<Arc<McpClient>, McpError> {
+        let progress: ProgressSinks = Arc::default();
+        let tools_stale = Arc::new(AtomicBool::new(false));
+        let transport = match spec {
+            McpSpec::Stdio { name, command, args, env } => Transport::Stdio(
+                spawn_stdio(name, command, args, env, Arc::clone(&progress), Arc::clone(&tools_stale))?,
+            ),
+            McpSpec::Http { url, headers, .. } => {
+                let url = loopback_url(url).map_err(McpError::Policy)?;
+                let client = reqwest::Client::builder()
+                    .no_proxy()
+                    .redirect(reqwest::redirect::Policy::none())
+                    .connect_timeout(Duration::from_secs(2))
+                    .build()
+                    .map_err(|e| McpError::Transport(e.to_string()))?;
+                Transport::Http(Http {
+                    client,
+                    url,
+                    headers: headers.clone(),
+                    session_id: Mutex::new(None),
+                })
+            }
+        };
+        let client = Arc::new(McpClient {
+            name: spec.name().to_string(),
+            transport,
+            next_id: AtomicU64::new(1),
+            tools: Mutex::new(Vec::new()),
+            tools_stale,
+            progress,
+            protocol_version: Mutex::new(PROTOCOL_VERSION.to_string()),
+            server_info: Mutex::new(Value::Null),
+        });
+        let deadline = tokio::time::Instant::now() + opts.handshake_timeout;
+        client.initialize(deadline).await?;
+        let left = deadline.saturating_duration_since(tokio::time::Instant::now());
+        let tools = client.list_tools(left.max(Duration::from_secs(1))).await?;
+        info!(
+            server = %client.name,
+            protocol = %lock(&client.protocol_version),
+            tools = tools.len(),
+            "MCP server connected"
+        );
+        Ok(client)
+    }
+
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    /// Process id of a stdio server.
+    pub fn pid(&self) -> Option<u32> {
+        match &self.transport {
+            Transport::Stdio(s) => s.pid,
+            Transport::Http(_) => None,
+        }
+    }
+
+    /// Tools from the last `tools/list`.
+    pub fn tools(&self) -> Vec<McpTool> {
+        lock(&self.tools).clone()
+    }
+
+    pub fn tool(&self, name: &str) -> Option<McpTool> {
+        lock(&self.tools).iter().find(|t| t.name == name).cloned()
+    }
+
+    /// The server announced `tools/list_changed` since the last listing.
+    pub fn tools_stale(&self) -> bool {
+        self.tools_stale.load(Ordering::SeqCst)
+    }
+
+    pub fn protocol_version(&self) -> String {
+        lock(&self.protocol_version).clone()
+    }
+
+    pub fn server_info(&self) -> Value {
+        lock(&self.server_info).clone()
+    }
+
+    /// Whether the server is gone (stdio EOF).
+    pub fn closed(&self) -> Option<String> {
+        match &self.transport {
+            Transport::Stdio(s) => lock(&s.closed).clone(),
+            Transport::Http(_) => None,
+        }
+    }
+
+    async fn initialize(&self, deadline: tokio::time::Instant) -> Result<(), McpError> {
+        let params = json!({
+            "protocolVersion": PROTOCOL_VERSION,
+            "capabilities": {},
+            "clientInfo": {"name": "acp-bridge", "version": env!("CARGO_PKG_VERSION")},
+        });
+        let left = deadline.saturating_duration_since(tokio::time::Instant::now());
+        let result = self.request_inner("initialize", params, left, None, false).await?;
+        let version = result
+            .get("protocolVersion")
+            .and_then(Value::as_str)
+            .unwrap_or("")
+            .to_string();
+        if !ACCEPTED_VERSIONS.contains(&version.as_str()) {
+            return Err(McpError::Protocol(format!(
+                "server '{}' speaks MCP '{version}', not one of {ACCEPTED_VERSIONS:?}",
+                self.name
+            )));
+        }
+        *lock(&self.protocol_version) = version;
+        *lock(&self.server_info) = result.get("serverInfo").cloned().unwrap_or(Value::Null);
+        self.notify("notifications/initialized", json!({})).await
+    }
+
+    /// `tools/list`, following `nextCursor` (at most 10 pages).
+    pub async fn list_tools(&self, timeout: Duration) -> Result<Vec<McpTool>, McpError> {
+        let mut out = Vec::new();
+        let mut cursor: Option<String> = None;
+        for _ in 0..MAX_LIST_PAGES {
+            let params = match &cursor {
+                Some(c) => json!({"cursor": c}),
+                None => json!({}),
+            };
+            let r = self.request("tools/list", params, timeout, None).await?;
+            out.extend(
+                r.get("tools")
+                    .and_then(Value::as_array)
+                    .into_iter()
+                    .flatten()
+                    .filter_map(McpTool::from_value),
+            );
+            cursor = r
+                .get("nextCursor")
+                .and_then(Value::as_str)
+                .filter(|c| !c.is_empty())
+                .map(str::to_owned);
+            if cursor.is_none() {
+                break;
+            }
+        }
+        self.tools_stale.store(false, Ordering::SeqCst);
+        *lock(&self.tools) = out.clone();
+        Ok(out)
+    }
+
+    /// `tools/call` with a progress token. Progress notifications go to
+    /// `progress`; a cancel or the timeout sends `notifications/cancelled`.
+    pub async fn call(
+        &self,
+        tool: &str,
+        arguments: Value,
+        timeout: Duration,
+        cancel: Option<&CancelToken>,
+        progress: Option<mpsc::UnboundedSender<Value>>,
+    ) -> Result<McpResult, McpError> {
+        let token = format!("acp-bridge-{}", self.next_id.fetch_add(1, Ordering::SeqCst));
+        if let Some(sink) = progress {
+            lock(&self.progress).insert(token.clone(), sink);
+        }
+        let params = json!({"name": tool, "arguments": arguments, "_meta": {"progressToken": token}});
+        let started = std::time::Instant::now();
+        let r = self.request("tools/call", params, timeout, cancel).await;
+        lock(&self.progress).remove(&token);
+        debug!(server = %self.name, tool, ms = started.elapsed().as_millis() as u64, ok = r.is_ok(), "MCP tools/call");
+        r.map(|v| McpResult::from_result(&v))
+    }
+
+    /// A request raced against `timeout` and `cancel`.
+    pub async fn request(
+        &self,
+        method: &str,
+        params: Value,
+        timeout: Duration,
+        cancel: Option<&CancelToken>,
+    ) -> Result<Value, McpError> {
+        self.request_inner(method, params, timeout, cancel, true).await
+    }
+
+    async fn request_inner(
+        &self,
+        method: &str,
+        params: Value,
+        timeout: Duration,
+        cancel: Option<&CancelToken>,
+        allow_reinit: bool,
+    ) -> Result<Value, McpError> {
+        let id = self.next_id.fetch_add(1, Ordering::SeqCst);
+        let msg = json!({"jsonrpc": "2.0", "id": id, "method": method, "params": params});
+        let never = CancelToken::new();
+        let cancel = cancel.unwrap_or(&never);
+        let outcome = match &self.transport {
+            Transport::Stdio(s) => {
+                let (tx, rx) = oneshot::channel();
+                lock(&s.pending).insert(id, tx);
+                if let Err(e) = write_line(&s.stdin, &msg).await {
+                    lock(&s.pending).remove(&id);
+                    return Err(e);
+                }
+                tokio::select! {
+                    r = rx => r.map_err(|_| McpError::Closed(lock(&s.closed).clone().unwrap_or_else(|| "connection lost".into()))),
+                    _ = tokio::time::sleep(timeout) => Err(McpError::Timeout),
+                    _ = cancel.cancelled() => Err(McpError::Cancelled),
+                }
+                .inspect_err(|_| {
+                    lock(&s.pending).remove(&id);
+                })
+            }
+            Transport::Http(h) => {
+                tokio::select! {
+                    r = self.http_exchange(h, &msg, Some(id), allow_reinit) => r.and_then(|v| v.ok_or_else(|| McpError::Protocol("no response".into()))),
+                    _ = tokio::time::sleep(timeout) => Err(McpError::Timeout),
+                    _ = cancel.cancelled() => Err(McpError::Cancelled),
+                }
+            }
+        };
+        match outcome {
+            Ok(v) => match rpc_error(&v) {
+                Some(e) => Err(e),
+                None => Ok(v.get("result").cloned().unwrap_or(Value::Null)),
+            },
+            Err(e @ (McpError::Timeout | McpError::Cancelled)) => {
+                if method != "initialize" {
+                    let reason = if e == McpError::Timeout { "timeout" } else { "cancelled by the user" };
+                    let _ = tokio::time::timeout(
+                        Duration::from_secs(2),
+                        self.notify("notifications/cancelled", json!({"requestId": id, "reason": reason})),
+                    )
+                    .await;
+                }
+                Err(e)
+            }
+            Err(e) => Err(e),
+        }
+    }
+
+    /// Send a notification.
+    pub async fn notify(&self, method: &str, params: Value) -> Result<(), McpError> {
+        let msg = json!({"jsonrpc": "2.0", "method": method, "params": params});
+        match &self.transport {
+            Transport::Stdio(s) => write_line(&s.stdin, &msg).await,
+            Transport::Http(h) => self.http_exchange(h, &msg, None, true).await.map(|_| ()),
+        }
+    }
+
+    /// POST one message; for a request return its response. A 404 while
+    /// holding a session id means the server restarted: re-initialize once
+    /// and retry.
+    async fn http_exchange(
+        &self,
+        h: &Http,
+        msg: &Value,
+        expect_id: Option<u64>,
+        allow_reinit: bool,
+    ) -> Result<Option<Value>, McpError> {
+        for attempt in 0..2 {
+            match self.http_post_once(h, msg, expect_id).await? {
+                HttpOutcome::SessionGone if attempt == 0 && allow_reinit => {
+                    warn!(server = %self.name, "MCP session expired (404); re-initializing");
+                    *lock(&h.session_id) = None;
+                    let params = json!({
+                        "protocolVersion": PROTOCOL_VERSION,
+                        "capabilities": {},
+                        "clientInfo": {"name": "acp-bridge", "version": env!("CARGO_PKG_VERSION")},
+                    });
+                    let id = self.next_id.fetch_add(1, Ordering::SeqCst);
+                    let init = json!({"jsonrpc": "2.0", "id": id, "method": "initialize", "params": params});
+                    match self.http_post_once(h, &init, Some(id)).await? {
+                        HttpOutcome::Message(Some(_)) => {}
+                        _ => return Err(McpError::Transport("re-initialize failed".into())),
+                    }
+                    let note = json!({"jsonrpc": "2.0", "method": "notifications/initialized", "params": {}});
+                    let _ = self.http_post_once(h, &note, None).await?;
+                }
+                HttpOutcome::SessionGone => {
+                    return Err(McpError::Transport("HTTP 404: MCP session not found".into()))
+                }
+                HttpOutcome::Message(v) => return Ok(v),
+            }
+        }
+        Err(McpError::Transport("HTTP 404: MCP session not found".into()))
+    }
+
+    async fn http_post_once(&self, h: &Http, msg: &Value, expect_id: Option<u64>) -> Result<HttpOutcome, McpError> {
+        let is_init = msg.get("method").and_then(Value::as_str) == Some("initialize");
+        let mut req = h
+            .client
+            .post(h.url.clone())
+            .header("Content-Type", "application/json")
+            .header("Accept", "application/json, text/event-stream");
+        for (k, v) in &h.headers {
+            req = req.header(k.as_str(), v.as_str());
+        }
+        let session = lock(&h.session_id).clone();
+        if let Some(sid) = &session {
+            req = req.header("Mcp-Session-Id", sid.as_str());
+        }
+        if !is_init {
+            req = req.header("MCP-Protocol-Version", self.protocol_version());
+        }
+        let resp = req
+            .body(msg.to_string())
+            .send()
+            .await
+            .map_err(|e| McpError::Transport(format!("cannot reach MCP server '{}': {e}", self.name)))?;
+        let status = resp.status();
+        if status.as_u16() == 404 && session.is_some() {
+            return Ok(HttpOutcome::SessionGone);
+        }
+        if let Some(sid) = resp.headers().get("mcp-session-id").and_then(|v| v.to_str().ok()) {
+            if is_init {
+                *lock(&h.session_id) = Some(sid.to_string());
+            }
+        }
+        if status.as_u16() == 202 {
+            return Ok(HttpOutcome::Message(None));
+        }
+        if !status.is_success() {
+            let body = resp.text().await.unwrap_or_default();
+            return Err(McpError::Transport(format!(
+                "HTTP {} from MCP server '{}': {}",
+                status.as_u16(),
+                self.name,
+                body.chars().take(200).collect::<String>()
+            )));
+        }
+        let Some(id) = expect_id else {
+            return Ok(HttpOutcome::Message(None));
+        };
+        let is_sse = resp
+            .headers()
+            .get("content-type")
+            .and_then(|v| v.to_str().ok())
+            .is_some_and(|c| c.contains("text/event-stream"));
+        if is_sse {
+            let mut resp = resp;
+            let mut parser = SseParser::default();
+            loop {
+                let chunk = resp
+                    .chunk()
+                    .await
+                    .map_err(|e| McpError::Transport(e.to_string()))?;
+                let events = match &chunk {
+                    Some(bytes) => parser.push(bytes),
+                    None => parser.finish().into_iter().collect(),
+                };
+                for data in events {
+                    let Ok(v) = serde_json::from_str::<Value>(&data) else {
+                        continue;
+                    };
+                    if let Some(found) = self.route_incoming(&v, id) {
+                        return Ok(HttpOutcome::Message(Some(found)));
+                    }
+                }
+                if chunk.is_none() {
+                    return Err(McpError::Protocol("SSE stream ended without a response".into()));
+                }
+            }
+        }
+        let body = resp
+            .bytes()
+            .await
+            .map_err(|e| McpError::Transport(e.to_string()))?;
+        let v: Value = serde_json::from_slice(&body)
+            .map_err(|e| McpError::Protocol(format!("invalid JSON from MCP server: {e}")))?;
+        let items = match v {
+            Value::Array(items) => items,
+            single => vec![single],
+        };
+        for item in items {
+            if let Some(found) = self.route_incoming(&item, id) {
+                return Ok(HttpOutcome::Message(Some(found)));
+            }
+        }
+        Err(McpError::Protocol("response did not answer the request".into()))
+    }
+
+    /// Handle a message read from an HTTP response: the awaited response is
+    /// returned, notifications are routed.
+    fn route_incoming(&self, v: &Value, id: u64) -> Option<Value> {
+        if v.get("method").is_none() {
+            return (v.get("id").and_then(Value::as_u64) == Some(id)).then(|| v.clone());
+        }
+        handle_notification(&self.name, v, &self.progress, &self.tools_stale);
+        None
+    }
+
+    /// End the session: HTTP DELETE (best effort); a stdio server is
+    /// killed when the client is dropped.
+    pub async fn close(&self) {
+        if let Transport::Http(h) = &self.transport {
+            let sid = lock(&h.session_id).clone();
+            if let Some(sid) = sid {
+                let _ = tokio::time::timeout(
+                    Duration::from_secs(1),
+                    h.client.delete(h.url.clone()).header("Mcp-Session-Id", sid).send(),
+                )
+                .await;
+            }
+        }
+    }
+}
+
+enum HttpOutcome {
+    Message(Option<Value>),
+    SessionGone,
+}
+
+/// Route a server notification (progress, list_changed, log message).
+fn handle_notification(server: &str, v: &Value, progress: &ProgressSinks, stale: &AtomicBool) {
+    match v.get("method").and_then(Value::as_str).unwrap_or("") {
+        "notifications/progress" => {
+            let params = v.get("params").cloned().unwrap_or(Value::Null);
+            let token = match params.get("progressToken") {
+                Some(Value::String(s)) => s.clone(),
+                Some(other) => other.to_string(),
+                None => return,
+            };
+            if let Some(sink) = lock(progress).get(&token) {
+                let _ = sink.send(params);
+            }
+        }
+        "notifications/tools/list_changed" => stale.store(true, Ordering::SeqCst),
+        "notifications/message" => {
+            let params = v.get("params").map(Value::to_string).unwrap_or_default();
+            debug!(server, params = %params, "MCP server message")
+        }
+        other => debug!(server, method = other, "MCP notification ignored"),
+    }
+}
+
+async fn write_line(
+    stdin: &tokio::sync::Mutex<tokio::process::ChildStdin>,
+    msg: &Value,
+) -> Result<(), McpError> {
+    let mut line = msg.to_string();
+    line.push('\n');
+    let mut w = stdin.lock().await;
+    w.write_all(line.as_bytes())
+        .await
+        .map_err(|e| McpError::Closed(format!("write failed: {e}")))?;
+    w.flush()
+        .await
+        .map_err(|e| McpError::Closed(format!("write failed: {e}")))
+}
+
+fn spawn_stdio(
+    name: &str,
+    command: &str,
+    args: &[String],
+    env: &[(String, String)],
+    progress: ProgressSinks,
+    stale: Arc<AtomicBool>,
+) -> Result<Stdio, McpError> {
+    let mut cmd = tokio::process::Command::new(command);
+    cmd.args(args)
+        .env_clear()
+        .envs(child_env(env))
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .kill_on_drop(true);
+    #[cfg(unix)]
+    cmd.process_group(0);
+    let mut child = cmd
+        .spawn()
+        .map_err(|e| McpError::Transport(format!("cannot start MCP server '{name}' ({command}): {e}")))?;
+    let pid = child.id();
+    let stdin = Arc::new(tokio::sync::Mutex::new(
+        child.stdin.take().ok_or_else(|| McpError::Transport("no stdin".into()))?,
+    ));
+    let stdout = child.stdout.take().ok_or_else(|| McpError::Transport("no stdout".into()))?;
+    let stderr = child.stderr.take().ok_or_else(|| McpError::Transport("no stderr".into()))?;
+    let pending: Pending = Arc::default();
+    let closed: Arc<Mutex<Option<String>>> = Arc::default();
+    let tail: Arc<Mutex<std::collections::VecDeque<String>>> = Arc::default();
+    info!(server = name, command, pid = ?pid, "Started MCP server");
+
+    let reader = {
+        let (pending, closed, stdin) = (Arc::clone(&pending), Arc::clone(&closed), Arc::clone(&stdin));
+        let tail = Arc::clone(&tail);
+        let server = name.to_string();
+        tokio::spawn(async move {
+            let mut lines = BufReader::new(stdout).lines();
+            loop {
+                let line = match lines.next_line().await {
+                    Ok(Some(l)) => l,
+                    Ok(None) | Err(_) => break,
+                };
+                let Ok(v) = serde_json::from_str::<Value>(line.trim()) else {
+                    debug!(server = %server, line = %line, "Non-JSON line from MCP server");
+                    continue;
+                };
+                match (v.get("method").and_then(Value::as_str), v.get("id")) {
+                    (None, Some(id)) => {
+                        if let Some(tx) = id.as_u64().and_then(|id| lock(&pending).remove(&id)) {
+                            let _ = tx.send(v);
+                        }
+                    }
+                    (Some(method), Some(id)) => {
+                        // A request from the server.
+                        let reply = if method == "ping" {
+                            json!({"jsonrpc": "2.0", "id": id, "result": {}})
+                        } else {
+                            debug!(server = %server, method, "Refusing a server request");
+                            json!({"jsonrpc": "2.0", "id": id, "error": {"code": -32601, "message": format!("Method not found: {method}")}})
+                        };
+                        let _ = write_line(&stdin, &reply).await;
+                    }
+                    (Some(_), None) => handle_notification(&server, &v, &progress, &stale),
+                    (None, None) => {}
+                }
+            }
+            // Give the stderr reader a moment: the exit reason is there.
+            tokio::time::sleep(Duration::from_millis(100)).await;
+            let why: Vec<String> = lock(&tail).iter().cloned().collect();
+            *lock(&closed) = Some(if why.is_empty() {
+                "the server exited".into()
+            } else {
+                format!("the server exited: {}", why.join(" / "))
+            });
+            // Dropping the senders fails every waiting request.
+            lock(&pending).clear();
+            debug!(server = %server, "MCP server stdout closed");
+        })
+    };
+    let stderr_task = {
+        let server = name.to_string();
+        tokio::spawn(async move {
+            let mut lines = BufReader::new(stderr).lines();
+            while let Ok(Some(line)) = lines.next_line().await {
+                debug!(server = %server, "stderr: {line}");
+                let mut t = lock(&tail);
+                if !line.trim().is_empty() {
+                    t.push_back(line.chars().take(300).collect());
+                }
+                while t.len() > STDERR_TAIL {
+                    t.pop_front();
+                }
+            }
+        })
+    };
+    Ok(Stdio {
+        child: Mutex::new(Some(child)),
+        pid,
+        stdin,
+        pending,
+        closed,
+        tasks: vec![reader, stderr_task],
+    })
+}
+
