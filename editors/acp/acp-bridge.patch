+// ---------------------------------------------------------------------------
+
+type Pending = Arc<Mutex<HashMap<u64, oneshot::Sender<Value>>>>;
+type ProgressSinks = Arc<Mutex<HashMap<String, mpsc::UnboundedSender<Value>>>>;
+
+struct Stdio {
+    child: Mutex<Option<tokio::process::Child>>,
+    pid: Option<u32>,
+    stdin: Arc<tokio::sync::Mutex<tokio::process::ChildStdin>>,
+    pending: Pending,
+    closed: Arc<Mutex<Option<String>>>,
+    tasks: Vec<tokio::task::JoinHandle<()>>,
+}
+
+/// Last stderr lines of a stdio server (for error messages: mcpbridge
+/// explains there why it exits, e.g. "Xcode MCP access is disabled").
+const STDERR_TAIL: usize = 5;
+
+impl Drop for Stdio {
+    fn drop(&mut self) {
+        for t in &self.tasks {
+            t.abort();
+        }
+        if let Some(mut child) = lock(&self.child).take() {
+            let _ = child.start_kill();
+        }
+        if let Some(pid) = self.pid {
+            crate::process::kill_process_group(pid);
+        }
+    }
+}
+
+struct Http {
+    client: reqwest::Client,
+    url: url::Url,
+    headers: Vec<(String, String)>,
+    session_id: Mutex<Option<String>>,
+}
