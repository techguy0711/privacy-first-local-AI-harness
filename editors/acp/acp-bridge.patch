+/// Glob match on `/`-separated paths: `*` and `?` stay within one path
+/// segment, `**` spans segments, `{a,b}` alternatives. A pattern without
+/// `/` is matched against the file name only.
+pub fn glob_match(pattern: &str, rel_path: &str) -> bool {
+    let pattern = pattern.trim().trim_start_matches("./");
+    if pattern.is_empty() {
+        return true;
+    }
+    for alt in expand_braces(pattern) {
+        let (pat, text) = if alt.contains('/') {
+            (alt.as_str(), rel_path)
+        } else {
+            (alt.as_str(), rel_path.rsplit('/').next().unwrap_or(rel_path))
+        };
+        if wildcard(pat.as_bytes(), text.as_bytes()) {
+            return true;
+        }
+    }
+    false
+}
+
+fn expand_braces(p: &str) -> Vec<String> {
+    let (Some(open), Some(close)) = (p.find('{'), p.find('}')) else {
+        return vec![p.to_string()];
+    };
+    if close < open {
+        return vec![p.to_string()];
+    }
+    let (head, body, tail) = (&p[..open], &p[open + 1..close], &p[close + 1..]);
+    body.split(',')
+        .flat_map(|alt| expand_braces(&format!("{head}{alt}{tail}")))
+        .collect()
+}
+
+fn wildcard(p: &[u8], t: &[u8]) -> bool {
+    match (p.first(), t.first()) {
+        (None, None) => true,
+        (None, Some(_)) => false,
+        (Some(b'*'), _) if p.get(1) == Some(&b'*') => {
+            // `**/` also matches nothing.
+            let rest = if p.get(2) == Some(&b'/') { &p[3..] } else { &p[2..] };
+            (0..=t.len()).any(|i| wildcard(rest, &t[i..])) || wildcard(&p[2..], t)
+        }
+        (Some(b'*'), _) => {
+            let mut i = 0;
+            loop {
+                if wildcard(&p[1..], &t[i..]) {
+                    return true;
+                }
+                if i >= t.len() || t[i] == b'/' {
+                    return false;
+                }
+                i += 1;
+            }
+        }
+        (Some(b'?'), Some(c)) if *c != b'/' => wildcard(&p[1..], &t[1..]),
+        (Some(a), Some(b)) if a == b => wildcard(&p[1..], &t[1..]),
+        _ => false,
+    }
+}
