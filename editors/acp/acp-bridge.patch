+pub fn tool_raw_output(
+    working_dir: &Path,
+    name: &str,
+    arguments: &Value,
+    outcome: &ToolOutcome,
+) -> Option<Value> {
+    let arg = |k: &str| arguments.get(k).and_then(|v| v.as_str()).unwrap_or("");
+    match name {
+        "search_code" => {
+            let results: Vec<String> = if outcome.failed || outcome.output.starts_with("No matches") {
+                Vec::new()
+            } else {
