+    .await;
+    b.initialize(1);
+    let sid = b.new_session(project.to_str().unwrap(), json!([]));
+    let (notes, r) = b.prompt(&sid, "look it up");
+    assert_eq!(r["result"]["stopReason"], "end_turn", "{r}");
+    let reqs = recorded.lock().unwrap().clone();
+    assert!(tool_names(&reqs[0]).contains(&"web_search".to_string()));
+    let results = tool_results(reqs.last().unwrap());
+    assert!(results[0].starts_with("Result 1 for SpriteKit SKView presentScene — Snippet 1: presentScene(_:) presents a scene in an SKView. (https://example.invalid/result-1)"), "{}", results[0]);
+    assert!(results[0].ends_with("(Pages cannot be opened; use these snippets.)"));
+    assert!(results[1].starts_with("Error: web_search refused by the privacy guard: it contains a file name ('GameScene.swift')"), "{}", results[1]);
+    assert!(results[2].contains("refused by the privacy guard: it contains code syntax"), "{}", results[2]);
+    assert!(results[3].starts_with("Result 1 for Cannot assign"), "{}", results[3]);
+    assert!(results[4].ends_with("(Same query as before -- do not repeat it.)"), "{}", results[4]);
+    assert!(results[5].contains("names from this project (acme)"), "{}", results[5]);
+    assert!(results[6].starts_with("Result 1 for swift SKScene scaleMode"), "{}", results[6]);
+    assert!(results[7].starts_with("Not run: the web search limit for this turn is reached (3 searches)"), "{}", results[7]);
+
+    let lines = mock_log(&log);
+    let calls: Vec<Value> = lines.iter().filter(|l| l["msg"]["method"] == "tools/call").map(|l| l["msg"]["params"].clone()).collect();
+    assert_eq!(
+        calls[0],
+        json!({"name": "brave_web_search", "arguments": {"query": "SpriteKit SKView presentScene", "count": 5, "result_filter": ["web"], "text_decorations": false}, "_meta": calls[0]["_meta"].clone()})
+    );
+    for c in &calls {
+        let a = c["arguments"].as_object().unwrap();
