+    }
+    let (wd, cancel) = (working_dir.to_path_buf(), cancel.clone());
+    let plan = tokio::task::spawn_blocking(move || verify::detect_with_cancel(&wd, Some(&cancel)))
+        .await
+        .ok()
+        .flatten();
+    match &plan {
+        Some(p) => {
+            if let Some(s) = state.sessions_write().get_mut(session_id) {
+                s.verify_plan = Some(p.clone());
+            }
+        }
+        None => debug!(cwd = %working_dir.display(), "No verify build detected"),
+    }
+    plan
+}
+
+/// Run the verify build after the model's final answer `text` (already in
+/// the history) and decide how the turn continues. Reported to the client
+/// as an `execute` tool call titled `Build: <command>`.
+#[allow(clippy::too_many_arguments)]
+async fn verify_after_final_answer(
+    state: &AppState,
+    session_id: &str,
+    working_dir: &std::path::Path,
+    text: &str,
+    vs: &mut VerifyState,
+    xcode: Option<&XcodeHandle>,
+    notify: &(dyn Fn(Notification) + Send + Sync),
+    cancel: &CancelToken,
+) -> VerifyStep {
+    let cfg = &state.config.verify;
+    if cfg.mode == verify::VerifyMode::Off {
+        return VerifyStep::Skip;
+    }
+    if !vs.changed {
+        // Nothing changed since the last (failed) build: rebuilding would
+        // repeat the same errors.
+        return match &vs.last_errors {
+            Some(errors) => VerifyStep::Finish(append_note(
+                text,
+                &format!("**The build still fails.** Remaining errors:\n```\n{errors}\n```"),
+            )),
+            None => VerifyStep::Skip,
+        };
+    }
+    let id = format!("build_{}", Uuid::new_v4().simple());
+    let built = run_harness_build(state, session_id, working_dir, xcode, &id, vs.attempts + 1, notify, cancel).await;
+    let Some((outcome, label)) = built else {
+        return if cancel.is_cancelled() {
+            VerifyStep::Cancelled
+        } else {
+            VerifyStep::Skip
+        };
+    };
+    vs.attempts += 1;
+    vs.changed = false;
+    let status = outcome.status;
+    let errors = outcome.errors;
+
+    match status {
+        verify::BuildStatus::Passed => {
+            vs.last_errors = None;
+            VerifyStep::Finish(append_note(text, "Build succeeded."))
+        }
+        verify::BuildStatus::Cancelled => VerifyStep::Cancelled,
+        verify::BuildStatus::Failed if vs.attempts < cfg.max_attempts => {
+            vs.last_errors = Some(errors.clone());
+            if !text.trim().is_empty() {
+                // Not the answer after all: show it as interim reasoning.
+                notify(Notification::Thought(text.to_string()));
+            }
+            let mut sessions = state.sessions_write();
+            if let Some(session) = sessions.get_mut(session_id) {
+                session.messages.push(json!({
+                    "role": "user",
+                    "content": format!("{BUILD_FAILED_PROMPT}\n{errors}")
+                }));
+            }
+            VerifyStep::Retry
+        }
+        verify::BuildStatus::Failed => {
+            vs.last_errors = Some(errors.clone());
+            VerifyStep::Finish(append_note(
+                text,
+                &format!(
+                    "**The build still fails** after {} build attempts. Remaining errors:\n```\n{errors}\n```",
+                    vs.attempts
+                ),
+            ))
+        }
+        verify::BuildStatus::TimedOut => VerifyStep::Finish(append_note(
+            text,
+            &format!(
+                "**The verify build timed out** after {}s (`{label}`), so the changes are not verified.",
+                cfg.timeout_secs
+            ),
+        )),
+        verify::BuildStatus::CouldNotRun => VerifyStep::Finish(append_note(
+            text,
+            &format!(
+                "**The verify build could not run** (`{label}`), so the changes are not verified:\n```\n{errors}\n```"
+            ),
+        )),
+        verify::BuildStatus::StoppedInXcode => {
+            VerifyStep::Finish(append_note(text, XCODE_BUILD_STOPPED))
+        }
+    }
+}
+
+/// A session's ready xcode-tools connection.
+type XcodeHandle = (Arc<crate::xcode::XcodeConn>, Arc<crate::mcp::McpClient>);
+
+/// Final text when Xcode reports the build was cancelled by the user.
+pub const XCODE_BUILD_STOPPED: &str = "The build was cancelled in Xcode; how should I proceed?";
+
+/// Run the harness build and report it to the client as tool call `id`.
+/// With `[verify] command = "auto"`, an Xcode project in the cwd and
+/// xcode-tools connected (BuildProject allowed), the build runs in Xcode;
+/// otherwise (or when BuildProject fails to start or times out) the
+/// detected command (`xcodebuild …`) or the configured one runs. `None`
+/// when builds are off or nothing was detected (or the turn was
+/// cancelled during detection). Returns the outcome and a label.
+#[allow(clippy::too_many_arguments)]
+async fn run_harness_build(
+    state: &AppState,
+    session_id: &str,
+    working_dir: &Path,
+    xcode: Option<&XcodeHandle>,
+    id: &str,
+    attempt: usize,
+    notify: &(dyn Fn(Notification) + Send + Sync),
+    cancel: &CancelToken,
+) -> Option<(verify::BuildOutcome, String)> {
+    let mode = &state.config.verify.mode;
+    if *mode == verify::VerifyMode::Off {
+        return None;
+    }
+    let mut fallback_id = id.to_string();
+    if *mode == verify::VerifyMode::Auto && verify::xcode_container(working_dir).is_some() {
+        if let Some((conn, client)) = xcode.filter(|(conn, client)| conn.usable(client, "BuildProject").is_some()) {
+            match xcode_build(state, working_dir, conn, client, id, attempt, notify, cancel).await {
+                Ok(outcome) => return Some((outcome, "Xcode (BuildProject)".into())),
+                Err(why) => {
+                    warn!(reason = %why, "BuildProject failed; falling back to xcodebuild");
+                    fallback_id = format!("{id}-xcodebuild");
+                }
+            }
+        } else {
+            debug!("Xcode project without xcode-tools (or BuildProject not allowed): building with xcodebuild");
+        }
+    }
+    let plan = tokio::select! {
+        p = verify_plan_for(state, session_id, working_dir, cancel) => p,
+        _ = cancel.cancelled() => None,
+    }?;
+    let outcome = build_and_report(state, working_dir, &plan, &fallback_id, attempt, notify, cancel).await;
+    Some((outcome, plan.label))
+}
+
+/// Build in Xcode with BuildProject, forwarding its progress to the
+/// client. `Err` (the caller falls back to xcodebuild) when the call
+/// cannot run or times out.
+#[allow(clippy::too_many_arguments)]
+async fn xcode_build(
+    state: &AppState,
+    working_dir: &Path,
+    conn: &crate::xcode::XcodeConn,
+    client: &crate::mcp::McpClient,
+    id: &str,
+    attempt: usize,
+    notify: &(dyn Fn(Notification) + Send + Sync),
+    cancel: &CancelToken,
+) -> Result<verify::BuildOutcome, String> {
+    use crate::acp::ToolCallContent;
+    notify(Notification::ToolStart {
+        id: id.to_string(),
+        name: "build".into(),
+        title: "Build: Xcode (BuildProject)".into(),
+        raw_input: json!({"command": "BuildProject"}),
+        locations: Vec::new(),
+        content: Vec::new(),
+    });
+    info!(attempt, "Verify build through Xcode (BuildProject)");
+    let timeout = Duration::from_secs(state.config.verify.timeout_secs);
+    let (tx, mut rx) = mpsc::unbounded_channel::<Value>();
+    let call = conn.call(client, "BuildProject", json!({}), timeout, Some(cancel), Some(tx));
+    tokio::pin!(call);
+    let result = loop {
+        tokio::select! {
+            r = &mut call => break r,
+            Some(p) = rx.recv() => {
+                let text = match (p.get("progress").and_then(Value::as_f64), p.get("total").and_then(Value::as_f64)) {
+                    (Some(n), Some(t)) => format!("Building… {n}/{t}"),
+                    _ => format!("Building… {}", p.get("message").and_then(Value::as_str).unwrap_or("")),
+                };
+                notify(Notification::ToolProgress { id: id.to_string(), content: vec![ToolCallContent::Text(text)] });
+            }
+        }
+    };
+    let done = |status: &str, text: &str| {
+        notify(Notification::ToolDone {
+            id: id.to_string(),
+            name: "build".into(),
+            status: status.into(),
+            content: vec![if status == "failed" && !text.starts_with("Cancelled") {
+                ToolCallContent::code_block(text, "", MAX_TOOL_OUTPUT_CHARS)
+            } else {
+                ToolCallContent::plain(text, MAX_TOOL_OUTPUT_CHARS)
+            }],
+            raw_output: Some(json!({"command": "BuildProject", "output": text})),
+        })
+    };
+    let r = match result {
+        Ok(r) => r,
+        Err(crate::mcp::McpError::Cancelled) => {
+            done("failed", "Cancelled.");
+            return Ok(verify::BuildOutcome { status: verify::BuildStatus::Cancelled, errors: String::new() });
+        }
+        Err(e) => {
+            done("failed", &format!("BuildProject failed ({e}); building with xcodebuild instead."));
+            return Err(e.to_string());
+        }
+    };
+    let s = r.structured_or_text_json();
+    let build_result = s
+        .as_ref()
+        .and_then(|v| v.get("buildResult").and_then(Value::as_str))
+        .unwrap_or("")
+        .to_string();
+    if s.is_none() && r.is_error {
+        done("failed", &format!("BuildProject failed ({}); building with xcodebuild instead.", r.text));
+        return Err(r.text);
+    }
+    let errors = s
+        .as_ref()
+        .and_then(|v| v.get("errors").and_then(Value::as_array).cloned())
+        .unwrap_or_default();
+    let report = verify::xcode_build_errors(&errors, working_dir);
+    let lower = build_result.to_ascii_lowercase();
+    let (status, errors) = if lower.contains("cancelled by a user interaction") {
+        (verify::BuildStatus::StoppedInXcode, String::new())
+    } else if !report.is_empty() {
+        (verify::BuildStatus::Failed, report)
+    } else if lower.contains("fail") || r.is_error {
+        let why = if build_result.is_empty() { r.text.clone() } else { build_result.clone() };
+        (verify::BuildStatus::Failed, why)
+    } else {
+        (verify::BuildStatus::Passed, String::new())
+    };
+    match status {
+        verify::BuildStatus::Passed => done("completed", "Build succeeded."),
+        verify::BuildStatus::StoppedInXcode => done("failed", "Cancelled in Xcode."),
+        _ => done("failed", &errors),
+    }
+    info!(attempt, ?status, "Xcode build finished");
+    Ok(verify::BuildOutcome { status, errors })
+}
+
+/// Run the build `plan` and report it to the client as an `execute` tool
+/// call `id` titled `Build: <label>`.
+async fn build_and_report(
+    state: &AppState,
+    working_dir: &Path,
+    plan: &verify::VerifyPlan,
+    id: &str,
+    attempt: usize,
+    notify: &(dyn Fn(Notification) + Send + Sync),
+    cancel: &CancelToken,
+) -> verify::BuildOutcome {
+    let cfg = &state.config.verify;
+    notify(Notification::ToolStart {
+        id: id.to_string(),
+        name: "build".into(),
+        title: tools::shorten_title(&format!("Build: {}", plan.label)),
+        raw_input: json!({"command": plan.command}),
+        locations: Vec::new(),
+        content: Vec::new(),
+    });
+    info!(attempt, command = %plan.command, "Verify build");
+    let timeout = Duration::from_secs(cfg.timeout_secs);
+    let outcome = verify::run(plan, working_dir, timeout, Some(cancel.clone())).await;
+    let status = outcome.status;
+    let detail = build_detail(&outcome, cfg.timeout_secs);
+    notify(Notification::ToolDone {
+        id: id.to_string(),
+        name: "build".into(),
+        status: if status == verify::BuildStatus::Passed {
+            "completed"
+        } else {
+            "failed"
+        }
+        .into(),
+        content: vec![match status {
+            verify::BuildStatus::Passed | verify::BuildStatus::Cancelled => {
+                crate::acp::ToolCallContent::plain(&detail, MAX_TOOL_OUTPUT_CHARS)
+            }
+            _ => crate::acp::ToolCallContent::code_block(&detail, "", MAX_TOOL_OUTPUT_CHARS),
+        }],
+        raw_output: Some(json!({"command": plan.command, "output": detail})),
+    });
+    info!(attempt, ?status, "Verify build finished");
+    outcome
+}
+
+/// Client-facing text for a finished build.
+fn build_detail(outcome: &verify::BuildOutcome, timeout_secs: u64) -> String {
+    match outcome.status {
+        verify::BuildStatus::Passed => "Build succeeded.".to_string(),
+        verify::BuildStatus::Cancelled => "Cancelled.".to_string(),
+        verify::BuildStatus::StoppedInXcode => "The build was cancelled in Xcode.".to_string(),
+        verify::BuildStatus::TimedOut => {
+            format!("Timed out after {timeout_secs}s.\n{}", outcome.errors)
+        }
+        _ => outcome.errors.clone(),
+    }
+}
+
+/// A model's `BuildProject` call (alias `build`): run the harness build now
+/// and hand the result back as the tool result. Counts against the turn's
+/// `LLM_VERIFY_MAX_ATTEMPTS`.
+#[allow(clippy::too_many_arguments)]
+async fn build_tool_call(
+    state: &AppState,
+    session_id: &str,
+    working_dir: &Path,
+    backend: llm::Backend,
+    tool_call_id: &str,
+    turn: &mut TurnCtx,
+    vs: &mut VerifyState,
+    notify: &(dyn Fn(Notification) + Send + Sync),
+    cancel: &CancelToken,
+) {
+    let cfg = &state.config.verify;
+    let refuse = |text: &str| {
+        notify(Notification::ToolStart {
+            id: tool_call_id.to_string(),
+            name: "build".into(),
+            title: "Build".into(),
+            raw_input: json!({}),
+            locations: Vec::new(),
+            content: Vec::new(),
+        });
+        notify(Notification::ToolDone {
+            id: tool_call_id.to_string(),
+            name: "build".into(),
+            status: "failed".into(),
+            content: vec![crate::acp::ToolCallContent::plain(text, MAX_TOOL_OUTPUT_CHARS)],
+            raw_output: None,
+        });
+        push_message(state, session_id, backend.format_tool_result(tool_call_id, text));
+    };
+    if cfg.mode == verify::VerifyMode::Off {
+        return refuse("Not run: builds are off in this session. Finish with your answer.");
+    }
+    if vs.attempts >= cfg.max_attempts {
+        return refuse(&format!(
+            "Not run: the build limit for this turn is reached ({} builds). Finish with your answer.",
+            vs.attempts
+        ));
+    }
+    let built = run_harness_build(
+        state,
+        session_id,
+        working_dir,
+        turn.xcode.as_ref(),
+        tool_call_id,
+        vs.attempts + 1,
+        notify,
+        cancel,
+    )
+    .await;
+    let Some((outcome, _label)) = built else {
+        if cancel.is_cancelled() {
+            return push_message(state, session_id, backend.format_tool_result(tool_call_id, "Cancelled."));
+        }
+        return refuse("Not run: no build system was detected in the working directory.");
+    };
+    vs.attempts += 1;
+    vs.changed = false;
+    if outcome.status == verify::BuildStatus::StoppedInXcode {
+        turn.end_turn = Some(XCODE_BUILD_STOPPED.to_string());
+    }
+    let text = match outcome.status {
+        verify::BuildStatus::Passed => {
+            vs.last_errors = None;
+            "Build succeeded.".to_string()
+        }
+        verify::BuildStatus::Failed => {
+            vs.last_errors = Some(outcome.errors.clone());
+            turn.guard.on_build_failed();
+            format!("Build failed with these errors:\n{}", outcome.errors)
+        }
+        _ => build_detail(&outcome, cfg.timeout_secs),
+    };
+    push_message(state, session_id, backend.format_tool_result(tool_call_id, &text));
+}
+
+/// Tool results for calls that were never run because the turn was
+/// cancelled, so every tool call in the history has its result.
+fn push_not_run_results(
+    state: &AppState,
+    session_id: &str,
+    backend: llm::Backend,
+    calls: &[Value],
+) {
+    let mut sessions = state.sessions_write();
+    if let Some(session) = sessions.get_mut(session_id) {
+        for tc in calls {
+            let id = tc.get("id").and_then(|v| v.as_str()).unwrap_or("");
+            session.messages.push(
+                backend.format_tool_result(id, "Not run: the user cancelled the turn."),
+            );
+        }
+    }
+}
+
+/// User message after a reply was discarded for looping (or for running
+/// into max_tokens).
+pub const LOOP_NUDGE: &str = "You were going in circles. Do not reconsider: pick the most likely option and act now with ONE tool call, or give your final answer.";
+/// Added to [`LOOP_NUDGE`] when the reply ran into max_tokens.
+const LENGTH_NUDGE: &str = " If you were writing a large file, split it into several smaller files (one write_file call each).";
+
+/// Why a reply is discarded by the loop check, if it is: it ran into
+/// max_tokens, or (when it has no tool call) its reasoning or text loops.
+fn loop_trigger(
+    finish_reason: Option<&str>,
+    reasoning: Option<&str>,
+    text: &str,
+    has_tool_calls: bool,
+    max_reasoning_chars: usize,
+) -> Option<String> {
+    if finish_reason == Some("length") {
+        return Some("length".into());
+    }
+    if has_tool_calls {
+        // The model got to a tool call: whatever it thought, it acted.
+        return None;
+    }
+    reasoning
+        .and_then(|r| crate::loopdetect::detect_reasoning(r, max_reasoning_chars))
+        .or_else(|| crate::loopdetect::detect_repetition(text))
+        .map(|k| match k {
+            crate::loopdetect::LoopKind::SentenceRepeat(s) => {
+                format!("sentence_repeat: \"{}\"", s.chars().take(80).collect::<String>())
+            }
+            other => other.as_str().to_string(),
+        })
+}
+
+/// Per-turn state shared by the tool calls of one turn.
+struct TurnCtx {
+    guard: guards::TurnGuard,
+    /// `notes` calls made this turn.
+    notes_calls: usize,
+    /// The session's xcode-tools connection when it is ready this turn.
+    xcode: Option<(Arc<crate::xcode::XcodeConn>, Arc<crate::mcp::McpClient>)>,
+    /// `docs_search` is offered this turn.
+    docs_search: bool,
+    /// `docs_search` calls made this turn.
+    docs_calls: usize,
+    /// Exposed MCP tools: model-facing name -> MCP tool name.
+    passthrough: HashMap<String, String>,
+    /// End the turn after this round with this text (Xcode stopped a build).
+    end_turn: Option<String>,
+    /// The web-search server when it answers this turn.
+    web: Option<Arc<crate::mcp::McpClient>>,
+    /// `web_search` calls that went out this turn.
+    web_calls: usize,
+}
+
+/// The workspace names the web-search guard refuses (collected once per
+/// session, again after 10 minutes, after any tool call that may have
+/// written files, and when a resume moves the session to another cwd).
+async fn workspace_terms(state: &AppState, session_id: &str, wd: &Path) -> Arc<crate::websearch::WorkspaceTerms> {
+    if let Some((at, terms)) = state.sessions_read().get(session_id).and_then(|s| s.workspace_terms.clone()) {
+        if at.elapsed() < Duration::from_secs(600) {
+            return terms;
+        }
+    }
+    let dir = wd.to_path_buf();
+    let terms = Arc::new(
+        tokio::task::spawn_blocking(move || crate::websearch::WorkspaceTerms::scan(&dir))
+            .await
+            .unwrap_or_default(),
+    );
+    debug!(terms = terms.len(), "Collected workspace names for the web-search guard");
+    if let Some(s) = state.sessions_write().get_mut(session_id) {
+        s.workspace_terms = Some((std::time::Instant::now(), Arc::clone(&terms)));
+    }
+    terms
+}
+
+/// A `web_search` call: privacy guard, budgets, cache, then
+/// `brave_web_search` with fixed arguments.
+async fn web_search_call(
+    state: &AppState,
+    session_id: &str,
+    wd: &Path,
+    turn: &mut TurnCtx,
+    args: &Value,
+    cancel: &CancelToken,
+) -> (tools::ToolOutcome, Option<Value>) {
+    use crate::websearch as ws;
+    let fail = |output: String| (tools::ToolOutcome { output, failed: true }, None);
+    let (Some(client), Some(web)) = (turn.web.clone(), state.web.clone()) else {
+        return fail("Error: web_search is not available in this session.".into());
+    };
+    let query = args.get("query").and_then(Value::as_str).unwrap_or("");
+    let key = query.split_whitespace().collect::<Vec<_>>().join(" ").to_lowercase();
+    let (cached, used) = match state.sessions_read().get(session_id) {
+        Some(s) => (s.web_cache.get(&key).cloned(), s.web_searches),
+        None => (None, 0),
+    };
+    if let Some((text, raw)) = cached {
+        info!(query = %key, "web_search answered from the session cache");
+        return (
+            tools::ToolOutcome {
+                output: format!("{text}\n(Same query as before -- do not repeat it.)"),
+                failed: false,
+            },
+            Some(raw),
+        );
+    }
+    if turn.web_calls >= ws::PER_TURN {
+        return fail(format!("Not run: the web search limit for this turn is reached ({} searches). Continue without searching.", ws::PER_TURN));
+    }
+    if used >= ws::PER_SESSION {
+        return fail(format!("Not run: the web search limit for this conversation is reached ({} searches). Continue without searching.", ws::PER_SESSION));
+    }
+    let terms = workspace_terms(state, session_id, wd).await;
+    let q = match ws::check_query(query, &terms, &ws::env_secrets()) {
+        Ok(q) => q,
+        Err(r) => {
+            warn!(rule = r.rule, reason = %r.reason, "web_search refused by the privacy guard");
+            return fail(ws::refusal_text(&r.reason));
+        }
+    };
+    turn.web_calls += 1;
+    if let Some(s) = state.sessions_write().get_mut(session_id) {
+        s.web_searches += 1;
+    }
+    info!(query = %q, "web_search");
+    match client.call(ws::BRAVE_TOOL, ws::brave_args(&q), web.call_timeout(), Some(cancel), None).await {
+        Ok(r) => {
+            let (text, raw) = ws::shape_results(&q, &r);
+            if let Some(s) = state.sessions_write().get_mut(session_id) {
+                s.web_cache.insert(key, (text.clone(), raw.clone()));
+            }
+            (tools::ToolOutcome { output: text, failed: false }, Some(raw))
+        }
+        Err(crate::mcp::McpError::Cancelled) => fail("Cancelled.".into()),
+        Err(e) => {
+            warn!(error = %e, "web_search failed");
+            if matches!(e, crate::mcp::McpError::Transport(_) | crate::mcp::McpError::Closed(_)) {
+                web.reset().await;
+            }
+            fail(format!("Error: web search failed: {e}"))
+        }
+    }
+}
+
+/// A `docs_search` call: Xcode's DocumentationSearch, shaped for the model.
+async fn docs_search_call(turn: &mut TurnCtx, args: &Value, cancel: &CancelToken) -> (tools::ToolOutcome, Option<Value>) {
+    let fail = |output: String| (tools::ToolOutcome { output, failed: true }, None);
+    let Some((conn, client)) = turn.xcode.clone().filter(|_| turn.docs_search) else {
+        return fail(tools::DOCS_UNAVAILABLE.to_string());
+    };
+    if turn.docs_calls >= crate::xcode::DOCS_PER_TURN {
+        return fail(format!(
+            "Not run: docs_search limit for this turn reached ({} searches). Use what you found and make the change.",
+            crate::xcode::DOCS_PER_TURN
+        ));
+    }
+    turn.docs_calls += 1;
+    let query = args.get("query").and_then(Value::as_str).unwrap_or("").trim().to_string();
+    if query.is_empty() {
+        return fail("Error: query is empty".into());
+    }
+    let mut call_args = json!({"query": query});
+    if let Some(f) = args.get("frameworks").filter(|f| f.is_array()) {
+        call_args["frameworks"] = f.clone();
+    }
+    let timeout = Duration::from_secs(conn.policy.call_timeout_secs.clamp(5, 120));
+    let started = std::time::Instant::now();
+    match conn.call(&client, "DocumentationSearch", call_args, timeout, Some(cancel), None).await {
+        Ok(r) if !r.is_error => {
+            let (text, raw) = crate::xcode::shape_docs(&query, &r);
+            info!(query = %query, documents = raw["documents"].as_array().map_or(0, |d| d.len()), ms = started.elapsed().as_millis() as u64, "docs_search");
+            (tools::ToolOutcome { output: text, failed: false }, Some(raw))
+        }
+        Ok(r) => fail(format!("Error: DocumentationSearch failed: {}", r.text)),
+        Err(crate::mcp::McpError::Cancelled) => fail("Cancelled.".into()),
+        Err(e) => fail(format!("Error: DocumentationSearch failed: {e}")),
+    }
+}
