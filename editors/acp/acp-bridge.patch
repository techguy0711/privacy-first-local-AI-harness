+    /// A lock whose pid now belongs to a process started after the lock was
+    /// written (pid reuse after a SIGKILL) is stale: the session can be
+    /// loaded, and retention deletes it when it is old.
+    #[test]
+    fn reused_pid_locks_are_stale() {
+        let dir = tmp("reuse");
+        let store = Store::open(&PersistSettings { enabled: true, state_dir: Some(dir.clone()), retention_days: 30 }).unwrap();
+        let now = now_unix();
+        let held = uuid::Uuid::new_v4().to_string();
+        let old = uuid::Uuid::new_v4().to_string();
+        for (id, at) in [(&held, now), (&old, now - 40 * 86_400)] {
+            store.create(&meta(id, "/p", at));
+            store.append(id, &[json!({"role": "user", "content": "x"})]);
+        }
+        // A live process that started now ...
+        let mut child = std::process::Command::new("sleep").arg("30").spawn().unwrap();
+        let pid = child.id();
+        let hour_ago = SystemTime::now() - Duration::from_secs(3600);
+        for id in [&held, &old] {
+            let lock = store.dir(id).join(".lock");
+            std::fs::write(&lock, pid.to_string()).unwrap();
+            // ... named by locks written an hour ago.
+            std::fs::File::options().write(true).open(&lock).unwrap().set_modified(hour_ago).unwrap();
+        }
+        assert!(store.load(&held).is_ok(), "reused pid: the lock is taken over");
+        assert_eq!(std::fs::read_to_string(store.dir(&held).join(".lock")).unwrap(), std::process::id().to_string());
+        assert_eq!(store.cleanup(), 1, "the old session with the stale lock is deleted");
+        assert!(!store.dir(&old).exists());
+        assert!(store.dir(&held).exists(), "held by this process");
+        // The same pid with a lock written after it started holds it.
+        std::fs::write(store.dir(&held).join(".lock"), pid.to_string()).unwrap();
+        assert_eq!(store.load(&held).unwrap_err(), LoadError::InUse(pid));
+        let _ = child.kill();
+        let _ = child.wait();
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    /// retention_days = 0: a session left behind without session/close
+    /// (crash) is deleted a day later; meta keeps the web search count.
+    #[test]
+    fn retention_zero_and_meta_fields() {
