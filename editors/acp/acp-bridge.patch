+
+/// Ollama-native twin of `mock_llm_sequence_router` (`/api/chat`, message
+/// at the top level, tool-call arguments as objects).
+fn mock_ollama_native_sequence_router(script: Vec<Value>) -> (Router, Recorded) {
+    let recorded: Recorded = Arc::default();
+    let router = Router::new()
+        .route("/api/tags", get(mock_ollama_tags))
+        .route("/api/chat", post(mock_ollama_native_sequence))
+        .route("/api/show", post(mock_ollama_show))
+        .route("/api/ps", get(mock_ollama_ps))
+        .with_state((Arc::new(script), Arc::clone(&recorded)));
+    (router, recorded)
+}
+
+async fn mock_ollama_native_sequence(
+    State((script, recorded)): State<(Arc<Vec<Value>>, Recorded)>,
+    req: Request<Body>,
+) -> impl IntoResponse {
+    let body_bytes = axum::body::to_bytes(req.into_body(), 4 * 1024 * 1024)
+        .await
+        .unwrap();
+    let body: Value = serde_json::from_slice(&body_bytes).unwrap();
+    let n = {
+        let mut r = recorded.lock().unwrap();
+        r.push(body);
+        r.len() - 1
+    };
+    let message = script.get(n).or(script.last()).cloned().unwrap();
+    axum::Json(json!({"model": "test-model", "message": message, "done": true})).into_response()
+}
+
+/// Estimated tokens of a request body the way acp-bridge estimates them.
+fn request_tokens(body: &Value) -> u64 {
+    let msgs = body["messages"].as_array().unwrap();
+    acp_bridge::context::estimate_request_tokens(msgs, body["tools"].to_string().len())
+}
+
+/// A long tool loop under a small LLM_MODEL_CONTEXT: later requests stay
+/// within the budget, the oldest write_file contents are elided first, and
+/// every tool call keeps its result. Runs against both backend shapes.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_context_budget_shrinks_old_rounds_for_both_backends() {
+    for native in [false, true] {
+        let port = free_port();
+        let project = fresh_project_dir("ctx");
+        let cwd = project.to_str().unwrap().to_string();
+        let write = |i: usize| -> Value {
+            let args = json!({"path": format!("src/f{i}.txt"), "content": format!("{i}").repeat(5000)});
+            if native {
+                json!({"role": "assistant", "content": "",
+                       "tool_calls": [{"function": {"name": "write_file", "arguments": args}}]})
+            } else {
+                scripted_tool_call("Write the next file.", &format!("call_{i}"), "write_file", args)
+            }
+        };
+        let mut script: Vec<Value> = (0..8).map(write).collect();
+        script.push(final_answer("All files written."));
+        let (router, recorded) = if native {
+            mock_ollama_native_sequence_router(script)
+        } else {
+            mock_llm_sequence_router(script)
+        };
+        let base = if native {
+            format!("http://127.0.0.1:{port}")
+        } else {
+            format!("http://127.0.0.1:{port}/v1")
+        };
+        let mut h = TestHarness::start_with_router_and_env(
+            port,
+            router,
+            &[
+                ("LLM_BASE_URL", &base),
+                ("LLM_MODEL_CONTEXT", "10000"),
+                ("LLM_MAX_TOKENS", "1000"),
+                ("LLM_VERIFY", "off"),
+                // Budget mechanics only: no room kept for the notes block
+                // (covered by tooling_test step6_*).
+                ("LLM_NOTES", "0"),
+            ],
+        )
+        .await;
+        h.send(&json!({"jsonrpc":"2.0","id":1,"method":"session/new","params":{"cwd":&cwd}}));
+        let sid = h.read_line()["result"]["sessionId"].as_str().unwrap().to_string();
+        h.send(&json!({
+            "jsonrpc":"2.0","id":2,"method":"session/prompt",
+            "params":{"sessionId":&sid,"prompt":[{"type":"text","text":"write eight files"}]}
+        }));
+        let (_n, response) = h.read_until_response(2);
+        assert_eq!(response["result"]["stopReason"], "end_turn", "native={native}");
+        for i in 0..8 {
+            assert_eq!(
+                std::fs::read_to_string(project.join(format!("src/f{i}.txt"))).unwrap().len(),
+                5000,
+                "tools still write the real content"
+            );
+        }
+
+        let budget = acp_bridge::context::budget_tokens(10_000, Some(1000));
+        let requests = recorded.lock().unwrap().clone();
+        assert_eq!(requests.len(), 9);
+        let last = &requests[8];
         assert!(
-            content.is_object(),
-            "agent_thought_chunk must include content object, got {n}"
-        );
-        assert_eq!(
-            content["type"].as_str(),
-            Some("text"),
-            "agent_thought_chunk.content.type must be 'text'"
+            request_tokens(last) <= budget,
+            "native={native}: {} > {budget}",
+            request_tokens(last)
         );
+        let msgs = last["messages"].as_array().unwrap();
+        assert_eq!(msgs[0]["role"], "system");
+        assert!(msgs.iter().any(|m| m["content"] == "write eight files"), "turn message kept");
+        // The oldest surviving write_file has elided contents; the newest is intact.
+        let args_of = |m: &Value| -> Value {
+            let a = &m["tool_calls"][0]["function"]["arguments"];
+            match a.as_str() {
+                Some(s) => serde_json::from_str(s).unwrap(),
+                None => a.clone(),
+            }
+        };
+        let calls: Vec<&Value> = msgs.iter().filter(|m| m["tool_calls"].is_array()).collect();
+        let first_args = args_of(calls[0]);
         assert!(
-            content["text"].is_string(),
-            "agent_thought_chunk.content.text must be a string"
+            first_args["content"].as_str().unwrap().starts_with("[contents of src/f"),
+            "native={native}: {first_args}"
         );
+        assert_eq!(args_of(calls.last().unwrap())["content"].as_str().unwrap().len(), 5000);
+        // Every tool call is immediately followed by its result.
+        for (i, m) in msgs.iter().enumerate() {
+            if m["tool_calls"].is_array() {
+                assert_eq!(msgs[i + 1]["role"], "tool", "native={native}: call at {i} lost its result");
+                if !native {
+                    assert_eq!(msgs[i + 1]["tool_call_id"], m["tool_calls"][0]["id"]);
+                }
+            }
+            if m["role"] == "tool" {
+                assert!(msgs[i - 1]["tool_calls"].is_array(), "native={native}: orphan result at {i}");
+            }
+        }
+        // An unconstrained early request was sent untouched.
+        let first_req = requests[0]["messages"].as_array().unwrap();
+        assert_eq!(first_req.len(), 2);
+        h.shutdown();
+        let _ = std::fs::remove_dir_all(&project);
     }
+}
 
