+/// An allowlisted mcpbridge is never started with a subcommand
+/// (`run-agent <agent>` would launch a coding agent); without arguments it
+/// is.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn fix_mcpbridge_subcommands_are_refused() {
+    let dir = fresh_dir("bridge-args");
+    let bridge = dir.join("mcpbridge");
+    std::os::unix::fs::symlink(mock_bin(), &bridge).unwrap();
+    let config = dir.join("acp.toml");
+    std::fs::write(&config, format!("[mcp]\nallowed_commands = [\"{}\"]\nconnect_timeout_secs = 5\n", bridge.display())).unwrap();
+    let log = dir.join("mock.jsonl");
+    let (mut b, recorded) =
+        Bridge::start_with_config(script(vec![answer("one"), answer("two")]), &[], Some(&config)).await;
+    b.initialize(1);
+    let mut server = xcode_server(&[("MOCK_LOG", log.to_str().unwrap())]);
+    server[0]["command"] = json!(bridge);
+    server[0]["args"] = json!(["run-agent", "claude"]);
+    let sid = b.new_session(dir.to_str().unwrap(), server.clone());
+    b.prompt(&sid, "first");
+    assert!(mock_starts(&log).is_empty(), "not started with a subcommand");
+    server[0]["args"] = json!([]);
+    let sid = b.new_session(dir.to_str().unwrap(), server);
+    b.prompt(&sid, "second");
+    assert_eq!(mock_starts(&log).len(), 1, "started without arguments");
+    assert!(tool_names(&recorded.lock().unwrap()[1]).contains(&"docs_search".to_string()));
+    let stderr = b.shutdown();
+    assert!(stderr.contains("Not starting MCP server: arguments refused"), "{stderr}");
+    let _ = std::fs::remove_dir_all(&dir);
+}
