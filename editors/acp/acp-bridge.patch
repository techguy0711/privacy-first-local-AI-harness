+/// `[mcp]` table of the config file.
+#[derive(Debug, Deserialize, Default, Clone)]
+pub struct McpSection {
+    /// `false` turns every MCP feature off (`LLM_MCP=off`).
+    pub enabled: Option<bool>,
+    /// `"allowlist"` (default) or `"off"`: servers the client (Xcode)
+    /// passes in `session/new`.
