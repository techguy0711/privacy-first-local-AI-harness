+        Bridge::start_with_config(script(replies), &[("LLM_VERIFY", "auto")], Some(&config)).await;
+    b.initialize(1);
+    let sid = b.new_session(
+        project.to_str().unwrap(),
+        xcode_server(&[
+            ("MOCK_LOG", log.to_str().unwrap()),
+            ("MOCK_PROGRESS", "1"),
