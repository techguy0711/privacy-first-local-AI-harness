+    #[test]
+    fn locks_list_and_retention() {
+        let dir = tmp("ret");
+        let store = Store::open(&PersistSettings { enabled: true, state_dir: Some(dir.clone()), retention_days: 30 }).unwrap();
+        let now = now_unix();
+        let fresh = uuid::Uuid::new_v4().to_string();
+        let old = uuid::Uuid::new_v4().to_string();
+        let old_locked = uuid::Uuid::new_v4().to_string();
+        let other_cwd = uuid::Uuid::new_v4().to_string();
+        store.create(&meta(&fresh, "/p", now));
+        store.create(&meta(&old, "/p", now - 40 * 86_400));
+        store.create(&meta(&old_locked, "/p", now - 40 * 86_400));
+        store.create(&meta(&other_cwd, "/q", now - 10));
+        for id in [&fresh, &old, &old_locked, &other_cwd] {
+            store.append(id, &[json!({"role": "user", "content": "x"})]);
+        }
+        // A session that never got a message: not listed, deleted after a day.
+        let empty = uuid::Uuid::new_v4().to_string();
+        store.create(&meta(&empty, "/p", now - 2 * 86_400));
+        store.unlock(&empty);
+        // Released locks for all but one (held by a live process: us).
+        store.unlock(&fresh);
+        store.unlock(&old);
+        store.unlock(&other_cwd);
+        let listed: Vec<String> = store.list(Some("/p")).into_iter().map(|m| m.session_id).collect();
+        assert_eq!(listed.len(), 3);
+        assert_eq!(listed[0], fresh, "newest first");
+        assert_eq!(store.list(None).len(), 4);
+        assert_eq!(store.cleanup(), 2, "only the old, unlocked session and the empty one go");
+        assert!(!store.dir(&old).exists());
+        assert!(!store.dir(&empty).exists());
+        assert!(store.dir(&old_locked).exists(), "a live lock is never deleted");
+        // A lock held by another live process blocks loading.
+        std::fs::write(store.dir(&fresh).join(".lock"), "1").unwrap(); // launchd: always alive
+        assert_eq!(store.load(&fresh).unwrap_err(), LoadError::InUse(1));
+        // A stale lock (dead pid) is taken over.
+        std::fs::write(store.dir(&fresh).join(".lock"), "999999").unwrap();
+        assert!(store.load(&fresh).is_ok());
+        let _ = std::fs::remove_dir_all(&dir);
+    }
