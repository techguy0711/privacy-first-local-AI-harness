+            assert!(report.dropped_indices.windows(2).all(|w| w[0] < w[1]));
+            assert!(report.dropped_indices.iter().all(|&i| i != 0 && i != protected_turn_msg));
+            assert!(out.iter().any(|x| x["content"] == "build the game"), "turn message kept");
+            assert_eq!(out.last().unwrap()["content"], "the real question");
+            assert!(report.after_tokens < report.before_tokens);
+        }
+    }
+
+    #[test]
+    fn last_resort_shrinks_recent_rounds_but_keeps_them() {
+        // One huge recent result: nothing old to drop.
+        let mut m = conversation(|_| Vec::new(), 0);
+        m.extend(openai_round("c1", "read_file", json!({"path": "big.txt"}), &big(200_000)));
+        let (out, report) = fit_messages(&m, 0, 2000, &[1]);
+        assert_eq!(out.len(), m.len());
+        assert!(report.truncated == 1 && report.fits(), "{report:?}");
+        assert_pairs_consistent(&out);
+    }
