+/// Display content attached to a tool call (ACP `ToolCallContent`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ToolCallContent {
+    /// Markdown text, sent as `{type: "content", content: {type: "text"}}`.
+    Text(String),
+    /// Whole-file change. `path` is absolute; `old_text: None` = new file.
+    Diff {
+        path: String,
+        old_text: Option<String>,
+        new_text: String,
+    },
+}
+
+impl ToolCallContent {
+    /// Wire shape for the negotiated version. v1 diffs carry the full old
+    /// and new text; v2 diffs carry the structured `changes` list (the
+    /// optional git patch text is not generated).
+    pub fn to_json(&self, version: ProtocolVersion) -> Value {
+        match self {
+            Self::Text(text) => json!({
+                "type": "content",
+                "content": {"type": "text", "text": text}
+            }),
+            Self::Diff {
+                path,
+                old_text,
+                new_text,
+            } => match version {
+                ProtocolVersion::V2 => json!({
+                    "type": "diff",
+                    "changes": [{
+                        "operation": if old_text.is_some() { "modify" } else { "add" },
+                        "path": path,
+                        "fileType": "text"
+                    }]
+                }),
+                _ => json!({
+                    "type": "diff",
+                    "path": path,
+                    "oldText": old_text,
+                    "newText": new_text
+                }),
+            },
+        }
+    }
+
+    /// Tool output as a Markdown code block, truncated to `max_chars`
+    /// characters. The fence is longer than any backtick run in the output
+    /// so the block cannot be closed early.
+    pub fn code_block(output: &str, lang: &str, max_chars: usize) -> Self {
+        let (body, total) = truncate_chars(output, max_chars);
+        let mut run = 0usize;
+        let mut longest = 0usize;
+        for c in body.chars() {
+            run = if c == '`' { run + 1 } else { 0 };
+            longest = longest.max(run);
+        }
+        let fence = "`".repeat(longest.max(2) + 1);
+        let mut text = format!("{fence}{lang}\n{}\n{fence}", body.trim_end_matches('\n'));
+        if let Some(total) = total {
+            text.push_str(&format!(
+                "\n\n_(truncated: first {max_chars} of {total} characters)_"
+            ));
+        }
+        Self::Text(text)
+    }
+
+    /// Plain text, truncated to `max_chars` characters.
+    pub fn plain(output: &str, max_chars: usize) -> Self {
+        let (body, total) = truncate_chars(output, max_chars);
+        match total {
+            Some(total) => Self::Text(format!(
+                "{body}\n\n_(truncated: first {max_chars} of {total} characters)_"
+            )),
+            None => Self::Text(body.to_string()),
+        }
+    }
+}
+
+/// First `max_chars` characters of `text`, plus the total character count
+/// when it was cut.
+fn truncate_chars(text: &str, max_chars: usize) -> (&str, Option<usize>) {
+    match text.char_indices().nth(max_chars) {
+        Some((idx, _)) => (&text[..idx], Some(text.chars().count())),
+        None => (text, None),
+    }
+}
