+/// HTTP(S)_PROXY / ALL_PROXY in the agent's environment do not capture the
+/// LLM traffic (prompts and source go only to the configured endpoint).
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn fix_llm_traffic_ignores_proxy_variables() {
+    let proxy = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    proxy.set_nonblocking(true).unwrap();
+    let p = format!("http://{}", proxy.local_addr().unwrap());
+    let (router, recorded) = mock_router(script(vec![answer("direct")]));
+    let (url, handle) = serve(router).await;
+    let env: Vec<(String, String)> = [
+        ("LLM_BASE_URL", format!("{}/v1", url.replace("127.0.0.1", "localhost"))),
+        ("HTTP_PROXY", p.clone()),
+        ("http_proxy", p.clone()),
+        ("HTTPS_PROXY", p.clone()),
+        ("ALL_PROXY", p.clone()),
+    ]
+    .into_iter()
+    .map(|(k, v)| (k.to_string(), v))
+    .collect();
+    let mut b = Bridge::spawn(&env, None);
+    b._server = Some(handle);
+    b.initialize(1);
+    let sid = b.new_session(fresh_dir("proxy").to_str().unwrap(), json!([]));
+    let (_, r) = b.prompt(&sid, "hi");
+    assert_eq!(r["result"]["text"], "direct", "{r}");
+    assert_eq!(recorded.lock().unwrap().len(), 1);
+    b.shutdown();
+    assert!(proxy.accept().is_err(), "nothing connected to the proxy");
+}
