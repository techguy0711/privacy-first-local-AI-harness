+// Step 4: reasoning-loop check
+// ---------------------------------------------------------------------------
+
+fn looping_reasoning() -> String {
+    let mut t = String::from("The error is on line 44. ");
+    for _ in 0..15 {
+        t.push_str("Wait, I will try to use the scene property of the view. Actually, the scene property is read-only in this case.\n");
+    }
+    t
+}
+
+/// A reply that loops until max_tokens is discarded: the client sees a
+/// short thought instead of the loop, the retry carries
+/// `reasoning_effort: "none"` and the nudge, and the looping text never
+/// enters the history. A second loop in the same turn fails the turn.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn step4_loop_is_discarded_and_retried_with_thinking_off() {
+    let dir = fresh_dir("loop");
+    let looping = Reply::Message(
+        json!({"role": "assistant", "content": "", "reasoning": looping_reasoning()}),
+        "length",
+    );
+    let (mut b, recorded) = Bridge::start(script(vec![looping.clone(), answer("Use presentScene.")]), &[]).await;
+    b.initialize(1);
+    let sid = b.new_session(dir.to_str().unwrap(), json!([]));
+    let (notes, r) = b.prompt(&sid, "fix it");
+    assert_eq!(r["result"]["stopReason"], "end_turn", "{r}");
+    assert_eq!(r["result"]["text"], "Use presentScene.");
+    let reqs = recorded.lock().unwrap().clone();
+    assert_eq!(reqs.len(), 2);
+    assert!(reqs[0].get("reasoning_effort").is_none());
+    assert_eq!(reqs[1]["reasoning_effort"], "none");
+    let last = reqs[1]["messages"].as_array().unwrap().last().unwrap().clone();
+    assert_eq!(last["role"], "user");
+    let nudge = last["content"].as_str().unwrap();
+    assert!(nudge.starts_with("You were going in circles.") && nudge.contains("split it into several smaller files"), "{nudge}");
+    assert!(!reqs[1].to_string().contains("scene property is read-only"), "looping text kept in history");
+    let thoughts: Vec<String> = updates(&notes, "agent_thought_chunk")
+        .iter()
+        .map(|u| u["content"]["text"].as_str().unwrap().to_string())
+        .collect();
+    assert!(thoughts.iter().any(|t| t.contains("stopped a repeating line of reasoning")), "{thoughts:?}");
+    assert!(!thoughts.iter().any(|t| t.contains("scene property is read-only")), "{thoughts:?}");
+    // The next turn starts with thinking on again.
+    let (_, r) = b.prompt(&sid, "thanks");
+    assert_eq!(r["result"]["stopReason"], "end_turn", "{r}");
+    assert!(recorded.lock().unwrap()[2].get("reasoning_effort").is_none());
+    b.shutdown();
+
+    // A loop that ends without a tool call (finish "stop"), twice: failed.
+    let stop_loop = Reply::Message(
+        json!({"role": "assistant", "content": "Not sure.", "reasoning": looping_reasoning()}),
+        "stop",
+    );
+    let (mut b, recorded) = Bridge::start(script(vec![stop_loop]), &[]).await;
+    b.initialize(1);
+    let sid = b.new_session(dir.to_str().unwrap(), json!([]));
+    let (_, r) = b.prompt(&sid, "fix it");
+    assert_eq!(r["result"]["status"], "failed", "{r}");
+    assert!(r["result"]["text"].as_str().unwrap().contains("got stuck twice"), "{r}");
+    assert_eq!(recorded.lock().unwrap().len(), 2);
+    b.shutdown();
+
+    // LLM_LOOP_CHECK=0: the same reply is the answer.
+    let stop_loop = Reply::Message(
+        json!({"role": "assistant", "content": "Not sure.", "reasoning": looping_reasoning()}),
+        "stop",
+    );
+    let (mut b, recorded) = Bridge::start(script(vec![stop_loop]), &[("LLM_LOOP_CHECK", "0")]).await;
+    b.initialize(1);
+    let sid = b.new_session(dir.to_str().unwrap(), json!([]));
+    let (_, r) = b.prompt(&sid, "fix it");
+    assert_eq!(r["result"]["text"], "Not sure.", "{r}");
+    assert_eq!(recorded.lock().unwrap().len(), 1);
