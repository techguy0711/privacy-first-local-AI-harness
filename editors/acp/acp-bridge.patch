+    let config = brave_config(&dir, &mock.url);
+    let queries = [
+        "SpriteKit SKView presentScene",                                    // allowed (1)
+        "GameScene.swift scene presentScene",                               // file name
+        "let skView = view as! SKView",                                     // code
+        "Cannot assign to property: 'scene' is a get-only property SKView", // allowed (2), after a 404
+        "SpriteKit  skview presentScene",                                   // cached
+        "acme crash reporting",                                             // bundle id part
+        "swift SKScene scaleMode",                                          // allowed (3)
