+// ----------------------------------------------------------------------------
+// Client-facing tool call details (ACP title / locations / rawInput / diff)
+// ----------------------------------------------------------------------------
+
+/// Largest text (either side) reported to the client in a diff.
+const MAX_DIFF_BYTES: usize = 256 * 1024;
+/// Maximum length of a tool call title.
+const MAX_TITLE_CHARS: usize = 80;
+
+/// The change a `write_file` / `edit` call is about to make, shown to the
+/// client as an ACP diff. For `write_file` both sides are whole files; for
+/// `edit` they are the replaced snippet and its replacement (Claude-style
+/// Edit semantics, which Xcode maps onto its own old/new-string update).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct FileChange {
+    /// Absolute path as the client knows it: the session cwd joined with the
+    /// model's path (not canonicalized, so it matches the cwd the client sent).
+    pub path: PathBuf,
+    /// Previous text; `None` when `write_file` creates a new file.
+    pub old_text: Option<String>,
+    /// Text after the change.
+    pub new_text: String,
+}
+
+/// Result of [`execute_tool_detailed`].
+#[derive(Debug, Clone)]
+pub struct ToolOutcome {
+    /// The text handed back to the model (identical to [`execute_tool`]).
+    pub output: String,
+    /// True when the tool reported an error (or `bash` exited non-zero).
+    pub failed: bool,
+}
+
+/// Absolute path for a model-supplied path, resolved the same way the tools
+/// resolve it (leading `/` stripped, joined to the working directory), with
+/// `.` / `..` removed lexically. Not canonicalized, so it keeps the cwd
+/// spelling the client sent.
+pub fn display_path(working_dir: &Path, relative_path: &str) -> PathBuf {
+    use std::path::Component;
+    let joined = working_dir.join(relative_path.trim_start_matches('/'));
+    let abs = if joined.is_absolute() {
+        joined
+    } else {
+        std::path::absolute(&joined).unwrap_or(joined)
+    };
+    let mut out = PathBuf::new();
+    for c in abs.components() {
+        match c {
+            Component::CurDir => {}
+            Component::ParentDir => {
+                if matches!(out.components().next_back(), Some(Component::Normal(_))) {
+                    out.pop();
+                }
+            }
+            other => out.push(other.as_os_str()),
+        }
+    }
+    out
+}
+
+/// First line of `text`, cut to the tool-call title length; `…` marks a
+/// cut or dropped lines.
+pub fn shorten_title(text: &str) -> String {
+    shorten(text, MAX_TITLE_CHARS)
+}
+
+/// First line of `text`, cut to `max_chars` characters; `…` marks a cut or
+/// dropped lines.
+fn shorten(text: &str, max_chars: usize) -> String {
+    let text = text.trim();
+    let line = text.lines().next().unwrap_or("").trim();
+    if line.chars().count() > max_chars || text.lines().nth(1).is_some() {
+        let cut: String = line.chars().take(max_chars).collect();
+        format!("{cut}…")
+    } else {
+        line.to_string()
+    }
+}
+
+/// The command line a shell-like tool runs: the `bash` command itself, or
+/// the git invocation a `git_*` tool stands for. `None` for other tools.
+fn command_line(name: &str, arguments: &Value) -> Option<String> {
+    let path_suffix = match arguments.get("path").and_then(|v| v.as_str()) {
+        Some(p) if !p.is_empty() => format!(" -- {p}"),
+        _ => String::new(),
+    };
+    match name {
+        "bash" => Some(
+            arguments
+                .get("command")
+                .and_then(|v| v.as_str())
+                .unwrap_or("")
+                .to_string(),
+        ),
+        "git_status" => Some("git status".to_string()),
+        "git_diff" => {
+            let staged = arguments
+                .get("staged")
+                .and_then(|v| v.as_bool())
+                .unwrap_or(false);
+            let cached = if staged { " --cached" } else { "" };
+            Some(format!("git diff{cached}{path_suffix}"))
+        }
+        "git_log" => Some(format!("git log{path_suffix}")),
+        "git_commit" => {
+            let message = arguments.get("message").and_then(|v| v.as_str());
+            Some(format!("git commit -m {:?}", message.unwrap_or("")))
+        }
+        _ => None,
+    }
+}
+
+/// Human-readable title for a tool call, e.g. `Write MyApp/GameScene.swift`.
+/// Shell-like tools (`bash`, `git_*`) are titled with their command text.
+pub fn tool_title(name: &str, arguments: &Value) -> String {
+    let arg = |key: &str| arguments.get(key).and_then(|v| v.as_str()).unwrap_or("");
+    let rel = |key: &str| {
+        let p = arg(key).trim_start_matches('/');
+        let p = p.strip_prefix("./").unwrap_or(p);
+        if p.is_empty() || p == "." {
+            ".".to_string()
+        } else {
+            p.to_string()
+        }
+    };
+    let title = match name {
+        "read_file" => format!("Read {}", rel("path")),
+        "write_file" => format!("Write {}", rel("path")),
+        "edit" => format!("Edit {}", rel("path")),
+        "list_dir" => format!("List {}", rel("path")),
+        "search_code" => match arguments.get("file_glob").and_then(|v| v.as_str()) {
+            Some(glob) if !glob.is_empty() => format!("Search \"{}\" in {glob}", arg("pattern")),
+            _ => format!("Search \"{}\"", arg("pattern")),
+        },
+        "web_fetch" => format!("Fetch {}", arg("url")),
+        "notes" => format!("Notes: {}", if arg("action").is_empty() { "read" } else { arg("action") }),
+        // Xcode renders `mcp__xcode-tools__*` titles as its own tool rows.
+        "docs_search" => "mcp__xcode-tools__DocumentationSearch".to_string(),
+        "web_search" => format!("Web search: {}", arg("query")),
+        n if n.starts_with("mcp__") => n.to_string(),
+        _ => match command_line(name, arguments) {
+            Some(cmd) if !cmd.trim().is_empty() => cmd,
+            _ => name.to_string(),
+        },
+    };
+    shorten(&title, MAX_TITLE_CHARS)
+}
+
+/// Absolute paths a tool call touches (ACP `locations`).
+pub fn tool_locations(working_dir: &Path, name: &str, arguments: &Value) -> Vec<PathBuf> {
+    let path = arguments.get("path").and_then(|v| v.as_str());
+    match (name, path) {
+        ("read_file" | "write_file" | "edit", Some(p)) if !p.is_empty() => {
+            vec![display_path(working_dir, p)]
+        }
+        ("list_dir", p) => vec![display_path(working_dir, p.unwrap_or("."))],
+        ("search_code", _) => vec![display_path(working_dir, ".")],
+        _ => Vec::new(),
+    }
+}
